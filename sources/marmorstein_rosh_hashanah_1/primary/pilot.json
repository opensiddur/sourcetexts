            "corresp": "urn:x-opensiddur:text:bible:chronicles_1/16/12",
            "fragments": [
              {
                "scan": "s60",
                "printed_page": "15",
                "text": "זִכְרוּ נִפְלְאוֹתָיו אֲשֶׁר עָשָׂה מֹפְתָיו וּמִשְׁפְּטֵי־פִיהוּ:"
