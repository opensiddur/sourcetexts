            "corresp": "urn:x-opensiddur:text:bible:chronicles_1/16/10",
            "fragments": [
              {
                "scan": "s60",
                "printed_page": "15",
                "text": "הִתְהַלְלוּ בְּשֵׁם קָדְשׁוֹ יִשְׂמַח לֵב מְבַקְשֵׁי יי:"
