            "fragments": [
              {
                "scan": "s62",
                "printed_page": "16",
                "text": "וַיַּעֲמִידֶהָ לְיַעֲקֹב לְחֹק לְיִשְׂרָאֵל בְּרִית עוֹלָם:"
