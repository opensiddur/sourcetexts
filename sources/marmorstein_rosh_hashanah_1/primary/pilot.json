            "fragments": [
              {
                "scan": "s62",
                "printed_page": "16",
                "text": "חִילוּ מִלְּפָנָיו כָּל־הָאָרֶץ אַף־תִּכּוֹן תֵּבֵל בַּל־תִּמּוֹט:"
