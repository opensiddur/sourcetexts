          {
            "corresp": "urn:x-opensiddur:text:bible:chronicles_1/16/9",
            "fragments": [
              {
                "scan": "s60",
                "printed_page": "15",
                "text": "שִׁירוּ לוֹ וְזַמְּרוּ־לוֹ שִׂיחוּ בְּכָל־נִפְלְאוֹתָיו:"
