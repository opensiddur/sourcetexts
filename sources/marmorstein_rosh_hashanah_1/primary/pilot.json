            "corresp": "urn:x-opensiddur:text:bible:chronicles_1/16/11",
            "fragments": [
              {
                "scan": "s60",
                "printed_page": "15",
                "text": "דִּרְשׁוּ יי וְעֻזּוֹ בַּקְּשׁוּ פָנָיו תָּמִיד:"
              }
