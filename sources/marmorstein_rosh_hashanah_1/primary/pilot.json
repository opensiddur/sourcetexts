            "fragments": [
              {
                "scan": "s62",
                "printed_page": "16",
                "text": "הָבוּ לַיי כְּבוֹד שְׁמוֹ שְׂאוּ מִנְחָה וּבֹאוּ לְפָנָיו הִשְׁתַּחֲווּ לַיי בְּהַדְרַת־קֹדֶשׁ:"
