      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "לַמְנַצֵּחַ מִזְמוֹר לְדָוִד:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "הַשָּׁמַיִם מְסַפְּרִים כְּבוֹד־אֵל וּמַעֲשֵׂה יָדָיו מַגִּיד הָרָקִיעַ:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "יוֹם לְיוֹם יַבִּיעַ אֹמֶר וְלַיְלָה לְלַיְלָה יְחַוֶּה־דָּעַת:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "אֵין אֹמֶר וְאֵין דְּבָרִים בְּלִי נִשְׁמָע קוֹלָם:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "בְּכָל־הָאָרֶץ יָצָא קַוָּם וּבִקְצֵה תֵבֵל מִלֵּיהֶם לַשֶּׁמֶשׁ שָׂם אֹהֶל בָּהֶם:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "וְהוּא כְּחָתָן יֹצֵא מֵחֻפָּתוֹ יָשִׂישׂ כְּגִבּוֹר לָרוּץ אֹרַח:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "מִקְצֵה הַשָּׁמַיִם מוֹצָאוֹ וּתְקוּפָתוֹ עַל־קְצוֹתָם וְאֵין נִסְתָּר מֵחַמָּתוֹ:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "תּוֹרַת יְהוָה תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת יְהוָה נֶאֱמָנָה מַחְכִּימַת פֶּתִי:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/9",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "פִּקּוּדֵי יְהוָה יְשָׁרִים מְשַׂמְּחֵי־לֵב מִצְוַת יְהוָה בָּרָה מְאִירַת עֵינָיִם:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/10",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s64",
                "printed_page": "17",
                "text": "יִרְאַת יְהוָה טְהוֹרָה"
              },
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "עוֹמֶדֶת לָעַד מִשְׁפְּטֵי־יְהוָה אֱמֶת צָדְקוּ יַחְדָּו:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/11",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "הַנֶּחֱמָדִים מִזָּהָב וּמִפַּז רָב וּמְתוּקִים מִדְּבַשׁ וְנֹפֶת צוּפִים:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/12",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "גַּם־עַבְדְּךָ נִזְהָר בָּהֶם בְּשָׁמְרָם עֵקֶב רָב:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/13",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "שְׁגִיאוֹת מִי־יָבִין מִנִּסְתָּרוֹת נַקֵּנִי:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/14",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "גַּם מִזֵּדִים חֲשֹׂךְ עַבְדֶּךָ אַל־יִמְשְׁלוּ־בִי אָז אֵיתָם וְנִקֵּיתִי מִפֶּשַׁע רָב:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/15",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s66",
                "printed_page": "18",
                "text": "יִהְיוּ לְרָצוֹן אִמְרֵי־פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְהוָה צוּרִי וְגֹאֲלִי:"
              }
            ]
          }
        ],
        "en": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "For the conductor of the Choir, a Psalm by David:"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "The heavens tell of the glory of God, and the firmament proclaims the work of His hand."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "Day utters speech to day and night to night expresses knowledge."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "There is neither speech nor words without their sound being heard."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "Their line goes out over the whole earth and at the ends of the world are their words, for the sun has He set a tent among them."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "And he (the sun) comes forth like a bridegroom from his canopy, rejoices like a hero to run a course."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "At one end of the heavens is his starting point and his circuit goes round to the other end — nothing can hide from his glow."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "The Torah of the Lord is flawless, refreshing the soul, the testimony of the Lord is faithful making the simple wise."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/9",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "The precepts of the Lord are upright, causing the heart to rejoice, the commandment of the Lord is clear, giving light to the eyes."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/10",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s65",
                "printed_page": "17",
                "text": "The fear of the Lord is pure, enduring for ever, the judgments of"
              },
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "the Lord are truth, together just,"
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/11",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "they are more precious than gold, even than an abundance of refined gold, and sweeter than honey and the honeycomb."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/12",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "Your servant, too, is careful about them, for keeping them there is great reward."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/13",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "As for errors, who understands, cleanse me from hidden sins."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/14",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "From the arrogant, too, keep away Thy servant — let them not rule over me; then will I be without fault and clear of grave offence."
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/19/15",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s67",
                "printed_page": "18",
                "text": "May the words of my mouth be pleasing and the meditation of my heart before Thee, O Lord my Rock and my Redeemer."
              }
            ]
          }
        ]
      },
