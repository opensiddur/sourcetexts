        "language": "he",
        "text": "קדושה לש״ץ בחזרת התפלה.",
        "type": "description",
        "source_script": "rashi"
      }
    ],
    "languages": {
      "he": [
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh",
          "speaker": {
            "abbr": "ח׳",
            "expan": "חזן"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "נְקַדֵּשׁ אֶת שִׁמְךָ בָּעוֹלָם כְּשֵׁם שֶׁמַּקְדִּישִׁים אוֹתוֹ בִּשְׁמֵי מָרוֹם כַּכָּתוּב עַל־יַד נְבִיאֶךָ וְקָרָא זֶה אֶל־זֶה וְאָמַר.",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh",
          "speaker": {
            "abbr": "ק׳",
            "expan": "קהל"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל־הָאָרֶץ כְּבוֹדוֹ:",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/leummatam",
          "speaker": {
            "abbr": "ח׳",
            "expan": "חזן"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "לְעֻמָּתָם בָּרוּךְ יֹאמֵרוּ.",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod",
          "speaker": {
            "abbr": "ק׳",
            "expan": "קהל"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "בָּרוּךְ כְּבוֹד־יְיָ מִמְּקוֹמוֹ:",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei",
          "speaker": {
            "abbr": "ח׳",
            "expan": "חזן"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר.",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/yimlokh",
          "speaker": {
            "abbr": "ק׳",
            "expan": "קהל"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ:",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador",
          "speaker": {
            "abbr": "ח׳",
            "expan": "חזן"
          },
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה.",
              "page_start": false
            }
          ]
        },
        {
          "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/hael_haqadosh",
          "fragments": [
            {
              "scan": "s9",
              "printed_page": "3",
              "text": "בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:",
              "page_start": false
            }
          ]
        }
      ]
