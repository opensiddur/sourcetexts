  },
  {
    "day": "wednesday",
    "scan": "s335",
    "physical_line": 5,
    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/32",
    "text": "(כְּנֶֽשֶׁר עַל כַּנְפֵי נְשָׁרִים. נָשָׂא עֲבָדָיו וְיִשֵׁר הֲדוּרִים:)",
    "xml_id": "appendix_s335_line_5",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/32/optional",
    "whole_line": true,
