  },
  {
    "day": "wednesday",
    "scan": "s335",
    "physical_line": 6,
    "canonical_part": null,
    "text": "(כְּדוֹב שַׁכּוּל וּכְנָמֵר שַׁחַל. כְּרָקָב וּכְעָשׁ וְרוּחוֹ כַּנָּֽחַל:)",
    "xml_id": "appendix_s335_line_6",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/kedov_shakkul_ukhenamer_shachal/optional",
