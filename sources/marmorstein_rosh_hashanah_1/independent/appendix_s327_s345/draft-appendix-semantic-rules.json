  },
  {
    "day": "wednesday",
    "scan": "s335",
    "physical_line": 3,
    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/30",
    "text": "(יָפֶה דוֹדִי יָפְיוֹ וְטוּבוֹ. יִרְאוּ וְיֶחֱזוּ צִיּוֹן בְּשׁוּבוֹ:)",
    "xml_id": "appendix_s335_line_3",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/30/optional",
    "whole_line": true,
