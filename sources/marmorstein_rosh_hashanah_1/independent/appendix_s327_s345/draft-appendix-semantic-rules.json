    "scan": "s334",
    "physical_line": 21,
    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/22",
    "text": "(וַאֲשֶׁר חֶֽרֶב גַּאֲוָתֵֽנוּ. לְהִלָּחֵם מִלְחַמְתֵּֽנוּ:)",
    "xml_id": "appendix_s334_line_21",
    "kind": "optional",
