    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/44",
    "text": "(כְּאַרְיֵה מַשְׁחִית וְכַכְּפִיר לְעֹזְבָיו. כְּרָקָב גַּם כָּעָשׁ לְאוֹיְבָיו:)",
    "xml_id": "appendix_s335_line_18",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/44/optional",
