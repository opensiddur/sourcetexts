    "physical_line": 15,
    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/41",
    "text": "(כְּאַרְיֵה יִשְׁאַג וְכִכְפִיר יִנְהָם. אַל יִהְיֶה כְּגֵר וּכְאִישׁ נִדְהָם:)",
    "xml_id": "appendix_s335_line_15",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/41/optional",
