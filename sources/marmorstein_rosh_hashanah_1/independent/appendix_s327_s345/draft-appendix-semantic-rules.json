    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/43",
    "text": "(כְּגִבּוֹר אֵין אֱיָל וּכְאוֹרֵחַ. נָס וּכְבוֹרֵחַ מַר צוֹרֵחַ:)",
    "xml_id": "appendix_s335_line_17",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/43/optional",
