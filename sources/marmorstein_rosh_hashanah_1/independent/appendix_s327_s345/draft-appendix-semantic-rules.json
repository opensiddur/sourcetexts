    "physical_line": 19,
    "canonical_part": "urn:x-opensiddur:text:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/45",
    "text": "(כַּבִּיר כֹּחַ כְּשָׁמִיר וָשַֽׁיִת. וְלֹא יַשְׁאִיר כְּנוֹקֶף זַֽיִת:)",
    "xml_id": "appendix_s335_line_19",
    "kind": "optional",
    "condition": "urn:x-opensiddur:condition:poem:hymn_of_divine_unity_for_the_fourth_day_paytan/45/optional",
