  {
    "stem": "haftarah_before_blessing",
    "urn": "urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar",
    "title": {
      "he": "ברכה לפני ההפטרה",
      "en": "Blessing before the Haphtorah"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s174",
              "printed_page": "76",
              "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר בָּחַר בִּנְבִיאִים טוֹבִים וְרָצָה בְדִבְרֵיהֶם הַנֶּאֱמָרִים בֶּאֱמֶת בָּרוּךְ אַתָּה יְיָ הַבּוֹחֵר בַּתּוֹרָה וּבְמֹשֶׁה עַבְדּוֹ וּבְיִשְׂרָאֵל עַמּוֹ וּבִנְבִיאֵי הָאֱמֶת וָצֶדֶק:"
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar/text"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s175",
              "printed_page": "76",
              "text": "Blessed art Thou, O Lord our God, King of the World, who has chosen worthy prophets and found pleasure in their words that are spoken in truth. Blessed art Thou, O Lord, who has chosen the Torah and His servant Moses, His people Israel and prophets of truth and righteousness."
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar/text"
        }
      ]
    }
  },
  {
    "stem": "haftarah_after_blessings",
    "urn": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after",
    "title": {
      "he": "ברכות אחרונות להפטרה",
      "en": "Blessings after the Haphtorah"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s182",
              "printed_page": "80",
              "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם צוּר כָּל־הָעוֹלָמִים צַדִּיק בְּכָל־הַדּוֹרוֹת הָאֵל הַנֶּאֱמָן הָאוֹמֵר וְעוֹשֶׂה הַמְדַבֵּר וּמְקַיֵּם שֶׁכָּל־דְּבָרָיו אֱמֶת וָצֶדֶק:"
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/tzur"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s182",
              "printed_page": "80",
              "text": "נֶאֱמָן אַתָּה הוּא יְיָ אֱלֹהֵינוּ וְנֶאֱמָנִים דְּבָרֶיךָ וְדָבָר אֶחָד מִדְּבָרֶיךָ אָחוֹר לֹא־יָשׁוּב רֵיקָם כִּי אֵל מֶלֶךְ נֶאֱמָן וְרַחֲמָן אָתָּה. בָּרוּךְ אַתָּה יְיָ הָאֵל הַנֶּאֱמָן בְּכָל־דְּבָרָיו:"
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/neeman"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s182",
              "printed_page": "80",
              "text": "רַחֵם עַל־צִיּוֹן כִּי הִיא בֵּית חַיֵּינוּ וְלַעֲלוּבַת נֶפֶשׁ תּוֹשִׁיעַ בִּמְהֵרָה בְּיָמֵינוּ. בָּרוּךְ אַתָּה יְיָ מְשַׂמֵּחַ צִיּוֹן בְּבָנֶיהָ:"
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/rachem"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s182",
              "printed_page": "80",
              "text": "שַׂמְּחֵנוּ יְיָ אֱלֹהֵינוּ בְּאֵלִיָּהוּ הַנָּבִיא עַבְדֶּךָ וּבְמַלְכוּת בֵּית דָּוִד מְשִׁיחֶךָ בִּמְהֵרָה יָבֹא וְיָגֵל לִבֵּנוּ. עַל־כִּסְאוֹ לֹא־יֵשֵׁב זָר וְלֹא יִנְחֲלוּ עוֹד אֲחֵרִים אֶת־כְּבוֹדוֹ. כִּי בְשֵׁם קָדְשְׁךָ נִשְׁבַּעְתָּ לּוֹ שֶׁלֹּא־יִכְבֶּה נֵרוֹ לְעוֹלָם וָעֶד. בָּרוּךְ אַתָּה יְיָ מָגֵן דָּוִד:"
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/sammechenu"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s183",
              "printed_page": "80",
              "text": "Blessed art Thou, O Lord our God, King of the World, Rock of all eternity, just in all generations, faithful God who says and acts, speaks and fulfils, for all His words are truth and righteousness."
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/tzur"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s183",
              "printed_page": "80",
              "text": "Faithful art Thou, O Lord our God and faithful are Thy words and not one of Thy words turns back empty; for Thou art a faithful and compassionate God and King. Blessed art Thou, O Lord God who is faithful in all His words."
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/neeman"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s183",
              "printed_page": "80",
              "text": "Have mercy upon Zion, it is the centre of our life; and save her, whose soul is afflicted, speedily in our days. Blessed art Thou, O Lord, who makes Zion rejoice with her children."
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/rachem"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s183",
              "printed_page": "80",
              "text": "Let us rejoice, O Lord our God, with the prophet Elijah Thy servant and with the realm of the House of David thine anointed. Speedily may he come that our heart may have joy. Let no stranger sit on his throne, and let others no longer inherit his glory for by Thy Holy Name hast Thou sworn to him that his light shall not be extinguished for ever. Blessed art Thou, O Lord, shield of David."
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/after/sammechenu"
        }
      ]
    }
  },
