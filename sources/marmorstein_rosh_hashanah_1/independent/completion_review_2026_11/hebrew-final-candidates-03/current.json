          "paragraph": 1,
          "fragments": [
            {
              "scan": "s189",
              "printed_page": "84",
              "text": "וּבְכֵן יְהִי־רָצוֹן לְפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיַּעֲלוּ כָּל הַמַּלְאָכִים הַמְמֻנִּים עַל הַשּׁוֹפָר וְעַל הַתְּקִיעָה וְעַל הַשְּׁבָרִים וְעַל הַתְּרוּעָה לִפְנֵי כִסֵּא כְבוֹדֶךָ וְיַמְלִיצוּ טוֹב בַּעֲדֵינוּ לְכַפֵּר עַל כָּל חַטֹּאתֵינוּ:",
              "page_start": false
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:prayer:shofar_uvkhen_yehi_ratzon/text"
        }
      ]
    },
