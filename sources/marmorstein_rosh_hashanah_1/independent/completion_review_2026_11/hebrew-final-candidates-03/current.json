          "source": "urn:x-opensiddur:text:bible:proverbs/3/16",
          "source_reference": "urn:x-opensiddur:text:bible:proverbs/3/16",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/orekh",
