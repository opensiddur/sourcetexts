  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/shofar_uvkhen_yehi_ratzon.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shofar_uvkhen_yehi_ratzon" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n188.jpg">
        <tei:note type="instruction" xml:lang="he">בעוד שהצבור אומרים אשרי העם <tei:choice><tei:abbr>וכו׳</tei:abbr><tei:expan>וכולי</tei:expan></tei:choice> יאמר התוקע בלחש.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:shofar_uvkhen_yehi_ratzon/text"/>וּבְכֵן יְהִי־רָצוֹן לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיַּעֲלוּ כָּל הַמַּלְאָכִים הַמְמֻנִּים עַל הַשּׁוֹפָר וְעַל הַתְּקִיעָה וְעַל הַשְּׁבָרִים וְעַל הַתְּרוּעָה לִפְנֵי כִסֵּא כְבוֹדֶךָ וְיַמְלִיצוּ טוֹב בַּעֲדֵינוּ לְכַפֵּר עַל כָּל חַטֹּאתֵינוּ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
