                  <tei:fs type="opensiddur:quorum">
                    <tei:f name="minyan">
                      <tei:binary value="true"/>
                    </tei:f>
                  </tei:fs>
                </j:all>
              </j:conditional>
              <tei:div>
                <tei:head xml:lang="he">חזרת התפלה לשליח צבור</tei:head>
                <tei:head xml:lang="en">Repetition of the Amidah</tei:head>
