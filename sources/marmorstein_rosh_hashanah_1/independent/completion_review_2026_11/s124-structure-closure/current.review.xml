        </documentary_order_context>
  <expanded_actual_full_repetition_scope><tei:div xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2" xml:id="section_morning_repetition">
