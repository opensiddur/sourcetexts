        <tei:note xmlns:tei="http://www.tei-c.org/ns/1.0" type="instruction" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n123.jpg" xml:lang="he">סוגרים הארון.</tei:note>
        <tei:note xmlns:tei="http://www.tei-c.org/ns/1.0" type="description" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n123.jpg" xml:lang="he">ע״ס א״ב.</tei:note>
