      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/qadosh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n106.jpg">
        <tei:p><tei:milestone unit="chapter" n="6"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:yotzer_or/qadosh/quoted_isaiah_6_3" n="qadosh"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3/qadosh" type="quotation">Holy, holy, holy is the Lord of Hosts, The whole earth is full of His glory.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
