  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/yotzer_qadosh.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:yotzer_or/qadosh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n105.jpg">
        <tei:p><tei:milestone unit="chapter" n="6"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:prayer:yotzer_or/qadosh/quoted_isaiah_6_3" n="qadosh"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3/qadosh" type="quotation">קָד֧וֹשׁ ׀ קָד֛וֹשׁ קָדוֹשׁ <j:divineName>יְיָ֥</j:divineName> צְבָא֑וֹת מְלֹ֥א כָל־הָאָ֖רֶץ כְּבוֹדֽוֹ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/yotzer_qadosh.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
