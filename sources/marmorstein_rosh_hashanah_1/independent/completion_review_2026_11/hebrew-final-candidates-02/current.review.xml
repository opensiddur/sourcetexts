  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/morning_full_kaddish_preface.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">וְעַתָּה יִגְדַּל־נָא כֹּחַ אֲדֹנָי כַּאֲשֶׁר דִּבַּרְתָּ לֵאמֹר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">זְכֹר רַחֲמֶיךָ <j:divineName>יְיָ</j:divineName> וַחֲסָדֶיךָ כִּי מֵעוֹלָם הֵמָּה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/morning_full_kaddish_preface.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">And now let the power of the Lord appear great as Thou hast said.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">Remember Thy mercies, O Lord, and Thine acts of loving-kindness for they exist since eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_ein_kamokha.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_kamokha" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg" n="69"/><tei:milestone unit="chapter" n="86" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/86/8">אֵין כָּמוֹךָ בָאֱלֹהִים אֲדֹנָי וְאֵין כְּמַעֲשֶׂיךָ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/malkhut"/><tei:milestone unit="chapter" n="145" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145/13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/145/13">מַלְכוּתְךָ מַלְכוּת כָּל עֹלָמִים וּמֶמְשַׁלְתְּךָ בְּכָל דּוֹר וָדֹר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/melekh"/> <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד:  <tei:milestone 
unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/oz"/><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְיָ</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְיָ</j:divineName> יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_ein_kamokha.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:ein_kamokha" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="chapter" n="86" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/86/8">There is none like Thee among the mighty ones O Lord and nought like Thy works.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/malkhut"/><tei:milestone unit="chapter" n="145" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145/13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/145/13">Thy realm is a realm for all eternity and Thy rule over every generation.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/melekh"/> The Lord is King, the Lord has reigned, the Lord will reign for ever and ever.  <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" 
corresp="urn:x-opensiddur:text:prayer:ein_kamokha/oz"/><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11">The Lord gives strength to His people, the Lord blesses His people with peace.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_shema.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/text"/><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema/4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/4">שְׁמַע יִשְׂרָאֵל <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ <j:divineName>יְיָ</j:divineName> אֶחָד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_shema.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/text"/><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema/4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/4">Hear, O Israel, the Lord is our God, the Lord is One.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_echad_eloheinu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:echad_eloheinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:echad_eloheinu/text"/>אֶחָד אֱלֹהֵינוּ גָּדוֹל אֲדוֹנֵנוּ קָדוֹשׁ (וְנוֹרָא) שְׁמוֹ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_echad_eloheinu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:echad_eloheinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:echad_eloheinu/text"/>Our God is One, our Lord is great, holy (and awe-inspiring) is His Name! <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_gaddelu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:note type="description" xml:lang="en">The reader, holding the scroll of the Torah in front of him, says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/gaddelu/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/34/4">גַּדְּלוּ לַ<j:divineName>ייָ</j:divineName> אִתִּי. וּנְרוֹמְמָה שְׁמוֹ יַחְדָּו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_gaddelu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:note type="description" xml:lang="en">The reader, holding the scroll of the Torah in front of him, says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/gaddelu/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/34/4">Magnify the Lord with me, and let us exalt His Name together.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_vayaazor.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:vayaazor/text"/>וְיַעֲזוֹר וְיָגֵן וְיוֹשִׁיעַ לְכָל הַחוֹסִים בּוֹ וְנֹאמַר אָמֵן: הַכֹּל הָבוּ גֹדֶל לֵאלֹהֵינוּ וּתְנוּ כָבוֹד לַתּוֹרָה כֹּהֵן קְרָב. יַעֲמוֹד (פלוני בר פלוני הכהן): בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">תּוֹרַת <j:divineName>יְיָ</j:divineName> תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת <j:divineName>יְיָ</j:divineName> נֶאֱמָנָה מַחְכִּימַת פֶּתִי:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">פִּקּוּדֵי <j:divineName>יְיָ</j:divineName> יְשָׁרִים מְשַׂמְּחֵי לֵב מִצְוַת <j:divineName>יְיָ</j:divineName> בָּרָה מְאִירַת עֵינָיִם:</tei:seg><tei:milestone 
unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְיָ</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְיָ</j:divineName> יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="18" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael"/><tei:milestone unit="verse" n="31" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/18/31">הָאֵל תָּמִים דַּרְכּוֹ אִמְרַת <j:divineName>יְיָ</j:divineName> צְרוּפָה מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_vayaazor.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:vayaazor/text"/>And He will help, protect and save all who shelter with Him, and let us say: Amen. Let all of you ascribe greatness to our God and honour the Torah, let the Cohen approach. Let there arise . . . Blessed be He, who in His holiness has given the Torah to His people Israel.  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">The Torah of the Lord is flawless, refreshing the soul; the testimony of the Lord is faithful, making the simple wise.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">The precepts of the Lord are upright, causing the heart to rejoice, the commandment of the Lord is clear, giving light to the eyes.</tei:seg><tei:milestone 
unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11">The Lord gives strength to His people, the Lord blesses His people with peace:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="18" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael"/><tei:milestone unit="verse" n="31" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/18/31">God’s way is perfect, the Lord’s word is pure, a shield is He for all who shelter with Him.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_veattem.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg">
        <tei:note type="description" xml:lang="en">The congregation responds:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/text"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem/4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/4/4">וְאַתֶּם הַדְּבֵקִים בַּ<j:divineName>ייָ</j:divineName> אֱלֹהֵיכֶם חַיִּים כֻּלְּכֶם הַיּוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_veattem.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg">
        <tei:note type="description" xml:lang="en">The congregation responds:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/text"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem/4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/4/4">You who adhere to the Lord your God, are all alive this day.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/torah_barekhu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/call"/>בָּרְכוּ אֶת־<j:divineName>יְיָ</j:divineName> הַמְבֹרָךְ: <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="en">Cong.</tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/response"/>בָּרוּךְ <j:divineName>יְיָ</j:divineName> הַמְבֹרָךְ לְעוֹלָם וָעֶד: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/torah_barekhu.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/call"/>Bless the Lord who is called blessed. <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="en">The congregation responds:</tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/response"/>Blessed is the Lord who is called blessed, for ever and ever. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
