          "corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/melekh",
          "end_reference": true
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s160",
              "printed_page": "69",
              "text": "יְיָ עֹז לְעַמּוֹ יִתֵּן יְיָ יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/29/11",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/29/11",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_29/11",
          "corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/oz",
