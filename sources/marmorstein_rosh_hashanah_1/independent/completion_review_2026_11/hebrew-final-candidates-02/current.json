          "paragraph": 1,
          "fragments": [
            {
              "scan": "s160",
              "printed_page": "69",
              "text": "מַלְכוּתְךָ מַלְכוּת כָּל עֹלָמִים וּמֶמְשַׁלְתְּךָ בְּכָל דּוֹר וָדֹר:",
              "page_start": false
            }
