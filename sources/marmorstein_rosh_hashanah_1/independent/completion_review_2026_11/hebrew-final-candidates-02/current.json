          "paragraph": 1,
          "fragments": [
            {
              "scan": "s161",
              "printed_page": "69",
              "text": "There is none like Thee among the mighty ones O Lord and nought like Thy works.",
              "page_start": true
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/86/8",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/86/8",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_86/8"
        },
