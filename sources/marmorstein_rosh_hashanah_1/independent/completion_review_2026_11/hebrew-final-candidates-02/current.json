  {
    "stem": "torah_vayaazor",
    "urn": "urn:x-opensiddur:text:prayer:vayaazor",
    "title": {
      "he": "ויעזור",
      "en": "And He will help"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": "וְיַעֲזוֹר וְיָגֵן וְיוֹשִׁיעַ לְכָל הַחוֹסִים בּוֹ וְנֹאמַר אָמֵן: הַכֹּל הָבוּ גֹדֶל לֵאלֹהֵינוּ וּתְנוּ כָבוֹד לַתּוֹרָה כֹּהֵן קְרָב. יַעֲמוֹד (פלוני בר פלוני הכהן): בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ: "
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:vayaazor/text"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": "תּוֹרַת יְיָ תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת יְיָ נֶאֱמָנָה מַחְכִּימַת פֶּתִי:"
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/19/8",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/19/8",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/torat",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": " "
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": "פִּקּוּדֵי יְיָ יְשָׁרִים מְשַׂמְּחֵי לֵב מִצְוַת יְיָ בָּרָה מְאִירַת עֵינָיִם:"
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/19/9",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/19/9",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": " "
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": "יְיָ עֹז לְעַמּוֹ יִתֵּן יְיָ יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:"
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/29/11",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/29/11",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/oz",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": " "
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s166",
              "printed_page": "72",
              "text": "הָאֵל תָּמִים דַּרְכּוֹ אִמְרַת יְיָ צְרוּפָה מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ:"
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/18/31",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/18/31",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/hael",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s167",
              "printed_page": "72",
              "text": "And He will help, protect and save all who shelter with Him, and let us say: Amen. Let all of you ascribe greatness to our God and honour the Torah, let the Cohen approach. Let there arise . . . Blessed be He, who in His holiness has given the Torah to His people Israel. "
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:vayaazor/text"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s167",
              "printed_page": "72",
              "text": "The Torah of the Lord is flawless, refreshing the soul; the testimony of the Lord is faithful, making the simple wise."
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/19/8",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/19/8",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/torat",
