          "source_reference": "urn:x-opensiddur:text:bible:psalms/145/13",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/quotations/psalms_145/13",
          "corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/malkhut",
          "end_reference": true
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s161",
              "printed_page": "69",
              "text": " The Lord is King, the Lord has reigned, the Lord will reign for ever and ever. ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:ein_kamokha/melekh",
          "end_reference": true
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s161",
              "printed_page": "69",
              "text": "The Lord gives strength to His people, the Lord blesses His people with peace.",
              "page_start": false
            }
