{
  "units": [
    {
      "stem": "khevodo_ihel",
      "urn": "urn:x-opensiddur:text:poem:khevodo_ihel",
      "title": {
        "he": "כְּבוֹדוֹ אִהֵל",
        "en": "He extends His glory"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "כְּבוֹדוֹ, אִהֵל כְּהַיּוֹם בְּרַחֲמִים מֶלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/1",
            "reference_unit": "stanza"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "בּוֹחֵן כָּל־עֶשְׁתּוֹנוֹת צָעִיר וָרַב, מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "גֵּאוּת וָעוֹז הִתְאַזָּר מֶֽלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "דּוֹק וָחֶֽלֶד יֶחֶרְדוּן מֵאֵֽימַת מֶֽלֶךְ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "הַיּוֹצֵר יַחַד לִבָּם יָחוֹן מֶלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/2",
            "reference_unit": "stanza"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "וּמֵבִין אֶל־כָּל־מַעֲשֵׂיהֶם יַצְדִּיק מֶלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "זִכָּרוֹן הוּא יוֹם תְּרוּעַת מֶלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "חֹק לְיִשְׂרָאֵל הוּא לְזַכּוֹתָם מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            }
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "טֶֽרֶף נָתַן לִירֵאָיו מַמְלִיךְ כָּל־מֶֽלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "יִזְכּוֹר לְעוֹלָם בְּרִיתוֹ בְּזִכְרוֹן טוֹב מֶֽלֶךְ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "כָּלָה אַל תַּעַשׂ לִשְׁאֵרִית בְּנֵי מֶלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/3",
            "reference_unit": "stanza"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "לָכֵן אָתָנוּ לְךָ מַלְכֵּנוּ מֶלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "מֵאֶתְמוֹל קִדַּמְנוּךָ לְחַלּוֹתְךָ",
                "page_start": false
              },
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "מֶלֶךְ:",
                "page_start": true
              }
            ]
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "נָא נְצוֹר חֶֽסֶד לְנִינֵי שָׁלְֽחוּ לוֹ שְׁלֹשֶׁת אֵֽילֵי מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/4",
            "reference_unit": "stanza",
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            }
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "סְכוֹת בָּאֵי בְתַחַן לְמַר בָּכוּ אֶרְאֶלֵּי מֶֽלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "עֱנוּתָם בַּל תְּבֶז לְלָן בַּמָּקוֹם עָלוּ וְיָרְדוּ בוֹ מַלְאֲכֵי מֶֽלֶךְ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "פְּדֵם הַיּוֹם מִדִּין גָּמוּר מִלְּחַיְּבֵם מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/5",
            "reference_unit": "stanza"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "צַדְּקֵם בְּרַחֲמִים וּפָקְדֵם לְטוֹבָה מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            }
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "קְשׁוֹב קוֹל תְּקִיעָה מְתוֹקְעֵי",
                "page_start": false
              }
            ],
            "conditions": [
              {
                "type": "opensiddur:holiday-aggregate",
                "features": {
                  "shabbat": false
                }
              }
            ],
            "reference_unit": "stanza"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "(קְשׁוֹב זִכְרוֹן תְּקִיעָה מְזוֹכְרֵי)",
                "page_start": false
              }
            ],
            "conditions": [
              {
                "type": "opensiddur:holiday-aggregate",
                "features": {
                  "shabbat": true
                }
              }
            ],
            "condition_instruction": "אַם שַׁבָּת",
            "marked": true,
            "condition_instruction_language": "de-Hebr"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "לְךָ הַיּוֹם מֶֽלֶךְ.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "רַחֲמִים תְּעוֹרֵר לִמְחַכֶּֽיךָ מֶֽלֶךְ:",
                "page_start": false
              }
            ],
            "reference_unit": "stanza"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "שְׁעֵה שַׁוְעַת עַם מְשַׁחֲרֶֽיךָ מֶֽלֶךְ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/6",
            "reference_unit": "stanza",
            "speaker": {
              "abbr": "קו״ח",
              "expan": "קהל וחזן"
            }
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "תֵּֽפֶן בְּתוֹמְכֵי בָרוּךְ וּנְבָרֶכְךָ אֱלֹהִים חַיִּים וָמֶֽלֶךְ:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s107",
                "printed_page": "39",
                "text": "He extends His glory this day in mercy, the King, He who tests all thoughts of small and great, the King, in majesty and might does the King gird Himself, heaven and earth quake from fear of the King.",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/1"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s107",
                "printed_page": "39",
                "text": "He who has formed together their heart, will show grace, the King. He who knows all their deeds, will justify, the King. It is a memorial, a day of homage through the Shofar sound, a law for Israel, so that the King may acquit them. Food does He give to those who fear Him, He who appoints every king, eternally does He remember His covenant in kindly memory, the King.",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/2"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s107",
                "printed_page": "39",
                "text": "Let not destruction overtake the remnant of the King’s sons (Israel), Therefore, our King, do we come before Thee. O King, yesterday did we approach Thee already to implore",
                "page_start": false
              },
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Thee, O King.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/3"
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Mayest Thou preserve grace towards the offspring of him to whom three of the King’s angels were sent (Abraham). Take heed of those who approach with prayer for the sake of him whom the King’s Erelim did bitterly bewail (Isaac at the sacrifice). Reject not their humility for the sake of him who lodged the night at the place where the King’s angels ascended and descended (Jacob).",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/4"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Redeem them this day in judgment, do not utterly condemn them, O King. Acquit them in mercy, remember them kindly, O King.",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/5"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Heed the sound of the blast of those who blow the Shofar before Thee this day",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "conditions": [
              {
                "type": "opensiddur:holiday-aggregate",
                "features": {
                  "shabbat": false
                }
              }
            ]
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "(heed the memory of the Shofar blast of those who commemorate before Thee this day)",
                "page_start": false
              }
            ],
            "conditions": [
              {
                "type": "opensiddur:holiday-aggregate",
                "features": {
                  "shabbat": true
                }
              }
            ],
            "marked": true
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "O King.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Arouse compassion towards those who hope for Thee, O King.",
                "page_start": false
              }
            ],
            "reference_unit": "stanza"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "Turn towards the supplication of the people who seek Thee, O King, heed those who hold firmly to the blessing of Thy Name, that we may bless Thee, O living God and King.",
                "page_start": false
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:khevodo_ihel/6"
          }
        ]
      },
