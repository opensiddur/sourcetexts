  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/hashem_melekh.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashem_melekh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg" n="57"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hashem_melekh/text"/><j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/hashem_melekh.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashem_melekh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg" n="57"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hashem_melekh/text"/>The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/adirei_ayummah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adirei_ayummah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg">
        <tei:note type="description" xml:lang="he">ש״ץ מנגן. והקהל חוזר.</tei:note>
        <tei:note type="description" xml:lang="he">ע״ס א״ב משולש.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n141.jpg" n="57"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/1"/>אַדִּירֵי אֲיֻמָּה יַאֲדִירוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/2"/>בְּרוּאֵי בָרָק יְבָרְכוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/3"/>גִּבּוֹרֵי גֹבַהּ יַגְבִּירוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/4"/>דּוֹהֲרֵי דוֹלְקִים יְדוֹבְבוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/5"/>הֲמוֹנֵי הֲמֻלָּה יְהַלְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/6"/>וְחַיִל וְחַיוֹת יָעִידוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/7"/>זוֹכְרֵי זְמִירוֹת יְזַמְּרוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/8"/>חַכְמֵי חִידוֹת יְחַפְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/9"/>טַפְסְרֵי טְפוּחִים יְטַכְּסוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/10"/>יוֹרְשֵׁי יְקָרָה יְיַשְׁרוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/11"/>כַּבִּירֵי כֹחַ יְכַתְּרוּךָ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/12"/>לְבוּשֵׁי לַהֲבוֹת יְלַבְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/13"/>מַטְעִימֵי מֶלֶל יְמַלְּלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/14"/>נִצּוֹצֵי נֹגַהּ יְנַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/15"/>שְׂרָפִים סוֹבְבִים יְסַלְסְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/16"/>עוֹרְכֵי עֹז יַעֲנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/17"/>פַּחֲדֵי פְלָאֶיךָ יְפַצְּחוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/18"/>צִבְאוֹת צֹאנְךָ יְצַלְצְלוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/19"/>קְהִלּוֹת קֹדֶשׁ יַקְדִּישׁוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/20"/>רִבְבוֹת רְבָבָה יְרַנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/21"/>שְׁבִיבֵי שַׁלְהָבוֹת יְשַׁנְּנוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/22"/>סוֹמְכֵי תְהִלּוֹת יַתְמִידוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מֶלֶךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/23"/>תּוֹקְפֵי תִפְאַרְתֶּךָ יְתַמְּמוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> מָלָךְ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/24"/>תְּמִימֵי תְעוּדָה יְתַנּוּ בְקוֹל. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ: <j:divineName>יְיָ</j:divineName> מֶלֶךְ <j:divineName>יְיָ</j:divineName> מָלָךְ <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם וָעֶד: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/adirei_ayummah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adirei_ayummah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg" n="57"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/1"/>The mighty of the awe-inspiring people (Israel) swear allegiance aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/2"/>Those formed in lightning bless Thee aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/3"/>The strong and lofty raise their voice aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/4"/>The fiery in their haste utter aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/5"/>The massed multitude praise aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/6"/>And the hosts and the Hayoth testify aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/7"/>Chanters of psalms sing aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/8"/>The wise in mysteries confirm aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/9"/>Princes in heaven glorify aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/10"/>Heirs of the precious teaching affirm aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/11"/>The mighty in strength pay homage aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/12"/>Those enveloped in flames give thanks aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/13"/>They who speak pleasing words say aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/14"/>They who sparkle with brilliance triumph aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/15"/>The Seraphim around Him glorify aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/16"/>Those who classify the law respond aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/17"/>Those in dread at Thy wonders utter aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/18"/>The hosts of Thy flock let it ring out aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/19"/>Holy communities sanctify aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/20"/>Myriads of myriads exult aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/21"/>Those fashioned of flames repeat aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/22"/>Those who maintain praises say constantly aloud: The Lord is King. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/23"/>Those who affirm Thy glory speak sincerely and aloud: The Lord has reigned. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:adirei_ayummah/24"/>The perfect in testimony relate aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_tair_repeat.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_tair_repeat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_tair_repeat/text"/><tei:seg source="urn:x-opensiddur:text:poem:tair_vetaria">תָּעִיר וְתָרִיעַ. לְהַכְרִית כָּל מֵרֵעַ. וְתִקָּדֵשׁ בְּיוֹדְעֵי לְהָרִיעַ. קָדוֹשׁ:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/repetition_tair_repeat.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_tair_repeat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_tair_repeat/text"/><tei:seg source="urn:x-opensiddur:text:poem:tair_vetaria">Thou dost rise and let the trumpet sound to destroy every evil doer, and Thou art sanctified by those who know how to sound the Teruah, Holy One.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_melekh_zokher_repeat.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_melekh_zokher_repeat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n139.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n139.jpg" n="56"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_melekh_zokher_repeat/text"/><tei:seg source="urn:x-opensiddur:text:poem:melekh_zokher_achuz_qeren">מֶלֶךְ זוֹכֵר אֲחוּז קֶרֶן. לְתוֹקְעֵי לְךָ הַיּוֹם בְּקֶרֶן. נוֹרָא וְקָדוֹשׁ:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/repetition_melekh_zokher_repeat.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_melekh_zokher_repeat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n140.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n140.jpg" n="56"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/repetition_melekh_zokher_repeat/text"/><tei:seg source="urn:x-opensiddur:text:poem:melekh_zokher_achuz_qeren">O King, Thou dost remember him (Isaac) who was caught by the horn (the ram) on behalf of those who blow the horn before Thee today, O Awe-inspiring and Holy One.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/uvekhen_dayyan_emet_attah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah/text"/>וּבְכֵן דַּיַּן אֱמֶת אָֽתָּה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/uvekhen_dayyan_emet_attah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah/text"/>And thus Thou art the true judge. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/lael_orekh_din.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ב.</tei:note>
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן.</tei:note> לְאֵל עוֹרֵךְ דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל.</tei:note> לְבוֹחֵן לְבָבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְגוֹלֶה עֲמוּקוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְדוֹבֵר מֵישָׁרִים בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְהוֹגֶה דֵּעוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְוָתִיק וְעֹשֶׂה חֶסֶד בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְזוֹכֵר בְּרִיתוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְחוֹמֵל מַעֲשָׂיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְטַהֵר חוֹסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְיוֹדֵעַ מַחֲשָׁבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְכוֹבֵשׁ כַּעֲסוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְלוֹבֵשׁ צְדָקוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n145.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְמוֹחֵל עֲוֹנוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְנוֹרָא תְהִלּוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְסוֹלֵחַ לַעֲמוּסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְעוֹנֶה לְקוֹרְאָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְפוֹעֵל רַחֲמָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְצוֹפֶה נִסְתָּרוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְקוֹנֶה עֲבָדָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> לְרַחֵם עַמּוֹ בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְשׁוֹמֵר אֹהֲבָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְתוֹמֵךְ תְּמִימָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/lael_orekh_din.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg">
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> God who arranges judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who examines hearts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who reveals secrets in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who speaks uprightness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who considers opinions in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who in knowledge acts kindly on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who remembers His covenant in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who pities His creatures on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who cleanses those who trust in Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who knows thoughts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who suppresses His anger in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who clothes Himself in righteousness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n146.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who forgives sins in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who is awe-inspiring in fame on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who pardons those carried by Him in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who answers those who call on Him on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who displays His compassion in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who observes what is concealed on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who acquires His slaves in judgment. <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader and congregation</tei:note> Who has compassion on His people on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who protects those who love Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who supports His innocent ones on the day of judgment. <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
