            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/14"
          },
          {
            "paragraph": 15,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "The Seraphim around Him glorify aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever.",
