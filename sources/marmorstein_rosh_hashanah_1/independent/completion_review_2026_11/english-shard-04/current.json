            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/15"
          },
          {
            "paragraph": 16,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Those who classify the law respond aloud: The Lord is King.",
