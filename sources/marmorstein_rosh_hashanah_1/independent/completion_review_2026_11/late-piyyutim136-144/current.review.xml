  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="uvekhen_namlikhekha"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_namlikhekha" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg" n="57"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_namlikhekha/text"/>Therefore will we crown Thee. <tei:milestone unit="prayer-part"/></tei:p>
