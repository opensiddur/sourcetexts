  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="hashem_melekh"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hashem_melekh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n142.jpg" n="57"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hashem_melekh/text"/>The Lord is King, the Lord has reigned, The Lord will reign for ever and ever. <tei:milestone unit="prayer-part"/></tei:p>
