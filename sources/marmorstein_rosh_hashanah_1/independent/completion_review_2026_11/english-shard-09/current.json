      "title": {
        "he": "עלה אלהים",
        "en": "God rises at the Teruah sound"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "God rises at the Teruah sound, the Lord at the Shofar’s voice.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/47/6",
            "reference_unit": "verse",
