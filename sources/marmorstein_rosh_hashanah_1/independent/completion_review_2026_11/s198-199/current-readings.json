      "title": {
        "he": "אל מלך נאמן שדי",
        "en": "Prayer for the Reader"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s198",
                "printed_page": "89",
                "text": "אֵל מֶלֶךְ נֶאֱמָן שַׁדַּי מֶלֶךְ עֶלְיוֹן קַבֵּל שַׁוְעָתִי בְּרָצוֹן וּבְאִמּוּץ הַלֵּב. יְיָ אֱלֹהֵינוּ יְיָ אֶחָד אֵל חַי דַּיָּן אֱמֶת שׁוֹפֵט צֶדֶק רַחוּם וְחַנּוּן. רַחֵם עָלַי וּשְׁמַע תְּפִלָּתִי הַיּוֹם אֲשֶׁר אֶתְפַּלֵּל בַּעֲדִי וּבְעַד בֵּיתִי וּבְעַד עֲדָתִי הַמַּסְכִּימִים עִמִּי בִּתְפִלָּתִי וְתִכְלוֹל תְּפִלָּתִי עִם הַתְּפִלּוֹת הַיְשָׁרוֹת וְהַנְּקִיּוֹת אֲשֶׁר יַעֲשׂוּ יִשְׂרָאֵל. וְתַחְתּוֹר תַּחַת כִּסֵּא כְבוֹדֶךָ כְּמוֹ שֶׁחָתַרְתָּ לִתְפִלַּת מֹשֶׁה (נ״א מְנַשֶּׁה). וְאַל יֵבוֹשׁוּ בִי שׁוֹלְחַי וְלֹא אֲנִי בָהֶם: ",
                "page_start": true,
                "alternatives": [
                  {
                    "printed": "מֹשֶׁה (נ״א מְנַשֶּׁה)",
                    "readings": [
                      "מֹשֶׁה",
                      "מְנַשֶּׁה"
                    ]
                  }
                ]
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/text"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s198",
                "printed_page": "89",
                "text": "יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגוֹאֲלִי.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/19/15",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/15",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu/15"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s198",
                "printed_page": "89",
                "text": " אָמֵן סֶלָה: יְהִי רָצוֹן לְפָנֶיךָ אָיוֹם שֶׁתִּתֵּן לִי קוֹל נָעִים וְעָרֵב הַיּוֹם וְאַל יִפְסוֹק קוֹלִי וְאַל יִחַר גְּרוֹנִי וְיִהְיֶה קוֹלִי נָעִים וְחָזָק כְּמוֹ שֶׁנֶּאֱמַר ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s198",
                "printed_page": "89",
                "text": "וַיְהִי קוֹל הַשּׁוֹפָר הוֹלֵךְ וְחָזֵק:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:exodus/19/19/vayehi_qol",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/19/19",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19",
            "source_reference_part": {
              "unit": "verse-part",
              "n": "vayehi_qol",
              "corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19/vayehi_qol"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s198",
                "printed_page": "89",
                "text": " אָמֵן סֶלָה:",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s199",
                "printed_page": "89",
                "text": "O God, faithful King, Almighty, Supreme King, accept my devoted and confident prayer. O Lord our God, the Lone God, the living God, the truthful judge, the righteous ruler, merciful and gracious, have mercy upon me and hear my prayer today when I pray for myself and my family and all my congregation who join in my prayers. Include my prayer among the upright and pure prayers that Israel offers, and let it come beneath Thy glorious throne just as Thou didst to the prayer of Moses (Menasseh), so that those who sent me may not be put to shame through me, nor I through them. ",
                "page_start": true,
                "alternatives": [
                  {
                    "printed": "Moses (Menasseh)",
                    "readings": [
                      "Moses",
                      "Menasseh"
                    ]
                  }
                ]
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/text"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s199",
                "printed_page": "89",
                "text": "May the words of my mouth find favour and the meditation of my heart before Thee, O Lord, my Rock and my Redeemer,",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/19/15",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/15",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu/15"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s199",
                "printed_page": "89",
                "text": " Amen, Selah. May it be Thy will, O Awe-inspiring One, to give me a pleasant and sweet voice today so that my voice may not fail me and my throat not burn; let my voice be pleasant and strong, as it is written: ‘",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s199",
                "printed_page": "89",
                "text": "And the sound of the Shofar increased in strength",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:exodus/19/19/vayehi_qol",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/19/19",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19",
            "source_reference_part": {
