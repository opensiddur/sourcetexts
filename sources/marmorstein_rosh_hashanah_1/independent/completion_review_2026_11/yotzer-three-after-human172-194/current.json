{
  "units": [
    {
      "stem": "yotzer_hameir",
      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/hameir",
      "title": {
        "he": "הַמֵּאִיר",
        "en": "He who lights the earth"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "הַמֵּאִיר לָאָֽרֶץ וְלַדָּרִים עָלֶֽיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית: ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "מָה רַבּוּ מַעֲשֶֽׂיךָ יְיָ. כֻּלָּם בְּחָכְמָה עָשִׂיתָ. מָלְאָה הָאָֽרֶץ קִנְֽיָנֶךָ: ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
            "source": "urn:x-opensiddur:text:bible:psalms/104/24",
            "reference_unit": "verse",
            "end_reference": true
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "הַמֶּֽלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶֽיךָ הָרַבִּים רַחֵם עָלֵֽינוּ.",
                "page_start": false
              },
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "אֲדוֹן",
                "page_start": false
              },
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵֽנוּ מִשְׂגָּב בַּעֲדֵֽנוּ:",
                "page_start": true
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "He who lights the earth and those who dwell on it, with mercy and daily in His goodness constantly renews the work of creation. ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "How numerous are Thy works, O Lord, all of them hast Thou made with wisdom, the earth is full of Thy possessions. ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
            "source": "urn:x-opensiddur:text:bible:psalms/104/24",
            "reference_unit": "verse",
            "end_reference": true
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "O King, who alone is exalted from of old, extolled and praised and glorified since days of antiquity. O God of eternity, in Thy great mercy have mercy upon us,",
                "page_start": false
              },
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "Lord of our might, Rock of our fortress, shield of our salvation, a fortress around us.",
                "page_start": true
              }
            ]
          }
        ]
      },
      "conditions": [
        {
          "type": "opensiddur:holiday-aggregate",
          "features": {
            "shabbat": false
          }
        }
      ]
    },
    {
      "stem": "yotzer_el_barukh",
      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/el_barukh",
      "title": {
        "he": "אֵל בָּרוּךְ",
        "en": "Blessed God"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "אֵל בָּרוּךְ גְּדוֹל דֵּעָה. הֵכִין וּפָעַל זָהֳרֵי חַמָּה. טוֹב יָצַר כָּבוֹד לִשְׁמוֹ. מְאוֹרוֹת נָתַן סְבִיבוֹת עֻזּוֹ. פִּנּוֹת צְבָאָיו קְדוֹשִׁים רוֹמְמֵי שַׁדָּי. תָּמִיד מְסַפְּרִים כְּבוֹד־אֵל וּקְדֻשָּׁתוֹ: תִּתְבָּרַךְ יְיָ אֱלֹהֵֽינוּ עַל־שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ. וְעַל־מְאוֹרֵי־אוֹר שֶֽׁעָשִׂיתָ יְפָאֲרֽוּךָ סֶּֽלָה:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "Blessed God, great in knowledge, He has prepared and made the sun’s rays, the Benevolent has fashioned glory for His Name, lights has He placed around His might, the chiefs of His hosts are holy, exalting the Almighty, constantly do they recount the honour of God and His holiness. Blessed art Thou, O Lord our God, for the glory of Thy handiwork, and for the radiant lights that Thou hast made, they shall glorify Thee, Selah.",
                "page_start": false
              }
            ]
          }
        ]
      },
      "conditions": [
        {
          "type": "opensiddur:holiday-aggregate",
          "features": {
            "shabbat": false
          }
        }
      ]
    },
    {
      "stem": "lael_asher_shavat",
      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat",
      "title": {
        "he": "לָאֵל אֲשֶׁר שָׁבַת",
        "en": "To the God who rested"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "לָאֵל אֲשֶׁר שָׁבַת מִכָּל־הַמַּעֲשִׂים בַּיּוֹם הַשְּׁבִיעִי הִתְעַלָּה וְיָשַׁב עַל־כִּסֵּא כְבוֹדוֹ. תִּפְאֶֽרֶת עָטָה לְיוֹם הַמְּנוּחָה עֹנֶג קָרָא לְיוֹם הַשַּׁבָּת: זֶה שֶֽׁבַח שֶׁלַּיּוֹם הַשְּׁבִיעִי שֶׁבּוֹ שָׁבַת אֵל מִכָּל־מְלַאכְתּוֹ: וְיוֹם הַשְּׁבִיעִי מְשַׁבֵּחַ וְאוֹמֵר ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_1",
            "source": "urn:x-opensiddur:text:bible:psalms/92/1",
            "reference_unit": "verse",
            "end_reference": true,
            "source_type": "quotation"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "טוֹב לְהוֹדוֹת לַייָ: ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2",
            "source": "urn:x-opensiddur:text:bible:psalms/92/2/a",
            "reference_unit": "prayer-part",
            "end_reference": true,
            "source_type": "quotation",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/92/2",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/chapter",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/verse/2",
            "source_reference_part": {
              "unit": "half-verse",
              "n": "a",
              "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/verse/2/a"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "לְפִיכָךְ יְפָאֲרוּ וִיבָרְכוּ לָאֵל כָּל־יְצוּרָיו. שֶֽׁבַח יְקָר וּגְדֻלָּה יִתְּנוּ לָאֵל מֶלֶךְ יוֹצֵר כֹּל הַמַּנְחִיל מְנוּחָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ בְּיוֹם שַׁבַּת קֹדֶשׁ: שִׁמְךָ יְיָ אֱלֹהֵֽינוּ יִתְקַדַּשׁ. וְזִכְרְךָ מַלְכֵּֽנוּ יִתְפָּאַר. בַּשָּׁמַיִם מִמַּעַל וְעַל־הָאָֽרֶץ מִתָּחַת: תִּתְבָּרַךְ מוֹשִׁיעֵֽנוּ עַל־שֶֽׁבַח מַעֲשֵׂה יָדֶֽיךָ. וְעַל־מְאוֹרֵי־אוֹר שֶֽׁעָשִׂיתָ יְפָאֲרֽוּךָ סֶּֽלָה:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "To the God who rested from all His works on the seventh day, He rose and was seated on the throne of His glory, He draped Himself in splendour for the day of rest, a delight did He call the Sabbath day. This is the praise of the seventh day that on it God rested from all His work. And the seventh day praises and says: ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "a psalm of the Sabbath day, ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_1",
            "source": "urn:x-opensiddur:text:bible:psalms/92/1",
            "reference_unit": "verse",
            "end_reference": true,
            "source_type": "quotation"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "it is good to thank the Lord. ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2",
            "source": "urn:x-opensiddur:text:bible:psalms/92/2/a",
            "reference_unit": "prayer-part",
            "end_reference": true,
            "source_type": "quotation",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/92/2",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/chapter",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/verse/2",
            "source_reference_part": {
              "unit": "half-verse",
              "n": "a",
              "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/verse/2/a"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "Therefore do all His creatures glorify and bless God, praise, honour and grandeur do they offer to God, the King, the Creator of all, who has bestowed rest as an inheritance upon His people Israel in His holiness on the Holy Sabbath day. Thy Name. O Lord our God, be sanctified and Thy memory, O our King, be glorified in heaven above and on the earth below. Blessed art Thou, our Helper, for the glory of Thy handiwork and for the radiant lights that Thou hast made, they shall praise Thee, Selah.",
                "page_start": false
              }
            ]
          }
        ]
      },
      "conditions": [
        {
          "type": "opensiddur:holiday-aggregate",
          "features": {
            "shabbat": true
          }
        }
      ]
    }
  ],
  "instructions": {
    "shacharit_shema_alone": {
      "scan": "s110",
      "text": "יחיד אומר אל מלך נאמן.",
      "language": "he",
      "witnesses": [
        "he"
      ],
      "page_start": false
    },
    "shacharit_shema_emet_join": {
      "scan": "s112",
      "text": "יש לצרף אלהיכם לאמת, אכן יתן רוח מעט שלא יבולע הא׳.",
      "language": "he",
      "witnesses": [
        "he"
      ],
      "page_start": false
    }
  }
}
