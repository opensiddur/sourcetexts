          "fragments": [
            {
              "scan": "s155",
              "printed_page": "66",
              "text": "שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה חֵן וָחֶסֶד וְרַחֲמִים עָלֵינוּ וְעַל כָּל־יִשְׂרָאֵל עַמֶּךָ בָּרְכֵנוּ אָבִינוּ כֻּלָּנוּ כְאֶחָד בְּאוֹר פָּנֶיךָ כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְיָ אֱלֹהֵינוּ תּוֹרַת חַיִּים וְאַהֲבַת חֶסֶד וּצְדָקָה וּבְרָכָה וְרַחֲמִים וְחַיִּים וְשָׁלוֹם. וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת־עַמְּךָ יִשְׂרָאֵל בְּכָל־עֵת וּבְכָל־שָׁעָה בִּשְׁלוֹמֶךָ.",
              "page_start": true
            }
          ],
          "end_reference": true,
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shalom/sim_shalom",
          "source": "urn:x-opensiddur:text:prayer:amidah/shalom/sim_shalom"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s155",
              "printed_page": "66",
              "text": "בְּסֵפֶר חַיִּים בְּרָכָה וְשָׁלוֹם וּפַרְנָסָה טוֹבָה נִזָּכֵר וְנִכָּתֵב לְפָנֶיךָ אֲנַחְנוּ וְכָל עַמְּךָ בֵּית יִשְׂרָאֵל לְחַיִּים טוֹבִים וּלְשָׁלוֹם. בָּרוּךְ אַתָּה יְיָ עוֹשֵׂה הַשָּׁלוֹם:",
              "page_start": false
            }
          ],
