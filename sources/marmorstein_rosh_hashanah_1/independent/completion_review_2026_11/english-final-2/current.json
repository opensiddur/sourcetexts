  {
    "stem": "torah_uvenuchoh",
    "urn": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvenuchoh",
    "title": {
      "he": "ובנחה יאמר",
      "en": "When it rested"
    },
    "languages": {
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "When it rested He said: ‘Return, O Lord, to the myriads of thousands of Israel’.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:numbers/10/36",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10/36"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "Arise, O Lord, to Thy resting-place, Thou and the Ark of Thy strength.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/132/8",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/8"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "Thy priests are clothed in righteousness and Thy pious ones exult.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/132/9",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/9"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "For the sake of David, Thy servant, do not turn back the face of Thine anointed.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/132/10",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/10"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "For a fine portion have I given you, do not forsake my Torah.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:proverbs/4/2",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4/2"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "It is a tree of life for those who grasp it and whoever supports it is made happy.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:proverbs/3/18",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/18"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "Its ways are delightful ways and all its paths are peace.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:proverbs/3/17",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/17"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s197",
              "printed_page": "88",
              "text": "Restore us, O Lord, to Thee, that we may return, renew our days as of old.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:lamentations/5/21",
          "reference_unit": "verse",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5",
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5/21",
          "end_reference": true
        }
      ]
    },
    "instructions": [
      {
        "text": "When the scroll of the Torah is returned to the Holy Ark:",
        "language": "en",
        "witnesses": [
