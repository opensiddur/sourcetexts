        }
      ]
    },
    {
      "stem": "shofar_yehi_ratzon",
      "urn": "urn:x-opensiddur:text:prayer:yehi_ratzon_elohei_hamishpat",
      "title": {
        "he": "יהי רצון אלהי המשפט",
        "en": "Prayer before the Shofar"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "יְהִי רָצוֹן לְפָנֶיךָ יְיָ אֱלֹהַי אֱלֹהֵי הַמִּשְׁפָּט שֶׁתְּהֵי עַתָּה עֵת רָצוֹן לְפָנֶיךָ וְתִקְרַע בְּרַחֲמֶיךָ הָרַבִּים וַחֲסָדֶיךָ הַגְּדוֹלִים אֵת כָּל הַמַּסָכִים אֲשֶׁר הֵם מַבְדִּילִים בֵּינֶךָ וּבֵין עַמְּךָ יִשְׂרָאֵל הַיּוֹם הַזֶּה, וְהַעֲבֵר מִלְּפָנֶיךָ כָּל הַמַּשְׂטִינִים וְהַמְקַטְרְגִים עַל עַמְּךָ יִשְׂרָאֵל, סְתוֹם פֶּה שָׂטָן וְאַל יַשְׂטִין עָלֵינוּ כִּי אֵלֶיךָ תְּלוּיוֹת עֵינֵינוּ, אֲרוֹמִמְךָ אֱלֹהַי הַמֶּלֶךְ אֱלֹהֵי הַמִּשְׁפָּט, שֹׁמֵעַ קוֹל תְּפִלּוֹת וּתְרוּעוֹת עַמְּךָ יִשְׂרָאֵל הַיּוֹם בְּרַחֲמִים, אָמֵן:",
                "page_start": true
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_elohei_hamishpat/text"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "May it by Thy will, O Lord my God, God of judgment, that this may be a time of favour before Thee. Tear down in Thy many mercies and great kindnesses all partitions that separate Thee from Thy people Israel on this day. Remove from before Thee all opponents and accusers of Thy people Israel. Close Satan’s mouth that he may not oppose us, for towards Thee are our eyes suspended. I shall exalt Thee, my God, O King, God of judgment, who listens this day to the sound of prayers and Teruoth of Thy people Israel in compassion. Amen.",
                "page_start": true
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_elohei_hamishpat/text"
          }
        ]
      },
      "instructions": [
        {
          "text": "במחזורים נדפסת תחנה אחת מלאה שמות קדושות עומדות על סודות נשגבות ואסור לאמרה אלא מי שבא אל היכל הקדש פנימה, ולא כל הרוצה ליטול את השם יבוא ויטול, ולכן השמטתיה.",
          "language": "he",
          "witnesses": [
            "he"
          ]
        }
      ],
      "opening_page": {
        "he": true,
        "en": true
      }
    },
    {
