                "printed_page": "83",
                "text": "יוֹם תְּרוּעָה יִהְיֶה לָכֶם:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:numbers/29/1/b",
            "source_reference": "urn:x-opensiddur:text:bible:numbers/29/1",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:harei_ani_mukhan_litqoa/quotations/yom_teruah",
