    {
      "stem": "shofar_blessing",
      "urn": "urn:x-opensiddur:text:prayer:lishmoa_qol_shofar",
      "title": {
        "he": "לשמוע קול שופר",
        "en": "Blessing for the Shofar"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לִשְׁמוֹעַ קוֹל שׁוֹפָר:",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:lishmoa_qol_shofar/text"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "Blessed art Thou, O Lord our God, King of the World who has sanctified us with His commandments and commanded us to hear the sound of the Shofar.",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:lishmoa_qol_shofar/text"
          }
        ]
      },
      "instructions": [
        {
          "text": "ומתחיל בנגון ובקול רם.",
          "language": "he",
          "witnesses": [
            "he"
          ]
        }
      ]
    },
    {
      "stem": "shofar_yehi_ratzon_qashraq",
      "urn": "urn:x-opensiddur:text:prayer:shofar_yehi_ratzon_qashraq",
      "title": {
        "he": "יהי רצון שתקיעת קשר״ק",
        "en": "Quiet prayer of the Shofar blower"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s189",
                "printed_page": "84",
                "text": "יְהִי רָצוֹן לְפָנֶיךָ יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי שֶׁתְּקִיעַת קשר״ק שֶׁאֲנַחְנוּ תּוֹקְעִים הַיּוֹם תַּעֲשֶׂה מִמֶּנָּה עֲטָרָה עַל יַד הַמְּמֻנֶּה שרשי״ה לִהְיוֹת עוֹלָה וְלֵישֵׁב בְּרֹאשְׁךָ אֱלֹהַי, וַעֲשֵׂה עִמָּנוּ אוֹת לְטוֹבָה וְהִמָּלֵא עָלֵינוּ רַחֲמִים, בָּרוּךְ אַתָּה בַּעַל הָרַחֲמִים:",
                "page_start": true
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:shofar_yehi_ratzon_qashraq/text"
          }
        ]
      },
      "instructions": [
