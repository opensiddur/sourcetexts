    {
      "stem": "shofar_psalm_47",
      "urn": "urn:x-opensiddur:text:bible:psalms/47",
      "title": {
        "he": "למנצח לבני קרח",
        "en": "Psalm 47"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/1",
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "לַמְנַצֵּחַ לִבְנֵי־קֹרַח מִזְמוֹר:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/2",
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "כָּל־הָעַמִּים תִּקְעוּ־כָף הָרִיעוּ לֵאלֹהִים בְּקוֹל רִנָּה:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/3",
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "כִּי יְיָ עֶלְיוֹן נוֹרָא מֶלֶךְ גָּדוֹל עַל־כָּל־הָאָרֶץ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/4",
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "יַדְבֵּר עַמִּים תַּחְתֵּינוּ וּלְאֻמִּים תַּחַת רַגְלֵינוּ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/5",
            "fragments": [
              {
                "scan": "s186",
                "printed_page": "82",
                "text": "יִבְחַר־לָנוּ אֶת־נַחֲלָתֵנוּ אֶת גְּאוֹן יַעֲקֹב",
                "page_start": false
              },
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "אֲשֶׁר־אָהֵב סֶלָה:",
                "page_start": true
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/6",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "עָלָה אֱלֹהִים בִּתְרוּעָה יְיָ בְּקוֹל שׁוֹפָר:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/7",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "זַמְּרוּ אֱלֹהִים זַמֵּרוּ זַמְּרוּ לְמַלְכֵּנוּ זַמֵּרוּ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/8",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "כִּי מֶלֶךְ כָּל־הָאָרֶץ אֱלֹהִים זַמְּרוּ מַשְׂכִּיל:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/9",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "מָלַךְ אֱלֹהִים עַל־גּוֹיִם אֱלֹהִים יָשַׁב עַל־כִּסֵּא קָדְשׁוֹ:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/10",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "נְדִיבֵי עַמִּים נֶאֱסָפוּ עַם אֱלֹהֵי אַבְרָהָם כִּי לֵאלֹהִים מָגִנֵּי־אֶרֶץ מְאֹד נַעֲלָה:",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/1",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "To the Master of the Choir: A psalm from the Sons of Korah.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/2",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "All the peoples clap hands, they call unto God with the sound of rejoicing",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/3",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "for the Lord is supreme, awe-inspiring, a great King over all the earth.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/4",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "He subdues peoples beneath us and nations under our feet.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/5",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "He will select our inheritance for us, the pride of Jacob whom He has loved, Selah.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/6",
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "God arises amidst blasts, the Lord at the sound of the",
                "page_start": false
              },
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "Shofar.",
                "page_start": true
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/7",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "Sing praise to God, sing to Him, sing to our King, sing praise to Him.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/8",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "For the King of all the earth is God, sing with intelligent understanding.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/9",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "God reigned over peoples, God is seated on His holy throne.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:psalms/47/10",
            "fragments": [
              {
                "scan": "s188",
                "printed_page": "83",
                "text": "The nobles of the peoples are assembled, the people of the God of Abraham; for the shields of the earth are of God, most exalted is He.",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ]
      },
      "complete_chapters": [
