{
  "english_witnesses": [
    {
      "stem": "torah_shelosh_esreh_middot",
      "urn": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening",
      "title": {
        "he": "שלש עשרה מדות",
        "en": "Thirteen Attributes"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "The Lord, the Lord is a merciful and gracious God, slow to anger and great in kindness and truth;"
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/text",
            "source": "urn:x-opensiddur:text:bible:exodus/34/6/adonai_adonai",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/34/6",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6",
            "source_reference_part": {
              "unit": "verse-part",
              "n": "adonai_adonai",
              "corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6/adonai_adonai"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "He preserves kindness to the thousandth generation, forgives guilt, transgression and sin, "
              }
            ],
            "source": "urn:x-opensiddur:text:bible:exodus/34/7/notzer_chesed",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/34/7",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7",
            "source_reference_part": {
              "unit": "verse-part",
              "n": "notzer_chesed",
              "corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7/notzer_chesed"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "and purifies."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:exodus/34/7/venakeh",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/34/7",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7",
            "source_reference_part": {
              "unit": "verse-part",
              "n": "venakeh",
              "corresp": "urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7/venakeh"
            }
          }
        ]
      },
      "instructions": [
        {
          "text": "תפלה משערי ציון לאמר בשעת הוצאת ס״ת.",
          "language": "he",
          "witnesses": [
            "he"
          ]
        }
      ]
    },
    {
      "stem": "torah_ribbono_malle_mishalot",
      "urn": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot",
      "title": {
        "he": "רבון העולם מלא משאלותינו",
        "en": "Master of the world, fulfil our wishes"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "Master of the world, fulfil our wishes for the good, grant our will and give us our wish; forgive all our sins and all the sins of our household through forgiveness in grace and forgiveness in mercy and purify us from our transgressions, sins and iniquities; remember us benevolently before Thee and consider us with salvation and compassion; remember us for a long and good life, for peace, livelihood and sustenance; give us bread to eat, clothes to wear, wealth and honour, long life to ponder on Thy Torah and fulfil its commandments and sense and intelligence, to grasp and understand the depths of its mysteries. Send healing for all our sufferings, bless all the work of our hands, decree for us good decrees, help and comfort; annul all harsh decrees from upon us, incline the heart of the kingdom, its advisers and princes for our good, Amen. Thus may it be Thy will."
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/opening"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "May the words of my mouth and the meditation of my heart find favour before Thee, Lord, my rock and my redeemer."
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/yehi",
            "source": "urn:x-opensiddur:text:bible:psalms/19/15",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/15",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/yihyu",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/yihyu/15",
            "end_reference": true
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s163",
                "printed_page": "70",
                "text": "My prayer goes out to Thee, O Lord, at a time of favour, O God, in Thine abundant mercy, answer me with the truth of Thy salvation."
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/vaani",
            "source": "urn:x-opensiddur:text:bible:psalms/69/14",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/69/14",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/vaani",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/vaani/14",
            "end_reference": true
          }
        ]
      }
    },
    {
      "stem": "torah_berikh_shemeh",
      "urn": "urn:x-opensiddur:text:prayer:berikh_shemeh",
      "title": {
        "he": "בְּרִיךְ שְׁמֵהּ",
        "en": "Berikh Shemeh"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Blessed be the Name of the Master of the world, blessed by Thy crown and Thy place. May Thy favour rest upon Thy people Israel in eternity. Show the salvation of Thy right hand to Thy people in Thy Sanctuary; grant us the goodness of Thy light and accept our prayer with compassion; may it be Thy will to grant us a long and happy life"
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:berikh_shemeh/berikh"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": " and may I be remembered among the righteous so that Thou wilt have compassion on me and guard me and all that belongs to me and to Thy people Israel. Thou dost nourish all and sustain all; it is Thou who dost rule over all, Thou rulest over kings and the kingdom is Thine. I serve the Holy One, blessed be He, bow down before Him and His holy Torah at all times. I do not trust in men, I do not rely on angels, only on the God of heaven. He is the true God and His Torah is truth and His prophets are truth and He does goodness and truth in abundance. On Him do I rely and to His holy, honoured Name do I utter praise. Let it be Thy will to open my heart to the Torah, to grant the requests of my heart and those of the whole people of Israel for the good, for life and for peace."
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:berikh_shemeh/velehevei"
          }
        ]
      }
    },
    {
      "stem": "torah_shema",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema",
      "title": {
        "he": "שמע ישראל",
        "en": "Hear, O Israel"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Hear, O Israel, the Lord is our God, the Lord is One."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/text",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4",
            "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/6/4",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/shema/quotations/shema/4"
          }
        ]
      }
    },
    {
      "stem": "torah_echad_eloheinu",
      "urn": "urn:x-opensiddur:text:prayer:echad_eloheinu",
      "title": {
        "he": "אחד אלהינו",
        "en": "Our God is One"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Our God is One, our Lord is great, holy (and awe-inspiring) is His Name!"
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:echad_eloheinu/text"
          }
        ]
      }
    },
    {
      "stem": "torah_gaddelu",
      "urn": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu",
      "title": {
        "he": "גדלו",
        "en": "Magnify the Lord"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Magnify the Lord with me, and let us exalt His Name together."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/gaddelu/text",
            "source": "urn:x-opensiddur:text:bible:psalms/34/4",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/34/4",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu/4"
          }
        ]
      }
    },
    {
      "stem": "torah_lekha_adonai",
      "urn": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai",
      "title": {
        "he": "לך יי הגדלה",
        "en": "Thine, O Lord, is greatness"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Thine, O Lord, is greatness, might, glory, triumph and majesty. For all in heaven and on earth is Thine, O Lord, dominion and supremacy above all."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/lekha",
            "source": "urn:x-opensiddur:text:bible:chronicles_1/29/11",
            "source_reference": "urn:x-opensiddur:text:bible:chronicles_1/29/11",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/lekha",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/lekha/11",
            "end_reference": true
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": " "
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_hadom"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Exalt the Lord, our God, and bow down at His footstool, Holy is He."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/99/5",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/99/5",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_hadom",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_hadom/5",
            "end_reference": true
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": " "
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/romemu_har"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Exalt the Lord your God, and bow down before His holy mountain, for holy is the Lord our God."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/99/9",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/99/9",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_har",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/lekha_adonai/quotations/romemu_har/9",
            "end_reference": true
          }
        ]
      }
    },
    {
      "stem": "torah_al_hakol",
      "urn": "urn:x-opensiddur:text:prayer:al_hakol",
      "title": {
        "he": "על הכל",
        "en": "Above all things"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s165",
                "printed_page": "71",
                "text": "Above all things let there be magnified, sanctified, praised, glorified, exalted and elevated the Name of the King of all kings, the Holy One, blessed be He, in the worlds that He created in this and the future world, according to His will and the will of those who fear Him and the will of the whole house of Israel. Rock of eternity, Lord of all creatures, God"
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:al_hakol/opening"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "of all souls, who dwells in the infinite heights, and resides in the primaeval heavens, His holiness is above the Hayoth, His holiness is above the glorious throne. And thus may Thy Name be sanctified among us, O Lord our God, before the eyes of all the living; and let us sing before Him a new song, as it is written: ‘"
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "Sing to God, sing praise of His Name. Exalt Him who rides upon the clouds, Yah is His Name, and rejoice before Him."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/68/5",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/68/5",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru/5"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": " We shall see Him eye to eye when He returns to His dwelling as it is written: "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "eye to eye shall they behold when the Lord returns to Zion."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:isaiah/52/8/b",
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/52/8",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8",
            "source_reference_part": {
              "unit": "half-verse",
              "n": "b",
              "corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8/b"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": " And it was said: ‘"
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "And the glory of the Lord shall be revealed and all flesh together shall see, for the mouth of the Lord has spoken"
              }
            ],
            "source": "urn:x-opensiddur:text:bible:isaiah/40/5",
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/40/5",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah/5"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "’."
              }
            ],
            "end_reference": true
          }
        ]
      }
    }
  ],
