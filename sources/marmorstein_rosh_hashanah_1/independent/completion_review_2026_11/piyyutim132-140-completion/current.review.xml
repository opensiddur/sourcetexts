<actual_current_encoding>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/1"/>אַתָּה הוּא אֱלֹהֵינוּ. בַּשָּׁמַיִם וּבָאָרֶץ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/2"/>גִּבּוֹר וְנַעֲרָץ. דָּגוּל מֵרְבָבָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/3"/>הוּא שָׂח וַיֶּהִי. וְצִוָּה וְנִבְרָאוּ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/4"/>זִכְרוֹ לָנֶצַח. חַי עוֹלָמִים: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/5"/>טְהוֹר עֵינַיִם. יוֹשֵׁב סֵתֶר: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/6"/>כִּתְרוֹ יְשׁוּעָה. לְבוּשׁוֹ צְדָקָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/7"/>מַעֲטֵהוּ קִנְאָה. נֶאְפָּד נְקָמָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/8"/>סִתְרוֹ יֹשֶׁר. עֲצָתוֹ אֱמוּנָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/9"/>פְּעֻלָּתוֹ אֱמֶת. צַדִּיק וְיָשָׁר: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/10"/>קָרוֹב לְקוֹרְאָיו בֶּאֱמֶת. רָם וּמִתְנַשֵּׂא: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/11"/>שׁוֹכֵן שְׁחָקִים. תּוֹלֶה אֶרֶץ עַל בְּלִימָה: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/12"/>חַי וְקַיָּם נוֹרָא בַמָּרוֹם וְקָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/1"/>Thou art our God in heaven and on earth. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/2"/>Mighty and awe-inspiring distinguished among myriads. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/3"/>He spoke and it came to pass, He commanded, then were they created. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/4"/>His memory is forever, He lives in all eternity. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/5"/>Pure is His gaze, He is enthroned in mystery. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/6"/>His crown is salvation, His robe is righteousness. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/7"/>His cloak is zeal, He is girded with retribution. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/8"/>His mystery is equity, His counsel faith. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/9"/>His work is truth, He is just and upright. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/10"/>He is close to those who call Him in truth, lofty and exalted. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/11"/>He resides in the clouds and suspends the earth in space. </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:attah_hu_eloheinu/12"/>Living, enduring, awe-inspiring, lofty and holy. <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tair_vetaria" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/tair_vetaria/part_1"/>תָּעִיר וְתָרִיעַ. לְהַכְרִית כָּל־מֵרֵעַ. וְתִקָּדֵשׁ בְּיוֹדְעֵי לְהָרִיעַ. קָדוֹשׁ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:tair_vetaria" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg" n="52"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/tair_vetaria/part_1"/>Thou dost rise and let the trumpet sound to destroy every evil doer, and Thou art sanctified by those who know how to sound the Teruah, Holy One. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adderet_mamlakhah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:note type="description" xml:lang="he">חתום בראשי חרוזים אלעזר בירבי קליר.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> אַדֶּרֶת מַמְלָכָה. עַד מָה הֻשְׁלָכָה. וְעוֹד לֹא מָלְכָה: לְבֵל הִמְלִיכָה. וְאַחֲרָיו הָלְכָה. שֶׁלֹּא כַהֲלָכָה: עָלֶיהָ הַמְלָכָה. גְּבֶרֶת מַמְלָכָה. עַד תּוֹפִיעַ מְלוּכָה: וַכְלִילֵי <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n133.jpg" n="53"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_2"/>חָרְכָה. מִתְמִימַי פָּרְכָה. וְנִתַּן לָהּ אַרְכָּה: רָחֲבָה וְאָרְכָה. וְקַשְׁתָּהּ דָּרְכָה. וְעֹל הֶאֱרִיכָה: בְּעַתַּתָּהּ בְּרַכָּה. וְהִנֵּה דְרוּכָה. וְעַד עַתָּה מוֹלְכָה: יְסוֹדוֹת עִרְמָה. עֵרָה וְהֶחֱרִימָה. וְעַד יְסוֹד עֵירֹמָה: רֹאשׁ הֵרִימָה. וְסוֹד הֶעֱרִימָה. וַתְּהִי רָמָה: בְּעָרְמָה מַעֲרִימָה. וְעַד שַׁחַק רָמָה. וְתָאֱפוֹד מְלוּכָה: יְרִיעוֹתַי גָּרְדָה. אָהֳלֵי שָׁדְדָה. וְחָרְשָׁה וְשִׂדְּדָה: קַנְיָנוּת רָפְדָה. 
וּמַלְכוּת אָפְדָה. וְאֶת הִקְפִּידָה: יוֹזְמֵי וּפִרְדָּה. עֲבוֹד <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_3"/>לְזוּ חָרְדָה. וְחִלְּלָה מְלוּכָה: לְהָצוֹת בְּנֵי מֶלֶךְ. וּפָצָה לְעֵין מֶלֶךְ. מִי לִי בָרָק מֶלֶךְ: יָהֲרָה בְּכֵס מֶלֶךְ. זוּלָתִי אֵין מֶלֶךְ. אֲנִי וְאַפְסִי מֶלֶךְ: רָם עַל כָּל־מֶלֶךְ. תַּעֲבִירֶנָּה מִמֶּלֶךְ. וּלְךָ תָּשִׁיב מְלוּכָה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:adderet_mamlakhah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg" n="52"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_1"/>The glorious realm, how has it been cast down and not yet been restored to rule. It swore allegiance to Bel, it followed him against the law. Thus there gained dominion over it a mighty alien realm, until God’s realm will once again appear. It has burned my sanctuary, it has crushed my upright <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n134.jpg" n="53"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_2"/>men and has achieved length of rule. It has expanded greatly, stretched the bow and extended far its yoke. It has frightened the tender people (Israel) and trampled it down, and rules to this day. It has loosened and destroyed the foundation stones of the Temple and laid them bare down to the ground. It has lifted up its head, devised a secret plan and stands there powerfully. It is ablaze with guile, raises itself up to heaven and girds itself in majesty. My tapestries has it torn, destroyed my tabernacles, ploughed and 
harrowed its site. It has acquired dominion, wrapped itself in might and offended this people (Israel). It initiated rebellion, served idols zealously <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/adderet_mamlakhah/part_3"/>and desecrated the realm of God. It oppressed the King’s children (Israel) and said in the sight of the King: “Who is in heaven my king?”. There is boasting from the royal throne: “There is no king besides me, I alone am king”. O Thou who art exalted above all kings, remove from it the rank of king, so that the kingdom may return to Thee. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_memallet" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_memallet/part_1"/>מֶלֶךְ מְמַלֵּט מֵרָעָה. לְיוֹדְעֵי תְרוּעָה. הָאֵל קָדוֹשׁ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_memallet" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_memallet/part_1"/>O King, Thou savest from misfortune those who understand Teruah, Holy God. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_zokher_achuz_qeren" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_zokher_achuz_qeren/part_1"/>מֶלֶךְ זוֹכֵר אֲחוּז קֶרֶן. לְתוֹקְעֵי לְךָ הַיּוֹם בְּקֶרֶן. נוֹרָא וְקָדוֹשׁ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_zokher_achuz_qeren" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg" n="54"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_zokher_achuz_qeren/part_1"/>O King, Thou dost remember him (Isaac) who was caught by the horn (the ram) on behalf of those who blow the horn before Thee today, O awe-inspiring and Holy One! <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:aafir_nezer" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n137.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ב.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n137.jpg" n="55"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/aafir_nezer/part_1"/> <tei:note type="description" xml:lang="he">החזן בנגון.</tei:note>אַאֽפִּיר נֶֽזֶר אָיוֹם. בְּשִׁלּוּשׁ קְדֻשַּׁת הַיוֹם: גִּבּוֹרֵי כֹחַ גְּדֻלָּה. דִּדּוּהוּ בְבֵית דִּיגְלָה: חוּג הוֹגֶה הֶמְלָה. וּתְקוֹעֵהוּ בְּהִלּוּל וּמִלָּה: זוֹכֵר לָעַד זָכִיּוֹת. חֲדִישׁוּהוּ זֶמֶר חַיּוֹת: טוֹב עוֹמֵס טָרַח. יְיַחֲדוּהוּ בְּחִדּוּשׁ יֶרַח: כּוֹבֵשׁ כָּל־כְּעָסִים. לְבַל אַף לְהָשִׂים: מְשָׁרְתָיו בְּחִיל מוֹרָא. נִכְחָם הַלְלוּ נוֹרָא: שַׂרְפֵי סְבִיב סַעֲרָה. עֱנוּ לְמַעֲבִיר <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n139.jpg" n="56"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/aafir_nezer/part_2"/>עֶבְרָה: פְּלִיאָים פִּצְחוּ פֶה. צִלְצְלוּ הַכֹּל צוֹפֶה: קְהִלּוֹת עַם קְדוֹשִׁים. רוֹמְמוּהוּ רְבָבוֹת רוֹעֲשִׁים: שְׁמֹעַ קוֹל שׁוֹפָר. תַּאֲזִין וְאַשְׁמָה תוּפָר: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:aafir_nezer" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n138.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n138.jpg" n="55"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/aafir_nezer/part_1"/>I adorn the awe-inspiring with a crown through the threefold sanctification of the day. The strong in might and greatness rejoice before Him in the house of assembly. They who praise in tumultuous throngs, laud Him with glorifying word. To Him who remembers piety for ever, do the Hayoth sing a new song. Praise Him alone — benevolent is He and forgives sins — on the day of the new moon. He suppresses wrath entirely and does not allow anger. O you (the angels) who serve Him in trembling and fear, praise Him who is awe-inspiring in the presence of those (Israel). Angels of fire encircled by the whirlwind, chant in honour of Him who <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n140.jpg" n="56"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/aafir_nezer/part_2"/>removes wrath. Angels of mystery, open your mouths to praise Him who sees all. Congregations of the holy people, praise Him, tumultuous myriads. Hearken to the loud blast of the Shofar that guilt may be
 forgiven. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:teshalesh_shofarot" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n139.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n139.jpg" n="56"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/teshalesh_shofarot/part_1"/>תְּשַׁלֵּשׁ שׁוֹפָרוֹת בְּהַר הַקֹּדֶשׁ. וַאֲשַׁלֵּשׁ קְדֻשָּׁה בַּקֹּדֶשׁ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:teshalesh_shofarot" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n140.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n140.jpg" n="56"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/teshalesh_shofarot/part_1"/>Three times wilt Thou sound the Shofar blast on the holy mountain; three times will I pronounce the sanctification in the Sanctuary. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="#yarum_variant">
      <tei:p>נ״א מלכות</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shemo_mefoarim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shemo"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שְׁמוֹ מְפָאֲרִים עֲדַת חֶבְלוֹ. וְנַעֲרִיץ בְּאֶרְאֶלֵּי קֹדֶשׁ הִלּוּלוֹ. וּבְהֵיכָלוֹ כָּבוֹד אָמַר כּוּלּוֹ. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shomerei"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שׁוֹמְרֵי מִצְווֹתָיו עוֹד יְשׁוּבוּן לְבִצָּרוֹן. נִדְבָּרִים יְרֵאָיו בְּטֹהַר וְיִתְרוֹן. וַיַּקְשֵׁב <j:divineName>יְיָ</j:divineName> וַיִּשְׁמַע וַיִּכָּתֵב בְּסֵפֶר זִכָּרוֹן. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shapru"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שַׁפְּרוּ מַעֲשִׂים וּבְרִית לֹא תוּפָר. נַאֲקַתְכֶם יַאֲזִין שְׁחָקִים שִׁפַּר. וְתִיטַב לַ<j:divineName>יְיָ</j:divineName> מִשּׁוֹר פָּר. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n133.jpg" n="53"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shivtei"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שִׁבְטֵי מְקוֹרָאֶךָ עֲלֵה וּמְשׁוֹל. נְטִישׁוֹת צָרִים כְּהִתְוִיז לְנַשֵּׁל. כִּי לַ<j:divineName>יְיָ</j:divineName> הַמְּלוּכָה וּמוֹשֵׁל. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shevutenu"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> שְׁבוּתֵנוּ מִמֶּרְחָק עֲלוֹת לְהַר קָדְשׁוֹ. וּנְפָאֲרֶנּוּ תָּמִיד בִּדְבִיר מִקְדָּשׁוֹ. כִּי זָכַר אֶת דְּבַר קָדְשׁוֹ. קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei"/> <j:conditional type="marked" xml:id="shemo_mefoarim_segment_6"><tei:note type="instruction" xml:lang="he">בק״ק מיץ אין אומרים</tei:note><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>כָּל יוֹשְׁבֵי תֵבֵל וְשׁוֹכְנֵי אָרֶץ. יֹאמְרוּ תָמִיד הִגְדִּיל <j:divineName>יְיָ</j:divineName> לַעֲשׂוֹת בָּאָרֶץ. וְהָיָה <j:divineName>יְיָ</j:divineName> לְמֶלֶךְ עַל כָּל הָאָרֶץ. קָדוֹשׁ: <j:endConditional target="#shemo_mefoarim_segment_6"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/adar"/>אֲדָר וָהוֹד אֶתֵּן בְּצִבְיוֹן. שׁוּעַ אֶעֶרְכָה בְּנִיב וְהִגָּיוֹן.  <tei:milestone unit="chapter" n="57" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/57/3">אֶקְרָא לֵאלֹהִים עֶלְיוֹן:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  בְּיוֹם הַנִּבְחָר מִשְּׁמֵי עָרִיץ. מֵישָׁרִים לִשְׁפֹּט קְדֻשָּׁתוֹ לְהַעֲרִיץ.  <tei:milestone unit="chapter" n="97" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter"/><tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter/1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/97/1"><j:divineName>יְיָ</j:divineName> מָלָךְ תָּגֵל הָאָרֶץ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  גֵּאוּתוֹ גָּדְלָה עוֹלָם מֵהָכִיל. עֱזוּזוֹ לְסַפֵּר כֹּחַ מִי יָכִיל.  <tei:milestone unit="chapter" n="47" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter/8"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/47/8">מֶלֶךְ עַל כָּל הָאָרֶץ אֱלֹהִים זַמְּרוּ מַשְׂכִּיל:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/adar"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shemo@prayerbook_for_the_new_year-heidenheim-1965-he">שְׁמוֹ מְפָאֲרִים.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/dea"/>דַּע יִשְׁמוּ כָּל בְּרִיוֹתָיו. וְיֵדְעוּ כִּי גָדְלוּ גְּבוּרוֹתָיו.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/4">זֵכֶר עָשָׂה לְנִפְלְאוֹתָיו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  הִצִּיב וְיָדָה אֶבֶן פִּנָּתוֹ. נַחֲלִיאֵל עֲבוּר לְשַׁעֲשֵׁעַ בְּאֻמָּתוֹ.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/5">יִזְכֹּר לְעוֹלָם בְּרִיתוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n135.jpg" n="54"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/varasham"/>וְרָשַׁם בְּחֹק דַּת הֶגְיוֹנִי. בְּכָל שָׁנָה וְשָׁנָה לִפְקוֹד זִכְרוֹנִי. לְזִכָּרוֹן בְּהֵיכַל <j:divineName>יְיָ</j:divineName> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/varasham"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shomerei@prayerbook_for_the_new_year-heidenheim-1965-he">שׁוֹמְרֵי מִצְווֹתָיו.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/zevach"/>זֶבַח קֹדֶשׁ כְּהֻכְשַׁר אָז בְּעֵינָיו. רֶגֶל תְּמוּרָתוֹ אַיִל לְהַקְרִיב לְפָנָיו. אַחַר נֶאֱחַז בַּסְּבַךְ בְּקַרְנָיו: חִנֵּם חֲנִיטָיו לִתְקוֹעַ בְּזֶה חֹדֶשׁ. יוֹם זֶה אִם יִקְרֶה בְּשַׁבַּת קֹדֶשׁ. זִכְרוֹן תְּרוּעָה מִקְרָא קֹדֶשׁ: טִבְעוֹן אִם בְּחֹל יְבֹאָכֶם. צַוּוּ לִתְקוֹעַ בְּכָל גְּבוּלְכֶם. יוֹם תְּרוּעָה יִהְיֶה לָכֶם: <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/zevach"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shapru@prayerbook_for_the_new_year-heidenheim-1965-he">שַׁפְּרוּ.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yarum"/>יָרוּם צוּר יִשְׁעִי פִּי כָל־אֻמִּים. חֲשׂוֹף זְרוֹעֲךָ לְהוֹשִׁיעַ מִמִּתְקוֹמְמִים.  <tei:milestone unit="chapter" n="145" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/145/13">מַלְכוּתְךָ מַלְכוּת כָּל עוֹלָמִים:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  כְּהִגָּלוֹתְךָ לְעֵין כֹּל שְׁכִינָה לְהוֹעֵד. קְהִלּוֹת וְרִבְבוֹת בְּנִימוֹ לְהָעֵד.  <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18"><j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעֹלָם וָעֶד:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  לְךָ יָאֲתָה כָּבוֹד  <tei:anchor xml:id="yarum_variant"/>וְעֹז הַגּוֹיִם. חֶלֶד וְכָל שׁוֹכְנֶיהָ וְכָל הָאִיִּים.  <tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter"/><tei:milestone unit="verse" n="7" 
corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:jeremiah/10/7">מִי לֹא יִרָאֲךָ מֶלֶךְ הַגּוֹיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/><tei:milestone unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/yarum"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shivtei@prayerbook_for_the_new_year-heidenheim-1965-he">שִׁבְטֵי.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n137.jpg" n="55"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/motot"/>מוֹטַת צָרִים שְׁבֹר וְהַכְחִידֵם. וּדְחוּיֶיךָ קַבֵּץ וְחִנָּם תִּפְדֵּם.  <tei:milestone unit="chapter" n="74" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/74/2">זְכוֹר עֲדָתְךָ קָנִיתָ קֶדֶם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  נְדִיבֵי עַמִּים נַחֲמוּ בְּכִפְלַיִם. קָמֵיהֶם עַל פָּנֵימוֹ גַּלֵּה שׁוּלַיִם.  <tei:milestone unit="chapter" n="137" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/137/7">זְכֹר <j:divineName>יְיָ</j:divineName> לִבְנֵי אֱדוֹם אֵת יוֹם יְרוּשָׁלָיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  סְלִיל מְסִלָּתֵנוּ יַשֵּׁר לְצַעַד. וּבֵין יְקִירָה קַרְסֹל לֹא יִמְעַד. כִּנְאֻמַת זָכוֹר אֶזְכְּרֶנּוּ עוֹד: <tei:milestone unit="stanza"/><tei:milestone
 unit="navigation" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_cues/motot"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:poem:shemo_mefoarim/shevutenu@prayerbook_for_the_new_year-heidenheim-1965-he">שְׁבוּתֵנוּ.</tei:ref></tei:note><tei:milestone unit="navigation"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/qiryat"/>קִרְיַת מְשׂוֹשׂ הֵיכָל וְאוּלָם. מִזְבֵּחַ יָשִׁיב וּכְלֵי שָׁרֵת כֻּלָּם. <j:divineName>יְיָ</j:divineName> יִמְלֹךְ לְעוֹלָם: שָׁמַיִם וָאָרֶץ יְרַנְּנוּ לִשְׁמוֹ. יְעָרוֹת יִמְחֲאוּ כַף לְהַנְעִימוֹ.  <tei:milestone unit="chapter" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter/6"/><tei:seg source="urn:x-opensiddur:text:bible:ruth/1/6">כִּי פָקַד <j:divineName>יְיָ</j:divineName> אֶת עַמּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  תֹּקֶף אֶרְאֶלִּים וְכוֹכְבֵי צָפֶר. תְּהִלּוֹת יִתְּנוּ שֶׁבַח לְהַשְׁפִּיר.  <tei:milestone unit="chapter" n="150" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/150/3">הַלְלוּהוּ בְּתֵקַע שׁוֹפָר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_refrains/kol_yoshvei"/> <j:conditional type="marked" xml:id="shemo_mefoarim_segment_37"><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei">כָּל יוֹשְׁבֵי תֵבֵל וְשׁוֹכְנֵי אָרֶץ. יֹאמְרוּ תָמִיד הִגְדִּיל <j:divineName>יְיָ</j:divineName> לַעֲשׂוֹת בָּאָרֶץ. וְהָיָה <j:divineName>יְיָ</j:divineName> לְמֶלֶךְ עַל כָּל הָאָרֶץ. קָדוֹשׁ:</tei:seg> <j:endConditional target="#shemo_mefoarim_segment_37"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yishpot"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> יִשְׁפֹּט תֵּבֵל בְּצֶדֶק וּלְאֻמִּים בְּמֵישָׁרִים. הָאֵל קָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/vehu"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>חו״ק</tei:abbr><tei:expan>חזן וקהל</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="23" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:job/23/13">וְהוּא בְאֶחָד וּמִי יְשִׁיבֶנּוּ. וְנַפְשׁוֹ אִוְּתָה וַיָּעַשׂ.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  נוֹרָא וְקָדוֹשׁ: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:shemo_mefoarim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n132.jpg" n="52"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shemo"/>His Name is praised by the community of His portion, His praise is proclaimed by the holy Erelim and in His sanctuary everything utters glory of the Holy One. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shomerei"/>Those who observe His commandments will yet return to the fortress, those who fear Him, speak to one another in purity and bliss, and the Lord has listened and heard and it is inscribed in the book of remembrance, the Holy One. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shapru"/>Improve your deeds that the covenant may not be broken, He who has adorned the skies, will hear your cry, and it will be more pleasing than the sacrifice of oxen to the Lord the Holy One. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n134.jpg" n="53"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shivtei"/>Let the tribes of those Thou hast called, arise and rule, cut off the branches of enemies and let them fall, for both kingdom and ruler belong to the Lord, the Holy One. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/shevutenu"/>May our exiled ascend from afar His holy mountain that we may praise Him always in His Inner Sanctuary, for He has remembered His holy word, the Holy One. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei"/> <j:conditional xml:id="shemo_mefoarim_segment_6"><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>All inhabitants of the world and dwellers on earth do constantly say: Great things has the Lord performed on earth, and the Lord shall be King over all the earth, the Holy One. <j:endConditional target="#shemo_mefoarim_segment_6"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/adar"/>Glorification and praise willingly do I bestow, I order prayer in speech and thought,  <tei:milestone unit="chapter" n="57" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_1/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/57/3">I call upon the supreme God.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  On the day chosen from the mighty heavens for upright judgment to glorify His holiness,  <tei:milestone unit="chapter" n="97" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter"/><tei:milestone unit="verse" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_2/chapter/1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/97/1">the Lord rules, the earth rejoices.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  The world is too small to contain His loftiness, who is there able to describe His might?  <tei:milestone unit="chapter" n="47" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/adar_3/chapter/8"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/47/8">King of all the earth is God, then sing with understanding.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/dea"/>May all His creatures acquire perception and know how great is His might.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_4/chapter/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/4">A memorial has He established for His wonders.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  He has firmly planted His foundation stone (Torah), the divine gift, so as to rejoice in His people.  <tei:milestone unit="chapter" n="111" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/dea_5/chapter/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/111/5">He remembers His covenant for ever.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n136.jpg" n="54"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/varasham"/>He has inscribed my thoughts through a statute of the faith so as to remember me year by year, for a remembrance in the sanctuary of the Lord. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/zevach"/>When the holy sacrifice (Isaac) once found favour in His eyes, He allowed a ram to be sacrificed in his stead, which was later caught with his horns in the thicket. He taught the descendants of (Isaac) to blow the Shofar on this new moon; but if this day falls on a Sabbath, then the mere mention of Teruah is a sacred proclamation. When it falls on a weekday for you, let it be blown in all your regions, let it be a day of Teruah for you. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yarum"/>Exalted is the rock of my salvation in the mouths of all peoples. Expose Thine arm to help us against adversaries,  <tei:milestone unit="chapter" n="145" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_6/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/145/13">Thy realm is a realm of all eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  When Thou revealest Thyself before all eyes to visit once again Thy dwelling place, congregations in their myriads will proclaim aloud:  <tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter"/><tei:milestone unit="verse" n="18" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_7/chapter/18"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/15/18">The Lord shall reign for ever and ever.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  Becoming to Thee is honour and the acknowledgment of might pronounced by the earth and its inhabitants and all the isles:  <tei:milestone unit="chapter" n="10" 
corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/yarum_8/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:jeremiah/10/7">who does not fear Thee, King of the nations.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n138.jpg" n="55"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/motot"/>Break the yoke of adversaries, destroy them; gather those dispersed by Thee and redeem them without ransom.  <tei:milestone unit="chapter" n="74" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter"/><tei:milestone unit="verse" n="2" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_9/chapter/2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/74/2">Remember Thy congregation which Thou hast once chosen.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  Comfort the noblest of peoples, expose to their faces the shame of those who rise against them;  <tei:milestone unit="chapter" n="137" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/motot_10/chapter/7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/137/7">remember, O Lord, against the sons of Edom the day of Jerusalem.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  Make even our highway, straighten it for our steps that the foot of Thy favourite may not stumble,
 as Thou hast said: I will surely still remember him. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/qiryat"/>The joyful city, sanctum and porch, and the altar may He restore with all the sacred vessels; the Lord will reign for ever. Heaven and earth exult at His Name; forests clap their hands in delight in Him;  <tei:milestone unit="chapter" n="1" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_11/chapter/6"/><tei:seg source="urn:x-opensiddur:text:bible:ruth/1/6">for the Lord has considered His people.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  The mighty Erelim and the bright stars in glory will proclaim His praise.  <tei:milestone unit="chapter" n="150" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/qiryat_12/chapter/3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/150/3">Praise Him with the Shofar blast.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shabbat_refrains/kol_yoshvei"/> <j:conditional type="marked" xml:id="shemo_mefoarim_segment_36"><j:all><tei:fs type="opensiddur:rite"><tei:f name="metz"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:poem:shemo_mefoarim/kol_yoshvei">All the inhabitants of the world and dwellers on earth do constantly say: Great things has the Lord performed on earth, and the Lord shall be King over all the earth, the Holy One.</tei:seg> <j:endConditional target="#shemo_mefoarim_segment_36"/> <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/yishpot"/>He judges the world in justice and nations in righteousness, God is holy. <tei:milestone unit="stanza"/></tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/vehu"/><tei:milestone unit="chapter" n="23" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:poem:shemo_mefoarim/quotations/vehu_13/chapter/13"/><tei:seg source="urn:x-opensiddur:text:bible:job/23/13">He is unique, who can reply to Him? Whatever His soul desires, He accomplishes,</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  Awe-inspiring and Holy! <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
