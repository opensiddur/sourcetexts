        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s131",
                "printed_page": "51",
                "text": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion. And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/ending/text",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot"
