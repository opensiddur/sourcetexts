          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s153",
                "printed_page": "64",
                "text": "אַתָּה בְחַרְתָּנוּ מִכָּל הָעַמִּים. אָהַבְתָּ אוֹתָנוּ וְרָצִיתָ בָּנוּ. וְרוֹמַמְתָּנוּ מִכָּל הַלְּשׁוֹנוֹת. וְקִדַּשְׁתָּנוּ בְּמִצְוֹתֶיךָ. וְקֵרַבְתָּנוּ מַלְכֵּנוּ לַעֲבוֹדָתֶךָ. וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עָלֵינוּ קָרָאתָ:",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushat_hayom/attah_vechartanu",
