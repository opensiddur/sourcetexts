            "paragraph": 1,
            "fragments": [
              {
                "scan": "s154",
                "printed_page": "65",
                "text": "מוֹדִים אֲנַחְנוּ לָךְ שָׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ לְעוֹלָם וָעֶד. צוּר חַיֵּינוּ מָגֵן יִשְׁעֵנוּ אַתָּה הוּא לְדוֹר וָדוֹר. נוֹדֶה לְּךָ וּנְסַפֵּר תְּהִלָּתֶךָ עַל חַיֵּינוּ הַמְּסוּרִים בְּיָדֶךָ וְעַל נִשְׁמוֹתֵינוּ הַפְּקוּדוֹת לָךְ",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/modim/modim",
            "source": "urn:x-opensiddur:text:prayer:amidah/hodaah/modim"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s154",
                "printed_page": "65",
                "text": "וְעַל",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/modim/modim_end",
            "source": "urn:x-opensiddur:text:prayer:amidah/hodaah/modim"
          },
          {
            "paragraph": 1,
            "fragments": [
