  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/naalah_vedin.xml"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="#naalah_variant">
      <tei:p>נ״א אֲרַצֶּֽנוּ</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:naalah_vedin" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/naalah_vedin/part_1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> נַעֲלָה בַדִּין עֲלוֹת בִּתְרוּעָה. גֵּיא עִם דָּרֶיהָ לְרוֹעֲעָה.  <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/naalah_vedin/part_2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>  <j:conditional xml:id="naalah_vedin_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>בַּשּׁוֹפָר <j:endConditional target="#naalah_vedin_segment_2"/><j:conditional type="marked" xml:id="naalah_vedin_segment_3"><tei:note type="instruction" xml:lang="he">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>בְּזִכְרוֹן שׁוֹפָר 
<j:endConditional target="#naalah_vedin_segment_3"/>  <tei:choice><j:option>אֲפַתֶּנּוּ</j:option><j:option>אֲרַצֶּֽנוּ</j:option></tei:choice> <tei:anchor xml:id="naalah_variant"/>  וּבְבֶרֶךְ כְּרִיעָה. בְּמָגִנַּת רֵעִים בְּגַנּוֹ אֶתְרוֹעָֽעָה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/naalah_vedin.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:naalah_vedin" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/naalah_vedin/part_1"/>He rises in judgment, rising together with the loud blast, to shake the earth and its inhabitants.  <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/naalah_vedin/part_2"/>But with  <j:conditional xml:id="naalah_vedin_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>the Shofar <j:endConditional target="#naalah_vedin_segment_2"/><j:conditional type="marked" xml:id="naalah_vedin_segment_3"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>the memory of the Shofar <j:endConditional target="#naalah_vedin_segment_3"/> I appease Him, and with bent knee, in the shelter of friends, will I sound in His garden (the Sanctuary) the shattering tone. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/melekh_bedin.xml"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="#melekh_bedin_variant">
      <tei:p>נ״א אֲרַצֶּֽנוּ</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_bedin" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n127.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n127.jpg" n="50"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> מֶלֶךְ בַדִּין עֲלוֹת בִּתְרוּעָה. גֵּיא עִם דָּרֶיהָ לְרוֹעֲעָה.  <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>  <j:conditional xml:id="melekh_bedin_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>בַּשּׁוֹפָר <j:endConditional target="#melekh_bedin_segment_2"/><j:conditional type="marked" xml:id="melekh_bedin_segment_3"><tei:note type="instruction" xml:lang="he">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>בְּזִכְרוֹן שׁוֹפָר 
<j:endConditional target="#melekh_bedin_segment_3"/>  <tei:choice><j:option>אֲפַתֶּנּוּ</j:option><j:option>אֲרַצֶּֽנוּ</j:option></tei:choice>: <tei:anchor xml:id="melekh_bedin_variant"/>  וּבְבֶרֶךְ כְּרִיעָה. בְּטַלְלֵי תֶֽחִי בְּגַנּוֹ אֶתְרוֹעָֽעָה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/melekh_bedin.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:melekh_bedin" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n128.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n128.jpg" n="50"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_1"/>The King rises in judgment with the loud blast to shake the earth with its inhabitants,  <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/melekh_bedin/part_2"/>but with  <j:conditional xml:id="melekh_bedin_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>the Shofar <j:endConditional target="#melekh_bedin_segment_2"/><j:conditional type="marked" xml:id="melekh_bedin_segment_3"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>the memory of the Shofar <j:endConditional target="#melekh_bedin_segment_3"/> I appease Him, and with bent knee in the dew of revival will I sound in His garden the shattering tone. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_attah_gibbor.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/open" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/open/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor">אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/repetition_attah_gibbor.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/open" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/open/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor">Thou art for ever mighty, O Lord, the reviver of the dead, Thou art great to save.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_mekhalkel.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n125.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim">מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/repetition_mekhalkel.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n126.jpg" n="49"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim">Sustaining life with kindness, reviving the dead with great compassion, supporting the falling, healing the sick and releasing the captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/morning_full_kaddish_preface.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">וְעַתָּה יִגְדַּל־נָא כֹּחַ אֲדֹנָי כַּאֲשֶׁר דִּבַּרְתָּ לֵאמֹר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">זְכֹר רַחֲמֶיךָ <j:divineName>יְיָ</j:divineName> וַחֲסָדֶיךָ כִּי מֵעוֹלָם הֵמָּה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/morning_full_kaddish_preface.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">And now let the power of the Lord appear great as Thou hast said.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish_preface/quotations/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">Remember Thy mercies, O Lord, and Thine acts of loving-kindness for they exist since eternity.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/shofar_uvkhen_yehi_ratzon.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shofar_uvkhen_yehi_ratzon" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n188.jpg">
        <tei:note type="description" xml:lang="he">בעוד שהצבור אומרים אשרי העם <tei:choice><tei:abbr>וכו׳</tei:abbr><tei:expan>וכולי</tei:expan></tei:choice> יאמר התוקע בלחש.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:shofar_uvkhen_yehi_ratzon/text"/>וּבְכֵן יְהִי רָצוֹן לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹקֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁיַּעֲלוּ כָּל הַמַּלְאָכִים הַמְמֻנִּים עַל הַשּׁוֹפָר וְעַל הַתְּקִיעָה וְעַל הַשְּׁבָרִים וְעַל הַתְּרוּעָה לִפְנֵי כִסֵּא כְבוֹדֶךָ וְיַמְלִיצוּ טוֹב בַּעֲדֵינוּ לְכַפֵּר עַל כָּל חַטֹּאתֵינוּ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
