          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "וֶעֱזוּז נוֹרְאֹתֶיךָ יֹאמֵרוּ וּגְדֻלָּתְךָ אֲסַפְּרֶנָּה:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/6",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/6"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "זֵכֶר רַב־טוּבְךָ יַבִּיעוּ וְצִדְקָתְךָ יְרַנֵּנוּ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/7",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/7"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "חַנּוּן וְרַחוּם יְיָ אֶרֶךְ אַפַּיִם וּגְדָל חָסֶד:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/8",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/8"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "טוֹב־יְיָ לַכֹּל וְרַחֲמָיו עַל־כָּל־מַעֲשָׂיו:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/9",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/9"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "יוֹדוּךָ יְיָ כָּל־מַעֲשֶׂיךָ וַחֲסִידֶיךָ יְבָרְכוּכָה:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/10",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/10"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "כְּבוֹד מַלְכוּתְךָ יֹאמֵרוּ וּגְבוּרָתְךָ יְדַבֵּרוּ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/11",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/11"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "לְהוֹדִיעַ לִבְנֵי הָאָדָם גְּבוּרֹתָיו וּכְבוֹד הֲדַר מַלְכוּתוֹ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/12",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/12"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "מַלְכוּתְךָ מַלְכוּת כָּל־עֹלָמִים וּמֶמְשַׁלְתְּךָ בְּכָל־דּוֹר וָדֹר:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/13",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/13"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "סוֹמֵךְ יְיָ לְכָל־הַנֹּפְלִים וְזוֹקֵף לְכָל־הַכְּפוּפִים:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/14",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/14"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "עֵינֵי כֹל אֵלֶיךָ יְשַׂבֵּרוּ וְאַתָּה נוֹתֵן־לָהֶם אֶת־אָכְלָם בְּעִתּוֹ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/15",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/15"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "פּוֹתֵחַ אֶת־יָדֶךָ וּמַשְׂבִּיעַ לְכָל־חַי רָצוֹן:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/16",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/16"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "צַדִּיק יְיָ בְּכָל־דְּרָכָיו וְחָסִיד בְּכָל־מַעֲשָׂיו:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/17",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/17"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "קָרוֹב יְיָ לְכָל־קֹרְאָיו לְכֹל אֲשֶׁר יִקְרָאֻהוּ בֶאֱמֶת:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/18",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/18"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "רְצוֹן־יְרֵאָיו יַעֲשֶׂה וְאֶת־שַׁוְעָתָם יִשְׁמַע וְיוֹשִׁיעֵם:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/19",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/19"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "שׁוֹמֵר יְיָ אֶת־כָּל־אֹהֲבָיו וְאֵת כָּל־הָרְשָׁעִים יַשְׁמִיד:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/20",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/20"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "תְּהִלַּת יְיָ יְדַבֶּר־פִּי וִיבָרֵךְ כָּל־בָּשָׂר שֵׁם קָדְשׁוֹ לְעוֹלָם וָעֶד:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/21",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/21"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "וַאֲנַחְנוּ נְבָרֵךְ יָהּ מֵעַתָּה וְעַד־עוֹלָם הַלְלוּיָהּ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/115/18",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_115",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_115/18",
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Fortunate are they that dwell in Thine House, they will still praise Thee, Selah.",
                "page_start": true
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/84/5",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_84",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_84/5"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Fortunate the people to whom this happens, fortunate the people whose God is the Lord.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/144/15",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_144",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_144/15"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Hymn by David I exalt Thee, my God and King, and bless Thy Name for ever and ever.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/1",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/1"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Every day do I bless Thee and praise Thy Name for ever and ever.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/2",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/2"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Great is the Lord and highly to be praised, His greatness is unfathomable.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/3",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/3"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Generation shall praise Thy works to generation and they shall tell of Thy mighty deeds.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/4",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/4"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The beauty of the glory of Thy majesty and words about Thy wonders shall I utter.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/5",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/5"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Men shall speak of the strength of Thine awe-inspiring deeds and, as for Thy greatness, let me relate it.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/6",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/6"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The fame of the abundance of Thy goodness do they express and exult in Thy righteousness.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/7",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/7"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Gracious and compassionate is the Lord, long suffering and great in kindness.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/8",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/8"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Benevolent is the Lord towards all and Wis compassion is upon all His creatures.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/9",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/9"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "All Thy works acknowledge Thee, O Lord, and Thy pious ones bless Thee.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/10",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/10"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "They speak of the glory of Thy dominion and tell of Thy might",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/11",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/11"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "to make known to the sons of man His mighty deeds and the glory of the beauty of His dominion.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/12",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/12"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Thy kingdom is an everlasting kingdom and Thy dominion is in every generation.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/13",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/13"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The Lord supports all that fall and straightens all that are bent.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/14",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/14"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "All eyes hope for Thee and Thou givest them their food in its time.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/15",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/15"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Thou openest Thy hands and satisfiest all the living in favour.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/16",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/16"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "Righteous is the Lord in all His ways and pious in all His deeds.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/17",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/17"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The Lord is near all who call Him, all who call Him in truth.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/18",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/18"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The desire of those that fear Him does He do and He hears their cry and saves them.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/19",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/19"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The Lord protects all that love Him and destroys all the wicked.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/20",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/20"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "The fame of the Lord does my mouth declare and all flesh shall bless His holy Name for ever and ever.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/21",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/21"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s195",
                "printed_page": "87",
                "text": "We too shall bless the Lord from now to eternity. Halleluyah.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/115/18",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_115",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_115/18",
            "end_reference": true
          }
        ]
