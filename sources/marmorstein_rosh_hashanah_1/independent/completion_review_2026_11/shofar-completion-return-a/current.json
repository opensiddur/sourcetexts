{
  "units": [
    {
      "stem": "torah_yequm_purqan_scholars",
      "urn": "urn:x-opensiddur:text:prayer:yequm_purqan/scholars",
      "title": {
        "he": "יקום פורקן לרבנן",
        "en": "Salvation for the scholars"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s190",
                "printed_page": "85",
                "text": "יְקוּם פּוּרְקָן מִן־שְׁמַיָּא חִנָּא וְחִסְדָּא וְרַחֲמֵי וְחַיֵּי אֲרִיכֵי וּמְזוֹנֵי רְוִיחֵי וְסִיַּעְתָּא דִשְׁמַיָּא וּבַרְיוּת גּוּפָא וּנְהוֹרָא מְעַלְיָא: זַרְעָא חַיָּא וְקַיָּמָא זַרְעָא דִּי לָא־יִפְסוּק וְדִי לָא־יִבְטוּל מִפִּתְגָמֵי אוֹרַיְתָא: לְמָרָנָן וְרַבָּנָן חֲבוּרָתָא קַדִּישְׁתָּא, דִּי בְאַרְעָא דְיִשְׂרָאֵל וְדִי בְבָבֶל לְרֵישֵׁי כַלֵּי וּלְרֵישֵׁי גַלְוָתָא וּלְרֵישֵׁי מְתִיבְתָא וּלְדַיָּנֵי דִּי בָבָא: לְכָל־תַּלְמִידֵיהוֹן וּלְכָל־תַּלְמִידֵי תַלְמִידֵיהוֹן וּלְכָל מָן דְּעָסְקִין בְּאוֹרַיְתָא. מַלְכָּא דְעָלְמָא יְבָרֵךְ יַתְהוֹן יַפִּישׁ חַיֵּיהוֹן וְיַסְגֵּא יוֹמֵיהוֹן וְיִתֵּן אַרְכָה לִשְׁנֵיהוֹן. וְיִתְפָּרְקוּן וְיִשְׁתֵּזְבוּן מִן כָּל־עָקָא וּמִן כָּל־מַרְעִין בִּישִׁין מָרָן דִּי בִשְׁמַיָּא יְהֵא בְסַעְדְּהוֹן כָּל־זְמַן וְעִדָּן וְנֹאמַר אָמֵן:",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yequm_purqan/scholars/text"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s191",
                "printed_page": "85",
                "text": "Let there arise salvation from heaven, mercy and kindness, compassion, long life, abundant sustenance, divine help, bodily health, heavenly enlightenment, living and enduring seed who do not interrupt or abandon study of the words of the Torah, to the masters and teachers, the holy congregations in the Land of Israel and in Babylon, the heads of the learned gathering, the Exilarchs, the heads of the academies and the judges at the gate, to all their pupils and all the pupils of their pupils and all who occupy themselves with the Law. May the King of the world bless them, prolong their lives, increase their days and give length to their years. May they be saved and delivered from every need and all evil happenings. May our Lord in Heaven aid them at every time and season, and let us say: Amen.",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yequm_purqan/scholars/text"
          }
        ]
      }
    },
    {
      "stem": "torah_yequm_purqan_congregation",
      "urn": "urn:x-opensiddur:text:prayer:yequm_purqan/congregation",
      "title": {
        "he": "יקום פורקן לקהל",
        "en": "Salvation for the congregation"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s190",
                "printed_page": "85",
                "text": "יְקוּם פּוּרְקָן מִן־שְׁמַיָּא חִנָּא וְחִסְדָּא וְרַחֲמֵי וְחַיֵּי אֲרִיכֵי וּמְזוֹנֵי רְוִיחֵי וְסִיַּעְתָּא דִשְׁמַיָּא וּבַרְיוּת גּוּפָא וּנְהוֹרָא מְעַלְיָא זַרְעָא חַיָּא וְקַיָּמָא זַרְעָא דִּי לָא־יִפְסוּק וְדִי לָא יִבְטוּל מִפִּתְגָמֵי אוֹרַיְתָא: לְכָל־קְהָלָא קַדִּישָׁא הָדֵין. רַבְרְבַיָּא עִם זְעֵרַיָּא טַפְלָא וּנְשַׁיָּא מַלְכָּא דְעָלְמָא יְבָרֵךְ יַתְכוֹן יַפִּישׁ חַיֵּיכוֹן וְיַסְגֵּא יוֹמֵיכוֹן וְיִתֵּן אַרְכָה לִשְׁנֵיכוֹן. וְתִתְפָּרְקוּן וְתִשְׁתֵּזְבוּן מִן כָּל־עָקָא וּמִן כָּל־מַרְעִין בִּישִׁין, מָרָן דִּי בִשְׁמַיָּא יְהֵא בְסַעְדְּכוֹן כָּל־זְמַן וְעִדָּן. וְנֹאמַר אָמֵן:",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yequm_purqan/congregation/text"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s191",
                "printed_page": "85",
                "text": "Let there arise salvation from heaven, mercy and kindness, long life, abundant food, divine help, bodily health, heavenly enlightenment, living and enduring seed, who do not interrupt or abandon study of the words of the Torah, to this holy congregation, old and young, children and women. May the King of the world bless you, prolong your life, increase your days and give length to your years. May you be saved and delivered from every need and all evil happenings. May our Lord in heaven aid you at every time and season, and let us say: Amen.",
                "page_start": false
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yequm_purqan/congregation/text"
          }
        ]
      }
    },
    {
      "stem": "torah_mi_sheberakh_kol_haqahal",
      "urn": "urn:x-opensiddur:text:prayer:mi_sheberakh/kol_haqahal",
      "title": {
        "he": "מי שברך לקהל",
        "en": "Prayer for the congregation"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah_mi_sheberakh_kol_haqahal/text",
            "fragments": [
              {
                "scan": "s190",
                "printed_page": "85",
                "text": "מִי שֶׁבֵּרַךְ אֲבוֹתֵינוּ אַבְרָהָם יִצְחָק וְיַעֲקֹב. הוּא יְבָרֵךְ אֶת־כָּל־הַקָּהָל הַקָּדוֹשׁ הַזֶּה עִם כָּל־קְהִלּוֹת הַקֹּדֶשׁ, הֵם וּנְשֵׁיהֶם וּבְנֵיהֶם",
                "page_start": false
              },
              {
                "scan": "s192",
                "printed_page": "86",
                "text": "וּבְנוֹתֵיהֶם וְכָל־אֲשֶׁר־לָהֶם. וּמִי שֶׁמְּיַחֲדִים בָּתֵּי כְנֵסִיוֹת לִתְפִלָּה. וּמִי שֶׁבָּאִים בְּתוֹכָם לְהִתְפַּלֵּל. וּמִי שֶׁנּוֹתְנִים נֵר לַמָּאוֹר וְיַיִן לְקִדּוּשׁ וּלְהַבְדָּלָה וּפַת לָאוֹרְחִים וּצְדָקָה לָעֲנִיִּים. וְכָל־מִי שֶׁעוֹסְקִים בְּצָרְכֵי צִבּוּר בֶּאֱמוּנָה. הַקָּדוֹשׁ בָּרוּךְ הוּא יְשַׁלֵּם שְׂכָרָם וְיָסִיר מֵהֶם כָּל מַחֲלָה וְיִרְפָּא לְכָל גּוּפָם וְיִסְלַח לְכָל־עֲוֹנָם וְיִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל־מַעֲשֵׂה יְדֵיהֶם עִם כָּל־יִשְׂרָאֵל אֲחֵיהֶם. וְנֹאמַר אָמֵן:",
                "page_start": true
              }
            ],
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah_mi_sheberakh_kol_haqahal/text",
            "fragments": [
              {
                "scan": "s191",
                "printed_page": "85",
                "text": "He who blessed our fathers, Abraham, Isaac and Jacob, bless all this holy congregation together with all other holy congregations; them, their wives, sons and daughters",
                "page_start": false
              },
              {
                "scan": "s193",
                "printed_page": "86",
                "text": "and all that belong to them; those who set aside synagogues for prayer and those who come to pray in them; those who provide light for illumination, wine for Kiddush and Havdalah, bread for strangers, charity for the poor; and all those who occupy themselves faithfully with the affairs of the community. May the Holy One, blessed be He, pay their reward, avert from them all illness, heal all their body, forgive all their guilt and send blessing and success for all the work of their hands and that of all Israel, their brethren, and let us say: Amen.",
                "page_start": true
              }
            ],
            "end_reference": true
          }
        ]
      }
    },
    {
      "stem": "torah_hanoten_teshuah",
      "urn": "urn:x-opensiddur:text:prayer:hanoten_teshuah",
      "title": {
        "he": "הנותן תשועה",
        "en": "Prayer for the ruler"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah_hanoten_teshuah/text",
            "fragments": [
              {
                "scan": "s192",
                "printed_page": "86",
                "text": "הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים וּמֶמְשָׁלָה לַנְּסִיכִים. מַלְכוּתוֹ מַלְכוּת כָּל־עוֹלָמִים. הַפּוֹצֶה אֶת־דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה. הַנּוֹתֵן בַּיָּם דֶּרֶךְ וּבְמַיִם עַזִּים נְתִיבָה. הוּא יְבָרֵךְ וְיִשְׁמוֹר וְיִנְצוֹר וְיַעֲזוֹר וִירוֹמֵם וִיגַדֵּל וִינַשֵּׂא לְמַעְלָה אֶת אֲדוֹנֵנוּ פלוני יָרוּם הוֹדוֹ: מֶלֶךְ מַלְכֵי הַמְּלָכִים בְּרַחֲמָיו יְחַיֵּהוּ וְיִשְׁמְרֵהוּ וּמִכָּל־צָרָה וְיָגוֹן וָנֶזֶק יַצִּילֵהוּ. וְיַדְבֵּר עַמִּים תַּחַת רַגְלָיו וְיַפִּיל שׂוֹנְאָיו לְפָנָיו וּבְכֹל אֲשֶׁר־יִפְנֶה יַצְלִיחַ. מֶלֶךְ מַלְכֵי הַמְּלָכִים בְּרַחֲמָיו יִתֵּן בְּלִבּוֹ וּבְלֵב כָּל־יוֹעֲצָיו וְשָׂרָיו רַחֲמָנוּת לַעֲשׂוֹת טוֹבָה עִמָּנוּ וְעִם כָּל יִשְׂרָאֵל. בְּיָמָיו וּבְיָמֵינוּ תִּוָּשַׁע יְהוּדָה וְיִשְׂרָאֵל יִשְׁכֹּן לָבֶטַח וּבָא לְצִיּוֹן גּוֹאֵל. וְכֵן יְהִי רָצוֹן. וְנֹאמַר אָמֵן:",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah_hanoten_teshuah/text",
            "fragments": [
              {
                "scan": "s193",
                "printed_page": "86",
                "text": "May He who grants salvation to kings and dominion to princes, whose kingdom is an everlasting kingdom, who delivered His servant David from the evil sword, who made a way through the sea, a path through mighty waters, bless, guard, protect, help, exalt, magnify and raise to grandeur our lord . . . May his majesty be exalted. May the King of kings in His mercy grant him life, guard him and deliver him from all adversity, grief and loss, subdue nations beneath his feet and overthrow his enemies before him and wherever he turns, may he be successful. May the King of kings lay in his heart and in the heart of all his advisers and princes compassion so as to deal kindly with us and all Israel. In his days and in ours may Judah be saved and Israel dwell in safety and may the Redeemer come to Zion, Thus may it be Thy will, and let us say: Amen.",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ]
      }
    },
    {
      "stem": "torah_ashrei",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei",
      "title": {
        "he": "אשרי",
        "en": "Ashrei"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "אַשְׁרֵי יוֹשְׁבֵי בֵיתֶךָ עוֹד יְהַלְלוּךָ סֶלָה:",
                "page_start": true
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/84/5",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_84",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_84/5"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "אַשְׁרֵי הָעָם שֶׁכָּכָה לּוֹ אַשְׁרֵי הָעָם שֶׁיְיָ אֱלֹהָיו:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/144/15",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_144",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_144/15"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "תְּהִלָּה לְדָוִד. אֲרוֹמִמְךָ אֱלוֹהַי הַמֶּלֶךְ וַאֲבָרְכָה שִׁמְךָ לְעוֹלָם וָעֶד:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/1",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/1"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "בְּכָל־יוֹם אֲבָרְכֶךָּ וַאֲהַלְלָה שִׁמְךָ לְעוֹלָם וָעֶד:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/2",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/2"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "גָּדוֹל יְיָ וּמְהֻלָּל מְאֹד וְלִגְדֻלָּתוֹ אֵין חֵקֶר:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/3",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/3"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "דּוֹר לְדוֹר יְשַׁבַּח מַעֲשֶׂיךָ וּגְבוּרֹתֶיךָ יַגִּידוּ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/4",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/4"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s194",
                "printed_page": "87",
                "text": "הֲדַר כְּבוֹד הוֹדֶךָ וְדִבְרֵי נִפְלְאֹתֶיךָ אָשִׂיחָה:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/145/5",
            "reference_unit": "verse",
