      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n196.jpg">
        <tei:pb ed="1965" n="88" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n196.jpg"/>
        <tei:head xml:lang="en">Prayer while returning the Scrolls of the Torah to the Ark</tei:head>
        <tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="en">Reader:</tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/call"/><tei:milestone unit="chapter" n="148" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/call/quotations/psalms_148"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/call/quotations/psalms_148/13"/><tei:milestone unit="half-verse" n="a" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/call/quotations/psalms_148/13/a"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/148/13/a">Let them praise the Name of the Lord for His Name alone is exalted.</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="en">Congregation:</tei:note> <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/response"/><tei:milestone unit="chapter" n="148" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/response/quotations/psalms_148"/><tei:milestone unit="verse" n="13" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/response/quotations/psalms_148/13"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/response/quotations/psalms_148/13/b"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/148/13/b">His majesty is above earth and heavens.</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/veyarem"/><tei:milestone unit="chapter" n="148" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/veyarem/quotations/psalms_148"/><tei:milestone unit="verse" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/yehallelu/veyarem/quotations/psalms_148/14"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/148/14"> When He raises the condition of 
His people, then there is glory to all His pious ones, the Children of Israel, the people near Him, Halleluyah.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
