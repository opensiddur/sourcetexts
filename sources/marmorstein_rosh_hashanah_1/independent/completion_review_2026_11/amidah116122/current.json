    {
      "stem": "emet_veyatziv",
      "urn": "urn:x-opensiddur:text:prayer:emet_veyatziv",
      "title": {
        "he": "אֱמֶת וְיַצִּיב",
        "en": "True and firm"
      },
      "languages": {
        "he": [
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "מִי־כָמֹ֤כָה בָּאֵלִם֙ יְהֹ֔וָה מִי כָּמֹכָה נֶאְדָּר בַּקֹּדֶשׁ נוֹרָא תְהִלֹּת עֹשֵׂה פֶלֶא:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/mi_khamokhah",
            "source": "urn:x-opensiddur:text:bible:exodus/15/11",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/15/11",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_exodus_15_11/11",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_exodus_15_11"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "שִׁירָה חֲדָשָׁה שִׁבְּחוּ גְאוּלִים לְשִׁמְךָ עַל־שְׂפַת הַיָּם יַחַד כֻּלָּם הוֹדוּ וְהִמְלִיכוּ וְאָמְרוּ. ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/shirah"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "יְיָ יִמְלֹךְ לְעֹלָם וָעֶד:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/adonai_yimlokh",
            "source": "urn:x-opensiddur:text:bible:exodus/15/18",
            "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_exodus_15_18/18",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_exodus_15_18"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "צוּר יִשְׂרָאֵל קוּמָה בְּעֶזְרַת יִשְׂרָאֵל וּפְדֵה כִנְאֻמֶךָ יְהוּדָה וְיִשְׂרָאֵל.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/tzur_yisrael"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "גֹּאֲלֵנוּ יְיָ צְבָאוֹת שְׁמוֹ קְדוֹשׁ יִשְׂרָאֵל.",
                "page_start": false
              }
            ],
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/47/4",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_isaiah_47_4/4",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:emet_veyatziv/quotations/quoted_isaiah_47_4",
            "source": "urn:x-opensiddur:text:bible:isaiah/47/4"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "בָּרוּךְ אַתָּה יְיָ גָּאַל יִשְׂרָאֵל:",
                "page_start": false
              }
            ]
          }
        ]
      }
    },
    {
