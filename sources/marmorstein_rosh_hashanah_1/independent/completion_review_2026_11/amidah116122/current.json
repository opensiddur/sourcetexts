    {
      "stem": "shacharit_amidah_avot",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot",
      "title": {
        "he": "אבות",
        "en": "אבות"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא אֵל עֶלְיוֹן גּוֹמֵל חֲסָדִים טוֹבִים וְקֹנֵה הַכֹּל וְזוֹכֵר חַסְדֵּי אָבוֹת וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם לְמַעַן שְׁמוֹ בְּאַהֲבָה:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/barukh_attah",
            "source": "urn:x-opensiddur:text:prayer:amidah/avot/barukh_attah"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "זָכְרֵנוּ לַחַיִּים. מֶלֶךְ חָפֵץ בַּחַיִּים. וְכָתְבֵנוּ בְּסֵפֶר הַחַיִּים. לְמַעַנְךָ אֱלֹהִים חַיִּים.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/zokhrenu",
            "source": "urn:x-opensiddur:text:prayer:amidah/avot/zokhrenu"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "מֶלֶךְ עוֹזֵר וּמוֹשִׁיעַ וּמָגֵן. בָּרוּךְ אַתָּה יְיָ מָגֵן אַבְרָהָם:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/magen_avraham",
            "source": "urn:x-opensiddur:text:prayer:amidah/avot/magen_avraham"
          }
        ]
      }
    },
    {
      "stem": "shacharit_amidah_gevurot",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot",
      "title": {
        "he": "גבורות",
        "en": "גבורות"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/attah_gibbor",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mekhalkel_chayyim",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "מִי כָמוֹךָ אַב הָרַחֲמִים. זוֹכֵר יְצוּרָיו לַחַיִּים בְּרַחֲמִים.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mi_khamokha",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s116",
                "printed_page": "44",
                "text": "וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה יְיָ מְחַיֵּה הַמֵּתִים:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mechayyeh_hametim",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"
          }
