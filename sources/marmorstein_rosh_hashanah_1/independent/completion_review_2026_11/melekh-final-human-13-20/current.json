            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ אָזוּר גְּבוּרָה. גָּדוֹל שִׁמְךָ בִּגְבוּרָה. לְךָ זְרוֹעַ עִם גְּבוּרָה:",
            "page_start": true
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/1"
