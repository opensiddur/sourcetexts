      {
        "paragraph": 1,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ גֵּאוּת לָבֵשׁ. יַמִּים מְיַבֵּשׁ. וְגַאֲוַת אֲפִיקִים מְכַבֵּשׁ:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/3"
