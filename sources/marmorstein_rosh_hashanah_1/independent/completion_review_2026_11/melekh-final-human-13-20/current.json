        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ בִּגְדֵי נָקָם. לָבֵשׁ בְּיוֹם נָקָם. לְצָרָיו יָשִׁיב אֶל־חֵיקָם:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/2"
