      {
        "paragraph": 2,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ בַּעֲשָׂרָה לְבוּשִׁים. הִתְאַזָּר בִּקְדוֹשִׁים. אֵל נַעֲרָץ בְּסוֹד קְדוֹשִׁים. קָדוֹשׁ:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/4"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ דָּר בִּנְהוֹרָא. עוֹטֶה כַשַּׂלְמָה אוֹרָה. מִשְׁפָּטֵנוּ יוֹצִיא כָאוֹרָה:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/5"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ הִתְאַזָּר עֹז. יְמִינוֹ תָּעוֹז. וֶאֱנוֹשׁ אַל יָעוֹז:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/6"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ וַיִּלְבַּשׁ צְדָקָה. וְנִקְדַּשׁ בִּצְדָקָה. לְךָ יְיָ הַצְּדָקָה:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/7"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ זֶה הָדוּר בִּלְבוּשׁוֹ. וְכוֹבַע יְשׁוּעָה בְּרֹאשׁוֹ. אֱלֹהִים יָשַׁב עַל כִּסֵּא קָדְשׁוֹ:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/8"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ חֲמוּץ בְּגָדִים. בְּדָרְכוֹ בוֹגְדִים. יִבְצֹר רוּחַ נְגִידִים:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/9"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ טַלִּיתוֹ כַשֶּׁלֶג מְצֻחְצָח. צַח וּבְצַחְצָחוֹת יְצַחְצַח. מְצַחְצְחִים פָּעֳלָם לְנַצַּח:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/10"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ יָעַט קִנְאָה. קַנֹּא קִנֵּא גָּאֹה גָאָה. כְּאִישׁ מִלְחָמוֹת יָעִיר קִנְאָה:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/11"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ, כָּל־אַפְסֵי אָרֶץ. יִשְׁתַּחֲווּ לְמֶלֶךְ עַל כָּל־הָאָרֶץ. כִּי בָא לִשְׁפּוֹט אֶת־הָאָרֶץ:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/12"
      },
      {
        "paragraph": 3,
        "fragments": [
          {
            "scan": "s98",
            "printed_page": "35",
            "text": "מֶלֶךְ לְיוֹם קוּמוֹ לָעַד. כָּל־יְצוּר לְפָנָיו יִרְעַד. רָם וְנִשָּׂא שׁוֹכֵן עַד:",
            "page_start": false
          }
        ],
        "reference_unit": "stanza",
        "corresp": "urn:x-opensiddur:text:poem:melekh_azur_gevurah/13"
