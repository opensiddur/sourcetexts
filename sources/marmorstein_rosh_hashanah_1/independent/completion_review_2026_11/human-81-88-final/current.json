[
  {
    "stem": "shacharit_amidah_avot",
    "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot",
    "title": {
      "he": "אבות",
      "en": "אבות"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא אֵל עֶלְיוֹן גּוֹמֵל חֲסָדִים טוֹבִים וְקֹנֵה הַכֹּל וְזוֹכֵר חַסְדֵּי אָבוֹת וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם לְמַעַן שְׁמוֹ בְּאַהֲבָה:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/barukh_attah",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/barukh_attah"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "זָכְרֵֽנוּ לַחַיִּים. מֶלֶךְ חָפֵץ בַּחַיִּים. וְכָתְבֵֽנוּ בְּסֵפֶר הַחַיִּים. לְמַעַנְךָ אֱלֹהִים חַיִּים.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/zokhrenu",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/zokhrenu"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "מֶלֶךְ עוֹזֵר וּמוֹשִׁיעַ וּמָגֵן. בָּרוּךְ אַתָּה יְיָ מָגֵן אַבְרָהָם:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/magen_avraham",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/magen_avraham"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Blessed art Thou, O Lord our God and the God of our fathers, the God of Abraham, the God of Isaac and the God of Jacob, the great, mighty and awe-inspiring God, God the Most High, who performs acts of kindness and owns everything and remembers the good deeds of the fathers and will bring a redeemer for their children’s children for His Name’s sake in love.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/barukh_attah",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/barukh_attah"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Remember us for life, O King who delights in life, and inscribe us in the book of life for Thy sake, O living God.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/zokhrenu",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/zokhrenu"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "O King, helper and saviour and shield, blessed art Thou, O Lord, the shield of Abraham.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avot/magen_avraham",
          "source": "urn:x-opensiddur:text:prayer:amidah/avot/magen_avraham"
        }
      ]
    }
  },
  {
    "stem": "shacharit_amidah_gevurot",
    "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot",
    "title": {
      "he": "גבורות",
      "en": "גבורות"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/attah_gibbor",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mekhalkel_chayyim",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "מִי כָמוֹךָ אַב הָרַחֲמִים. זוֹכֵר יְצוּרָיו לַחַיִּים בְּרַחֲמִים.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mi_khamokha",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה יְיָ מְחַיֵּה הַמֵּתִים:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mechayyeh_hametim",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Thou art for ever mighty, O Lord the reviver of the dead, Thou art great to save.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/attah_gibbor",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling and healing the sick and releasing captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mekhalkel_chayyim",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mi_khamokha",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mechayyeh_hametim",
          "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"
        }
      ]
    }
  },
  {
    "stem": "shacharit_amidah_qedushat_hashem",
    "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem",
    "title": {
      "he": "קדושת השם",
      "en": "קדושת השם"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s116",
              "printed_page": "44",
              "text": "אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלוּךָ סֶּֽלָה:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/attah_qadosh",
          "source": "urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/attah_qadosh"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "וּבְכֵן תֵּן פַּחְדְּךָ יְיָ אֱלֹהֵינוּ עַל כָּל־מַעֲשֶׂיךָ וְאֵימָתְךָ עַל כָּל־מַה־שֶּׁבָּרָֽאתָ וְיִירָאוּךָ כָּל־הַמַּעֲשִׂים וְיִשְׁתַּחֲווּ לְפָנֶיךָ כָּל־הַבְּרוּאִים וְיֵעָשׂוּ כֻלָּם אֲגֻדָּה אַחַת לַעֲשׂוֹת רְצוֹנְךָ בְּלֵבָב שָׁלֵם כְּמוֹ שֶׁיָּדַֽעְנוּ יְיָ אֱלֹהֵינוּ שֶׁהַשָּׁלְטָן לְפָנֶיךָ עֹז בְּיָדַֽךָ וּגְבוּרָה בִּימִינֶךָ וְשִׁמְךָ נוֹרָא עַל כָּל־מַה־שֶּׁבָּרָֽאתָ:",
              "page_start": true
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_pachdekha",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_pachdekha"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "וּבְכֵן תֵּן כָּבוֹד יְיָ לְעַמֶּךָ תְּהִלָּה לִירֵאֶיךָ וְתִקְוָה לְדוֹרְשֶׁיךָ וּפִתְחוֹן פֶּה לַמְיַחֲלִים לָךְ שִׂמְחָה לְאַרְצֶךָ וְשָׂשׂוֹן לְעִירֶךָ וּצְמִיחַת קֶרֶן לְדָוִד עַבְדֶּךָ וַעֲרִיכַת נֵר לְבֶן־יִשַׁי מְשִׁיחֶךָ בִּמְהֵרָה בְיָמֵינוּ:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_kavod",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "וּבְכֵן צַדִּיקִים יִרְאוּ וְיִשְׂמָחוּ וִישָׁרִים יַעֲלֹזוּ וַחֲסִידִים בְּרִנָּה יָגִילוּ וְעוֹלָתָה תִּקְפָּץ־פִּיהָ. וְכָל־הָרִשְׁעָה כֻּלָּהּ כְּעָשָׁן תִּכְלֶה כִּי תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן־הָאָרֶץ:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_tzaddiqim",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_tzaddiqim"
        },
        {
          "paragraph": 5,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "וְתִמְלוֹךְ אַתָּה יְיָ לְבַדֶּךָ עַל כָּל־מַעֲשֶׂיךָ בְּהַר צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ וּבִירוּשָׁלַיִם עִיר קָדְשֶׁךָ. כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/vetimlokh",
          "source": "urn:x-opensiddur:text:prayer:amidah/vetimlokh_attah_hashem"
        },
        {
          "paragraph": 5,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "יִמְלֹךְ יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ:",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/146/10",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/146/10",
          "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10/10",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "קָדוֹשׁ אַתָּה וְנוֹרָא שְׁמֶךָ וְאֵין אֱלוֹהַּ מִבַּלְעָדֶיךָ. כַּכָּתוּב",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/qadosh_attah",
          "source": "urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "וַיִּגְבַּהּ יְיָ צְבָאוֹת בַּמִּשְׁפָּט וְהָאֵל הַקָּדוֹשׁ נִקְדָּשׁ בִּצְדָקָה.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:isaiah/5/16",
          "source_reference": "urn:x-opensiddur:text:bible:isaiah/5/16",
          "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16/16",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s118",
              "printed_page": "45",
              "text": "בָּרוּךְ אַתָּה יְיָ הַמֶּלֶךְ הַקָּדוֹשׁ:",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s117",
              "printed_page": "44",
              "text": "Thou art holy and Thy Name is holy and holy ones praise Thee every day. Selah!",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/attah_qadosh",
          "source": "urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/attah_qadosh"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "And therefore put the fear of Thee, O Lord our God, upon all Thy works and awe of Thee upon all that Thou hast created, so that all works may fear Thee and all the created bow down before Thee and all of them may be made into one group for the performance of Thy will with a complete heart, since we know, O Lord our God, that dominion lies before Thee, that strength is in Thy hand and might in Thy right hand and that Thy Name inspires with awe all that Thou has created.",
              "page_start": true
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_pachdekha",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_pachdekha"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "And therefore grant honour, O Lord, to Thy people, fame to those who fear Thee and praise to those who seek Thee and confidence to those who wait for Thee, joy to Thy land happiness to Thy city and a rise of fortune to David Thy servant and an array of light to the son of Jesse Thine anointed speedily and in our days.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_kavod",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "And thus may the righteous see and rejoice and the upright exult and the pious revel with joy. Vice shall close its mouth and all evil entirely disappear like smoke when Thou removest the dominion of arrogance from the earth.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_tzaddiqim",
          "source": "urn:x-opensiddur:text:prayer:amidah/uvekhen_tzaddiqim"
        },
        {
          "paragraph": 5,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "And Thou, O Lord, shalt reign alone over all Thy works on Mount Zion, Thy glorious dwelling, and in Jerusalem, Thy Holy City, as it is written in Thy holy word,",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/vetimlokh",
          "source": "urn:x-opensiddur:text:prayer:amidah/vetimlokh_attah_hashem"
        },
        {
          "paragraph": 5,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "the Lord shall reign for ever, your God, O Zion, from generation to generation. Halleluyah!",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:psalms/146/10",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/146/10",
          "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10/10",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "Holy art Thou and awe-inspiring is Thy Name and there is no God beside Thee, as it is written,",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/qadosh_attah",
          "source": "urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "exalted is the Lord of Hosts through judgment and the Holy God is sanctified through righteousness.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:bible:isaiah/5/16",
          "source_reference": "urn:x-opensiddur:text:bible:isaiah/5/16",
          "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16/16",
          "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16"
        },
        {
          "paragraph": 6,
          "fragments": [
            {
              "scan": "s119",
              "printed_page": "45",
              "text": "Blessed art Thou, O Lord, the Holy King.",
              "page_start": false
            }
          ],
          "source": "urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"
        }
      ]
    }
