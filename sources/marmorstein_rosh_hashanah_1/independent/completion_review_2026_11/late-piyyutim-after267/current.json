            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/21"
          },
          {
            "paragraph": 22,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Those who maintain praises say constantly aloud: The Lord is King.",
