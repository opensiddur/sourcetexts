            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/12"
          },
          {
            "paragraph": 13,
            "fragments": [
              {
                "scan": "s143",
                "printed_page": "57",
                "text": "They who speak pleasing words say aloud: The Lord is King.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/13"
          },
          {
            "paragraph": 14,
            "fragments": [
              {
                "scan": "s143",
                "printed_page": "57",
                "text": "They who sparkle with brilliance triumph aloud: The Lord has reigned.",
                "page_start": true
              }
