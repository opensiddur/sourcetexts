          },
          {
            "paragraph": 19,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Holy communities sanctify aloud: The Lord is King.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/19"
          },
          {
            "paragraph": 20,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Myriads of myriads exult aloud: The Lord has reigned.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/20"
          },
          {
            "paragraph": 21,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Those fashioned of flames repeat aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever.",
                "page_start": true,
                "quotations": [
                  {
                    "text": "The Lord will reign for ever and ever.",
                    "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18",
                    "chapter_corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_21/chapter",
                    "source_reference_corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_21/chapter/18"
                  }
