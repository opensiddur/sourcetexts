            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/14"
          },
          {
            "paragraph": 15,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "The Seraphim around Him glorify aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever.",
                "page_start": true,
                "quotations": [
                  {
                    "text": "The Lord will reign for ever and ever.",
                    "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18",
                    "chapter_corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_15/chapter",
