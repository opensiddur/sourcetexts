            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/15"
          },
          {
            "paragraph": 16,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Those who classify the law respond aloud: The Lord is King.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/16"
          },
          {
            "paragraph": 17,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "Those in dread at Thy wonders utter aloud: The Lord has reigned.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/17"
          },
          {
            "paragraph": 18,
            "fragments": [
              {
                "scan": "s145",
                "printed_page": "58",
                "text": "The hosts of Thy flock let it ring out aloud: The Lord will reign. The Lord is King, the Lord has reigned, The Lord will reign for ever and ever.",
                "page_start": true,
                "quotations": [
                  {
                    "text": "The Lord will reign for ever and ever.",
                    "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18",
                    "chapter_corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_18/chapter",
                    "source_reference_corresp": "urn:x-opensiddur:text:poem:adirei_ayummah/quotations/refrain_18/chapter/18"
