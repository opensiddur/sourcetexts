  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/uvekhen_dayyan_emet_attah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_dayyan_emet_attah/text"/>And thus Thou art the true judge. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/lael_orekh_din.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg">
        <tei:note type="description" xml:lang="he">ע״ס א״ב.</tei:note>
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n143.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן.</tei:note> לְאֵל עוֹרֵךְ דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל.</tei:note> לְבוֹחֵן לְבָבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְגוֹלֶה עֲמוּקוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְדוֹבֵר מֵישָׁרִים בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְהוֹגֶה דֵּעוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְוָתִיק וְעֹשֶׂה חֶסֶד בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְזוֹכֵר בְּרִיתוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְחוֹמֵל מַעֲשָׂיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְטַהֵר חוֹסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְיוֹדֵעַ מַחֲשָׁבוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְכוֹבֵשׁ כַּעֲסוֹ בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְלוֹבֵשׁ צְדָקוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n145.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְמוֹחֵל עֲוֹנוֹת בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְנוֹרָא תְהִלּוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְסוֹלֵחַ לַעֲמוּסָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְעוֹנֶה לְקוֹרְאָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְפוֹעֵל רַחֲמָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְצוֹפֶה נִסְתָּרוֹת בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְקוֹנֶה עֲבָדָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> לְרַחֵם עַמּוֹ בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">חזן</tei:note> לְשׁוֹמֵר אֹהֲבָיו בַּדִּין: <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="he">קהל</tei:note> לְתוֹמֵךְ תְּמִימָיו בְּיוֹם דִּין: <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/lael_orekh_din.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:lael_orekh_din" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg">
        <tei:lg>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n144.jpg" n="58"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> God who arranges judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/2"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who examines hearts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/3"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who reveals secrets in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/4"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who speaks uprightness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/5"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who considers opinions in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who in knowledge acts kindly on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/7"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who remembers His covenant in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/8"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who pities His creatures on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/9"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who cleanses those who trust in Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/10"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who knows thoughts on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/11"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who suppresses His anger in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/12"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who clothes Himself in righteousness on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n146.jpg" n="59"/><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/13"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who forgives sins in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/14"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who is awe-inspiring in fame on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/15"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who pardons those carried by Him in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/16"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who answers those who call on Him on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/17"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who displays His compassion in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/18"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who observes what is concealed on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/19"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who acquires His slaves in judgment. <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/20"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader and congregation</tei:note> Who has compassion on His people on the day of judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/21"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Reader</tei:note> Who protects those who love Him, in judgment, <tei:milestone unit="stanza"/></tei:l>
          <tei:l><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:lael_orekh_din/22"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" resp="urn:x-opensiddur:contributor:opensiddur.org/codex" xml:lang="en">Congregation</tei:note> Who supports His innocent ones on the day of judgment. <tei:milestone unit="stanza"/></tei:l>
        </tei:lg>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/uvekhen_lekha_taaleh_qedushah.xml"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="urn:x-opensiddur:text:prayer:uvekhen_lekha_taaleh_qedushah/text" xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">
      <tei:p>The source prints הוא in parentheses without assigning an occasion; retained as a documentary variant.</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_lekha_taaleh_qedushah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n145.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n145.jpg" n="59"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_lekha_taaleh_qedushah/text"/>וּבְכֵן לְךָ תַעֲלֶה קְדֻשָּׁה. כִּי אַתָּה (הוּא) אֱלֹהֵינוּ מֶלֶךְ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/uvekhen_lekha_taaleh_qedushah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:uvekhen_lekha_taaleh_qedushah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n146.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n146.jpg" n="59"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:uvekhen_lekha_taaleh_qedushah/text"/>And thus let sanctification arise for Thee, For Thou art our God, O King. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_qedushah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n151.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n151.jpg" n="63"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/kakatuv"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh">כַּכָּתוּב עַל יַד נְבִיאֶךָ. </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/kakatuv_isaiah_6"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/kakatuv_isaiah_6/3"/><tei:milestone unit="verse-part" n="veqara" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/kakatuv_isaiah_6/3/veqara"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3/veqara">וְקָרָא זֶה אֶל זֶה וְאָמַר.</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/qadosh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/qadosh_isaiah_6"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/qadosh_isaiah_6/3"/><tei:milestone unit="verse-part" n="qadosh" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/qadosh_isaiah_6/3/qadosh"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/6/3/qadosh">קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ <j:divineName>יְיָ</j:divineName> צְבָאוֹת מְלֹא כָל־הָאָרֶץ כְּבוֹדוֹ:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/az_beqol"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/az_beqol_raash">אָז בְּקוֹל רַעַשׁ גָּדוֹל אַדִּיר וְחָזָק מַשְׁמִיעִים קוֹל מִתְנַשְּׂאִים לְעֻמַּת שְׂרָפִים לְעֻמָּתָם בָּרוּךְ יֹאמֵרוּ:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/barukh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/barukh_ezekiel_3"/><tei:milestone unit="verse" n="12" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/barukh_ezekiel_3/12"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/barukh_ezekiel_3/12/b"/><tei:seg source="urn:x-opensiddur:text:bible:ezekiel/3/12/b">בָּרוּךְ כְּבוֹד <j:divineName>יְיָ</j:divineName> מִמְּקוֹמוֹ:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/mimmeqomkha"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/mimeqomekha_malkenu_tofia">מִמְּקוֹמְךָ מַלְכֵּנוּ תוֹפִיעַ וְתִמְלוֹךְ עָלֵינוּ כִּי מְחַכִּים אֲנַחְנוּ לָךְ מָתַי תִּמְלוֹךְ בְּצִיּוֹן בְּקָרוֹב בְּיָמֵינוּ לְעוֹלָם וָעֶד תִּשְׁכּוֹן: תִּתְגַּדַּל וְתִתְקַדַּשׁ בְּתוֹךְ יְרוּשָׁלַיִם עִירְךָ לְדוֹר וָדוֹר וּלְנֵצַח נְצָחִים: וְעֵינֵינוּ תִרְאֶינָה מַלְכוּתֶךָ כַּדָּבָר הָאָמוּר בְּשִׁירֵי עֻזֶּךָ עַל יְדֵי דָוִד מְשִׁיחַ צִדְקֶךָ:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/yimlokh"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="chapter" n="146" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/yimlokh_psalms_146"/><tei:milestone unit="verse" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/quotations/yimlokh_psalms_146/10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/146/10">יִמְלֹךְ <j:divineName>יְיָ</j:divineName> לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/qedushah/ledor_vador"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador">לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_avodah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/avodah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n153.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n153.jpg" n="65"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/avodah/retzeh"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh">רְצֵה <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בְּעַמְּךָ יִשְׂרָאֵל וּבִתְפִלָּתָם. וְהָשֵׁב אֶת הָעֲבוֹדָה לִדְבִיר בֵּיתֶךָ וְאִשֵּׁי יִשְׂרָאֵל וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל בְּרָצוֹן וּתְהִי לְרָצוֹן תָּמִיד עֲבוֹדַת יִשְׂרָאֵל עַמֶּךָ. וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְצִיּוֹן בְּרַחֲמִים. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_modim_derabbanan.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/modim_derabbanan" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n153.jpg">
        <tei:note type="description" xml:lang="he">מודים דרבנן.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n153.jpg" n="65"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/hodaah/modim_derabbanan/text"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan">מוֹדִים אֲנַחְנוּ לָךְ שָׁאַתָּה הוּא <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ אֱלֹהֵי כָל בָּשָׂר יוֹצְרֵנוּ יוֹצֵר בְּרֵאשִׁית בְּרָכוֹת וְהוֹדָאוֹת לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עַל שֶׁהֶחֱיִיתָנוּ וְקִיַּמְתָּנוּ כֵּן תְּחַיֵּנוּ וּתְקַיְּמֵנוּ וְתֶאֱסוֹף גָּלֻיּוֹתֵינוּ לְחַצְרוֹת קָדְשֶׁךָ לִשְׁמֹר חֻקֶּיךָ וְלַעֲשׂוֹת רְצוֹנֶךָ וּלְעָבְדְּךָ בְּלֵבָב שָׁלֵם עַל שֶׁאֲנַחְנוּ מוֹדִים לָךְ. בָּרוּךְ אֵל הַהוֹדָאוֹת:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_birkat_kohanim.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg" n="66"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/birkat_kohanim"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ בָּרְכֵנוּ בַבְּרָכָה הַמְשֻׁלֶּשֶׁת בַּתּוֹרָה הַכְּתוּבָה עַל יְדֵי מֹשֶׁה עַבְדֶּךָ הָאֲמוּרָה מִפִּי אַהֲרֹן וּבָנָיו כֹּהֲנִים עַם קְדוֹשֶׁךָ כָּאָמוּר: </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_24"/><tei:milestone unit="verse" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_24/24"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/24">יְבָרֶכְךָ <j:divineName>יְיָ</j:divineName> וְיִשְׁמְרֶךָ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz"> </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_25"/><tei:milestone unit="verse" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_25/25"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/25">יָאֵר <j:divineName>יְיָ</j:divineName> פָּנָיו אֵלֶיךָ וִיחֻנֶּךָ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/birkat_kohanim_leshatz"> </tei:seg> <tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_26"/><tei:milestone unit="verse" n="26" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/birkat_kohanim/quotations/numbers_6_26/26"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/6/26">יִשָּׂא <j:divineName>יְיָ</j:divineName> פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/repetition_sim_shalom.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shalom" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n154.jpg" n="66"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shalom/sim_shalom"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/shalom/sim_shalom">שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה חֵן וָחֶסֶד וְרַחֲמִים עָלֵינוּ וְעַל כָּל־יִשְׂרָאֵל עַמֶּךָ. בָּרְכֵנוּ אָבִינוּ כֻּלָּנוּ כְאֶחָד בְּאוֹר פָּנֶיךָ כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ תּוֹרַת חַיִּים וְאַהֲבַת חֶסֶד וּצְדָקָה וּבְרָכָה וְרַחֲמִים וְחַיִּים וְשָׁלוֹם. וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת־עַמְּךָ יִשְׂרָאֵל בְּכָל־עֵת וּבְכָל־שָׁעָה בִּשְׁלוֹמֶךָ.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/shalom/besefer"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/shalom/besefer_chayyim">בְּסֵפֶר חַיִּים בְּרָכָה וְשָׁלוֹם וּפַרְנָסָה טוֹבָה נִזָּכֵר וְנִכָּתֵב לְפָנֶיךָ אֲנַחְנוּ וְכָל עַמְּךָ בֵּית יִשְׂרָאֵל לְחַיִּים טוֹבִים וּלְשָׁלוֹם. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> עוֹשֵׂה הַשָּׁלוֹם:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
