    {
      "stem": "torah_maftir_numbers_29",
      "urn": "urn:x-opensiddur:text:bible:numbers/29",
      "title": {
        "he": "ובחדש השביעי",
        "en": "Maphtir: Numbers 29:1–6"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/1",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וּבַחֹ֨דֶשׁ הַשְּׁבִיעִ֜י בְּאֶחָ֣ד לַחֹ֗דֶשׁ מִֽקְרָא־קֹ֙דֶשׁ֙ יִהְיֶ֣ה לָכֶ֔ם כָּל־מְלֶ֥אכֶת עֲבֹדָ֖ה לֹ֣א תַעֲשׂ֑וּ י֥וֹם תְּרוּעָ֖ה יִהְיֶ֥ה לָכֶֽם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/2",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וַעֲשִׂיתֶ֨ם עֹלָ֜ה לְרֵ֤יחַ נִיחֹ֙חַ֙ לַֽיהוָ֔ה פַּ֧ר בֶּן־בָּקָ֛ר אֶחָ֖ד אַ֣יִל אֶחָ֑ד כְּבָשִׂ֧ים בְּנֵי־שָׁנָ֛ה שִׁבְעָ֖ה תְּמִימִֽם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/3",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וּמִ֨נְחָתָ֔ם סֹ֖לֶת בְּלוּלָ֣ה בַשָּׁ֑מֶן שְׁלֹשָׁ֤ה עֶשְׂרֹנִים֙ לַפָּ֔ר שְׁנֵ֥י עֶשְׂרֹנִ֖ים לָאָֽיִל׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/4",
            "fragments": [
              {
                "scan": "s174",
                "printed_page": "76",
                "text": "וְעִשָּׂר֣וֹן אֶחָ֔ד לַכֶּ֖בֶשׂ הָאֶחָ֑ד לְשִׁבְעַ֖ת הַכְּבָשִֽׂים׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/5",
            "fragments": [
              {
                "scan": "s174",
                "printed_page": "76",
                "text": "וּשְׂעִיר־עִזִּ֥ים אֶחָ֖ד חַטָּ֑את לְכַפֵּ֖ר עֲלֵיכֶֽם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/6",
            "fragments": [
              {
                "scan": "s174",
                "printed_page": "76",
                "text": "מִלְּבַד֩ עֹלַ֨ת הַחֹ֜דֶשׁ וּמִנְחָתָ֗הּ וְעֹלַ֤ת הַתָּמִיד֙ וּמִנְחָתָ֔הּ וְנִסְכֵּיהֶ֖ם כְּמִשְׁפָּטָ֑ם לְרֵ֣יחַ נִיחֹ֔חַ אִשֶּׁ֖ה לַיהוָֽה׃"
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/1",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "In the seventh month, on the first day of the month, you shall have a sacred assembly; you may not do any form of work, a day of Teruah shall it be for you."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/2",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "You shall prepare a whole-offering of sweet savour to the Lord, one young bullock, one ram, seven flawless lambs in their first year."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/3",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Their meal-offering shall be of flour mixed with oil, three tenths for the bullock, two tenths for the ram"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/4",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "and one tenth"
              },
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "for each of the seven lambs."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/5",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "And also one he-goat as a sin-offering to atone for you."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/6",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "Apart from the whole-offering of the new moon and its meal-offering and the regular whole-offering with its meal-offering and their drink-offerings according to their rule for a sweet savour, a fire offering to the Lord."
              }
            ]
          }
        ]
      },
      "start": "urn:x-opensiddur:text:bible:numbers/29/1",
      "end": "urn:x-opensiddur:text:bible:numbers/29/6"
    }
