      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/1",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַֽיהוָ֛ה פָּקַ֥ד אֶת־שָׂרָ֖ה כַּאֲשֶׁ֣ר אָמָ֑ר וַיַּ֧עַשׂ יְהוָ֛ה לְשָׂרָ֖ה כַּאֲשֶׁ֥ר דִּבֵּֽר׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/2",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַתַּ֩הַר֩ וַתֵּ֨לֶד שָׂרָ֧ה לְאַבְרָהָ֛ם בֵּ֖ן לִזְקֻנָ֑יו לַמּוֹעֵ֕ד אֲשֶׁר־דִּבֶּ֥ר אֹת֖וֹ אֱלֹהִֽים׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/3",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַיִּקְרָ֨א אַבְרָהָ֜ם אֶֽת־שֶׁם־בְּנ֧וֹ הַנּֽוֹלַד־ל֛וֹ אֲשֶׁר־יָֽלְדָה־לּ֥וֹ שָׂרָ֖ה יִצְחָֽק׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/4",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַיָּ֤מָל אַבְרָהָם֙ אֶת־יִצְחָ֣ק בְּנ֔וֹ בֶּן־שְׁמֹנַ֖ת יָמִ֑ים כַּאֲשֶׁ֛ר צִוָּ֥ה אֹת֖וֹ אֱלֹהִֽים׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/5",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וְאַבְרָהָ֖ם בֶּן־מְאַ֣ת שָׁנָ֑ה בְּהִוָּ֣לֶד ל֔וֹ אֵ֖ת יִצְחָ֥ק בְּנֽוֹ׃"
              }
            ],
            "instructions": [
              {
                "text": "לוי.",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/6",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַתֹּ֣אמֶר שָׂרָ֔ה צְחֹ֕ק עָ֥שָׂה לִ֖י אֱלֹהִ֑ים כָּל־הַשֹּׁמֵ֖עַ יִֽצְחַק־לִֽי׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/7",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַתֹּ֗אמֶר מִ֤י מִלֵּל֙ לְאַבְרָהָ֔ם הֵינִ֥יקָה בָנִ֖ים שָׂרָ֑ה כִּֽי־יָלַ֥דְתִּי בֵ֖ן לִזְקֻנָֽיו׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/8",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַיִּגְדַּ֥ל הַיֶּ֖לֶד וַיִּגָּמַ֑ל וַיַּ֤עַשׂ אַבְרָהָם֙ מִשְׁתֶּ֣ה גָד֔וֹל בְּי֖וֹם הִגָּמֵ֥ל אֶת־יִצְחָֽק׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/9",
            "fragments": [
              {
                "scan": "s168",
                "printed_page": "73",
                "text": "וַתֵּ֨רֶא שָׂרָ֜ה אֶת־בֶּן־הָגָ֧ר הַמִּצְרִ֛ית אֲשֶׁר־יָלְדָ֥ה"
              },
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "לְאַבְרָהָ֖ם מְצַחֵֽק׃"
              }
            ],
            "instructions": [
              {
                "text": "(בשבת ג.)",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/10",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַתֹּ֨אמֶר֙ לְאַבְרָהָ֔ם גָּרֵ֛שׁ הָאָמָ֥ה הַזֹּ֖את וְאֶת־בְּנָ֑הּ כִּ֣י לֹ֤א יִירַשׁ֙ בֶּן־הָאָמָ֣ה הַזֹּ֔את עִם־בְּנִ֖י עִם־יִצְחָֽק׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/11",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיֵּ֧רַע הַדָּבָ֛ר מְאֹ֖ד בְּעֵינֵ֣י אַבְרָהָ֑ם עַ֖ל אוֹדֹ֥ת בְּנֽוֹ׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/12",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיֹּ֨אמֶר אֱלֹהִ֜ים אֶל־אַבְרָהָ֗ם אַל־יֵרַ֤ע בְּעֵינֶ֙יךָ֙ עַל־הַנַּ֣עַר וְעַל־אֲמָתֶ֔ךָ כֹּל֩ אֲשֶׁ֨ר תֹּאמַ֥ר אֵלֶ֛יךָ שָׂרָ֖ה שְׁמַ֣ע בְּקֹלָ֑הּ כִּ֣י בְיִצְחָ֔ק יִקָּרֵ֥א לְךָ֖ זָֽרַע׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/13",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וְגַ֥ם אֶת־בֶּן־הָאָמָ֖ה לְג֣וֹי אֲשִׂימֶ֑נּוּ כִּֽי־זַרְעֲךָ֖ הֽוּא׃"
              }
            ],
            "instructions": [
              {
                "text": "ג. (בשבת ד.)",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/14",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיַּשְׁכֵּ֨ם אַבְרָהָ֣ם ׀ בַּבֹּ֡קֶר וַיִּֽקַּֽח־לֶ֩חֶם֩ וְחֵ֨מַת מַ֜יִם וַיִּתֵּ֣ן אֶל־הָ֠גָר שָׂ֧ם עַל־שִׁכְמָ֛הּ וְאֶת־הַיֶּ֖לֶד וַֽיְשַׁלְּחֶ֑הָ וַתֵּ֣לֶךְ וַתֵּ֔תַע בְּמִדְבַּ֖ר בְּאֵ֥ר שָֽׁבַע׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/15",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיִּכְל֥וּ הַמַּ֖יִם מִן־הַחֵ֑מֶת וַתַּשְׁלֵ֣ךְ אֶת־הַיֶּ֔לֶד תַּ֖חַת אַחַ֥ד הַשִּׂיחִֽם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/16",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַתֵּ֩לֶךְ֩ וַתֵּ֨שֶׁב לָ֜הּ מִנֶּ֗גֶד הַרְחֵק֙ כִּמְטַחֲוֵ֣י קֶ֔שֶׁת כִּ֣י אָֽמְרָ֔ה אַל־אֶרְאֶ֖ה בְּמ֣וֹת הַיָּ֑לֶד וַתֵּ֣שֶׁב מִנֶּ֔גֶד וַתִּשָּׂ֥א אֶת־קֹלָ֖הּ וַתֵּֽבְךְּ׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/17",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיִּשְׁמַ֣ע אֱלֹהִים֮ אֶת־ק֣וֹל הַנַּ֒עַר֒ וַיִּקְרָא֩ מַלְאַ֨ךְ אֱלֹהִ֤ים ׀ אֶל־הָגָר֙ מִן־הַשָּׁמַ֔יִם וַיֹּ֥אמֶר לָ֖הּ מַה־לָּ֣ךְ הָגָ֑ר אַל־תִּ֣ירְאִ֔י כִּֽי־שָׁמַ֧ע אֱלֹהִ֛ים אֶל־ק֥וֹל הַנַּ֖עַר בַּאֲשֶׁ֥ר הוּא־שָֽׁם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/18",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "ק֚וּמִי שְׂאִ֣י אֶת־הַנַּ֔עַר וְהַחֲזִ֥יקִי אֶת־יָדֵ֖ךְ בּ֑וֹ כִּֽי־לְג֥וֹי גָּד֖וֹל אֲשִׂימֶֽנּוּ׃"
              }
            ],
            "instructions": [
              {
                "text": "(בשבת ה.)",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/19",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיִּפְקַ֤ח אֱלֹהִים֙ אֶת־עֵינֶ֔יהָ וַתֵּ֖רֶא בְּאֵ֣ר מָ֑יִם וַתֵּ֜לֶךְ וַתְּמַלֵּ֤א אֶת־הַחֵ֙מֶת֙ מַ֔יִם וַתַּ֖שְׁקְ אֶת־הַנָּֽעַר׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/20",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיְהִ֧י אֱלֹהִ֛ים אֶת־הַנַּ֖עַר וַיִּגְדָּ֑ל וַיֵּ֙שֶׁב֙ בַּמִּדְבָּ֔ר וַיְהִ֖י רֹבֶ֥ה קַשָּֽׁת׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/21",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַיֵּ֖שֶׁב בְּמִדְבַּ֣ר פָּארָ֑ן וַתִּֽקַּֽח־ל֥וֹ אִמּ֛וֹ אִשָּׁ֖ה מֵאֶ֥רֶץ מִצְרָֽיִם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/22",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וַֽיְהִי֙ בָּעֵ֣ת הַהִ֔וא וַיֹּ֣אמֶר אֲבִימֶ֗לֶךְ וּפִיכֹל֙ שַׂר־צְבָא֔וֹ אֶל־אַבְרָהָ֖ם לֵאמֹ֑ר אֱלֹהִ֣ים עִמְּךָ֔ בְּכֹ֥ל אֲשֶׁר־אַתָּ֖ה עֹשֶֽׂה׃"
              }
            ],
            "instructions": [
              {
                "text": "ד. פ (בשבת ו.)",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/23",
            "fragments": [
              {
                "scan": "s170",
                "printed_page": "74",
                "text": "וְעַתָּ֗ה הִשָּׁ֨בְעָה לִּ֤י בֵֽאלֹהִים֙ הֵ֔נָּה אִם־תִּשְׁקֹ֣ר לִ֔י וּלְנִינִ֖י"
              },
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וּלְנֶכְדִּ֑י כַּחֶ֜סֶד אֲשֶׁר־עָשִׂ֤יתִי עִמְּךָ֙ תַּעֲשֶׂ֣ה עִמָּדִ֔י וְעִם־הָאָ֖רֶץ אֲשֶׁר־גַּ֥רְתָּה בָּֽהּ׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/24",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וַיֹּ֙אמֶר֙ אַבְרָהָ֔ם אָנֹכִ֖י אִשָּׁבֵֽעַ׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/25",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וְהוֹכִ֥חַ אַבְרָהָ֖ם אֶת־אֲבִימֶ֑לֶךְ עַל־אֹדוֹת֙ בְּאֵ֣ר הַמַּ֔יִם אֲשֶׁ֥ר גָּזְל֖וּ עַבְדֵ֥י אֲבִימֶֽלֶךְ׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/26",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וַיֹּ֣אמֶר אֲבִימֶ֔לֶךְ לֹ֣א יָדַ֔עְתִּי מִ֚י עָשָׂ֣ה אֶת־הַדָּבָ֣ר הַזֶּ֑ה וְגַם־אַתָּ֞ה לֹא־הִגַּ֣דְתָּ לִּ֗י וְגַ֧ם אָנֹכִ֛י לֹ֥א שָׁמַ֖עְתִּי בִּלְתִּ֥י הַיּֽוֹם׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/27",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וַיִּקַּ֤ח אַבְרָהָם֙ צֹ֣אן וּבָקָ֔ר וַיִּתֵּ֖ן לַאֲבִימֶ֑לֶךְ וַיִּכְרְת֥וּ שְׁנֵיהֶ֖ם בְּרִֽית׃"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/28",
            "fragments": [
              {
                "scan": "s172",
                "printed_page": "75",
                "text": "וַיַּצֵּ֣ב אַבְרָהָ֗ם אֶת־שֶׁ֛בַע כִּבְשֹׂ֥ת הַצֹּ֖אן לְבַדְּהֶֽן׃"
              }
            ],
            "instructions": [
              {
                "text": "ה. (בשבת ז.)",
                "language": "he",
                "type": "description"
              }
            ],
            "end_reference_before_instructions": true
