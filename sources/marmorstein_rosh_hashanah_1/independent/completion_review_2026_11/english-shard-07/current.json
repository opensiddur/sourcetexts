    {
      "stem": "torah_maftir_numbers_29",
      "urn": "urn:x-opensiddur:text:bible:numbers/29",
      "title": {
        "he": "ובחדש השביעי",
        "en": "Maphtir: Numbers 29:1–6"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/1",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "In the seventh month, on the first day of the month, you shall have a sacred assembly; you may not do any form of work, a day of Teruah shall it be for you."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/2",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "You shall prepare a whole-offering of sweet savour to the Lord, one young bullock, one ram, seven flawless lambs in their first year."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/3",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Their meal-offering shall be of flour mixed with oil, three tenths for the bullock, two tenths for the ram"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/4",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "and one tenth"
              },
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "for each of the seven lambs."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:numbers/29/5",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "And also one he-goat as a sin-offering to atone for you."
              }
