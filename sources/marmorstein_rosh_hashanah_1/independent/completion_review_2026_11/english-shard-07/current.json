{
  "english_witnesses": [
    {
      "stem": "torah_av_harachamim_hu_yerachem",
      "urn": "urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem",
      "title": {
        "he": "אב הרחמים הוא ירחם",
        "en": "The father of mercy"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "The father of mercy will have mercy upon the people borne by Him and remember the covenant with the eternal ones (forefathers) and deliver our souls from evil hours and rebuke the evil inclination from those whom He has lifted up and favour us for eternal refuge and fulfil our prayers with a full measure of salvation and compassion."
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem/text"
          }
        ]
      }
    },
    {
      "stem": "torah_vayaazor",
      "urn": "urn:x-opensiddur:text:prayer:vayaazor",
      "title": {
        "he": "ויעזור",
        "en": "And He will help"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "And He will help, protect and save all who shelter with Him, and let us say: Amen. Let all of you ascribe greatness to our God and honour the Torah, let the Cohen approach. Let there arise . . . Blessed be He, who in His holiness has given the Torah to His people Israel. "
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:vayaazor/text"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "The Torah of the Lord is flawless, refreshing the soul; the testimony of the Lord is faithful, making the simple wise."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/19/8",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/8",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/torat",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "The precepts of the Lord are upright, causing the heart to rejoice, the commandment of the Lord is clear, giving light to the eyes."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/19/9",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/9",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "The Lord gives strength to His people, the Lord blesses His people with peace:"
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/29/11",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/29/11",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/oz",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "God’s way is perfect, the Lord’s word is pure, a shield is He for all who shelter with Him."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/18/31",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/18/31",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/hael",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"
          }
        ]
      }
    },
    {
      "stem": "torah_veattem",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem",
      "title": {
        "he": "ואתם הדבקים",
        "en": "You who adhere"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s167",
                "printed_page": "72",
                "text": "You who adhere to the Lord your God, are all alive this day."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/text",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/4/4",
            "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/4/4",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/veattem/quotations/veattem/4"
          }
        ]
      }
    },
    {
      "stem": "torah_barekhu",
      "urn": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu",
      "title": {
        "he": "ברכו",
        "en": "Bless the Lord"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Bless the Lord who is called blessed."
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/call"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Blessed is the Lord who is called blessed, for ever and ever."
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/barekhu/response",
            "speaker": {
              "label": "The congregation responds:",
              "role": "congregation",
              "language": "en"
            },
            "speaker_before_reference": true
          }
        ]
      }
    },
    {
      "stem": "torah_before_blessing",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing",
      "title": {
        "he": "ברכה לפני קריאת התורה",
        "en": "Torah reading blessing"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Blessed art Thou, O Lord our God, King of the World, who has chosen us from all peoples and given us His Torah. Blessed art Thou, O Lord, giver of the Torah."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing/text",
            "source": "urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar"
          }
        ]
      }
    },
    {
      "stem": "torah_after_blessing",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing",
      "title": {
        "he": "ברכה לאחר קריאת התורה",
        "en": "Torah reading blessing"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Blessed art Thou, O Lord our God, King of the World, who has given us the Torah of truth and implanted in us eternal life. Blessed art Thou, O Lord, giver of the Torah."
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing/text",
            "source": "urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_natan"
          }
        ]
      }
    },
    {
      "stem": "torah_genesis_21",
      "urn": "urn:x-opensiddur:text:bible:genesis/21",
      "title": {
        "he": "וה׳ פקד את שרה",
        "en": "Reading from the First Torah Scroll"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/1",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "The Lord considered Sarah just as He had said and the Lord did for Sarah just as He had spoken."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/2",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "And Sarah conceived and bore a son to Abraham in his old age at the appointed time which God had told him."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/3",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Abraham called the name of his son, who was born to him, whom Sarah had born to him, Isaac."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/4",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Abraham circumcised his son Isaac when he was eight days old just as God had commanded him."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/5",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Abraham was a hundred years old, when his son Isaac was born to him."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/6",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Then Sarah said: ‘God has given me mirth; everyone who hears of it will laugh with me’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/7",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "She said: ‘Who would have foretold to Abraham that Sarah would suckle children; yet have I born him a son in his old age’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/8",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "The child grew and was weaned; and Abraham prepared a great feast on the day Isaac was weaned."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/9",
            "fragments": [
              {
                "scan": "s169",
                "printed_page": "73",
                "text": "Then Sarah saw the son of Hagar the Egyptian"
              },
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "woman, whom she had born to Abraham, scoffing."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/10",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "So she said to Abraham: ‘Drive away this slave-girl and her son, for the son of this slave-girl shall not inherit together with my son, Isaac’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/11",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "And this thing seemed very wrong in Abraham’s eyes because of his son."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/12",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "Then God said to Abraham: ‘Let it not seem wrong in your eyes concerning the lad and your slave-girl. With regard to all that Sarah tells you, listen to her voice, for it is through Isaac that descendants will be called after you."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/13",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "And also the son of the slave-girl will I make a nation because he too is your seed’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/14",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "Then Abraham rose early in the morning and took a loaf of bread and a water-skin and gave them to Hagar, placing them upon her shoulder, as well as the child and sent her away. She went and roamed about in the wilderness of Beersheba."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/15",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "When the water in the skin came to an end she put the child under one of the bushes."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/16",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "Then she went away and sat down at a distance of a bow shot because she thought: ‘Let me not see the child die’. She sat down at a distance and raised her voice and wept."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/17",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "And God heard the lad’s voice and an angel of God called to Hagar from heaven and said to her: ‘What troubles you, Hagar? Do not be afraid. God has heard the lad’s voice from where he is."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/18",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "Rise, lift up the lad and hold him firmly with the hand, for I will make him a great nation’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/19",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "And God opened her eyes and she saw a well of water and she went and filled the skin with water and gave the lad to drink."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/20",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "And God was with the lad and he grew up and lived in the wilderness and became an archer."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/21",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "He lived in the wilderness of Paran and his mother took a wife for him from the land of Egypt."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/22",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "It was at that time that Abimelekh and Pikhol, the general of his army, spoke to Abraham saying: ‘God is with you in everything that you do."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/23",
            "fragments": [
              {
                "scan": "s171",
                "printed_page": "74",
                "text": "So now swear to me here by God that you will not be untrue"
              },
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "to me or to my son or my grandson; according to the kindness that I have shown you, so may you show me kindness as well as the land in which you have resided’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/24",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "And Abraham said: ‘I swear’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/25",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Then Abraham remonstrated with Abimelekh about the well of water which the servants of Abimelekh had stolen."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/26",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Abimelekh said: ‘I do not know who has done this; you did not tell me about it, nor have I heard about it until today’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/27",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Then Abraham took sheep and cattle and gave them to Abimelekh and they both concluded a covenant."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/28",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Abraham set apart seven lambs."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/29",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Then Abimelekh said to Abraham: ‘What is the meaning of these seven lambs which you have set apart?’"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/30",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "He said: ‘Take these seven lambs from my hand so that these may be evidence for me that I dug this well’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/31",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "Therefore that place was called Beersheba because both of them took an oath there."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/32",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "And they concluded a covenant in Beersheba. And Abimelekh arose together with Pikhol, the general of his army and they returned to the land of the Philistines."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/33",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "And Abraham planted a tree in Beersheba and there He called on the Name of the Lord, the God of eternity."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:genesis/21/34",
            "fragments": [
              {
                "scan": "s173",
                "printed_page": "75",
                "text": "And Abraham resided in the land of the Philistines for many days."
              }
            ]
          }
        ]
      },
      "complete_chapters": [
        "urn:x-opensiddur:text:bible:genesis/21"
      ],
      "head": {
        "en": "Reading from the First Torah Scroll"
      },
      "citations": {
        "en": [
          {
            "scan": "s169",
            "text": "Genesis: Chapter 21",
            "reference": "urn:x-opensiddur:text:bible:genesis/21",
            "target": "urn:x-opensiddur:text:bible:genesis/21/1"
          }
        ]
      }
