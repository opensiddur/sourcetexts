{
  "english_witnesses": [
    {
      "stem": "even_chug",
      "urn": "urn:x-opensiddur:text:poem:even_chug",
      "title": {
        "he": "אֶבֶן חוּג",
        "en": "אֶבֶן חוּג"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s131",
                "printed_page": "51",
                "text": "The fortress of heaven, the foundation of the earth, the roaring waves of the deep flood, found their firm foundation through the first born son of the third mother (of our people). She, the root of our people, who lacked children and was today surrounded by her sister’s four sons, shed tears for children; then she heard divine comfort as a mother of children. When the tawny one (Esau) saw that she did not bear children, he hoped to possess her, then was she terrified. Fervently she prayed that his hope would not be fulfilled, that she might be delivered from the arrogant man and not be defiled. The Lord remembered the integrity of her ways, transformed the child in her sister’s womb; she was remembered today, for God recalled her sisterly affection and granted Joseph instead of Dinah. He changed nature as with a potter’s tool, to show the wonders of His strength and might. The Lord noted the plea of the strong (Jacob) and let two tribes emerge from her. As the barren woman of the household she was regarded as a stranger, but in the end a first born stemmed from her. May she protect her children on the day of remembrance, that they may be remembered as she herself was remembered.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/even_chug/part_1"
          }
        ]
      }
    },
    {
      "stem": "repetition_zokhrenu_magen",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/avot/ending",
      "title": {
        "he": "זכרנו — מגן אברהם",
        "en": "זכרנו — מגן אברהם"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s127",
                "printed_page": "49",
                "text": "Remember us for life, O King who delights in life, and inscribe us in the book of life for Thy sake, O living God, O King, helper, saviour and shield. Blessed art Thou, O Lord, shield of Abraham.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/avot/ending/text",
            "source": "urn:x-opensiddur:text:prayer:amidah/avot"
          }
        ]
      }
    },
    {
      "stem": "repetition_attah_gibbor",
