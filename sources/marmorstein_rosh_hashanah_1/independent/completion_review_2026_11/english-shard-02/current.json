    },
    {
      "stem": "attah_hu_eloheinu",
      "urn": "urn:x-opensiddur:text:poem:attah_hu_eloheinu",
      "title": {
        "he": "אַתָּה הוּא אֱלֹהֵינוּ",
        "en": "אַתָּה הוּא אֱלֹהֵינוּ"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "Thou art our God in heaven and on earth.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/1"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "Mighty and awe-inspiring distinguished among myriads.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/2"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "He spoke and it came to pass, He commanded, then were they created.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/3"
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "His memory is forever, He lives in all eternity.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/4"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "Pure is His gaze, He is enthroned in mystery.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/5"
          },
          {
            "paragraph": 6,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "His crown is salvation, His robe is righteousness.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/6"
          },
          {
            "paragraph": 7,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "His cloak is zeal, He is girded with retribution.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/7"
          },
          {
            "paragraph": 8,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "His mystery is equity, His counsel faith.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/8"
          },
          {
            "paragraph": 9,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "His work is truth, He is just and upright.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/9"
          },
          {
            "paragraph": 10,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "He is close to those who call Him in truth, lofty and exalted.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/10"
          },
          {
            "paragraph": 11,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "He resides in the clouds and suspends the earth in space.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/11"
          },
          {
            "paragraph": 12,
            "fragments": [
              {
                "scan": "s133",
                "printed_page": "52",
                "text": "Living, enduring, awe-inspiring, lofty and holy.",
                "page_start": true
              }
            ],
            "reference_unit": "stanza",
            "corresp": "urn:x-opensiddur:text:poem:attah_hu_eloheinu/12"
          }
        ]
      }
    }
