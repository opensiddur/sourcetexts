        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s131",
                "printed_page": "51",
                "text": "The Lord will rule for eternity, your God, O Zion, from generation to generation, Halleluyah.",
                "page_start": true
              }
            ],
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/yimlokh/quotation/146",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/yimlokh/quotation/146/10",
            "source": "urn:x-opensiddur:text:bible:psalms/146/10"
          }
        ]
      }
    },
    {
