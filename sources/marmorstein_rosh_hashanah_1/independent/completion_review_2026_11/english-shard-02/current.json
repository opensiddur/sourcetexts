      "title": {
        "he": "אתה גבור",
        "en": "אתה גבור"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s127",
                "printed_page": "49",
                "text": "Thou art for ever mighty, O Lord, the reviver of the dead, Thou art great to save.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/open/text",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
          }
        ]
      }
    },
    {
      "stem": "repetition_mekhalkel",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel",
      "title": {
        "he": "מכלכל חיים",
        "en": "מכלכל חיים"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s127",
                "printed_page": "49",
                "text": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling, healing the sick and releasing the captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/mekhalkel/text",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
          }
        ]
      }
    },
    {
      "stem": "repetition_mi_khamokha",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/ending",
      "title": {
        "he": "מי כמוך — מחיה המתים",
        "en": "מי כמוך — מחיה המתים"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s131",
                "printed_page": "51",
                "text": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion. And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/gevurot/ending/text",
            "source": "urn:x-opensiddur:text:prayer:amidah/gevurot"
          }
        ]
      }
    },
    {
      "stem": "repetition_yimlokh",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/yimlokh",
