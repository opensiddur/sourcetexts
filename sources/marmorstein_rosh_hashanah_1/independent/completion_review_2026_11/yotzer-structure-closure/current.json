[
  {
    "stem": "yotzer_hameir",
    "urn": "urn:x-opensiddur:text:prayer:yotzer_or/hameir",
    "title": {
      "he": "הַמֵּאִיר",
      "en": "He who lights the earth"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית: ",
              "page_start": false
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "מָה רַבּוּ מַעֲשֶׂיךָ יְיָ. כֻּלָּם בְּחָכְמָה עָשִׂיתָ. מָלְאָה הָאָרֶץ קִנְיָנֶךָ: ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
          "source": "urn:x-opensiddur:text:bible:psalms/104/24",
          "reference_unit": "verse",
          "end_reference": true
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "הַמֶּלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶיךָ הָרַבִּים רַחֵם עָלֵינוּ.",
              "page_start": false
            },
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "אֲדוֹן",
              "page_start": false
            },
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵנוּ מִשְׂגָּב בַּעֲדֵנוּ:",
              "page_start": true
            }
          ]
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "He who lights the earth and those who dwell on it, with mercy and daily in His goodness constantly renews the work of creation. ",
              "page_start": true
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "How numerous are Thy works, O Lord, all of them hast Thou made with wisdom, the earth is full of Thy possessions. ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
          "source": "urn:x-opensiddur:text:bible:psalms/104/24",
          "reference_unit": "verse",
          "end_reference": true
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "O King, who alone is exalted from of old, extolled and praised and glorified since days of antiquity. O God of eternity, in Thy great mercy have mercy upon us,",
              "page_start": false
            },
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "Lord of our might, Rock of our fortress, shield of our salvation, a fortress around us.",
              "page_start": true
            }
          ]
        }
      ]
    },
    "conditions": [
      {
        "type": "opensiddur:holiday-aggregate",
        "features": {
          "shabbat": false
        }
      }
    ]
  },
  {
    "stem": "yotzer_hakol_yodukha",
    "urn": "urn:x-opensiddur:text:prayer:yotzer_or/hakol_yodukha",
    "title": {
      "he": "הַכֹּל יוֹדוּךָ",
      "en": "All thank Thee"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "הַכֹּל יוֹדוּךָ וְהַכֹּל יְשַׁבְּחוּךָ. וְהַכֹּל יֹאמְרוּ אֵין קָדוֹשׁ כַּייָ: הַכֹּל יְרוֹמְמוּךָ סֶּלָה יוֹצֵר הַכֹּל. הָאֵל הַפּוֹתֵחַ בְּכָל־יוֹם דַּלְתוֹת שַׁעֲרֵי מִזְרָח: וּבוֹקֵעַ חַלּוֹנֵי רָקִיעַ. מוֹצִיא חַמָּה מִמְּקוֹמָהּ וּלְבָנָה מִמְּכוֹן שִׁבְתָּהּ: וּמֵאִיר לָעוֹלָם כֻּלּוֹ וּלְיוֹשְׁבָיו. שֶׁבָּרָא בְּמִדַּת רַחֲמִים: הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית: הַמֶּלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶיךָ הָרַבִּים רַחֵם עָלֵינוּ. אֲדוֹן עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵנוּ מִשְׂגָּב בַּעֲדֵנוּ: אֵין כְּעֶרְכֶּךָ וְאֵין זוּלָתֶךָ. אֶפֶס בִּלְתֶּךָ וּמִי דוֹמֶה־לָּךְ: אֵין כְּעֶרְכֶּךָ יְיָ אֱלֹהֵינוּ בָּעוֹלָם הַזֶּה. וְאֵין זוּלָתְךָ מַלְכֵּנוּ לְחַיֵּי הָעוֹלָם הַבָּא: אֶפֶס בִּלְתְּךָ גּוֹאֲלֵנוּ לִימוֹת הַמָּשִׁיחַ. וְאֵין דּוֹמֶה־לְךָ מוֹשִׁיעֵנוּ לִתְחִיַּת הַמֵּתִים:",
              "page_start": false
            }
          ]
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "All thank Thee, all praise Thee, all say: None is holy like the Lord. All exalt Thee, Selah, Creator of all, God who opens daily the portals of the Eastern gates and throws open windows of the firmament, brings forth the sun from its place and the moon from the site of its dwelling. He illuminates the whole world and its inhabitants whom He created through the attribute of mercy. He illuminates the earth and those who dwell on it with mercy, and in His goodness renews daily and constantly the work of creation. O King, who alone is exalted from of old, extolled and praised and glorified since days of antiquity. O God of eternity, in Thy great mercy have mercy upon us, Lord of our might, Rock of our fortress, shield of our salvation, a fortress around us. None can be compared with Thee, there is none except Thee, none beside Thee, and who resembles Thee? None can be compared with Thee, O Lord our God, in this world and there is none except Thee, our King, in the life of the future world. There will be nought besides Thee, our Redeemer, in the days of the anointed one and none resembles Thee, our Helper, at the revival of the dead.",
              "page_start": true
            }
          ]
        }
      ]
    },
    "conditions": [
      {
        "type": "opensiddur:holiday-aggregate",
        "features": {
          "shabbat": true
        }
      }
    ],
    "instructions": [
      {
        "text": "אַם שַׁבָּת.",
        "language": "de-Hebr",
        "witnesses": [
          "he"
        ],
        "placement": "condition"
      },
      {
        "text": "On the Sabbath.",
        "language": "en",
        "witnesses": [
          "en"
        ],
        "placement": "condition"
      }
    ]
  },
  {
    "stem": "el_adon",
    "urn": "urn:x-opensiddur:text:poem:el_adon",
    "title": {
      "he": "אֵל אָדוֹן",
      "en": "God, Lord above all works"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "אֵל אָדוֹן עַל כָּל־הַמַּעֲשִׂים. בָּרוּךְ וּמְבֹרָךְ בְּפִי כָל־נְשָׁמָה: גָּדְלוֹ וְטוּבוֹ מָלֵא עוֹלָם. דַּעַת וּתְבוּנָה סוֹבְבִים אוֹתוֹ: ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/1"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s102",
              "printed_page": "37",
              "text": "הַמִּתְגָּאֶה עַל־חַיּוֹת הַקֹּדֶשׁ. וְנֶהְדָּר בְּכָבוֹד עַל־הַמֶּרְכָּבָה:",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/2"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "זְכוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ. חֶסֶד וְרַחֲמִים לִפְנֵי כְבוֹדוֹ: ",
              "page_start": true
            }
          ],
          "reference_unit": "stanza",
          "conditions": [
            {
              "type": "opensiddur:holiday-aggregate",
              "features": {
                "shabbat": true
              }
            }
          ],
          "condition_instruction": "אַם שַׁבָּת.",
          "condition_instruction_language": "de-Hebr",
          "condition_end_corresp": "urn:x-opensiddur:text:poem:el_adon/6"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "טוֹבִים מְאוֹרוֹת שֶׁבָּרָא אֱלֹהֵינוּ. יְצָרָם בְּדַעַת בְּבִינָה וּבְהַשְׂכֵּל: כֹּחַ וּגְבוּרָה נָתַן בָּהֶם. לִהְיוֹת מוֹשְׁלִים בְּקֶרֶב תֵּבֵל: ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/3"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "מְלֵאִים זִיו וּמְפִיקִים נֹגַהּ. נָאֶה זִיוָם בְּכָל־הָעוֹלָם. שְׂמֵחִים בְּצֵאתָם וְשָׂשִׂים בְּבוֹאָם. עוֹשִׂים בְּאֵימָה רְצוֹן קוֹנָם: ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/4"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "פְּאֵר וְכָבוֹד נוֹתְנִים לִשְׁמוֹ. צָהֳלָה וְרִנָּה לְזֵכֶר מַלְכוּתוֹ: קָרָא לַשֶּׁמֶשׁ וַיִּזְרַח־אוֹר. רָאָה וְהִתְקִין צוּרַת הַלְּבָנָה: ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/5"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "שֶׁבַח נוֹתְנִים לוֹ כָּל־צְבָא מָרוֹם. תִּפְאֶרֶת וּגְדֻלָּה שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּדֶשׁ:",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/6"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "God, Lord above all works, blessed and called blessed by the mouth of every soul, His grandeur and His goodness fill the world, knowledge and understanding surround Him. ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/1"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s103",
              "printed_page": "37",
              "text": "He who is exalted above the holy Hayoth, splendid in glory above the Merkabah, merit and equity are",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/2"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "before His throne, grace and compassion before His glory. ",
              "page_start": true
            }
          ],
          "reference_unit": "stanza",
          "conditions": [
            {
              "type": "opensiddur:holiday-aggregate",
              "features": {
                "shabbat": true
              }
            }
          ],
          "condition_instruction": "On Sabbath.",
          "condition_end_corresp": "urn:x-opensiddur:text:poem:el_adon/6"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "Good are the lights which our God has created, He has formed them with knowledge, reason and understanding. Power and strength has He placed in them that they may reign in the midst of the world. ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/3"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "They are full of lustre and brightly shine, comely is their lustre over the whole world. They rejoice when they go forth and are jubilant when they come in and fulfil in awe the will of their Owner. ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/4"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "Glory and honour do they give to His Name, joy and delight at the mention of His Kingdom. He called to the sun, then light shone forth, He saw and decreed the shape of the moon. ",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/5"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s105",
              "printed_page": "38",
              "text": "Praise does the whole host of heaven bestow on Him, fame and grandeur the Seraphim, Ophanim and holy Hayoth.",
              "page_start": false
            }
          ],
          "reference_unit": "stanza",
          "corresp": "urn:x-opensiddur:text:poem:el_adon/6"
        }
      ]
    },
    "conditions": [
      {
        "type": "opensiddur:holiday-aggregate",
        "features": {
          "shabbat": true
        }
      }
    ]
  },
  {
    "stem": "lael_asher_shavat",
    "urn": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat",
    "title": {
      "he": "לָאֵל אֲשֶׁר שָׁבַת",
      "en": "To the God who rested"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "לָאֵל אֲשֶׁר שָׁבַת מִכָּל־הַמַּעֲשִׂים בַּיּוֹם הַשְּׁבִיעִי הִתְעַלָּה וְיָשַׁב עַל־כִּסֵּא כְבוֹדוֹ. תִּפְאֶרֶת עָטָה לְיוֹם הַמְּנוּחָה עֹנֶג קָרָא לְיוֹם הַשַּׁבָּת: זֶה שֶׁבַח שֶׁל יוֹם הַשְּׁבִיעִי שֶׁבּוֹ שָׁבַת אֵל מִכָּל־מְלַאכְתּוֹ: וְיוֹם הַשְּׁבִיעִי מְשַׁבֵּחַ וְאוֹמֵר ",
              "page_start": false
            }
          ]
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_1",
          "source": "urn:x-opensiddur:text:bible:psalms/92/1",
          "reference_unit": "verse",
          "end_reference": true,
          "source_type": "quotation"
        },
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s104",
              "printed_page": "38",
              "text": "טוֹב לְהוֹדוֹת לַייָ: ",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2",
          "source": "urn:x-opensiddur:text:bible:psalms/92/2/a",
          "reference_unit": "prayer-part",
          "end_reference": true,
          "source_type": "quotation",
          "source_reference": "urn:x-opensiddur:text:bible:psalms/92/2",
          "chapter_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/chapter",
          "source_reference_corresp": "urn:x-opensiddur:text:prayer:yotzer_or/lael_asher_shavat/quoted_psalms_92_2/verse/2",
          "source_reference_part": {
            "unit": "half-verse",
            "n": "a",
