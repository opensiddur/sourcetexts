  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_av_harachamim"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n159.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/text"/>אַב הָרַחֲמִים  <tei:milestone unit="chapter" n="51" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/quotations/psalms_51"/><tei:milestone unit="verse" n="20" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/quotations/psalms_51/20"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/51/20">הֵיטִיבָה בִרְצוֹנְךָ אֶת צִיּוֹן תִּבְנֶה חוֹמוֹת יְרוּשָׁלָֽ͏ִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  כִּי בְךָ לְבַד בָּטָֽחְנוּ מֶֽלֶךְ אֵל רָם וְנִשָּׂא אֲדוֹן עוֹלָמִים: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_av_harachamim"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n160.jpg" n="69"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/text"/>O Father of mercy,  <tei:milestone unit="chapter" n="51" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/quotations/psalms_51"/><tei:milestone unit="verse" n="20" corresp="urn:x-opensiddur:text:prayer:av_harachamim/heitivah/quotations/psalms_51/20"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/51/20">benefit Zion through Thy favour, build up the walls of Jerusalem.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  For in Thee alone do we trust, O King, lofty and exalted God, master of eternity. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_vayehi_binsoa"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg">
        <tei:pb ed="1965" n="70" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg"/>
        <tei:head xml:lang="he">סֵדֶר הוֹצָאַת סֵפֶר הַתּוֹרָה.</tei:head>
        <tei:note type="instruction" xml:lang="en">The Holy Ark is opened and, while the reader takes out two Torah scrolls, the congregation says:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35" n="35"/>וַיְהִי בִּנְסֹעַ הָאָרֹן וַֽיֹּאמֶר מֹשֶׁה קֽוּמָה <j:divineName>יְיָ</j:divineName> וְיָפֻצוּ אֹיְבֶיךָ וְיָנֻסוּ מְשַׂנְאֶיךָ מִפָּנֶיךָ: <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/ki_mitziyyon"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/2/3/b"> כִּי מִצִּיּוֹן תֵּצֵא תוֹרָה וּדְבַר <j:divineName>יְיָ</j:divineName> מִירוּשָׁלָֽ͏ִם:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/barukh"/>בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_vayehi_binsoa"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n162.jpg">
        <tei:pb ed="1965" n="70" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n162.jpg"/>
        <tei:head xml:lang="en">Prayer while the Scrolls of the Torah are taken out of the Ark</tei:head>
        <tei:note type="instruction" xml:lang="en">The Holy Ark is opened and, while the reader takes out two Torah scrolls, the congregation says:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:bible:numbers/10/35" n="35"/>It was when the Holy Ark set out that Moses said: Arise, O Lord, that Thine enemies may be scattered and that those who hate Thee, may flee from Thy countenance. <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/ki_mitziyyon"/><tei:milestone unit="chapter" n="2" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon"/><tei:milestone unit="verse" n="3" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/quotations/ki_mitziyyon/3/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/2/3/b"> From Zion does Torah go forth and the word of the Lord from Jerusalem.</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/vayehi_binsoa/barukh"/>Blessed be He, who in His holiness gave the Torah to His people Israel. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_shelosh_esreh_middot"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg">
        <tei:note type="instruction" xml:lang="he">תפלה משערי ציון לאמר בשעת הוצאת ס״ת.</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n161.jpg" n="70"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6"/><tei:milestone unit="verse-part" n="adonai_adonai" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6/adonai_adonai"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/6/adonai_adonai"><j:divineName>יְהֹוָה</j:divineName> <j:divineName>יְהֹוָה</j:divineName> אֵל רַחוּם וְחַנּוּן אֶרֶךְ אַפַּיִם וְרַב־חֶסֶד וֶאֱמֶת:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7"/><tei:milestone unit="verse-part" n="notzer_chesed" 
corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7/notzer_chesed"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/7/notzer_chesed">נֹצֵר חֶסֶד לָאֲלָפִים נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה </tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7"/><tei:milestone unit="verse-part" n="venakeh" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7/venakeh"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/7/venakeh">וְנַקֵּה:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/><tei:note type="instruction" xml:lang="he"><tei:ref target="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/text@prayerbook_for_the_new_year-heidenheim-1965-he">ג״פ.</tei:ref></tei:note></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_shelosh_esreh_middot"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n162.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n162.jpg" n="70"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6"/><tei:milestone unit="verse-part" n="adonai_adonai" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/adonai/6/adonai_adonai"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/6/adonai_adonai">The Lord, the Lord is a merciful and gracious God, slow to anger and great in kindness and truth;</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7"/><tei:milestone unit="verse-part" n="notzer_chesed" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/notzer/7/notzer_chesed"/><tei:seg 
source="urn:x-opensiddur:text:bible:exodus/34/7/notzer_chesed">He preserves kindness to the thousandth generation, forgives guilt, transgression and sin, </tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh"/><tei:milestone unit="verse" n="7" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7"/><tei:milestone unit="verse-part" n="venakeh" corresp="urn:x-opensiddur:text:prayer:shelosh_esreh_middot/torah_opening/quotations/venakeh/7/venakeh"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/34/7/venakeh">and purifies.</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_gaddelu"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:note type="description" xml:lang="en">The reader, holding the scroll of the Torah in front of him, says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/gaddelu/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/34/4">גַּדְּלוּ לַ<j:divineName>ייָ</j:divineName> אִתִּי. וּנְרוֹמְמָה שְׁמוֹ יַחְדָּו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_gaddelu"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:note type="description" xml:lang="en">The reader, holding the scroll of the Torah in front of him, says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/gaddelu/text"/><tei:milestone unit="chapter" n="34" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu"/><tei:milestone unit="verse" n="4" corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/gaddelu/quotations/gaddelu/4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/34/4">Magnify the Lord with me, and let us exalt His Name together.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_al_hakol"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hakol" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg">
        <tei:note type="description" xml:lang="en">While the reader carries a Torah scroll to the reading desk, the congregation says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n163.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:al_hakol/opening"/>עַל הַכֹּל יִתְגַּדַּל וְיִתְקַדַּשׁ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא: שְׁמוֹ שֶׁל־מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא: בָּעוֹלָמוֹת שֶׁבָּרָא הָעוֹלָם הַזֶּה וְהָעוֹלָם הַבָּא: כִּרְצוֹנוֹ וְכִרְצוֹן יְרֵאָיו וְכִרְצוֹן כָּל־בֵּית יִשְׂרָאֵל: צוּר <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/>הָעוֹלָמִים אֲדוֹן כָּל־הַבְּרִיּוֹת אֱלוֹהַּ כָּל־הַנְּפָשׁוֹת: הַיּוֹשֵׁב בְּמֶרְחֲבֵי מָרוֹם הַשּׁוֹכֵן בִּשְׁמֵי שְׁמֵי קֶדֶם: קְדֻשָּׁתוֹ עַל הַחַיּוֹת וּקְדֻשָּׁתוֹ עַל כִּסֵּא הַכָּבוֹד: וּבְכֵן יִתְקַדַּשׁ שִׁמְךָ בָּנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ לְעֵינֵי כָּל־חָי: וְנֹאמַר לְפָנָיו שִׁיר חָדָשׁ כַּכָּתוּב:  <tei:milestone unit="chapter" n="68" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/68/5">שִׁירוּ לֵאלֹהִים זַמְּרוּ שְׁמוֹ סֹלּוּ לָרוֹכֵב בָּעֲרָבוֹת בְּיָהּ שְׁמוֹ וְעִלְזוּ 
לְפָנָיו:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  וְנִרְאֵהוּ עַיִן בְּעַיִן בְּשׁוּבוֹ אֶל נָוֵהוּ כַּכָּתוּב:  <tei:milestone unit="chapter" n="52" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/52/8/b">כִּי עַיִן בְּעַיִן יִרְאוּ בְּשׁוּב <j:divineName>יְיָ</j:divineName> צִיּוֹן:</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  וְנֶאֱמַר  <tei:milestone unit="chapter" n="40" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah/5"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/40/5">וְנִגְלָה כְּבוֹד <j:divineName>יְיָ</j:divineName> וְרָאוּ כָל־בָּשָׂר יַחְדָּו כִּי פִּי <j:divineName>יְיָ</j:divineName> דִּבֵּר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_al_hakol"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:al_hakol" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg">
        <tei:note type="description" xml:lang="en">While the reader carries a Torah scroll to the reading desk, the congregation says:</tei:note>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n164.jpg" n="71"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:al_hakol/opening"/>Above all things let there be magnified, sanctified, praised, glorified, exalted and elevated the Name of the King of all kings, the Holy One, blessed be He, in the worlds that He created in this and the future world, according to His will and the will of those who fear Him and the will of the whole house of Israel. Rock of eternity, Lord of all creatures, God <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg" n="72"/>of all souls, who dwells in the infinite heights, and resides in the primaeval heavens, His holiness is above the Hayoth, His holiness is above the glorious throne. And thus may Thy Name be sanctified among us, O Lord our God, before the eyes of all the living; and let us sing before Him a new song, as it is written: ‘<tei:milestone unit="chapter" n="68" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/shiru/5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/68/5">Sing to God, sing praise of His Name. Exalt Him who rides 
upon the clouds, Yah is His Name, and rejoice before Him.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  We shall see Him eye to eye when He returns to His dwelling as it is written:  <tei:milestone unit="chapter" n="52" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8"/><tei:milestone unit="half-verse" n="b" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/ayin/8/b"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/52/8/b">eye to eye shall they behold when the Lord returns to Zion.</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  And it was said: ‘<tei:milestone unit="chapter" n="40" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah"/><tei:milestone unit="verse" n="5" corresp="urn:x-opensiddur:text:prayer:al_hakol/quotations/veniglah/5"/><tei:seg source="urn:x-opensiddur:text:bible:isaiah/40/5">And the glory of the Lord shall be revealed and all flesh together shall see, for the mouth of the Lord has spoken</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>’. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_av_harachamim_hu_yerachem"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem/text"/>אַב הָרַחֲמִים הוּא יְרַחֵם עַם עֲמוּסִים וְיִזְכּוֹר בְּרִית אֵתָנִים וְיַצִּיל נַפְשׁוֹתֵינוּ מִן הַשָּׁעוֹת הָרָעוֹת וְיִגְעַר בְּיֵצֶר הָרַע מִן הַנְּשׂוּאִים וְיָחֹן אוֹתָנוּ לִפְלֵיטַת עוֹלָמִים וִימַלֵּא מִשְׁאֲלוֹתֵינוּ בְּמִדָּה טוֹבָה יְשׁוּעָה וְרַחֲמִים: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_av_harachamim_hu_yerachem"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:av_harachamim/hu_yerachem/text"/>The father of mercy will have mercy upon the people borne by Him and remember the covenant with the eternal ones (forefathers) and deliver our souls from evil hours and rebuke the evil inclination from those whom He has lifted up and favour us for eternal refuge and fulfil our prayers with a full measure of salvation and compassion. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_vayaazor"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n165.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:vayaazor/text"/>וְיַעֲזוֹר וְיָגֵן וְיוֹשִׁיעַ לְכָל הַחוֹסִים בּוֹ וְנֹאמַר אָמֵן: הַכֹּל הָבוּ גֹדֶל לֵאלֹהֵינוּ וּתְנוּ כָבוֹד לַתּוֹרָה כֹּהֵן קְרָב. יַעֲמוֹד  <tei:note type="instruction" xml:lang="he">(פלוני בר פלוני הכהן)</tei:note>: בָּרוּךְ שֶׁנָּתַן תּוֹרָה לְעַמּוֹ יִשְׂרָאֵל בִּקְדֻשָּׁתוֹ:  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">תּוֹרַת <j:divineName>יְיָ</j:divineName> תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת <j:divineName>יְיָ</j:divineName> נֶאֱמָנָה מַחְכִּימַת פֶּתִי:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">פִּקּוּדֵי <j:divineName>יְיָ</j:divineName> יְשָׁרִים מְשַׂמְּחֵי לֵב מִצְוַת <j:divineName>יְיָ</j:divineName> בָּרָה
 מְאִירַת עֵינָיִם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְיָ</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְיָ</j:divineName> יְבָרֵךְ אֶת עַמּוֹ בַשָּׁלוֹם:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="18" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael"/><tei:milestone unit="verse" n="31" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/18/31">הָאֵל תָּמִים דַּרְכּוֹ אִמְרַת <j:divineName>יְיָ</j:divineName> צְרוּפָה מָגֵן הוּא לְכֹל הַחֹסִים בּוֹ:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_vayaazor"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:vayaazor" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n166.jpg" n="72"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:vayaazor/text"/>And He will help, protect and save all who shelter with Him, and let us say: Amen. Let all of you ascribe greatness to our God and honour the Torah, let the Cohen approach. Let there arise . . . Blessed be He, who in His holiness has given the Torah to His people Israel.  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat"/><tei:milestone unit="verse" n="8" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/torat/8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/8">The Torah of the Lord is flawless, refreshing the soul; the testimony of the Lord is faithful, making the simple wise.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei"/><tei:milestone unit="verse" n="9" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/piqqudei/9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/9">The precepts of the Lord are upright, causing the heart to rejoice, the commandment of the Lord is clear, giving light to the eyes.</tei:seg><tei:milestone 
unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz"/><tei:milestone unit="verse" n="11" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/oz/11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11">The Lord gives strength to His people, the Lord blesses His people with peace:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>   <tei:milestone unit="chapter" n="18" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael"/><tei:milestone unit="verse" n="31" corresp="urn:x-opensiddur:text:prayer:vayaazor/quotations/hael/31"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/18/31">God’s way is perfect, the Lord’s word is pure, a shield is He for all who shelter with Him.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_before_blessing"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing/text"/><tei:seg source="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar">בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName>, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר בָּחַר־בָּנוּ מִכָּל־הָעַמִּים, וְנָתַן־לָנוּ אֶת־תּוֹרָתוֹ. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName>, נוֹתֵן הַתּוֹרָה:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_before_blessing"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/before_blessing/text"/><tei:seg source="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_bachar">Blessed art Thou, O Lord our God, King of the World, who has chosen us from all peoples and given us His Torah. Blessed art Thou, O Lord, giver of the Torah.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_after_blessing"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n167.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing/text"/><tei:seg source="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_natan">בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName>, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר נָתַן־לָנוּ תּוֹרַת אֱמֶת, וְחַיֵּי עוֹלָם נָטַע בְּתוֹכֵנוּ. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName>, נוֹתֵן הַתּוֹרָה:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_after_blessing"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg">
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n168.jpg" n="73"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/after_blessing/text"/><tei:seg source="urn:x-opensiddur:text:prayer:birkhot_hatorah/asher_natan">Blessed art Thou, O Lord our God, King of the World, who has given us the Torah of truth and implanted in us eternal life. Blessed art Thou, O Lord, giver of the Torah.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
