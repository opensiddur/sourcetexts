          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s127",
                "printed_page": "49",
                "text": " I appease Him, and with bent knee, in the shelter of friends, will I sound in His garden (the Sanctuary) the shattering tone.",
                "page_start": true
