            "paragraph": 1,
            "fragments": [
              {
                "scan": "s124",
                "printed_page": "48",
                "text": "אֶת חִיל יוֹם פְּקוּדָה. בְּאֵימוֹ כָּל לֶחֶם לְשָׁקְדָה. גִּשְׁתָּם בְּבֶרֶךְ קְדוּדָה. דַּעַם לְטַהֵר כְּעַל מוֹקְדָה: הַיּוֹצֵר יַחַד כָּל נִשְׁפָּט. וְשׁוֹעַ וְדַל בְּפֶלֶס נִשְׁפָּט. זָכַר לֹא יַעֲשֶׂה מִשְׁפָּט. חִנּוּי עֶתֶר יוּצַג בְּמִשְׁפָּט: טֶרֶם כָּל מִפְעָל חָצַב. יוֹם מֵאֶמֶשׁ צוּר הֻצַּב. בְּאֵחוּד וְקוֹדֶם כְּתוֹךְ",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/repetition/et_chil_yom_pequddah/part_1",
