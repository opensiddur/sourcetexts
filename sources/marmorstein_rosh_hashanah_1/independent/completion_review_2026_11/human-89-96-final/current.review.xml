  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/shacharit_amidah_qedushat_hayom.xml"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="#malkeinu_alternative">
      <tei:p>הערת המהדיר: מלכנו — תוספת בסוגריים במקור; תנאי אמירתה אינו מצוין.</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n117.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/attah_vechartanu"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/attah_vechartanu_mikol">אַתָּה בְחַרְתָּֽנוּ מִכָּל הָעַמִּים. אָהַבְתָּ אוֹתָֽנוּ וְרָצִיתָ בָּֽנוּ. וְרוֹמַמְתָּֽנוּ מִכָּל הַלְּשׁוֹנוֹת. וְקִדַּשְׁתָּֽנוּ בְּמִצְוֹתֶיךָ. וְקֵרַבְתָּֽנוּ מַלְכֵּנוּ לַעֲבוֹדָתֶךָ. וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עָלֵֽינוּ קָרָֽאתָ:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/vattitten_lanu"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">וַתִּתֶּן־לָֽנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בְּאַהֲבָה אֶת־יוֹם</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">הַשַּׁבָּת הַזֶּה וְאֶת יוֹם</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_2"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">הַזִּכָּרוֹן הַזֶּה. יוֹם</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_4"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">זִכְרוֹן</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_4"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">תְּרוּעָה</tei:seg> <j:conditional type="marked" 
xml:id="shacharit_amidah_qedushat_hayom_segment_6"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">בְּאַהֲבָה</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_6"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">מִקְרָא קֹדֶשׁ זֵכֶר לִיצִיאַת מִצְרָֽיִם:</tei:seg> </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n119.jpg" n="46"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/yaaleh_veyavo"/><tei:seg source="urn:x-opensiddur:text:prayer:yaaleh_veyavo">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ. יַעֲלֶה וְיָבֹא וְיַגִּיעַ וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע וְיִפָּקֵד וְיִזָּכֵר זִכְרֹנֵֽנוּ וּפִקְדֹּנֵֽנוּ וְזִכְרוֹן אֲבוֹתֵינוּ. וְזִכְרוֹן מָשִׁיחַ בֶּן־דָּוִד עַבְדֶּךָ. וְזִכְרוֹן יְרוּשָׁלַיִם עִיר קָדְשֶׁךָ. וְזִכְרוֹן כָּל־עַמְּךָ בֵּית יִשְׂרָאֵל לְפָנֶיךָ. לִפְלֵטָה וּלְטוֹבָה וּלְחֵן וּלְחֶסֶד וּלְרַחֲמִים וּלְחַיִּים וּלְשָׁלוֹם בְּיוֹם הַזִּכָּרוֹן הַזֶּה. זָכְרֵנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בּוֹ לְטוֹבָה וּפָקְדֵנוּ בוֹ לִבְרָכָה וְהוֹשִׁיעֵנוּ בוֹ לְחַיִּים. וּבִדְבַר יְשׁוּעָה וְרַחֲמִים. חוּס וְחָנֵּנוּ. וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵנוּ. כִּי אֵלֶיךָ עֵינֵֽינוּ. כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/melokh"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ. מְלוֹךְ עַל כָּל־הָעוֹלָם כֻּלּוֹ בִּכְבוֹדֶךָ וְהִנָּשֵׂא עַל כָּל־הָאָרֶץ בִּיקָרֶךָ וְהוֹפַע בַּהֲדַר גְּאוֹן עֻזֶּךָ עַל כָּל־יוֹשְׁבֵי תֵבֵל אַרְצֶךָ. וְיֵדַע כָּל־פָּעוּל כִּי אַתָּה פְעַלְתּוֹ וְיָבִין כָּל־יָצוּר כִּי אַתָּה יְצַרְתּוֹ וְיֹאמַר כֹּל אֲשֶׁר נְשָׁמָה בְּאַפּוֹ <j:divineName>יְיָ</j:divineName> אֱלֹהֵי יִשְׂרָאֵל מֶלֶךְ וּמַלְכוּתוֹ בַּכֹּל מָשָׁלָה:</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_10"><tei:note type="instruction" xml:lang="he">אַם שַׁבָּת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ רְצֵה בִמְנוּחָתֵנוּ</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_10"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ שַׂבְּעֵנוּ מִטּוּבֶךָ וְשַׂמְּחֵנוּ בִּישׁוּעָתֶךָ.</tei:seg> <j:conditional type="marked" 
xml:id="shacharit_amidah_qedushat_hayom_segment_12"><tei:note type="instruction" xml:lang="he">אַם שַׁבָּת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">וְהַנְחִילֵנוּ <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ בְּאַהֲבָה וּבְרָצוֹן שַׁבַּת קָדְשֶׁךָ וְיָנוּחוּ בָהּ יִשְׂרָאֵל מְקַדְּשֵׁי שְׁמֶךָ.</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_12"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">וְטַהֵר לִבֵּנוּ לְעָבְדְּךָ בֶּאֱמֶת כִּי אַתָּה אֱלֹהִים אֱמֶת וּדְבָרְךָ</tei:seg> <tei:anchor xml:id="malkeinu_alternative"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">(מלכנו)</tei:seg> <tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">אֱמֶת וְקַיָּם לָעַד. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> מֶלֶךְ עַל כָּל־הָאָרֶץ מְקַדֵּשׁ</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_16"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">הַשַּׁבָּת וְ</tei:seg><j:endConditional 
target="#shacharit_amidah_qedushat_hayom_segment_16"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">יִשְׂרָאֵל וְיוֹם הַזִּכָּרוֹן:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/shacharit_amidah_qedushat_hayom.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n118.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/attah_vechartanu"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/attah_vechartanu_mikol">Thou hast chosen us from all peoples, loved us and found delight in us and exalted us above all tongues and sanctified us through Thy commandments, and brought us near, O our King, to Thy service and proclaimed Thy great and holy Name unto us.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/vattitten_lanu"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">Thou hast given us, O Lord our God, in love this day</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_2"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">of the Sabbath and this day</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_2"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">of remembrance, a day</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_4"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">of remembrance</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_4"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">of Teruah</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_6"><j:all><tei:fs 
type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">in love</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_6"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem">for a sacred convocation, a reminder of the exodus from Egypt.</tei:seg> </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n120.jpg" n="46"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/yaaleh_veyavo"/><tei:seg source="urn:x-opensiddur:text:prayer:yaaleh_veyavo">Our God and God of our fathers, may there rise and come and arrive and appear and be favourably received and be heard and considered and remain in memory before Thee, our remembrance and our consideration and the memory of our fathers and the memory of the anointed, the son of David, Thy servant, and the memory of Jerusalem the Holy City, and the memory of all Thy people, the House of Israel, for deliverance and for happiness, for favour and for grace and for compassion, for life and for peace on this Day of Remembrance. Remember us, O Lord our God, on it for happiness, consider us on it for blessing and help us on it unto life, and through the word of salvation and compassion, spare us and be gracious unto us have compassion upon us, and help us, for towards Thee our eyes are turned, for Thou O God, art a gracious and merciful King.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/melokh"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Our God and God of our fathers, reign over the whole world in Thy glory and rise above the whole earth in Thy grandeur. Shine forth in the exalted beauty of Thy might upon all the inhabitants of the territory of Thine earth so that every creature may recognize that Thou hast created it and that every form may understand that Thou hast formed it and all with breath in the nostrils may say: The Lord, the God of Israel, is King and His Kingdom rules over all.</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_10"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Our God and God of our fathers, take pleasure in our rest.</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_10"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Sanctify us through Thy commandments and grant our portion in Thy Torah, satisfy us with Thy goodness and gladden us with Thy help</tei:seg> <j:conditional type="marked" 
xml:id="shacharit_amidah_qedushat_hayom_segment_12"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">and grant us, O Lord our God, in love and favour, Thy holy Sabbath as a portion so that Israel, who sanctifies Thy Name, may rest on it</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_12"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">and purify our heart to serve Thee in truth for Thou, O Lord, art truth and Thy word is truth and endures for ever. Blessed art Thou, O Lord King over the whole earth, who sanctifies</tei:seg> <j:conditional type="marked" xml:id="shacharit_amidah_qedushat_hayom_segment_14"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">the Sabbath and</tei:seg> <j:endConditional target="#shacharit_amidah_qedushat_hayom_segment_14"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam">Israel and the Day of Remembrance.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/shacharit_amidah_avodah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n119.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah/retzeh"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh">רְצֵה <j:divineName>יְיָ</j:divineName> אֱלֹהֵֽינוּ בְּעַמְּךָ יִשְׂרָאֵל וּבִתְפִלָּתָם. וְהָשֵׁב אֶת הָעֲבוֹדָה לִדְבִיר בֵּיתֶךָ וְאִשֵּׁי יִשְׂרָאֵל וּתְפִלָּתָם בְּאַהֲבָה תְקַבֵּל בְּרָצוֹן וּתְהִי לְרָצוֹן תָּמִיד עֲבוֹדַת יִשְׂרָאֵל עַמֶּךָ.</tei:seg> </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n121.jpg" n="47"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah/vetechezeinah"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah">וְתֶחֱזֶינָה עֵינֵֽינוּ בְּשׁוּבְךָ לְצִיּוֹן בְּרַחֲמִים. בָּרוּךְ אַתָּה <j:divineName>יְיָ</j:divineName> הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/shacharit_amidah_avodah.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n120.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah/retzeh"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh">Take delight, O Lord our God, in Thy people Israel and in their prayer and restore the service to the sanctuary of Thy House and accept with love and favour the fire offerings of Israel and their prayer, and may the service of Thy people Israel be a perpetual delight.</tei:seg> </tei:p>
        <tei:p><tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n122.jpg" n="47"/><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/avodah/vetechezeinah"/><tei:seg source="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah">And may our eyes behold when Thou returnest to Zion in compassion. Blessed art Thou, O Lord, who restores His majesty to Zion.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
