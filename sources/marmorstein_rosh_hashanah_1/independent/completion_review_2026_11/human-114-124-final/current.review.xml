  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n109.jpg">
        <tei:p><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/4">שְׁמַ֖<tei:c rend="large">ע</tei:c> יִשְׂרָאֵ֑ל <j:divineName>יְהוָ֥ה</j:divineName> אֱלֹהֵ֖ינוּ <j:divineName>יְהוָ֥ה</j:divineName> ׀ אֶחָֽ<tei:c rend="large">ד</tei:c>:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
