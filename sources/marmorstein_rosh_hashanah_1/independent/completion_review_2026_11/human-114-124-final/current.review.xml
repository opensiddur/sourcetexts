      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n110.jpg">
        <tei:p><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/4">Hear, O Israel, the Lord is our God, the Lord is One.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n109.jpg">
        <tei:note type="description" xml:lang="he">בלחש</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem/text"/><tei:seg source="urn:x-opensiddur:text:prayer:shema/barukh_shem">בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n110.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem/text"/><tei:seg source="urn:x-opensiddur:text:prayer:shema/barukh_shem">Blessed be His glorious royal Name for ever and ever.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n109.jpg">
        <tei:p><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/5">וְאָ֣הַבְתָּ֔ אֵ֖ת <j:divineName>יְהוָ֣ה</j:divineName> אֱלֹהֶ֑יךָ בְּכָל־לְבָבְךָ֥ וּבְכָל־נַפְשְׁךָ֖ וּבְכָל־מְאֹדֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/6">וְהָי֞וּ הַדְּבָרִ֣ים הָאֵ֗לֶּה אֲשֶׁ֨ר אָנֹכִ֧י מְצַוְּךָ֛ הַיּ֖וֹם עַל־לְבָבֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/7">וְשִׁנַּנְתָּ֣ם לְבָנֶ֔יךָ וְדִבַּרְתָּ֖ בָּ֑ם בְּשִׁבְתְּךָ֤ בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/8">וּקְשַׁרְתָּ֥ם לְא֖וֹת עַל־יָדֶ֑ךָ וְהָי֥וּ לְטֹטָפֹ֖ת בֵּ֥ין עֵינֶֽיךָ:</tei:seg> <tei:milestone unit="verse" 
corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/9">וּכְתַבְתָּ֛ם עַל־מְזֻז֥וֹת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n110.jpg">
        <tei:p><tei:milestone unit="chapter" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/5">You shall love the Lord your God with all your heart and with all your soul and with all your possession.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/6">These words which I command you this day, shall be upon your heart.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/7">You shall inculcate them in your children and speak of them when you sit in your house and when you walk on the way, when you lie down and when you rise up.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/8">You shall bind them for a sign upon your arm and they shall be frontlets between your eyes.</tei:seg> <tei:milestone unit="verse" 
corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/6/9">You shall write them upon the doorposts of your house and upon your gates.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:deuteronomy/11/13">דברים יא יג</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n109.jpg">
        <tei:p><tei:milestone unit="chapter" n="11" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/13" n="13"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/13">וְהָיָ֗ה אִם־שָׁמֹ֤עַ תִּשְׁמְעוּ֙ אֶל־מִצְוֹתַ֔י אֲשֶׁ֧ר אָנֹכִ֛י מְצַוֶּ֥ה אֶתְכֶ֖ם הַיּ֑וֹם לְאַהֲבָ֞ה אֶת־<j:divineName>יְהוָ֤ה</j:divineName> אֱלֹֽהֵיכֶם֙ וּלְעָבְד֔וֹ בְּכָל־לְבַבְכֶ֖ם וּבְכָל־נַפְשְׁכֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/14" n="14"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/14">וְנָֽתַתִּ֧י מְטַֽר־אַרְצְכֶ֛ם בְּעִתּ֖וֹ יוֹרֶ֣ה וּמַלְק֑וֹשׁ וְאָֽסַפְתָּ֣ דְגָנֶ֔ךָ וְתִירֹשְׁךָ֖ וְיִצְהָרֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/15" n="15"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/15">וְנָֽתַתִּ֛י עֵ֥שֶׂב</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n111.jpg" n="42"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/15">בְּשָׂדְךָ֖ לִבְהֶמְתֶּ֑ךָ וְאָֽכַלְתָּ֖ וְשָׂבָֽעְתָּ:</tei:seg> <tei:milestone 
unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/16" n="16"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/16">הִשָּׁמְר֣וּ לָכֶ֔ם פֶּן־יִפְתֶּ֖ה לְבַבְכֶ֑ם וְסַרְתֶּ֗ם וַעֲבַדְתֶּם֙ אֱלֹהִ֣ים אֲחֵרִ֔ים וְהִשְׁתַּחֲוִיתֶ֖ם לָהֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/17">וְחָרָ֨ה אַף־<j:divineName>יְהוָ֜ה</j:divineName> בָּכֶ֗ם וְעָצַ֤ר אֶת־הַשָּׁמַ֙יִם֙ וְלֹא־יִהְיֶ֣ה מָטָ֔ר וְהָ֣אֲדָמָ֔ה לֹ֥א תִתֵּ֖ן אֶת־יְבוּלָ֑הּ וַאֲבַדְתֶּ֣ם מְהֵרָ֗ה מֵעַל֙ הָאָ֣רֶץ הַטֹּבָ֔ה אֲשֶׁ֥ר <j:divineName>יְהוָ֖ה</j:divineName> נֹתֵ֥ן לָכֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/18" n="18"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/18">וְשַׂמְתֶּם֙ אֶת־דְּבָרַ֣י אֵ֔לֶּה עַל־לְבַבְכֶ֖ם וְעַל־נַפְשְׁכֶ֑ם וּקְשַׁרְתֶּ֨ם אֹתָ֤ם לְאוֹת֙ עַל־יֶדְכֶ֔ם וְהָי֥וּ לְטוֹטָפֹ֖ת בֵּ֥ין עֵינֵיכֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/19" n="19"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/19">וְלִמַּדְתֶּ֥ם אֹתָ֛ם אֶת־בְּנֵיכֶ֖ם לְדַבֵּ֣ר בָּ֑ם בְּשִׁבְתְּךָ֤ 
בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/20" n="20"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/20">וּכְתַבְתָּ֛ם עַל־מְזוּז֥וֹת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/21" n="21"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/21">לְמַ֨עַן יִרְבּ֤וּ יְמֵיכֶם֙ וִימֵ֣י בְנֵיכֶ֔ם עַ֚ל־הָֽאֲדָמָ֔ה אֲשֶׁ֨ר נִשְׁבַּ֧ע <j:divineName>יְהוָ֛ה</j:divineName> לַאֲבֹתֵיכֶ֖ם לָתֵ֣ת לָהֶ֑ם כִּימֵ֥י הַשָּׁמַ֖יִם עַל־הָאָֽרֶץ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:deuteronomy/11/13">Deut. XI. 13</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n110.jpg">
        <tei:p><tei:milestone unit="chapter" n="11" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/13" n="13"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/13">And it shall happen if you listen carefully to My commandments which I command you today, to love the Lord your God and to serve Him with all your heart and with all your soul,</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/14" n="14"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/14">that I will grant the rain of your land in its season, the former rain and the latter rain, so that you will gather in your corn, your wine and your oil.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/15" n="15"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/15">I will give</tei:seg> <tei:pb ed="1965" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n112.jpg" n="42"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/15">grass to your field for your cattle, and you shall eat and be satisfied.</tei:seg> 
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/16" n="16"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/16">Take care that your heart be not deceived and that you do not turn aside and serve strange gods and bow down before them.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/17">For then the wrath of the Lord will burn against you and He will close the heavens so that no rain shall fall and the earth shall not yield its produce, and you shall soon perish from the good land that the Lord is giving you.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/18" n="18"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/18">Lay these words of mine upon your heart and upon your soul, bind them as a sign upon your arm and let them be frontlets between your eyes.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/19" n="19"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/19">Teach them to your children by talking about them when you sit in your house and walk on the way and 
when you lie down and when you rise up.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/20" n="20"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/20">You shall write them upon the doorposts of your house and upon your gates,</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/21" n="21"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/11/21">so that your days and the days of your children may increase upon the soil which the Lord has sworn to your fathers to give to them, as the days of the heavens above the earth.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:numbers/15/37">במדבר טו לז</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n111.jpg">
        <tei:p><tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/37" n="37"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/37">וַיֹּ֥אמֶר <j:divineName>יְהוָ֖ה</j:divineName> אֶל־מֹשֶׁ֥ה לֵּאמֹֽר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/38" n="38"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/38">דַּבֵּ֞ר אֶל־בְּנֵ֤י יִשְׂרָאֵל֙ וְאָֽמַרְתָּ֣ אֲלֵהֶ֔ם וְעָשׂ֨וּ לָהֶ֥ם צִיצִ֛ת עַל־כַּנְפֵ֥י בִגְדֵיהֶ֖ם לְדֹרֹתָ֑ם וְנָ֥תְנוּ עַל־צִיצִ֥ת הַכָּנָ֖ף פְּתִ֥יל תְּכֵֽלֶת:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/39" n="39"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/39">וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֹ֣ת <j:divineName>יְהוָ֔ה</j:divineName> וַעֲשִׂיתֶ֖ם אֹתָ֑ם וְלֹא תָת֜וּרוּ אַחֲרֵ֤י לְבַבְכֶם֙ וְאַחֲרֵ֣י עֵינֵיכֶ֔ם אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַחֲרֵיהֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/40" n="40"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/40">לְמַ֣עַן 
תִּזְכְּר֔וּ וַעֲשִׂיתֶ֖ם אֶת־כָּל־מִצְוֹתָ֑י וִהְיִיתֶ֥ם קְדֹשִׁ֖ים לֵאלֹֽהֵיכֶֽם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/41" n="41"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/41">אֲנִ֞י <j:divineName>יְהוָ֣ה</j:divineName> אֱלֹֽהֵיכֶ֗ם אֲשֶׁ֨ר הוֹצֵ֤אתִי אֶתְכֶם֙ מֵאֶ֣רֶץ מִצְרַ֔יִם לִהְי֥וֹת לָכֶ֖ם לֵאלֹהִ֑ים אֲנִ֖י <j:divineName>יְהוָ֥ה</j:divineName> אֱלֹהֵיכֶֽם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:numbers/15/37">Numbers XV. 37</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n112.jpg">
        <tei:p><tei:milestone unit="chapter" n="15" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/37" n="37"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/37">Thus spoke the Lord to Moses:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/38" n="38"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/38">Speak to the children of Israel and tell them to make themselves show-fringes upon the corners of their garments throughout their generations and to fasten to the fringe of each corner a thread of skyblue wool.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/39" n="39"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/39">They shall be show-fringes to you so that when you look upon them, you will remember all the commandments of the Lord and fulfil them. And do not follow your heart and your eyes after which you go <tei:choice><tei:sic>astray</tei:sic><tei:corr>astray.</tei:corr></tei:choice></tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/40" n="40"/><tei:seg 
source="urn:x-opensiddur:text:bible:numbers/15/40">Thus may you remember and fulfil all my commandments and be holy unto your God.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/41" n="41"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/15/41">I am the Lord your God who led you out of the land of Egypt in order to be your God. I am the Lord your God.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
</actual_current_encoding>
