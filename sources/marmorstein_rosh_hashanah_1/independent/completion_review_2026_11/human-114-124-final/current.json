          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "וְהָיָ֣ה לָכֶם֮ לְצִיצִת֒ וּרְאִיתֶ֣ם אֹת֗וֹ וּזְכַרְתֶּם֙ אֶת־כָּל־מִצְוֹ֣ת יְהוָ֔ה וַעֲשִׂיתֶ֖ם אֹתָ֑ם וְלֹא תָת֜וּרוּ אַחֲרֵ֤י לְבַבְכֶם֙ וְאַחֲרֵ֣י עֵינֵיכֶ֔ם אֲשֶׁר־אַתֶּ֥ם זֹנִ֖ים אַחֲרֵיהֶֽם:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/39",
