    {
      "stem": "shacharit_barukh_shem",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem",
      "title": {
        "he": "בָּרוּךְ שֵׁם",
        "en": "Blessed be His glorious Name"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem/text",
            "source": "urn:x-opensiddur:text:prayer:shema/barukh_shem"
