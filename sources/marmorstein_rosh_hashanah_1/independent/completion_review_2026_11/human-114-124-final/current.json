        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "Blessed be His glorious royal Name for ever and ever.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/barukh_shem/text",
            "source": "urn:x-opensiddur:text:prayer:shema/barukh_shem"
          }
