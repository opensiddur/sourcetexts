{
  "units": [
    {
      "stem": "ahavah_rabbah",
      "urn": "urn:x-opensiddur:text:prayer:ahavah_rabbah",
      "title": {
        "he": "אַהֲבָה רַבָּה",
        "en": "With great love"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "אַהֲבָה רַבָּה אֲהַבְתָּנוּ יְיָ אֱלֹהֵינוּ חֶמְלָה גְדוֹלָה וִיתֵרָה חָמַלְתָּ עָלֵינוּ: אָבִינוּ מַלְכֵּנוּ בַּעֲבוּר אֲבוֹתֵינוּ שֶׁבָּטְחוּ בְךָ",
                "page_start": false
              },
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וַתְּלַמְּדֵם חֻקֵּי חַיִּים כֵּן תְּחָנֵּנוּ וּתְלַמְּדֵנוּ: אָבִינוּ הָאָב הָרַחֲמָן הַמְרַחֵם רַחֵם עָלֵינוּ וְתֵן בְּלִבֵּנוּ לְהָבִין וּלְהַשְׂכִּיל לִשְׁמֹעַ לִלְמֹד וּלְלַמֵּד לִשְׁמֹר וְלַעֲשׂוֹת וּלְקַיֵּם אֶת־כָּל־דִּבְרֵי תַלְמוּד תּוֹרָתֶךָ בְּאַהֲבָה: וְהָאֵר עֵינֵינוּ בְּתוֹרָתֶךָ וְדַבֵּק לִבֵּנוּ בְּמִצְוֹתֶיךָ וְיַחֵד לְבָבֵנוּ לְאַהֲבָה וּלְיִרְאָה שְׁמֶךָ וְלֹא־נֵבוֹשׁ לְעוֹלָם וָעֶד: כִּי בְשֵׁם קָדְשְׁךָ הַגָּדוֹל וְהַנּוֹרָא בָטָחְנוּ נָגִילָה וְנִשְׂמְחָה בִּישׁוּעָתֶךָ:",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/ahavah"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וַהֲבִיאֵנוּ לְשָׁלוֹם מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ וְתוֹלִיכֵנוּ קוֹמְמִיּוּת לְאַרְצֵנוּ: כִּי אֵל פּוֹעֵל יְשׁוּעוֹת אָֽתָּה וּבָנוּ בָּחַרְתָּ מִכָּל־עַם וְלָשׁוֹן וְקֵרַבְתָּנוּ לְשִׁמְךָ הַגָּדוֹל סֶלָה בֶּאֱמֶת. לְהוֹדוֹת לְךָ וּלְיַחֶדְךָ בְּאַהֲבָה: בָּרוּךְ אַתָּה יְיָ הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/vahavienu"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s109",
                "printed_page": "40",
                "text": "With great love hast Thou loved us, O Lord our God, great and abundant compassion hast Thou shown us. Our Father, our King, for the sake of our fathers who trusted in",
                "page_start": false
              },
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "Thee and whom Thou didst teach the statutes of life, likewise be gracious to us and teach us. Our Father, merciful and compassionate Father, have compassion upon us and set it in our heart to comprehend and to understand, to hear, to learn and to teach, to keep, perform and fulfil all words of the teaching of Thy Torah in love. Enlighten our eyes through Thy Torah, attach our heart to Thy commandments, consecrate our heart to love Thy Name and to fear it, so that never may we be disgraced. For in Thy great and awe-inspiring Name do we trust, we exult and rejoice in Thy help.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/ahavah"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "Bring us in peace from the four corners of the earth and lead us upright into our land. For Thou art God who creates salvation and Thou hast chosen us from all peoples and tongues and brought us near Thy great Name for ever in truth, to thank Thee and to proclaim Thy unity. Blessed art Thou, O Lord, who has chosen His people Israel in love.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/vahavienu"
          }
        ]
      }
    },
    {
      "stem": "shacharit_shema_yisrael",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael",
      "title": {
        "he": "שְׁמַע יִשְׂרָאֵל",
        "en": "Hear, O Israel"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "שְׁמַ֖ע יִשְׂרָאֵ֑ל יְהוָ֥ה אֱלֹהֵ֖ינוּ יְהוָ֥ה ׀ אֶחָֽד:",
                "page_start": false,
                "enlarged_letters": [
                  "ע",
                  "ד"
                ]
              }
            ],
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6/4",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "Hear, O Israel, the Lord is our God, the Lord is One.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema_yisrael/quotations/quoted_deuteronomy_6/4",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4"
          }
        ]
      },
      "citations": {
