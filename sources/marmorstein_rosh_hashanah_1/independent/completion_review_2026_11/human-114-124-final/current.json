          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "Thus spoke the Lord to Moses:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/37",
            "source": "urn:x-opensiddur:text:bible:numbers/15/37",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "Speak to the children of Israel and tell them to make themselves show-fringes upon the corners of their garments throughout their generations and to fasten to the fringe of each corner a thread of skyblue wool.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/38",
            "source": "urn:x-opensiddur:text:bible:numbers/15/38"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "They shall be show-fringes to you so that when you look upon them, you will remember all the commandments of the Lord and fulfil them. And do not follow your heart and your eyes after which you go astray",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/numbers_15/chapter/39",
