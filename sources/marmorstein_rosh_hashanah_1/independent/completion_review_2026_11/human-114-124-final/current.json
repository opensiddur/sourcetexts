    {
      "stem": "shacharit_deuteronomy_6_5_to_9",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6",
      "title": {
        "he": "ואהבת",
        "en": "Shema — Deuteronomy 6"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְאָ֣הַבְתָּ֔ אֵ֖ת יְהוָ֣ה אֱלֹהֶ֑יךָ בְּכָל־לְבָבְךָ֥ וּבְכָל־נַפְשְׁךָ֖ וּבְכָל־מְאֹדֶֽךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/5",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/5",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְהָי֞וּ הַדְּבָרִ֣ים הָאֵ֗לֶּה אֲשֶׁ֨ר אָנֹכִ֧י מְצַוְּךָ֛ הַיּ֖וֹם עַל־לְבָבֶֽךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/6",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/6"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְשִׁנַּנְתָּ֣ם לְבָנֶ֔יךָ וְדִבַּרְתָּ֖ בָּ֑ם בְּשִׁבְתְּךָ֤ בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/7",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/7"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וּקְשַׁרְתָּ֥ם לְא֖וֹת עַל־יָדֶ֑ךָ וְהָי֥וּ לְטֹטָפֹ֖ת בֵּ֥ין עֵינֶֽיךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/8",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/8"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וּכְתַבְתָּ֛ם עַל־מְזֻז֥וֹת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/9",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/9"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "You shall love the Lord your God with all your heart and with all your soul and with all your possession.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/5",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/5",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "These words which I command you this day, shall be upon your heart.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/6",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/6"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "You shall inculcate them in your children and speak of them when you sit in your house and when you walk on the way, when you lie down and when you rise up.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/7",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/7"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "You shall bind them for a sign upon your arm and they shall be frontlets between your eyes.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/8",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/8"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "You shall write them upon the doorposts of your house and upon your gates.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_6/chapter/9",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/6/9"
          }
        ]
      }
    },
    {
      "stem": "shacharit_deuteronomy_11_13_to_21",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11",
      "title": {
        "he": "והיה אם שמוע",
        "en": "Shema — Deuteronomy 11"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְהָיָ֗ה אִם־שָׁמֹ֤עַ תִּשְׁמְעוּ֙ אֶל־מִצְוֹתַ֔י אֲשֶׁ֧ר אָנֹכִ֛י מְצַוֶּ֥ה אֶתְכֶ֖ם הַיּ֑וֹם לְאַהֲבָ֞ה אֶת־יְהוָ֤ה אֱלֹֽהֵיכֶם֙ וּלְעָבְד֔וֹ בְּכָל־לְבַבְכֶ֖ם וּבְכָל־נַפְשְׁכֶֽם:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/13",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/13",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְנָֽתַתִּ֧י מְטַֽר־אַרְצְכֶ֛ם בְּעִתּ֖וֹ יוֹרֶ֣ה וּמַלְק֑וֹשׁ וְאָֽסַפְתָּ֣ דְגָנֶ֔ךָ וְתִירֹשְׁךָ֖ וְיִצְהָרֶֽךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/14",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/14"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וְנָֽתַתִּ֛י עֵ֥שֶׂב",
                "page_start": false
              },
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "בְּשָׂדְךָ֖ לִבְהֶמְתֶּ֑ךָ וְאָֽכַלְתָּ֖ וְשָׂבָֽעְתָּ:",
                "page_start": true
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/15",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/15"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "הִשָּׁמְר֣וּ לָכֶ֔ם פֶּן־יִפְתֶּ֖ה לְבַבְכֶ֑ם וְסַרְתֶּ֗ם וַעֲבַדְתֶּם֙ אֱלֹהִ֣ים אֲחֵרִ֔ים וְהִשְׁתַּחֲוִיתֶ֖ם לָהֶֽם:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/16",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/16"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "וְחָרָ֨ה אַף־יְהוָ֜ה בָּכֶ֗ם וְעָצַ֤ר אֶת־הַשָּׁמַ֙יִם֙ וְלֹא־יִהְיֶ֣ה מָטָ֔ר וְהָ֣אֲדָמָ֔ה לֹ֥א תִתֵּ֖ן אֶת־יְבוּלָ֑הּ וַאֲבַדְתֶּ֣ם מְהֵרָ֗ה מֵעַל֙ הָאָ֣רֶץ הַטֹּבָ֔ה אֲשֶׁ֥ר יְהוָ֖ה נֹתֵ֥ן לָכֶֽם:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/17",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/17"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "וְשַׂמְתֶּם֙ אֶת־דְּבָרַ֣י אֵ֔לֶּה עַל־לְבַבְכֶ֖ם וְעַל־נַפְשְׁכֶ֑ם וּקְשַׁרְתֶּ֨ם אֹתָ֤ם לְאוֹת֙ עַל־יֶדְכֶ֔ם וְהָי֥וּ לְטוֹטָפֹ֖ת בֵּ֥ין עֵינֵיכֶֽם:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/18",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/18"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "וְלִמַּדְתֶּ֥ם אֹתָ֛ם אֶת־בְּנֵיכֶ֖ם לְדַבֵּ֣ר בָּ֑ם בְּשִׁבְתְּךָ֤ בְּבֵיתֶ֙ךָ֙ וּבְלֶכְתְּךָ֣ בַדֶּ֔רֶךְ וּֽבְשָׁכְבְּךָ֖ וּבְקוּמֶֽךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/19",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/19"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "וּכְתַבְתָּ֛ם עַל־מְזוּז֥וֹת בֵּיתֶ֖ךָ וּבִשְׁעָרֶֽיךָ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/20",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/20"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s112",
                "printed_page": "42",
                "text": "לְמַ֨עַן יִרְבּ֤וּ יְמֵיכֶם֙ וִימֵ֣י בְנֵיכֶ֔ם עַ֚ל־הָֽאֲדָמָ֔ה אֲשֶׁ֨ר נִשְׁבַּ֧ע יְהוָ֛ה לַאֲבֹתֵיכֶ֖ם לָתֵ֣ת לָהֶ֑ם כִּימֵ֥י הַשָּׁמַ֖יִם עַל־הָאָֽרֶץ:",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/21",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/21"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "And it shall happen if you listen carefully to My commandments which I command you today, to love the Lord your God and to serve Him with all your heart and with all your soul,",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/13",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/13",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "that I will grant the rain of your land in its season, the former rain and the latter rain, so that you will gather in your corn, your wine and your oil.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/14",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/14"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s111",
                "printed_page": "41",
                "text": "I will give",
                "page_start": false
              },
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "grass to your field for your cattle, and you shall eat and be satisfied.",
                "page_start": true
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/15",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/15"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "Take care that your heart be not deceived and that you do not turn aside and serve strange gods and bow down before them.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/16",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/16"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "For then the wrath of the Lord will burn against you and He will close the heavens so that no rain shall fall and the earth shall not yield its produce, and you shall soon perish from the good land that the Lord is giving you.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/17",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/17"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "Lay these words of mine upon your heart and upon your soul, bind them as a sign upon your arm and let them be frontlets between your eyes.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/18",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/18"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "Teach them to your children by talking about them when you sit in your house and walk on the way and when you lie down and when you rise up.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/19",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/19"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "You shall write them upon the doorposts of your house and upon your gates,",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/20",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/20"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s113",
                "printed_page": "42",
                "text": "so that your days and the days of your children may increase upon the soil which the Lord has sworn to your fathers to give to them, as the days of the heavens above the earth.",
                "page_start": false
              }
            ],
            "reference_unit": "verse",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/shema/deuteronomy_11/chapter/21",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/11/21"
          }
        ]
