  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_return_psalm_24"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/1">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:psalms/24">כ״ד.</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:p><tei:milestone unit="chapter" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/1">לְדָוִד מִזְמוֹר. לַ<j:divineName>יהוָה</j:divineName> הָאָרֶץ וּמְלוֹאָהּ תֵּבֵל וְיֹשְׁבֵי בָהּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/2">כִּי הוּא עַל־יַמִּים יְסָדָהּ וְעַל־נְהָרוֹת יְכוֹנְנֶהָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/3">מִי־יַעֲלֶה בְהַר־<j:divineName>יְהוָה</j:divineName> וּמִי־יָקוּם בִּמְקוֹם קָדְשׁוֹ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/4">נְקִי כַפַּיִם וּבַר־לֵבָב אֲשֶׁר לֹא־נָשָׂא לַשָּׁוְא נַפְשִׁי וְלֹא נִשְׁבַּע לְמִרְמָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/5" n="5"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/24/5">יִשָּׂא בְרָכָה מֵאֵת <j:divineName>יְהוָה</j:divineName> וּצְדָקָה מֵאֱלֹהֵי יִשְׁעוֹ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/6">זֶה דּוֹר דֹּרְשָׁיו מְבַקְשֵׁי פָנֶיךָ יַעֲקֹב סֶלָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/7">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וְהִנָּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבוֹא מֶלֶךְ הַכָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/8">מִי זֶה מֶלֶךְ הַכָּבוֹד <j:divineName>יְהוָה</j:divineName> עִזּוּז וְגִבּוֹר <j:divineName>יְהוָה</j:divineName> גִּבּוֹר מִלְחָמָה:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/9">שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבֹא מֶלֶךְ הַכָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/10" n="10"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/24/10">מִי הוּא־זֶה מֶלֶךְ הַכָּבוֹד <j:divineName>יְהוָה</j:divineName> צְבָאוֹת הוּא מֶלֶךְ הַכָּבוֹד סֶלָה:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_return_psalm_24"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/1">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:psalms/24">Psalm 24</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n196.jpg">
        <tei:p><tei:milestone unit="chapter" n="24" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/1">By David, a psalm. The earth belongs to the Lord together with the fullness of it, the world and those who dwell in it.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/2">For He has founded it above the seas and established it over rivers.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/3">Who may ascend the mountain of the Lord, and who remain in His holy place?</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/4">The clean of hands and the pure of heart, who has not taken my soul for vanity nor sworn falsely.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/5" n="5"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/24/5">He will receive blessing from the Lord and kindness from the God of his salvation.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/6">This is the generation of those that seek Him, that desire Thy countenance, Jacob, Selah.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/7">Lift up your heads, O gates, and lift yourselves up, O portals of eternity, so that the King of Glory may enter.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/8">Who is this King of Glory? He is the Lord strong and mighty, the Lord mighty in war.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/9">Lift up your heads, O gates, lift up, O portals of eternity, so that the King of Glory may come.</tei:seg> <tei:milestone unit="verse" 
corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_24/psalms_24/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/24/10">Who is this King of Glory? The Lord of Hosts, He is the King of Glory, Selah.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_return_psalm_29"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/1">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:psalms/29">כ״ט.</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:p><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/1">מִזְמוֹר לְדָוִד. הָבוּ לַ<j:divineName>יהוָה</j:divineName> בְּנֵי אֵלִים הָבוּ לַ<j:divineName>יהוָה</j:divineName> כָּבוֹד וָעֹז:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/2">הָבוּ לַ<j:divineName>יהוָה</j:divineName> כְּבוֹד שְׁמוֹ הִשְׁתַּחֲווּ לַ<j:divineName>יהוָה</j:divineName> בְּהַדְרַת־קֹדֶשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/3">קוֹל <j:divineName>יְהוָה</j:divineName> עַל־הַמָּיִם אֵל־הַכָּבוֹד הִרְעִים <j:divineName>יְהוָה</j:divineName> עַל־מַיִם רַבִּים:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/4">קוֹל־<j:divineName>יְהוָה</j:divineName> בַּכֹּחַ קוֹל <j:divineName>יְהוָה</j:divineName> בֶּהָדָר:</tei:seg> 
<tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/5" n="5"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/5">קוֹל <j:divineName>יְהוָה</j:divineName> שֹׁבֵר אֲרָזִים וַיְשַׁבֵּר <j:divineName>יְהוָה</j:divineName> אֶת־אַרְזֵי הַלְּבָנוֹן:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/6">וַיַּרְקִידֵם כְּמוֹ־עֵגֶל לְבָנוֹן וְשִׂרְיֹן כְּמוֹ בֶן־רְאֵמִים:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/7" n="7"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/7">קוֹל־<j:divineName>יְהוָה</j:divineName> חֹצֵב לַהֲבוֹת אֵשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/8">קוֹל <j:divineName>יְהוָה</j:divineName> יָחִיל מִדְבָּר יָחִיל <j:divineName>יְהוָה</j:divineName> מִדְבַּר קָדֵשׁ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/9">קוֹל <j:divineName>יְהוָה</j:divineName> יְחוֹלֵל אַיָּלוֹת וַיֶּחֱשֹׂף יְעָרוֹת 
וּבְהֵיכָלוֹ כֻּלּוֹ אֹמֵר כָּבוֹד:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/10"><j:divineName>יְהוָה</j:divineName> לַמַּבּוּל יָשָׁב וַיֵּשֶׁב <j:divineName>יְהוָה</j:divineName> מֶלֶךְ לְעוֹלָם:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/11" n="11"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/11"><j:divineName>יְהוָה</j:divineName> עֹז לְעַמּוֹ יִתֵּן <j:divineName>יְהוָה</j:divineName> יְבָרֵךְ אֶת־עַמּוֹ בַשָּׁלוֹם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_return_psalm_29"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="citation" target="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/1">
      <tei:p>
        <tei:ref target="urn:x-opensiddur:text:bible:psalms/29">Psalm 29</tei:ref>
      </tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n196.jpg">
        <tei:p><tei:milestone unit="chapter" n="29" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/1" n="1"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/1">Psalm of David: Ascribe to the Lord, sons of the powerful, ascribe to the Lord honour and might.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/2">Ascribe to the Lord the honour of His Name, bow down before the Lord in holy array.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/3">The voice of the Lord is above the waters, the God of glory has thundered, the Lord is above mighty waters.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/4" n="4"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/4">The voice of the Lord is power, the voice of the Lord is beauty.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/5" n="5"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/29/5">The voice of the Lord shatters cedars, the Lord shattered cedars of Lebanon.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/6" n="6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/6">He made them skip like a calf, Lebanon and Sirion like young unicorns.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/8">The voice of the Lord makes the wilderness tremble, the Lord makes the wilderness of Kadesh tremble.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/9">The voice of the Lord causes hinds to calve, and strips forests and in His sanctuary everything expresses honour.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/29/10">The Lord was enthroned as King for eternity.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/psalm_29/psalms_29/11" n="11"/><tei:seg 
source="urn:x-opensiddur:text:bible:psalms/29/11">The Lord gives strength to His people, the Lord blesses His people with peace.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="torah_uvenuchoh"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvenuchoh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n195.jpg">
        <tei:note type="description" xml:lang="en">When the scroll of the Torah is returned to the Holy Ark:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10/36" n="36"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/10/36">וּבְנֻחֹה יֹאמַר שׁוּבָה <j:divineName>יְיָ</j:divineName> רִבְבוֹת אַלְפֵי יִשְׂרָאֵל:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="132" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/8">קוּמָה <j:divineName>יְיָ</j:divineName> לִמְנוּחָתֶךָ אַתָּה וַאֲרוֹן עֻזֶּךָ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/9">כֹּהֲנֶיךָ יִלְבְּשׁוּ־צֶדֶק וַחֲסִידֶיךָ יְרַנֵּנוּ:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/10">בַּעֲבוּר דָּוִד עַבְדֶּךָ אַל־תָּשֵׁב פְּנֵי מְשִׁיחֶךָ:</tei:seg> <tei:milestone 
unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/4/2">כִּי לֶקַח טוֹב נָתַתִּי לָכֶם תּוֹרָתִי אַל תַּעֲזֹבוּ:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/18" n="18"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/18">עֵץ־חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ וְתֹמְכֶיהָ מְאֻשָּׁר:</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/17">דְּרָכֶיהָ דַרְכֵי־נֹעַם וְכָל־נְתִיבוֹתֶיהָ שָׁלוֹם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5"/><tei:milestone unit="verse" 
corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5/21" n="21"/><tei:seg source="urn:x-opensiddur:text:bible:lamentations/5/21">הֲשִׁיבֵנוּ <j:divineName>יְיָ</j:divineName> אֵלֶיךָ וְנָשׁוּבָה חַדֵּשׁ יָמֵינוּ כְּקֶדֶם:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="torah_uvenuchoh"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:chol/shacharit/torah/uvenuchoh" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n196.jpg">
        <tei:note type="description" xml:lang="en">When the scroll of the Torah is returned to the Holy Ark:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="10" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/numbers_10/36" n="36"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/10/36">When it rested He said: ‘Return, O Lord, to the myriads of thousands of Israel’.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="132" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/8" n="8"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/8">Arise, O Lord, to Thy resting-place, Thou and the Ark of Thy strength.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/9">Thy priests are clothed in righteousness and Thy pious ones exult.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/psalms_132/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/132/10">For the sake of David, Thy servant, do not turn back the face of Thine 
anointed.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="4" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_4/2" n="2"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/4/2">For a fine portion have I given you, do not forsake my Torah.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="3" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/18" n="18"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/18">It is a tree of life for those who grasp it and whoever supports it is made happy.</tei:seg> <tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/proverbs_3/17" n="17"/><tei:seg source="urn:x-opensiddur:text:bible:proverbs/3/17">Its ways are delightful ways and all its paths are peace.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="5" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5"/><tei:milestone unit="verse" 
corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/torah/return/uvenuchoh/lamentations_5/21" n="21"/><tei:seg source="urn:x-opensiddur:text:bible:lamentations/5/21">Restore us, O Lord, to Thee, that we may return, renew our days as of old.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="cantor_el_melekh_neeman"><tei:standOff xmlns:tei="http://www.tei-c.org/ns/1.0" type="notes">
    <tei:note type="commentary" target="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/text">
      <tei:p><tei:choice><tei:abbr>נ״א</tei:abbr><tei:expan>נוסח אחר</tei:expan></tei:choice> מְנַשֶּׁה</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n197.jpg">
        <tei:pb ed="1965" n="89" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n197.jpg"/>
        <tei:head xml:lang="he">תְּפִלָּה לִשְׁלִיחַ צִבּוּר.</tei:head>
        <tei:note type="instruction" xml:lang="he">לאמרה בכונה וברתת ובחרדה קודם התפלה.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/text"/>אֵל מֶלֶךְ נֶאֱמָן שַׁדַּי מֶלֶךְ עֶלְיוֹן קַבֵּל שַׁוְעָתִי בְּרָצוֹן וּבְאִמּוּץ הַלֵּב. <j:divineName>יְיָ</j:divineName> אֱלֹהֵינוּ <j:divineName>יְיָ</j:divineName> אֶחָד אֵל חַי דַּיָּן אֱמֶת שׁוֹפֵט צֶדֶק רַחוּם וְחַנּוּן. רַחֵם עָלַי וּשְׁמַע תְּפִלָּתִי הַיּוֹם אֲשֶׁר אֶתְפַּלֵּל בַּעֲדִי וּבְעַד בֵּיתִי וּבְעַד עֲדָתִי הַמַּסְכִּימִים עִמִּי בִּתְפִלָּתִי וְתִכְלוֹל תְּפִלָּתִי עִם הַתְּפִלּוֹת הַיְשָׁרוֹת וְהַנְּקִיּוֹת אֲשֶׁר יַעֲשׂוּ יִשְׂרָאֵל. וְתַחְתּוֹר תַּחַת כִּסֵּא כְבוֹדֶךָ כְּמוֹ שֶׁחָתַרְתָּ לִתְפִלַּת <tei:choice><j:option>מֹשֶׁה</j:option><j:option>מְנַשֶּׁה</j:option></tei:choice>. וְאַל יֵבוֹשׁוּ בִי שׁוֹלְחַי וְלֹא אֲנִי בָהֶם:  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu"/><tei:milestone unit="verse" n="15" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu/15"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/15">יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> צוּרִי וְגוֹאֲלִי.</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  אָמֵן סֶלָה: יְהִי רָצוֹן לְפָנֶיךָ אָיוֹם שֶׁתִּתֵּן לִי קוֹל נָעִים וְעָרֵב הַיּוֹם וְאַל יִפְסוֹק קוֹלִי וְאַל יִחַר גְּרוֹנִי 
וְיִהְיֶה קוֹלִי נָעִים וְחָזָק כְּמוֹ שֶׁנֶּאֱמַר  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol"/><tei:milestone unit="verse" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19"/><tei:milestone unit="verse-part" n="vayehi_qol" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19/vayehi_qol"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/19/19/vayehi_qol">וַיְהִי קוֹל הַשּׁוֹפָר הוֹלֵךְ וְחָזֵק:</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  אָמֵן סֶלָה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="cantor_el_melekh_neeman"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n198.jpg">
        <tei:pb ed="1965" n="89" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n198.jpg"/>
        <tei:head xml:lang="en">A Prayer for the Reader</tei:head>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/text"/>O God, faithful King, Almighty, Supreme King, accept my devoted and confident prayer. O Lord our God, the Lone God, the living God, the truthful judge, the righteous ruler, merciful and gracious, have mercy upon me and hear my prayer today when I pray for myself and my family and all my congregation who join in my prayers. Include my prayer among the upright and pure prayers that Israel offers, and let it come beneath Thy glorious throne just as Thou didst to the prayer of <tei:choice><j:option>Moses</j:option><j:option>Menasseh</j:option></tei:choice>, so that those who sent me may not be put to shame through me, nor I through them.  <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu"/><tei:milestone unit="verse" n="15" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/yihyu/15"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/19/15">May the words of my mouth find favour and the meditation of my heart before Thee, O Lord, my Rock and my Redeemer,</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/>  Amen, Selah. May it be Thy will, O Awe-inspiring One, to give me a pleasant and sweet voice today so that my voice may not fail me and my throat not burn;
 let my voice be pleasant and strong, as it is written: ‘ <tei:milestone unit="chapter" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol"/><tei:milestone unit="verse" n="19" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19"/><tei:milestone unit="verse-part" n="vayehi_qol" corresp="urn:x-opensiddur:text:prayer:el_melekh_neeman_shaddai/quotations/vayehi_qol/19/vayehi_qol"/><tei:seg source="urn:x-opensiddur:text:bible:exodus/19/19/vayehi_qol">And the sound of the Shofar increased in strength</tei:seg><tei:milestone unit="verse-part"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> ’. Amen, Selah. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="cantor_hineni"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n197.jpg">
        <tei:note type="instruction" xml:lang="he">תפלה אחרת <tei:choice><tei:abbr>לש״ץ</tei:abbr><tei:expan>לשליח צבור</tei:expan></tei:choice>.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/1"/>הִנְנִי הֶעָנִי מִמַּעַשׂ וְנִרְעָשׁ וְנִפְחָד מִפַּחַד יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל בָּאתִי לַעֲמוֹד וּלְחַנֵּן לְפָנֶיךָ עַל עַמְּךָ יִשְׂרָאֵל אֲשֶׁר שְׁלָחוּנִי וְאַף עַל פִּי שֶׁאֵינִי כְדַי וְהָגוּן לְכָךְ: <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/2"/> עַל כֵּן אֲבַקֶּשְׁךָ אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב. <j:divineName>יְיָ</j:divineName> <j:divineName>יְיָ</j:divineName> אֵל רַחוּם וְחַנּוּן, אֱלֹהִים. שַׁדַּי אָיוֹם וְנוֹרָא. הֱיֵה נָא מַצְלִיחַ דַּרְכִּי אֲשֶׁר אָנֹכִי הוֹלֵךְ לַעֲמוֹד לְבַקֵּשׁ רַחֲמִים עָלַי וְעַל שׁוֹלְחָי. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/3"/> וְנָא אַל תַּפְשִׁיעֵם בְּחַטֹּאתַי וְאַל תְּחַיְּבֵם בַּעֲוֹנוֹתַי כִּי חוֹטֵא וּפוֹשֵׁעַ אָנִי וְאַל יִכָּלְמוּ בִּי בִּפְשָׁעַי וְאַל יֵבוֹשׁוּ בִי וְאַל אֵבוֹשָׁה בָהֶם וְקַבֵּל תְּפִלָּתִי כִּתְפִלַּת זָקֵן וְרָגִיל וּפִרְקוֹ נָאֶה וּזְקָנוֹ מְגֻדָּל וְקוֹלוֹ נָעִים וּמְעֹרָב בְּדַעַת עִם הַבְּרִיּוֹת. וְתִגְעַר בְּשָׂטָן לְבַל יַשְׂטִינֵנוּ. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/4"/> וִיהִי נָא דִגְלֵנוּ עָלֶיךָ אַהֲבָה. לְכָל 
פְּשָׁעִים תְּכַסֶּה בְאַהֲבָה. וְכָל צוֹמוֹתֵינוּ וְעִנּוּיֵינוּ הֲפֹךְ לָנוּ וּלְכָל יִשְׂרָאֵל לְשָׂשׂוֹן וּלְשִׂמְחָה לְחַיִּים וּלְשָׁלוֹם. הָאֱמֶת וְהַשָּׁלוֹם אֱהָבוּ וְאַל יְהִי שׁוּם מִכְשׁוֹל בִּתְפִלָּתִי: </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/5"/>וִיהִי רָצוֹן לְפָנֶיךָ <j:divineName>יְיָ</j:divineName> אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא אֵל עֶלְיוֹן אֶהְיֶה אֲשֶׁר אֶהְיֶה שֶׁכָּל הַמַּלְאָכִים שֶׁהֵם בַּעֲלֵי תְפִלּוֹת יָבִיאוּ תְפִלָּתִי לִפְנֵי כִסֵּא כְבוֹדֶךָ וְיָפִיצוּ אוֹתָהּ לְפָנֶיךָ בַּעֲבוּר כָּל הַצַּדִּיקִים וְהַחֲסִידִים הַתְּמִימִים וְהַיְשָׁרִים וּבַעֲבוּר כְּבוֹד שִׁמְךָ הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא כִּי אַתָּה שׁוֹמֵעַ תְּפִלַּת עַמְּךָ יִשְׂרָאֵל בְּרַחֲמִים בָּרוּךְ אַתָּה שׁוֹמֵעַ תְּפִלָּה: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="cantor_hineni"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n198.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/1"/>Behold I come, poor in deeds, shaking and trembling with fear, before Him, who is enthroned above Israel’s songs of praise, to appear and entreat before Thee for Thy people Israel, who have sent me, although I am neither deserving nor worthy of this. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/2"/> Therefore I implore Thee, God of Abraham, God of Isaac and God of Jacob, O Lord, Lord, merciful and gracious God, O God, Almighty, fearful and awe-inspiring, let my way meet with success, for I am about to approach to beg mercy for myself and those who send me. <tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/3"/> Hold them not guilty for my sins, do not condemn them because of my guilt, for I am a sinner and transgressor; may they not be put to shame because of my transgressions, let them not be disgraced through me nor I through them. Accept my prayer as if it were the prayer of an elder, who is experienced, whose conduct is seemly, whose beard is imposing, whose voice is pleasant and who enjoys the love of his fellow men. Rebuke Satan that he may not oppose us. <tei:milestone unit="prayer-part" 
corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/4"/> Let our banner before Thee be love, cover all transgressions with love, transform our fasts and our afflictions for us and all Israel into joy and mirth, for life and peace. Love truth and peace; and let there be no hindrance in my prayer. </tei:p>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:prayer:hineni_the_prayer_of_the_shaliach_tsibur/5"/>May it be Thy will, O Lord, God of Abraham, God of Isaac and God of Jacob, great, strong and awe-inspiring God, supreme God, whose name is: “I am that I am”, that all the angels who are bearers of prayers, may bring my prayer before Thy glorious throne and spread it before Thee, for the sake of all the righteous, the pious, the perfect and the upright and for the sake of Thy great, strong and awe-inspiring Name; for Thou hearest the prayer of Thy people Israel in compassion. Blessed art Thou, hearer of prayer. <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-heidenheim-1965-he" stem="cantor_four_verses"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n197.jpg">
        <tei:note type="instruction" xml:lang="he">קבלה <tei:choice><tei:abbr>מר״ת</tei:abbr><tei:expan>מרבנו תם</tei:expan></tei:choice> לומר <tei:choice><tei:abbr>ד׳</tei:abbr><tei:expan>ארבעה</tei:expan></tei:choice> פסוקים אלו, קודם שמתחיל <tei:choice><tei:abbr>הש״ץ</tei:abbr><tei:expan>השליח צבור</tei:expan></tei:choice> המלך וקודם הקדיש:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119/75" n="75"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/75">יָדַעְתִּי <j:divineName>יְיָ</j:divineName> כִּי צֶדֶק מִשְׁפָּטֶיךָ וֶאֱמוּנָה עִנִּיתָנִי:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="55" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/55/3">הַקְשִׁיבָה לִּי וַעֲנֵנִי אָרִיד בְּשִׂיחִי וְאָהִימָה:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="35" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/35/9">וְנַפְשִׁי תָּגִיל בַּ<j:divineName>יְיָ</j:divineName> תָּשִׂישׂ בִּישׁוּעָתוֹ:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="144" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/144/10">הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file project="prayerbook_for_the_new_year-marmorstein-1965-en" stem="cantor_four_verses"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n198.jpg">
        <tei:p><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119/75" n="75"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/75">I know, O Lord, that Thy judgments are justice, and faithfully hast Thou chastised me.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="55" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/55/3">Listen to me and answer me when I lament and sigh.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="35" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/35/9">Let my soul exult in the Lord, rejoice in His help.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="144" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/144/10">It is He who gives salvation to kings, who saves His servant David from the evil sword.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
