                }
              }
            ],
            "marked": true
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s183",
                "printed_page": "80",
                "text": " for honour and glory, for all these, O Lord our God, do we thank Thee and bless Thee. Blessed be Thy name in the mouth of all the living constantly and for ever and ever, Thy word is truth and endures to eternity. "
              }
            ],
            "end_reference": true
