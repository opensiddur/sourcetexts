    {
      "stem": "shofar_ribbon_haolamim_banekha",
      "urn": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha",
      "title": {
        "he": "רבון העולמים בניך",
        "en": "Prayer before the Shofar"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s185",
                "printed_page": "81",
                "text": "Master of the worlds, Thy children, the children of Thy favourites, turn their face towards Thee and trust in Thy great mercy. They have appointed me to blow the Shofar before Thee, as Thou hast commanded us in Thy Torah. Remember unto them the merit of our father Abraham, who walked before Thee in perfection; the merit of our father Isaac and his readiness for sacrifice when he lay bound upon the altar; the merit of our father Jacob, the upright man who dwelt in tents, as well as the merit of Moses, Aaron, David, Solomon and all the righteous men of the world. Rise from the throne of justice and sit on the throne of compassion, as it is said: ",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha/text"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s185",
                "printed_page": "81",
                "text": "God has arisen at the Teruah, the Lord at the sound of the Shofar",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/47/6",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/47/6",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha/quotations/alah",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha/quotations/alah/6"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s185",
                "printed_page": "81",
                "text": " . . . I myself know that I am not worthy to pray for myself, let alone for others, all the more since I have neither the knowledge nor the wisdom to bear in mind the intentions underlying the Shofar sounds and their connections with Thy holy names. But I trust in Thy great compassion and know that Thou wilt not turn me away empty from before Thee. And Thou in Thy goodness dost arouse Thine own compassion. So let the favour of the Lord our God be upon us and as for the work of our hands, confirm it. Consider good intentions as if they had been deeds, as if we had kept in mind all the intentions underlying the Shofar sounds, in order that those sounds of ours may ascend to arouse Thy compassion so that Thou mayest take pity on Thy children, through these Shofar sounds, transform the attribute of justice into the attribute of kindness and compassion and deal indulgently with us. Close and seal Satan’s mouth that he may not accuse us and when our reproach comes before Thee, do not blot out our name from Thy book. Inscribe all the children of our covenant for a good life. ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s185",
                "printed_page": "81",
                "text": "May the words of my mouth and the meditation of my heart find favour before thee, O Lord, my rock and my redeemer,",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/19/15",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/19/15",
            "chapter_corresp": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha/quotations/yihyu",
            "source_reference_corresp": "urn:x-opensiddur:text:prayer:ribbon_haolamim_banekha/quotations/yihyu/15"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s185",
                "printed_page": "81",
                "text": " Amen.",
                "page_start": false
              }
            ],
            "end_reference": true
          }
        ]
      },
      "head": {
        "he": "סֵדֶר הַתְּקִיעוֹת.",
        "en": "Prayer before the Shofar"
      },
      "instructions": [
        {
          "text": "תחנות לתוקע לפני התקיעה.",
          "language": "he",
          "witnesses": [
            "he"
          ]
        }
      ]
    },
    {
      "stem": "shofar_yehi_ratzon",
      "urn": "urn:x-opensiddur:text:prayer:yehi_ratzon_elohei_hamishpat",
      "title": {
        "he": "יהי רצון אלהי המשפט",
        "en": "Prayer before the Shofar"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "May it by Thy will, O Lord my God, God of judgment, that this may be a time of favour before Thee. Tear down in Thy many mercies and great kindnesses all partitions that separate Thee from Thy people Israel on this day. Remove from before Thee all opponents and accusers of Thy people Israel. Close Satan’s mouth that he may not oppose us, for towards Thee are our eyes suspended. I shall exalt Thee, my God, O King, God of judgment, who listens this day to the sound of prayers and Teruoth of Thy people Israel in compassion. Amen.",
                "page_start": true
              }
            ],
            "end_reference": true,
            "corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_elohei_hamishpat/text"
          }
        ]
      },
      "instructions": [
        {
          "text": "במחזורים נדפסת תחנה אחת מלאה שמות קדושות עומדות על סודות נשגבות ואסור לאמרה אלא מי שבא אל היכל הקדש פנימה, ולא כל הרוצה ליטול את השם יבוא ויטול, ולכן השמטתיה.",
          "language": "he",
          "witnesses": [
            "he"
          ]
        }
      ],
      "opening_page": {
        "he": true,
        "en": true
      }
    },
    {
      "stem": "shofar_qera_satan",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan",
      "title": {
        "he": "קרע שטן",
        "en": "Verses before the Shofar"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "My voice hast Thou heard, do not hide Thine ear to my plea for relief, to my cry.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:lamentations/3/56",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/lamentations_3/56"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "The beginning of Thy word is truth, and Thy righteous judgment is for eternity.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/119/160",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/160"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "Grant Thy servant an assurance of good, that the arrogant shall not oppress me.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/119/122",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/122"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "I rejoice in Thy word like a man who has found abundant booty.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/119/162",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/162"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "Teach me good sense and knowledge for I believe in Thy commandments.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/119/66",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/66"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s187",
                "printed_page": "82",
                "text": "Accept with favour the voluntary offerings of my mouth, O Lord, and teach me Thy judgments.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/119/108",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119",
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/shofar/qera_satan/psalms_119/108",
            "end_reference": true
          }
        ]
      },
      "instructions": [
        {
          "text": "ואח״כ יאמר, ויכוין בר״ת קרע שטן.",
          "language": "he",
          "witnesses": [
            "he"
          ],
          "abbreviations": [
            {
              "abbr": "ואח״כ",
              "expan": "ואחר כך"
            },
            {
              "abbr": "בר״ת",
              "expan": "בראשי תיבות"
            }
          ]
        }
      ]
    }
