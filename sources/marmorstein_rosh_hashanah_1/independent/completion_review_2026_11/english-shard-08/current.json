{
  "english_witnesses": [
    {
      "stem": "torah_vezot_hatorah",
      "urn": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah",
      "title": {
        "he": "וזאת התורה",
        "en": "This is the Torah"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "This is the Torah which Moses placed before the Children of Israel"
              }
            ],
            "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/vezot_hatorah/text",
            "source": "urn:x-opensiddur:text:bible:deuteronomy/4/44",
            "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/4/44",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/vezot",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/vezot/44"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "at the Lord’s command through Moses."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:numbers/9/23/al_pi",
            "source_reference": "urn:x-opensiddur:text:bible:numbers/9/23",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi/23",
            "source_reference_part": {
              "unit": "verse-part",
              "n": "al_pi",
              "corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/al_pi/23/al_pi"
            }
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "It is a tree of life for those who grasp it; and whoever supports it, is made happy."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:proverbs/3/18",
            "source_reference": "urn:x-opensiddur:text:bible:proverbs/3/18",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/etz",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/etz/18"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "Its ways are pleasant and all its paths are peace."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:proverbs/3/17",
            "source_reference": "urn:x-opensiddur:text:bible:proverbs/3/17",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/derakheha",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/derakheha/17"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "Length of days is in its right hand, in its left is wealth and honour."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:proverbs/3/16",
            "source_reference": "urn:x-opensiddur:text:bible:proverbs/3/16",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/orekh",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/orekh/16"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": " "
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "The Lord delights for the sake of His righteousness to magnify the Torah and to glorify it."
              }
            ],
            "source": "urn:x-opensiddur:text:bible:isaiah/42/21",
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/42/21",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/chafetz",
            "source_reference_corresp": "urn:x-opensiddur:text:siddur:chol/shacharit/torah/vezot_hatorah/quotations/chafetz/21"
          }
        ]
      }
    },
    {
      "stem": "haftarah_before_blessing",
      "urn": "urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar",
      "title": {
        "he": "ברכה לפני ההפטרה",
        "en": "Blessing before the Haphtorah"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "Blessed art Thou, O Lord our God, King of the World, who has chosen worthy prophets and found pleasure in their words that are spoken in truth. Blessed art Thou, O Lord, who has chosen the Torah and His servant Moses, His people Israel and prophets of truth and righteousness."
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar/text"
          }
        ]
      }
    },
    {
      "stem": "haftarah_samuel_1",
      "urn": "urn:x-opensiddur:text:bible:samuel_1/1",
      "title": {
        "he": "הפטרה ליום א׳ של ראש השנה",
        "en": "Haphtarah"
      },
      "languages": {
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/1",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "There was once a man from Romathaim-Tsofim, from the hill-country of Ephraim, whose name was Elkanah the son of Yeroham, the son of Elihu, the son of Tohu, the son of Tsuf, an Efrathite."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/2",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "He had two wives; the name of one was Hannah and that of the other was Peninah; Peninah had children but Hannah had no children."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/3",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "This man used to go up from his town year by year to Shiloh in order to prostrate himself and to sacrifice before the Lord of Hosts. There were two sons of Eli, Hofni and Pinhas, priests to the Lord."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/4",
            "fragments": [
              {
                "scan": "s175",
                "printed_page": "76",
                "text": "On"
              },
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "the day that Elkanah sacrificed, he used to give portions to his wife Peninah and to all her sons and daughters"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/5",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "but to Hannah he used to give a double portion because he loved Hannah even though the Lord had closed her womb."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/6",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "Her rival used to annoy her by taunting her that the Lord had closed her womb."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/7",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "He used to do this year by year and whenever she went up to the house of the Lord, her rival would annoy her so that she used to weep and would not eat."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/8",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "Once her husband Elkanah said to her: ‘Hannah, why do you weep, why do you not eat and why is your heart sad? Am I not better to you than ten children?’"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/9",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "Hannah arose after eating and drinking in Shiloh: and Eli the priest was sitting on a chair by the doorpost of the Sanctuary of the Lord"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/10",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "when she in bitterness of soul prayed to the Lord and was weeping violently."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/11",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "And she made a vow and said: ‘O Lord of Hosts, if Thou wilt only look at the misery of Thy handmaid and remember me and not forget Thy handmaid and give Thy handmaid a male child, I will give him to the Lord all the days of his life and no razor shall come upon his head’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/12",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "And it happened when she prayed so much before the Lord that Eli noticed her mouth."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/13",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "For Hannah was talking to herself, only her lips were moving but her voice could not be heard. So Eli thought that she was drunk"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/14",
            "fragments": [
              {
                "scan": "s177",
                "printed_page": "77",
                "text": "and Eli said to her: ‘How much longer will you be drunk?"
              },
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Remove your wine from yourself’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/15",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Then Hannah answered saying: ‘It is not so, my lord; I am a woman with a heavy heart, I have drunk neither wine nor mead but I have poured out my soul before the Lord."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/16",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Do not consider your handmaid as a worthless woman for it is owing to the abundance of my grief and distress that I have spoken so long’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/17",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Eli replied and said: ‘Go forth in peace and the God of Israel will grant your request which you asked of Him’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/18",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "She said: ‘May your handmaid find favour in your eyes’. Then the woman went her way, she ate and her face was no longer sad."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/19",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "They rose early in the morning and prostrated themselves before the Lord, then they returned and arrived at their house in Ramah. And Elkanah knew his wife Hannah and the Lord remembered her;"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/20",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "and in the course of time Hannah conceived and gave birth to a son. She called his name Samuel ‘for I have asked for him of the Lord’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/21",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "And the man Elkanah and the whole of his household went up to offer the annual sacrifice and his vow to the Lord."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/22",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Hannah, however, did not go up, for she said to her husband: ‘When the lad has been weaned, then I will bring him there that he may appear before the presence of the Lord and stay there for ever’."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/23",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Her husband Elkanah said to her: ‘Do what is best in your eyes, stay until you have weaned him; surely the Lord will fulfil His word’. The woman stayed and suckled her son until she had weaned him."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/24",
            "fragments": [
              {
                "scan": "s179",
                "printed_page": "78",
                "text": "Then she brought him up with her after she had weaned him, together with three bullocks, one ephah of flour and one bottle of wine. She brought him into the House of the Lord"
              },
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "at Shiloh. The lad was still very young."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/25",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "They slaughtered the bullock, and brought the lad to Eli."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/26",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "She said: ‘I pray you, my lord, as your soul lives, my lord, I am the woman who was standing here to pray to the Lord."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/27",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "For this lad did I pray and the Lord granted my request for which I asked of Him."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/1/28",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "I then dedicated him to the Lord; all the days that he exists, he is dedicated to the Lord’. Then he bowed down there before the Lord."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/1",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "And Hannah prayed and said: ‘My heart has rejoiced in the Lord, my condition has been raised through the Lord; my mouth has triumphed over my enemies since I have rejoiced in Thy salvation."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/2",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "None is holy as the Lord for there is none besides Thee and there is no rock like our God."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/3",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "Do not continue to talk haughtily, let insolence leave your mouth for a God of knowledge is the Lord and to Him all deeds are known."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/4",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "The bow of the mighty breaks and stumblers are girded with strength,"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/5",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "those once satisfied with food hire themselves out and the hungry cease to be hungry, even she who was childless has given birth to seven while another rich in children is forlorn."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/6",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "The Lord slays and revives, brings down to the grave and raises up."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/7",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "The Lord impoverishes and enriches, brings low and raises high,"
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/8",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "lifting the poor from the dust and the needy from the dung-heap to seat them with nobles and endow them with a glorious throne, for the earth’s foundations are the Lord’s and He has placed the world upon them."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/9",
            "fragments": [
              {
                "scan": "s181",
                "printed_page": "79",
                "text": "He guards the feet of his pious ones but evil doers are silenced in darkness for it is not by might that"
              },
              {
                "scan": "s183",
                "printed_page": "80",
                "text": "man prevails."
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:bible:samuel_1/2/10",
            "fragments": [
              {
                "scan": "s183",
                "printed_page": "80",
                "text": "As for the Lord, His opponents will be crushed, in heaven above does He thunder, the Lord will judge the ends of the earth and give strength to His king and raise the condition of his anointed."
              }
            ]
          }
        ]
      },
      "start": "urn:x-opensiddur:text:bible:samuel_1/1/1",
      "end": "urn:x-opensiddur:text:bible:samuel_1/2/10",
