          "fragments": [
            {
              "scan": "s121",
              "printed_page": "46",
              "text": "(Our God and God of our fathers, take pleasure in our rest.)",
              "page_start": false
            }
          ],
          "conditions": [
            {
              "type": "opensiddur:holiday-aggregate",
              "features": {
