          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s199",
                "printed_page": "89",
                "text": "Let my soul exult in the Lord, rejoice in His help.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/35/9",
            "reference_unit": "verse",
            "chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35",
