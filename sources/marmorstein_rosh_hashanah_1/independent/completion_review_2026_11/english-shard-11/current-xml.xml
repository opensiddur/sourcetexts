  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-heidenheim-1965-he/cantor_four_verses.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n197.jpg">
        <tei:note type="instruction" xml:lang="he">קבלה <tei:choice><tei:abbr>מר״ת</tei:abbr><tei:expan>מרבנו תם</tei:expan></tei:choice> לומר <tei:choice><tei:abbr>ד׳</tei:abbr><tei:expan>ארבעה</tei:expan></tei:choice> פסוקים אלו, קודם שמתחיל <tei:choice><tei:abbr>הש״ץ</tei:abbr><tei:expan>השליח צבור</tei:expan></tei:choice> המלך וקודם הקדיש:</tei:note>
        <tei:p><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119/75" n="75"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/75">יָדַעְתִּי <j:divineName>יְיָ</j:divineName> כִּי צֶדֶק מִשְׁפָּטֶיךָ וֶאֱמוּנָה עִנִּיתָנִי:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="55" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/55/3">הַקְשִׁיבָה לִּי וַעֲנֵנִי אָרִיד בְּשִׂיחִי וְאָהִימָה:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="35" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/35/9">וְנַפְשִׁי תָּגִיל בַּ<j:divineName>יְיָ</j:divineName> תָּשִׂישׂ בִּישׁוּעָתוֹ:</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="144" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/144/10">הַנּוֹתֵן תְּשׁוּעָה לַמְּלָכִים הַפּוֹצֶה אֶת דָּוִד עַבְדּוֹ מֵחֶרֶב רָעָה:</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
  <file path="/home/efeins/.codex/worktrees/marmorstein-projects/master/project/prayerbook_for_the_new_year-marmorstein-1965-en/cantor_four_verses.xml"><tei:text xmlns:tei="http://www.tei-c.org/ns/1.0">
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n198.jpg">
        <tei:p><tei:milestone unit="chapter" n="119" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_119/75" n="75"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/119/75">I know, O Lord, that Thy judgments are justice, and faithfully hast Thou chastised me.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="55" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_55/3" n="3"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/55/3">Listen to me and answer me when I lament and sigh.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="35" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_35/9" n="9"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/35/9">Let my soul exult in the Lord, rejoice in His help.</tei:seg> </tei:p>
        <tei:p><tei:milestone unit="verse"/><tei:milestone unit="chapter"/><tei:milestone unit="chapter" n="144" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144"/><tei:milestone unit="verse" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/cantor_four_verses/psalms_144/10" n="10"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/144/10">It is He who gives salvation to kings, who saves His servant David from the evil sword.</tei:seg> <tei:milestone unit="verse"/><tei:milestone unit="chapter"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</file>
