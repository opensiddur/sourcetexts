    {
      "stem": "ahavah_rabbah",
      "urn": "urn:x-opensiddur:text:prayer:ahavah_rabbah",
      "title": {
        "he": "אַהֲבָה רַבָּה",
        "en": "With great love"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וַתְּלַמְּדֵם חֻקֵּי חַיִּים כֵּן תְּחָנֵּנוּ וּתְלַמְּדֵנוּ: אָבִינוּ הָאָב הָרַחֲמָן הַמְרַחֵם רַחֵם עָלֵינוּ וְתֵן בְּלִבֵּנוּ לְהָבִין וּלְהַשְׂכִּיל לִשְׁמֹעַ לִלְמֹד וּלְלַמֵּד לִשְׁמֹר וְלַעֲשׂוֹת וּלְקַיֵּם אֶת־כָּל־דִּבְרֵי תַלְמוּד תּוֹרָתֶךָ בְּאַהֲבָה: וְהָאֵר עֵינֵינוּ בְּתוֹרָתֶךָ וְדַבֵּק לִבֵּנוּ בְּמִצְוֹתֶיךָ וְיַחֵד לְבָבֵנוּ לְאַהֲבָה וּלְיִרְאָה שְׁמֶךָ וְלֹא־נֵבוֹשׁ לְעוֹלָם וָעֶד: כִּי בְשֵׁם קָדְשְׁךָ הַגָּדוֹל וְהַנּוֹרָא בָטָחְנוּ נָגִילָה וְנִשְׂמְחָה בִּישׁוּעָתֶךָ:",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/ahavah"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s110",
                "printed_page": "41",
                "text": "וַהֲבִיאֵנוּ לְשָׁלוֹם מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ וְתוֹלִיכֵנוּ קוֹמְמִיּוּת לְאַרְצֵנוּ: כִּי אֵל פּוֹעֵל יְשׁוּעוֹת אָֽתָּה וּבָנוּ בָחַרְתָּ מִכָּל־עַם וְלָשׁוֹן וְקֵרַבְתָּנוּ לְשִׁמְךָ הַגָּדוֹל סֶלָה בֶּאֱמֶת. לְהוֹדוֹת לְךָ וּלְיַחֶדְךָ בְּאַהֲבָה: בָּרוּךְ אַתָּה יְיָ הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:ahavah_rabbah/vahavienu"
          }
        ]
      }
