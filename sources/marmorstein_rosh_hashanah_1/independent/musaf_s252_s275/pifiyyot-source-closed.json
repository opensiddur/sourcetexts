  "units": [
    {
      "stem": "musaf_heyeh_im_pifiyot",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/heyeh_im_pifiyot",
      "title": {
        "he": "היה עם פיפיות",
        "en": "Be with the mouths of Thy emissaries"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/1",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ הֱיֵה עִם פִּיפִיּוֹת שְׁלוּחֵי עַמְּךָ בֵּית יִשְׂרָאֵל. הָעוֹמְדִים לְבַקֵּשׁ תְּפִלָּה וְתַחֲנוּנִים מִלְּפָנֶיךָ עַל עַמְּךָ בֵּית יִשְׂרָאֵל.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/2",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "הוֹרֵם מַה שֶּׁיֹּאמְרוּ. הֲבִינֵם מַה שֶּׁיְּדַבֵּרוּ. הֲשִׁיבֵם מַה שֶׁיִּשְׁאֲלוּ. יַדְּעֵם הֵיךְ יְפָאֵֽרוּ:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/3",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "בְּאוֹר פָּנֶיךָ יְהַלֵּכוּן. בֶּרֶךְ לְךָ יִכְרְעוּן. עַמְּךָ בְּפִיהֶם יְבָרְכוּן.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/4",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "וּמִבִּרְכוֹת פִּיךָ כֻּלָּם יִתְבָּרְכוּן: עַמְּךָ לְפָנֶיךָ יַעֲבִירוּן. וְהֵם בַּתָּֽוֶךְ יַעֲבוֹרוּן:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/5",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "עֵינֵי עַמְּךָ בָּם תְּלוּיוֹת. וְעֵינֵיהֶם לְךָ מְיַחֲלוֹת:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/6",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s256",
                "printed_page": "118",
                "text": "גָּשִׁים מוּל אֲרוֹן הַקֹּדֶשׁ בְּאֵימָה. לְשַׁכֵּךְ כַּעַס",
                "page_start": false
              },
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "וְחֵימָה. וְעַמְּךָ מְסַבְּבִים אוֹתָם כַּחוֹמָה. וְאַתָּה מִן הַשָּׁמַיִם תַּשְׁגִּיחַ אוֹתָם לְרַחֲמָה:",
                "page_start": true
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/7",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "עַיִן נוֹשְׂאִים לְךָ לַשָּׁמָיִם. לֵב שׁוֹפְכִים נָכְחֲךָ כַּמַּיִם. וְאַתָּה תִּשְׁמַע מִן הַשָּׁמָיִם:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/8",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "שֶׁלֹּא יִכָּשְׁלוּ בִלְשׁוֹנָם. וְלֹא יִנָּקְשׁוּ בְּשִׁנּוּנָם. וְלֹא יֵבֹשׁוּ בְּמַשְׁעֵנָם. וְלֹא יִכָּלְמוּ בָם שְׁאוֹנָם.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/9",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "וְאַל יֹאמַר פִּיהֶם דָּבָר שֶׁלֹּא כִרְצוֹנֶךָ: כִּי חֲנוּנֶיךָ יְיָ אֱלֹהֵינוּ הֵמָּה חֲנוּנִים. וּמְרֻחָמֶיךָ הֵמָּה מְרֻחָמִים:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/10",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "כְּמוֹ שֶׁיָּדַֽעְנוּ יְיָ אֱלֹהֵינוּ אֶת אֲשֶׁר תָּחוֹן יוּחָן. וְאֵת אֲשֶׁר תְּרַחֵם יְרֻחָם:",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/11",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "כַּכָּתוּב בְּתוֹרָתֶךָ וְחַנֹּתִי אֶת אֲשֶׁר אָחֹן. וְרִחַמְתִּי אֶת אֲשֶׁר אֲרַחֵם:",
                "page_start": false,
                "quotations": [
                  {
                    "text": "וְחַנֹּתִי אֶת אֲשֶׁר אָחֹן. וְרִחַמְתִּי אֶת אֲשֶׁר אֲרַחֵם:",
                    "source_reference": "urn:x-opensiddur:text:bible:exodus/33/19",
                    "source_reference_part": {
                      "unit": "half-verse",
                      "n": "b",
                      "corresp": "urn:x-opensiddur:text:bible:exodus/33/19/b"
                    }
                  }
                ]
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 2,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "וְנֶאֱמַר אַל יֵבֹשׁוּ בִי קֹוֶיךָ אֲדֹנָי אֱלֹהִים צְבָאוֹת. אַל יִכָּלְמוּ בִי מְבַקְשֶׁיךָ אֱלֹהֵי יִשְׂרָאֵל:",
                "page_start": false,
                "quotations": [
                  {
                    "text": "אַל יֵבֹשׁוּ בִי קֹוֶיךָ אֲדֹנָי אֱלֹהִים צְבָאוֹת. אַל יִכָּלְמוּ בִי מְבַקְשֶׁיךָ אֱלֹהֵי יִשְׂרָאֵל:",
                    "source_reference": "urn:x-opensiddur:text:bible:psalms/69/7",
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12/quotes/psalms/69",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12/quotes/psalms/69/7"
                  }
                ]
              }
            ],
            "end_reference": true
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/1",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "Our God and God of our fathers, be with the mouths of the emissaries of Thy people, the House of Israel, who rise to entreat in prayer and supplication before Thee on behalf of Thy people the House of Israel.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/2",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "Teach them what they should say, make them understand what they should speak, grant them what they request and instruct them how they should glorify Thee.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/3",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "Let them walk in the light of Thy countenance, bend the knee before Thee, bless Thy people through their mouths",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/4",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "and by the blessings of Thy mouth may they all be blessed. Thy people do they lead past Thee and they pass by in their midst.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/5",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "The eyes of Thy people hang upon them and their eyes hope for Thee.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/6",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s257",
                "printed_page": "118",
                "text": "They approach the",
                "page_start": false
              },
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "Holy Ark in awe to soften anger and wrath; Thy people surround them like a wall and Thou dost watch from heaven to show them mercy.",
                "page_start": true
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/7",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "They lift up their eyes to Thee in heaven, they pour out their hearts before Thee like water and Thou dost hear them from heaven,",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/8",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "lest they stumble with their tongue, be confused in their repetition or be shamed in their confidence, lest their congregation be disgraced by them",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/9",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "and their mouth say aught that is not according to Thy will. For those favoured by Thee, O Lord our God, are indeed favoured and those who are pitied by Thee are truly pitied,",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/10",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "as we know well, O Lord our God, that he whom Thou dost favour is favoured and he whom Thou hast pitied, is pitied.",
                "page_start": false
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/11",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "As it is written in Thy Torah: ‘I will favour him whom I favour and pity him whom I pity’.",
                "page_start": false,
                "quotations": [
                  {
                    "text": "‘I will favour him whom I favour and pity him whom I pity’.",
                    "source_reference": "urn:x-opensiddur:text:bible:exodus/33/19",
                    "source_reference_part": {
                      "unit": "half-verse",
                      "n": "b",
                      "corresp": "urn:x-opensiddur:text:bible:exodus/33/19/b"
                    }
                  }
                ]
              }
            ],
            "end_reference": true
          },
          {
            "paragraph": 2,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12",
            "reference_unit": "stanza",
            "fragments": [
              {
                "scan": "s259",
                "printed_page": "119",
                "text": "And it was said: ‘Let those who trust in Thee, O Lord God of Hosts, not be shamed through me, let those who seek Thee, O God of Israel, not be disgraced through me’.",
                "page_start": false,
                "quotations": [
                  {
                    "text": "‘Let those who trust in Thee, O Lord God of Hosts, not be shamed through me, let those who seek Thee, O God of Israel, not be disgraced through me’.",
                    "source_reference": "urn:x-opensiddur:text:bible:psalms/69/7",
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12/quotes/psalms/69",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/12/quotes/psalms/69/7"
                  }
                ]
              }
            ],
            "end_reference": true
          }
        ]
      },
