    {
      "stem": "musaf_ochilah",
      "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/ochilah",
      "title": {
        "he": "אוחילה לאל",
        "en": "I pray to God"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/13",
            "reference_unit": "stanza",
            "end_reference": true,
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "אוֹחִילָה לָאֵל. אֲחַלֶּה פָנָיו. אֶשְׁאֲלָה מִמֶּנּוּ. מַעֲנֵה לָשׁוֹן: אֲשֶׁר בִּקְהַל עָם. אָשִׁירָה עֻזּוֹ: אַבִּיעָה רְנָנוֹת. בְּעַד מִפְעָלָיו:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/14",
            "reference_unit": "stanza",
            "end_reference": true,
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "לְאָדָם מַעַרְכֵי לֵב. וּמֵיְיָ מַעֲנֵה לָשׁוֹן:",
                "page_start": false,
                "quotations": [
                  {
                    "text": "לְאָדָם מַעַרְכֵי לֵב. וּמֵיְיָ מַעֲנֵה לָשׁוֹן:",
                    "source_reference": "urn:x-opensiddur:text:bible:proverbs/16/1",
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/14/quotes/proverbs/16",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/14/quotes/proverbs/16/1"
                  }
                ]
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/15",
            "reference_unit": "stanza",
            "end_reference": true,
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "אֲדֹנָי שְׂפָתַי תִּפְתָּח וּפִי יַגִּיד תְּהִלָּתֶךָ:",
                "page_start": false,
                "quotations": [
                  {
                    "text": "אֲדֹנָי שְׂפָתַי תִּפְתָּח וּפִי יַגִּיד תְּהִלָּתֶךָ:",
                    "source_reference": "urn:x-opensiddur:text:bible:psalms/51/17",
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/15/quotes/psalms/51",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/15/quotes/psalms/51/17"
                  }
                ]
              }
            ]
          },
          {
            "paragraph": 1,
            "corresp": "urn:x-opensiddur:text:prayer:heyeh_im_pifiyot/16",
            "reference_unit": "stanza",
            "end_reference": true,
            "fragments": [
              {
                "scan": "s258",
                "printed_page": "119",
                "text": "יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי:",
                "page_start": false,
