rayer:amidah/gevurot/attah_gibbor"}, "citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor", "fragments": [{"page_start": false, "printed_page": "16", "scan": "s26", "text": "אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ."}], "paragraph": 1}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim", "fragments": [{"page_start": false, "printed_page": "16", "scan": "s26", "text": "מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:"}], "paragraph": 2}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha", "fragments": [{"page_start": false, "printed_page": "16", "scan": "s26", "text": "מִי כָמוֹךָ אַב הָרַחֲמִים. זוֹכֵר יְצוּרָיו לַחַיִּים בְּרַחֲמִים."}], "paragraph": 3}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim", "fragments": [{"page_start": false, "printed_page": "16", "scan": "s26", "text": "וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה יְיָ מְחַיֵּה הַמֵּתִים:"}], "paragraph": 4}]}, "stem": "rh_gevurot", "title": {"en": "Evening Prayer for the New Year — Divine might", "he": "גבורות"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/gevurot"}, "variants": [{"host": "rh_gevurot", "id": "rh_gevurot_attah_gibbor_en", "identity": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor", "lang": "en", "printed": "Thou art for ever mighty, O Lord the reviver of the dead, Thou art great to save.", "printings": [{"printed_page": "16", "scan": "s27"}, {"printed_page": "102", "scan": "s225"}], "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/attah_gibbor/for_ever", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n26.jpg", "text": "Thou art for ever mighty, O Lord the reviver of the dead, Thou art great to save."}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/attah_gibbor/forever", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n224.jpg", "text": "Thou art forever mighty, O Lord the reviver of the dead, Thou art great to save."}]}, {"host": "rh_gevurot", "id": "rh_gevurot_mekhalkel_chayyim_en", "identity": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim", "lang": "en", "printed": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling and healing the sick and releasing captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth.", "printings": [{"printed_page": "16", "scan": "s27"}, {"printed_page": "102", "scan": "s225"}], "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mekhalkel_chayyim/falling_and_healing", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n26.jpg", "text": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling and healing the sick and releasing captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth."}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mekhalkel_chayyim/falling_healing", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n224.jpg", "text": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling, healing the sick, and releasing captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth."}]}, {"host": "rh_gevurot", "id": "rh_gevurot_mi_khamokha_en", "identity": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha", "lang": "en", "printed": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion.", "printings": [{"printed_page": "16", "scan": "s27"}, {"printed_page": "103", "scan": "s227"}], "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mi_khamokha/compassion_with_comma", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n26.jpg", "text": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion."}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mi_khamokha/compassion_without_comma", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n226.jpg", "text": "Who is like Thee, Father of compassion who remembers His creatures for life in compassion;"}]}, {"host": "rh_gevurot", "id": "rh_gevurot_mechayyeh_hametim_en", "identity": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim", "lang": "en", "printed": "And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead.", "printings": [{"printed_page": "16", "scan": "s27"}, {"printed_page": "103", "scan": "s227"}], "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mechayyeh_hametim/and_thou_lord_without_comma", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n26.jpg", "text": "And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead."}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/gevurot/mechayyeh_hametim/and_thou_lord_with_comma", "facs": "https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n226.jpg", "text": "and Thou art faithful to revive the dead. Blessed art Thou, O Lord, who revives the dead."}]}]}
