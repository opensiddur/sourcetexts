xt:prayer:amidah/qedushah/uvedivrei", "fragments": [{"page_start": false, "printed_page": "3", "scan": "s9", "text": "וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר."}], "speaker": {"abbr": "ח׳", "expan": "חזן"}}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/yimlokh", "fragments": [{"page_start": false, "printed_page": "3", "scan": "s9", "text": "יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלֲלוּיָהּ:"}], "speaker": {"abbr": "קו״ח", "expan": "קהל וחזן"}}, {"canonical": "urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador", "fragments": [{"page_start": false, "printed_page": "3", "scan": "s9", "text": "לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה."}], "speaker": {"abbr": "ח׳", "expan": "חזן"}}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/hael_haqadosh", "fragments": [{"page_start": false, "printed_page": "3", "scan": "s9", "text": "בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:"}]}]}, "page_context": "minchah/qedushah", "stem": "amidah_qedushah", "title": {"en": "Kedushah", "he": "קדושה"}, "urn": "urn:x-opensiddur:text:prayer:amidah/qedushah", "wording_selection": [{"features": {"urn:x-opensiddur:condition:prayer:amidah/qedushah/barukh_kevod/kevod_name_with_maqaf": true, "urn:x-opensiddur:condition:prayer:amidah/qedushah/barukh_kevod/kevod_name_without_maqaf": false, "urn:x-opensiddur:condition:prayer:amidah/qedushah/ledor_vador/dor_defective": false, "urn:x-opensiddur:condition:prayer:amidah/qedushah/ledor_vador/dor_plene": true, "urn:x-opensiddur:condition:prayer:amidah/qedushah/qadosh/haaretz_with_meteg": false, "urn:x-opensiddur:condition:prayer:amidah/qedushah/qadosh/haaretz_without_meteg": true}, "type": "opensiddur:variant"}]}, "variants": []}
