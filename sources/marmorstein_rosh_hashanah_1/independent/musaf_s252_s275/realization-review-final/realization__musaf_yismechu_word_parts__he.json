{"corrections": [], "documentary_instructions_sha256": "6f957bfb4979ed5582d14bb37743b36d6087f068676fba2db8d6d1f5d7a27cf5", "expanded_order_sha256": "d21ec0b0696e39475a9df5fddfd759423065a6c1c0f2d56bdc01b13a40af8a2a", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "fc8e3c6bab81298c4c3c01d23e025be34541c23990201aeac63a574a96490ca7", "unit": {"canonical_parts": true, "citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/text", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "93", "scan": "s206", "text": "יִשְׂמְחוּ בְּמַלְכוּתְךָ שֹׁמְרֵי שַׁבָּת וְקוֹרְאֵי עֹנֶג עַם מְקַדְּשֵׁי שְׁבִיעִי. כֻּלָּם יִשְׂבְּעוּ וְיִתְעַנְּגוּ מִטּוּבֶךָ וּבַשְּׁבִיעִי רָצִיתָ בּוֹ וְקִדַּשְׁתּוֹ חֶמְדַּת יָמִים אוֹתוֹ קָרָאתָ זֵכֶר לְמַעֲשֵׂה בְרֵאשִׁית:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:prayer:amidah/yismechu_vemalkhutekha"}]}, "stem": "musaf_yismechu_word_parts", "title": {"en": "Sabbath delight", "he": "ישמחו במלכותך"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/word_parts"}, "variants": []}
