{"corrections": [], "documentary_instructions_sha256": "6f957bfb4979ed5582d14bb37743b36d6087f068676fba2db8d6d1f5d7a27cf5", "expanded_order_sha256": "d21ec0b0696e39475a9df5fddfd759423065a6c1c0f2d56bdc01b13a40af8a2a", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "fc8e3c6bab81298c4c3c01d23e025be34541c23990201aeac63a574a96490ca7", "unit": {"citations": {"he": [{"abbreviations": [{"abbr": "נ״א", "expan": "נוסח אחר"}], "language": "he", "note_type": "annotation", "scan": "s246", "target": "#musaf_tehillot_kevodekha_source_variant_1", "text": "נ״א"}, {"abbreviations": [{"abbr": "נ״א", "expan": "נוסח אחר"}], "language": "he", "note_type": "annotation", "scan": "s246", "target": "#musaf_tehillot_kevodekha_source_variant_2", "text": "נ״א"}]}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:tehillot_kevodekha/tehillot", "end_reference": true, "fragments": [{"alternatives": [{"printed": "גָּעֲשׁוּ (נ״א גֵּעַשׁ)", "readings": [{"corresp": "urn:x-opensiddur:condition:poem:tehillot_kevodekha/tehillot/gaashu", "text": "גָּעֲשׁוּ"}, {"corresp": "urn:x-opensiddur:condition:poem:tehillot_kevodekha/tehillot/geash", "text": "גֵּעַשׁ"}], "xml_id": "musaf_tehillot_kevodekha_source_variant_1"}], "page_start": false, "printed_page": "113", "scan": "s246", "text": "תְּהִלּוֹת כְּבוֹדְךָ, אָמְצְךָ מְלֹא כָל הָאָרֶץ. שִׁמְעֲךָ דִּין מִשָּׁמַיִם, בְּכֵן יָרְאָה וְשָׁקְטָה הָאָרֶץ. רַעַשׁ יוֹם מִשְׁפָּט, גָּעֲשׁוּ (נ״א גֵּעַשׁ) תְּהוֹמוֹת הָאָרֶץ. קוֹל שׁוֹפָר חָזָק, דִּבֵּר וַיִּקְרָא אָרֶץ. צְבִי לַצַּדִּיק בְּזֶמֶר, הִשְׁמִיעָה כְּנַף הָאָרֶץ. פַּחַד וָפַחַת וָפַח, וּפַלָּצוּת יַבְעִיתוּ אָרֶץ. עֵת תָּקוּם לַמִּשְׁפָּט, זְעוֹם כָּל אַפְסֵי אָרֶץ. "}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ק׳", "expan": "קהל"}}, {"corresp": "urn:x-opensiddur:text:poem:tehillot_kevodekha/sollu_pannu", "end_reference": true, "fragments": [{"alternatives": [{"printed": "סֹלּוּ פַּנּוּ (נ״א סוּרוּ מִנִּי)", "readings": [{"corresp": "urn:x-opensiddur:condition:poem:tehillot_kevodekha/sollu_pannu/sollu_pannu", "text": "סֹלּוּ פַּנּוּ"}, {"corresp": "urn:x-opensiddur:condition:poem:tehillot_kevodekha/sollu_pannu/suru_minni", "text": "סוּרוּ מִנִּי"}], "xml_id": "musaf_tehillot_kevodekha_source_variant_2"}], "page_start": false, "printed_page": "113", "scan": "s246", "text": "סֹלּוּ פַּנּוּ (נ״א סוּרוּ מִנִּי) דֶּרֶךְ יְנוֹבְבוּ, חֲרֵדִים מֵחֶרְדַּת הָאָרֶץ. נָאוֹר וְאַדִּיר, טַעַם תָּשִׁיב לָאָרֶץ. מַה תִּירְאִי אֲדָמָה, יָרִיעוּ תַּחְתִּיֹּת אָרֶץ:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}}, {"corresp": "urn:x-opensiddur:text:poem:tehillot_kevodekha/lehitvadda", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "113", "scan": "s246", "text": "לְהִתְוַדַּע וּלְהִגָּלוֹת, כִּי הוּא מֶלֶךְ עַל כָּל הָאָרֶץ. כְּמוֹ פֵּאֲרוּהוּ מֵאָז בַּשַּׁחַק, יֻרְשׁוּ בְּחוּנָיו לְפָאֲרוֹ בָּאָרֶץ:"}], "paragraph": 2, "reference_unit": "stanza", "speaker": {"abbr": "קו״ח", "expan": "קהל וחזן"}}]}, "review_encoding": true, "source_notes": {"en": [{"language": "en", "text": "The printed English follows the main Hebrew readings rendered as “roared” and “Make straight, clear the way.” This edition prints no English alternatives for the corresponding Hebrew variants."}]}, "stem": "musaf_tehillot_kevodekha", "title": {"en": "The fame of Thine honour", "he": "תהלות כבודך"}, "urn": "urn:x-opensiddur:text:poem:tehillot_kevodekha"}, "variants": []}
