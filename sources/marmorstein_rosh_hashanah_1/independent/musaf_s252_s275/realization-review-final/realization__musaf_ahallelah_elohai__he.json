ׂעוּ שְׁעָרִים רָאשֵׁיכֶם וּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבֹא מֶלֶךְ הַכָּבוֹד:"}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/9", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/9", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_9/psalms_24/9"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_10/psalms_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "מִי הוּא זֶה מֶלֶךְ הַכָּבוֹד יְיָ צְבָאוֹת הוּא מֶלֶךְ הַכָּבוֹד סֶלָה:"}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/10", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/10", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_10/psalms_24/10"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/39", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "125", "scan": "s270", "text": "רָבְצָה עֲדִינָה. שָׁקְדָה מֵאַלְמוֹן. כִּי אָרַךְ לָהּ. קֵץ הַמְּלוּכָה:"}], "paragraph": 11, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/40", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "רִיבוּ מוֹשִׁיעִים. שְׂאוּ אֶדֶר מֵאֱדוֹם. וְשִׁית עַל אָדוֹן. הוֹד הַמְּלוּכָה:"}], "paragraph": 11, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 12}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/obadiah_1_21/obadiah_1", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "וְעָלוּ מוֹשִׁיעִים בְּהַר צִיּוֹן לִשְׁפֹּט אֶת הַר עֵשָׂו וְהָיְתָה לַייָ הַמְּלוּכָה:"}], "paragraph": 12, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:obadiah/1/21", "source_reference": "urn:x-opensiddur:text:bible:obadiah/1/21", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/obadiah_1_21/obadiah_1/21"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/41", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "שָׁוְא שָׂנֵא אֵל. וְהוּא עַל לְשׁוֹנֵנוּ. בִּקֵּשׁ אֱמֶת וָאָיִן. וְרָחֲקָה מְלוּכָה:"}], "paragraph": 13, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/42", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "שַׁדַּי הָסֵר אָוֶן מִצְּבָאֶךָ. וְיָרִיעוּ לְךָ. תְּרוּעַת מְלוּכָה:"}], "paragraph": 13, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 14}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/numbers_23_21/numbers_23", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "לֹא הִבִּיט אָוֶן בְּיַעֲקֹב וְלֹא רָאָה עָמָל בְּיִשְׂרָאֵל יְיָ אֱלֹהָיו עִמּוֹ וּתְרוּעַת מֶלֶךְ בּוֹ:"}], "paragraph": 14, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:numbers/23/21", "source_reference": "urn:x-opensiddur:text:bible:numbers/23/21", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/numbers_23_21/numbers_23/21"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/43", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "תַּחְגּוֹר גֵּאוּת. תִּתְאַזָּר עֹז. לְבַל יִשְׂתָּרֵר. זָר בִּמְלוּכָה:"}], "paragraph": 15, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/44", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "126", "scan": "s272", "text": "תִּכּוֹן תֵּבֵל. כִּי יְנֻעַר רָשָׁע. וְשָׂם צֶדֶק לְרַגְלָיו. וְיִצְנוֹף מְלוּכָה:"}], "paragraph": 16, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 17}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_93_1/psalms_93", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "יְיָ מָלָךְ גֵּאוּת לָבֵשׁ לָבֵשׁ יְיָ עֹז הִתְאַזָּר אַף תִּכּוֹן תֵּבֵל בַּל תִּמּוֹט:"}], "paragraph": 17, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/93/1", "source_reference": "urn:x-opensiddur:text:bible:psalms/93/1", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_93_1/psalms_93/1"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/45", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "תִּקּוֹם גּוֹיִם. תּוֹכִיחַ לְאֻמִּים. תִּשְׁבּוֹר מַטֵּה רֶשַׁע. מוֹשֵׁל הַמְּלוּכָה:"}], "paragraph": 18, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/46", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "תַּחֲלִיף אֱלִילִים. תִּשָּׂגֵב לְבַדֶּךָ. תִּקָּרֵא נֶצַח. יָחִיד בִּמְלוּכָה:"}], "paragraph": 18, "reference_unit": "stanza", "speaker": {"label": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 19}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/zechariah_14_9/zechariah_14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "וְהָיָה יְיָ לְמֶלֶךְ עַל כָּל הָאָרֶץ בַּיּוֹם הַהוּא יִהְיֶה יְיָ אֶחָד וּשְׁמוֹ אֶחָד:"}], "paragraph": 19, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:zechariah/14/9", "source_reference": "urn:x-opensiddur:text:bible:zechariah/14/9", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/zechariah_14_9/zechariah_14/9"}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "וּבְתוֹרָתְךָ כָּתוּב לֵאמֹר"}], "paragraph": 19}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_6_4/deuteronomy_6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s272", "text": "שְׁמַע יִשְׂרָאֵל יְיָ אֱלֹהֵינוּ יְיָ אֶחָד:"}], "paragraph": 19, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4", "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/6/4", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_6_4/deuteronomy_6/4"}]}, "review_encoding": true, "stem": "musaf_ahallelah_elohai", "title": {"en": "I praise my God", "he": "אהללה אלהי"}, "urn": "urn:x-opensiddur:text:poem:ahallelah_elohai"}, "variants": []}
