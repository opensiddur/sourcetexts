rence_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/36", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "צָעֲדוּ בְּמֵי שַׁעַל. צָפוּ בְּרוּחַ שֵׂכֶל. אָנָה יִנָּטְעוּ וִיקַבְּלוּ מְלוּכָה:"}], "paragraph": 7, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 8}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_17/exodus_15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "תְּבִאֵמוֹ וְתִטָּעֵמוֹ בְּהַר נַחֲלָתְךָ מָכוֹן לְשִׁבְתְּךָ פָּעַלְתָּ יְיָ מִקְּדָשׁ אֲדֹנָי כּוֹנְנוּ יָדֶיךָ:"}], "paragraph": 8, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/15/17", "source_reference": "urn:x-opensiddur:text:bible:exodus/15/17", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_17/exodus_15/17"}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "וְנֶאֱמַר"}], "paragraph": 8}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_18/exodus_15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "יְיָ יִמְלֹךְ לְעֹלָם וָעֶד:"}], "paragraph": 8, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/15/18", "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_18/exodus_15/18"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/37", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "קֻמְטוּ שַׁעֲרֵי זְבוּל. בֵּית עוֹלָמִים. כִּי מִבֵּינֵימוֹ. שָ