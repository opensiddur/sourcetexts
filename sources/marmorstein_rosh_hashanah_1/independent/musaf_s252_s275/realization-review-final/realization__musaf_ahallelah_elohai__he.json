{"corrections": [{"after": " שְׁעָרִים", "before": "", "corr": "שְׂאוּ", "file": "prayerbook_for_the_new_year-heidenheim-1965-he/musaf_ahallelah_elohai.xml", "id": "musaf_shabbat_seu_ayin", "key": "ahallelah_verse2", "reason": "Human394b confirms printed ayin is an obvious source typo; preserve in sic with alef in corr.", "scan": "s268", "sic": "שְׂעוּ"}], "documentary_instructions_sha256": "6f957bfb4979ed5582d14bb37743b36d6087f068676fba2db8d6d1f5d7a27cf5", "expanded_order_sha256": "d21ec0b0696e39475a9df5fddfd759423065a6c1c0f2d56bdc01b13a40af8a2a", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "fc8e3c6bab81298c4c3c01d23e025be34541c23990201aeac63a574a96490ca7", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/1", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "אֲהַלְלָה אֱלֹהַי. אָשִׁירָה עֻזּוֹ. אֲסַפְּרָה כְבוֹדוֹ. אֲאַפְּדֶנּוּ מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"label": "קהל.", "role": "congregation"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/2", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "אֲשַׂגֵּב לְפוֹעֵל. אֲשֶׁר שָׂח וּפָעַל. אֲנַוֵּהוּ. כִּי לוֹ יָאֲתָה מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/3", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "בְּעֻזּוֹ נֶצַח אֲשַׁנֵּן. כִּי צְבָאוֹ אָנִי. וְלִי נָאֶה שִׂיחַ. גֹּדֶל הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/4", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "בְּקָהָל אֲבַשֵּׂר. בְּרָב עָם אֲדַבֵּר. לְמִי שְׂאֵת וְיֶתֶר עָז. וּלְמִי הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/5", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "גּוֹשׁוּ גּוֹיִם. וּבֹאוּ מַמְלָכוֹת. רְאוּ מַה נֶהְדָּר. בְּמֵצַח הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "גַּדְּלוּהוּ אִתִּי. וּנְרוֹמְמֶנְהוּ יַחַד. וְאַל תִּתְגָּאוּ. בְּנֵזֶר הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/7", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "דְּרָכִים בְּעֵת. נֶעֶשְׂתָה מְצוּלָה. הִתְבּוֹנְנוּ יַחַד. לְמִי נִזְרְקָה מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "דָּרַךְ סוּס בַּיָּם. כְּנֶגֶד שֵׁשׁ מֵאוֹת רֶכֶב. וּמַה יוֹעִיל גֶּבֶר. עֹז בִּמְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/9", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "הֶאֱזִינוּ רוֹזְנִים. אָז וַיִּרְגָּזוּ. הִבִּיטוּ חֲתַת. וּמָאֲסוּ מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/10", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "הִגִּידוּ כֹחוֹ. לְאֻמִּים וְדִבֵּרוּ. לָזֶה יִכָּתֵב. שֵׁם הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/11", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "וְנִלְחַם רֵאשִׁית. גּוֹיִם"}, {"page_start": true, "printed_page": "121", "scan": "s262", "text": "וְאָבַד. כִּי נִשְׁבַּע חַי. בְּכִסֵּא מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/12", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "וַיָּלְעַג בְּכָל דּוֹר. כִּי לֹא לָמַד. מִי נִלְחַם בַּיָּם. וְעָטָה מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/13", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "זָד עַל אֲדוֹנָיו. עֶבֶד יֹשֵׁב נֶגֶב. בְּזֹאת תִּרְגַּז אֶרֶץ. בִּשְׂאֵת עֶבֶד מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "זֶרַע בְּרוּכִים. הֶחֱרִימוּ אֲרוּרִים. כִּי נָתְנוּ קוֹל. לְאַדִּיר בִּמְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "חֶשְׁבּוֹן וּבָשָׁן. עוֹרְרוּ מִלְחֶמֶת. בְּלִי לָתֵת דֶּרֶךְ. לְצִבְאוֹת מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/16", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "חֵילָם נִשְׁמַד. וְאַרְצָם חֻלָּקָה. וּמֵעַל זְרוּעָם. נָפְלָה מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/17", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "טָפְשׁוּ בְּנֵי כְנַעַן. כִּי נָכְרִים הֵם. בְּאַדְמַת בְּנֵי שֵׁם. זֶרַע מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/18", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "טְבָחָם בִּן נוּן. עַד פִּנָּה אֶרֶץ. לִפְנֵי אֲרוֹן הַבְּרִית. אֲדוֹן הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/19", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "יוֹשְׁבֵי חֲרוֹשֶׁת. אָז הִקְשָׁה לַחַץ. עֲזָרוּהוּ בְּלִי בֶצַע. אַפְסֵי מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/20", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "יָהּ נִלְחַם בָּם. צָבָא בְּלִי בֶצַע. כֵּן יֹאבְדוּ שְׁאָר. וְלָאֵל הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/21", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "כְּאֶרֶז בַּלְּבָנוֹן. אַשּׁוּר גָּדַל. וְחֵרֵף אוֹרִיד."}, {"page_start": true, "printed_page": "122", "scan": "s264", "text": "כַּבִּיר הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/22", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "כְּלִיל אֵשׁ הֲמָמָם. בְּלֵיל שִׁמּוּרִים. וְאָז יָדְעוּ כֹל. כִּי לָאֵל הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/23", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "לַשַּׁחַת כָּרַע בֵּל. כְּחָשְׁבוֹ עֲלוֹת לַשַּׁחַק. וְסָר מֶנּוּ לְבַב אֱנוֹשׁ. וְרָד הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "לְכַנּוֹ הוּשַׁב. וְכֹחַ אֵל הִכִּיר. לְמֵרִים וּמַשְׁפִּיל. הִשְׁלִים מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/25", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "מֻגָּרָה צֹאן לָטֶבַח. וְנִתְכְּנוּ עֲלִילוֹת. בִּלְבוּשׁ צָעִיר. רֹדֶם הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/26", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "מְכוּרֵי בְלֹא הוֹן. פְּדוּיֵי בְלֹא כֶסֶף. סֹלּוּ לְמַטֵּה כַּמַּיִם. לֵב הַמְּלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/27", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "נִמְכְּרוּ יוֹנִים. לִבְנֵי יְוָנִים. וְרִחֲקוּם מֵעַל גְּבוּל מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/28", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "נֵאֲרוּ בְּרִית וָדָת. וְהִמְרִידוּ עָם בָּאֵל. וּמִגְּרוּם בְּלֹא כֹחַ. מְכַהֲנֵי מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/29", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "שָׂעִיר הֶחֱנִיף. לְהוֹרֵהוּ בְּצֵדוֹ. וַיִּירַשׁ בְּקוֹל בֶּכִי. חֶרֶב וּמְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/30", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "שֻׂגַּב חָלָק. הֱיוֹת גְּבִיר לְאֶחָיו. וְעוֹד תִּסּוֹב. לִישֻׁרוּן מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"label": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": true, "printed_page": "123", "scan": "s266", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 2}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_33_5/deuteronomy_33", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "וַיְהִי בִישֻׁרוּן מֶלֶךְ בְּהִתְאַסֵּף רָאשֵׁי עָם יַחַד שִׁבְטֵי יִשְׂרָאֵל:"}], "paragraph": 2, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/33/5", "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/33/5", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_33_5/deuteronomy_33/5"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/31", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "עֲשֵׂה לְךָ בְּצִיּוֹן. שֵׁם נוֹרָאת. כְּאָז תַּצְלִיחֶנָּה. בְּכִסֵּא מְלוּכָה:"}], "paragraph": 3, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/32", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "עוֹרֵר וְהָקֵץ. מְשׂוֹשׂ כָּל הָאָרֶץ. וְכוֹנֵן כִּסְאֲךָ. בְּקִרְיַת מְלוּכָה:"}], "paragraph": 3, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}, {"fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ."}], "paragraph": 4}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_48_3/psalms_48", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "יְפֵה נוֹף מְשׂוֹשׂ כָּל הָאָרֶץ. הַר צִיּוֹן יַרְכְּתֵי צָפוֹן קִרְיַת מֶלֶךְ רָ