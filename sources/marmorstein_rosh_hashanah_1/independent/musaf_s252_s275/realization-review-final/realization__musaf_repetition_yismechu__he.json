rosh_hashanah/musaf/yismechu/text", "fragments": [{"page_start": false, "printed_page": "117", "scan": "s254", "text": "יִשְׂמְחוּ בְּמַלְכוּתְךָ שֹׁמְרֵי שַׁבָּת וְקוֹרְאֵי עֹנֶג עַם מְקַדְּשֵׁי שְׁבִיעִי. כֻּלָּם יִשְׂבְּעוּ וְיִתְעַנְּגוּ מִטּוּבֶךָ וּבַשְּׁבִיעִי רָצִיתָ בּוֹ וְקִדַּשְׁתּוֹ חֶמְדַּת יָמִים אוֹתוֹ קָרָאתָ זֵכֶר לְמַעֲשֵׂה בְרֵאשִׁית:"}], "paragraph": 1}]}, "marked": true, "review_encoding": true, "stem": "musaf_repetition_yismechu", "title": {"en": "Sabbath delight", "he": "ישמחו במלכותך"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/yismechu"}, "variants": []}
