ךָ יְקָר יִתֵּנוּ. וִיקַבְּלוּ כֻלָּם אֶת־עֹל מַלְכוּתֶךָ. וְתִמְלוֹךְ עֲלֵיהֶם מְהֵרָה לְעוֹלָם וָעֶד. כִּי הַמַּלְכוּת שֶׁלְּךָ הִיא וּלְעוֹלְמֵי עַד תִּמְלוֹךְ בְּכָבוֹד:"}], "paragraph": 1}]}, "review_encoding": true, "stem": "musaf_repetition_al_ken", "title": {"en": "Therefore we hope", "he": "על כן נקוה"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/al_ken", "wording_selection": [{"features": {"urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/al_ken/text/en/quiet_printing": false, "urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/al_ken/text/en/repetition_printing": true, "urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/al_ken/text/he/quiet_printing": false, "urn:x-opensiddur:condition:siddur:rosh_hashanah/musaf/al_ken/text/he/repetition_printing": true}, "type": "opensiddur:variant"}]}, "variants": []}
