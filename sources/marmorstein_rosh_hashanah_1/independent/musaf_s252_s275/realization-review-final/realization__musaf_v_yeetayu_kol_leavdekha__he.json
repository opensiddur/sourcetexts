{"corrections": [], "documentary_instructions_sha256": "6f957bfb4979ed5582d14bb37743b36d6087f068676fba2db8d6d1f5d7a27cf5", "expanded_order_sha256": "d21ec0b0696e39475a9df5fddfd759423065a6c1c0f2d56bdc01b13a40af8a2a", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "fc8e3c6bab81298c4c3c01d23e025be34541c23990201aeac63a574a96490ca7", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/1", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "וְיֶאֱתָיוּ כל לְעָבְדֶךָ. וִיבָרְכוּ שֵׁם כְּבוֹדֶךָ. וְיַגִּידוּ בָאִיִּים צִדְקֶךָ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/2", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "וְיִדְרְשׁוּךָ עַמִּים לֹא יְדָעוּךָ. וִיהַלְלוּךָ כָּל־אַפְסֵי אָרֶץ. וְיוֹמְרוּ תָמִיד יִגְדַּל יְיָ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/3", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": ""}], "paragraph": 1, "reference_unit": "stanza"}, {"conditions": [{"features": {"urn:x-opensiddur:condition:poem:v_yeetayu_kol_leavdekha/veyizbechu": true}, "type": "opensiddur:variant"}], "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "(וְיִזְבְּחוּ"}, {"page_start": false, "printed_page": "116", "scan": "s252", "text": "לְךָ אֶת־זִבְחֵיהֶם.)"}], "marked": true, "paragraph": 1}, {"deferred_page_boundary": true, "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": " וְיִזְנְחוּ אֶת־עֲצַבֵּיהֶם. וְיַחְפְּרוּ עִם פְּסִילֵיהֶם: וְיַטּוּ שְׁכֶם אֶחָד לְעָבְדֶךָ. "}], "paragraph": 1}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/4", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִירָאוּךָ עִם־שֶׁמֶשׁ מְבַקְשֵׁי פָנֶיךָ. וְיַכִּירוּ כֹּחַ מַלְכוּתֶךָ. וִילַמְּדוּ תוֹעִים בִּינָה. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/5", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וִימַלְּלוּ אֶת־גְּבוּרָתֶךָ. וִינַשְּׂאוּךָ מִתְנַשֵּׂא לְכֹל לְרֹאשׁ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/6", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וִיסַלְּדוּ בְּחִילָה פָּנֶיךָ. וִיעַטְּרוּךָ נֵזֶר תִּפְאָרָה. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/7", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִפְצְחוּ הָרִים רִנָּה. וְיִצְהֲלוּ אִיִּים בְּמָלְכֶךָ: וִיקַבְּלוּ עֹל מַלְכוּתְךָ עֲלֵיהֶם. וִירוֹמְמוּךָ בִּקְהַל עָם. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִשְׁמְעוּ רְחוֹקִים וְיָבוֹאוּ. וְיִתְּנוּ לְךָ כֶּתֶר מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}]}, "review_encoding": true, "stem": "musaf_v_yeetayu_kol_leavdekha", "title": {"en": "All will come to serve Thee", "he": "ויאתיו"}, "urn": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha"}, "variants": []}
