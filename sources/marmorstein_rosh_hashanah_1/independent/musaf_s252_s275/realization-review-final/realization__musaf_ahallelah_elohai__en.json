{"corrections": [], "documentary_instructions_sha256": "6f957bfb4979ed5582d14bb37743b36d6087f068676fba2db8d6d1f5d7a27cf5", "expanded_order_sha256": "d21ec0b0696e39475a9df5fddfd759423065a6c1c0f2d56bdc01b13a40af8a2a", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "fc8e3c6bab81298c4c3c01d23e025be34541c23990201aeac63a574a96490ca7", "unit": {"citations": {"en": []}, "instructions": [], "languages": {"en": [{"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/1", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "I praise my God, sing of His might, tell of His honour, I crown Him with a kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/2", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "I will exalt the Creator who spoke and created, I will glorify Him for the kingdom becomes Him."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/3", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "His might shall I ever repeat for I am of His host, and for me it is fitting to speak of the grandeur of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/4", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "In assembly do I proclaim, before a multitude of people do I announce whose is loftiness and might and whose is the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/5", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "Approach, O nations, and come, O kingdoms, behold how glorious He is with the diadem of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "Call Him great with me, together let us exalt Him, do not behave proudly with the crown of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/7", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "When paths were laid through the depths of the sea, they all understood to whom was granted the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "His horse walked through the sea against six hundred chariots of war, what did might avail man against the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/9", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "Princes heard and then trembled, they looked around in dread and abdicated their kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/10", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "Peoples told of His power and said: to Him shall be written the name of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/11", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s261", "text": "The first people (Amalek)"}, {"page_start": true, "printed_page": "121", "scan": "s263", "text": "to fight fought and perished, for the Lord had sworn by the throne of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/12", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "Amalek earned shame in every generation since he had not learned who fought at the sea and was clothed in the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/13", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The slave, who lived in the south, presumed against his master, whereupon the earth trembled when the slave took the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The seed of the blessed (Israel) destroyed the accursed since they raised their voice against Him who is glorious in kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "Heshbon and Bashan stirred up war for they would not grant passage to the hosts of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/16", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "Their army was annihilated, their land was divided and their seed was deprived of a kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/17", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The Canaanites were foolish for they had been strangers on the soil of the sons of Shem, the seed of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/18", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The son of Nun slew them until he cleared the land before the ark of the covenant of the Lord of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/19", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The man of Harosheth was hard in oppression, there helped him without pay those far from the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/20", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "The Lord fought against them with a Host without payment, may the rest perish likewise and to God be the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/21", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "Like the cedar on Lebanon did Assyria grow great and blasphemed: ‘In my might I will bring down the kingdom’."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/22", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s263", "text": "When the ray of fire destroyed them in the night of vigil, then all could perceive"}, {"page_start": true, "printed_page": "122", "scan": "s265", "text": "that to God was the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/23", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "Bel sank into ruin when he planned to rise to heaven, human reason left him and he descended from the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "When restored to his place, he acknowledged God’s power, to Him who raises and lowers, he delivered the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/25", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "Like sheep to the slaughter was it (Israel) to be driven, then was God’s work accomplished by the youngest tribe (Benjamin from whom Esther was descended) through the power of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/26", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "You who were sold without a price (Israel) will be redeemed without silver, prepare the way for Him who turns like water the heart of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/27", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "The doves (Israel) were sold to the Greeks and they banished them from the frontier of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/28", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "Covenant and law were broken, they caused the people to rebel against God, then powerless were they crushed by the priests of the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/29", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "The hairy one flattered his father with his venison and through the sound of weeping inherited sword and kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/30", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s265", "text": "Exalted will be the smooth one, becoming master to his brothers and once again will return to Yeshurun the kingdom."}], "paragraph": 1, "reference_unit": "stanza"}, {"fragments": [{"page_start": true, "printed_page": "123", "scan": "s267", "text": "As it is written in Thy Torah:"}], "paragraph": 2}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_33_5/deuteronomy_33", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "He was King in Yeshurun when the heads of the people assembled together with the tribes of Israel."}], "paragraph": 2, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/33/5", "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/33/5", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_33_5/deuteronomy_33/5"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/31", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "Make for Thyself in Zion an awe-inspiring name, prosper it as of old with the throne of the kingdom."}], "paragraph": 3, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/32", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "Arouse and revive the delight of the whole earth (Jerusalem) and establish Thy throne in the city of the kingdom."}], "paragraph": 3, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "As it is written in Thy holy words:"}], "paragraph": 4}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_48_3/psalms_48", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "a beautiful branch, the delight of the whole earth, the mountain of Zion, the stronghold of the North, the city of the great King."}], "paragraph": 4, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/48/3", "source_reference": "urn:x-opensiddur:text:bible:psalms/48/3", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_48_3/psalms_48/3"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/33", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "The light of the moon and of the sun wilt Thou cause to blush and those who worship them will be put to shame when Thou dost lift up the kingdom."}], "paragraph": 5, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/34", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "Glorify the city of beauty, that it may be bright as the sun and reveal in front of us the glory of the kingdom."}], "paragraph": 5, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "As it is written through Thy prophet:"}], "paragraph": 6}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/isaiah_24_23/isaiah_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s267", "text": "and the moon shall blush and the sun be ashamed, for the Lord of Hosts rules on Mount Zion and in Jerusalem and in front of His elders there is glory."}], "paragraph": 6, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:isaiah/24/23", "source_reference": "urn:x-opensiddur:text:bible:isaiah/24/23", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/isaiah_24_23/isaiah_24/23"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/35", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "124", "scan": "s269", "text": "The hosts redeemed from Egypt sang on the night of the feast, this is the night preserved for the devastation of a kingdom;"}], "paragraph": 7, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/36", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "they stepped through the waters of the sea, they looked with a spirit of insight to the place where they were to be planted and receive the kingdom."}], "paragraph": 7, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "As it is written in Thy Torah:"}], "paragraph": 8}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_17/exodus_15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "‘Thou wilt bring them and plant them upon the mount of Thine inheritance, the site for Thy dwelling which Thou hast made, O Lord, the sanctuary, O Lord, which Thy hands have established’."}], "paragraph": 8, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/15/17", "source_reference": "urn:x-opensiddur:text:bible:exodus/15/17", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_17/exodus_15/17"}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "And it was said:"}], "paragraph": 8}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_18/exodus_15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "‘The Lord will reign for ever and ever’."}], "paragraph": 8, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/15/18", "source_reference": "urn:x-opensiddur:text:bible:exodus/15/18", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/exodus_15_18/exodus_15/18"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/37", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "Destroyed are the gates of the temple, the House of eternity, for there has ceased from among them the Kingdom."}], "paragraph": 9, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/38", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "The Holy One will return to them for ever; then will they raise their heads again when He renews the kingdom."}], "paragraph": 9, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "As it is written:"}], "paragraph": 10}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_7/psalms_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "‘Lift up your heads, O gates, and lift yourselves up, O portals of eternity, so that the King of glory may enter."}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/7", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/7", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_7/psalms_24/7"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_8/psalms_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "Who is this King of glory? He is the Lord, mighty and strong, the Lord, mighty in war’."}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/8", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/8", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_8/psalms_24/8"}, {"fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "And it was said:"}], "paragraph": 10}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_9/psalms_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "‘Lift up your heads, O gates, lift up, O portals of eternity, so that the King of glory may enter."}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/9", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/9", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_9/psalms_24/9"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_10/psalms_24", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s269", "text": "Who is this King of glory? The Lord of Hosts, He is the King of glory, Selah’."}], "paragraph": 10, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/10", "source_reference": "urn:x-opensiddur:text:bible:psalms/24/10", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_24_10/psalms_24/10"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/39", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "125", "scan": "s271", "text": "The voluptuous one (Babel) sprawled at ease, she did not fear widowhood, for far from her was the end of the kingdom."}], "paragraph": 11, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/40", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "Struggle, deliverers, take the royal gown from Edom and adorn the Lord with the splendour of the Kingdom."}], "paragraph": 11, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "As it was written through Thy prophet:"}], "paragraph": 12}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/obadiah_1_21/obadiah_1", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "Deliverers shall ascend Mount Zion to judge the mountain of Esau and dominion shall be the Lord’s."}], "paragraph": 12, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:obadiah/1/21", "source_reference": "urn:x-opensiddur:text:bible:obadiah/1/21", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/obadiah_1_21/obadiah_1/21"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/41", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "God hates falsehood, yet it is upon our tongue; He demands truth, but it is not there; and, therefore, distant became the Kingdom."}], "paragraph": 13, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/42", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "Almighty, remove guilt from Thy hosts that they may cry out to Thee with the Teruah of the Kingdom."}], "paragraph": 13, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "As it is written in Thy Torah:"}], "paragraph": 14}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/numbers_23_21/numbers_23", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "And He observed no wrong in Jacob nor did He see trouble in Israel. The Lord, his God, is with him, and the royal Teruah is within him."}], "paragraph": 14, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:numbers/23/21", "source_reference": "urn:x-opensiddur:text:bible:numbers/23/21", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/numbers_23_21/numbers_23/21"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/43", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s271", "text": "Gird Thyself in loftiness, surround Thyself with strength, so that no stranger may rule over the Kingdom."}], "paragraph": 15, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/44", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "126", "scan": "s273", "text": "The world will be firm when the wicked is shaken off, the Lord will set justice beneath Him and put on the crown of the Kingdom."}], "paragraph": 16, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "As it is written in Thy holy words:"}], "paragraph": 17}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_93_1/psalms_93", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "The Lord has reigned, clothed in majesty, the Lord has clothed Himself in strength. He has girded Himself, the world is firmly founded, it does not totter."}], "paragraph": 17, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/93/1", "source_reference": "urn:x-opensiddur:text:bible:psalms/93/1", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/psalms_93_1/psalms_93/1"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/45", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Thou wilt take vengeance on nations, Thou wilt rebuke peoples, Thou wilt break the staff of evil, ruling over the Kingdom."}], "paragraph": 18, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/46", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Thou wilt make idols disappear, Thou alone wilt be exalted, Thou wilt be invoked for ever, unique in the Kingdom."}], "paragraph": 18, "reference_unit": "stanza"}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "As it is written through Thy prophet:"}], "paragraph": 19}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/zechariah_14_9/zechariah_14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "The Lord will be King over the whole earth, on that day will the Lord be One and His name One."}], "paragraph": 19, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:zechariah/14/9", "source_reference": "urn:x-opensiddur:text:bible:zechariah/14/9", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/zechariah_14_9/zechariah_14/9"}, {"fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it is written in Thy Torah:"}], "paragraph": 19}, {"chapter_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_6_4/deuteronomy_6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Hear, O Israel, the Lord is our God, the Lord is One."}], "paragraph": 19, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4", "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/6/4", "source_reference_corresp": "urn:x-opensiddur:text:poem:ahallelah_elohai/quotes/deuteronomy_6_4/deuteronomy_6/4"}]}, "review_encoding": true, "stem": "musaf_ahallelah_elohai", "title": {"en": "I praise my God", "he": "אהללה אלהי"}, "urn": "urn:x-opensiddur:text:poem:ahallelah_elohai"}, "variants": []}
