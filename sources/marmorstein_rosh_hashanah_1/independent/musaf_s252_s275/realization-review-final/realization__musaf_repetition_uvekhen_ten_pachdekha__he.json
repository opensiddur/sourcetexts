tition/uvekhen_ten_pachdekha", "wording_selection": [{"features": {"urn:x-opensiddur:condition:prayer:amidah/uvekhen_ten_pachdekha/kol_with_maqaf_shiltan": true, "urn:x-opensiddur:condition:prayer:amidah/uvekhen_ten_pachdekha/kol_without_maqaf_shaltan": false}, "type": "opensiddur:variant"}]}, "variants": []}
