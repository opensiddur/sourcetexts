{"corrections": [], "documentary_instructions_sha256": "e71b1e9b3dd82da6ec0bd15b49e51551398c5c75813b525dd8c7780b59187e4b", "expanded_order_sha256": "bdac3e900633996c1c688de67c9232cbd52b1b730fc80b1755a83c38acac8386", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "6de864e76440276ce2becb582cb2e3300c909ba9184d35e8d97472bb47ff1b63", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_1", "fragments": [{"page_start": true, "printed_page": "129", "scan": "s278", "text": "אֶפְחַד בְּמַעֲשַׂי. אֶדְאַג בְּכָל עֵת. אִירָא בְּיוֹם דִּין. בְּבוֹאִי לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ק׳", "expan": "קהל"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_2", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "אֶדְרוֹשׁ לְחַנּוּן. אֲחַלֶּה לְרַחוּם. אֲחַנֵּן לְחַק לִי. יוֹם לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_3", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "בְּבוֹאִי לְמִשְׁפָּט. בְּמִי אֶשָּׁעֵן. וּמִי יְחַפֶּשׂ לִי. צֶֽדֶק לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_4", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "בָּאָבוֹת בָּטַֽחְתִּי. וּפָעֳלָם אָכַֽלְתִּי. וְהֵם הָיוּ לִי. קֶֽדֶם לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_5", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "גָּבְרָה זְרוֹעִי. כְּשָׂח מְחֵנִי נָא. לְבַל יִמַּח מֶנִּי. שֵׁם וְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_6", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "גֶּֽבֶר אִם יַעֲמוֹד לְפָנָיו הֲיוֹעִיל. בְּעֵת יְבֻקַּשׁ מֶנִּי. זְכוּת לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_7", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "דַּצְתִּי בְּלוֹבֵשׁ אֵפוֹד. וְחֹֽשֶׁן הַמִּשְׁפָּט. אֲשֶׁר בָּם הוּחַק. שְׁמִי לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_8", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "דִּלֵּג בְּמַחְתָּה. עַד יֵעָצֵר נֶֽגֶף. בְּגֶֽשֶׁת זָר מְכַהֵן. יָקוּד לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_9", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "הַבִּֽיטָה אֵל. בְּעָמְדִי לְפָנֶֽיךָ. אֵין בְּקִרְבִּי אֱנוֹשׁ. תָּוִי לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_10", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "הֲיֵשׁ מִי יְפַלֵּל. וְיָשִׁיב"}, {"page_start": true, "printed_page": "130", "scan": "s280", "text": "חֵמָה. וְיוּחַק לַדּוֹרֹת. שְׁמוֹ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_11", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "וּמִי שׂוֹנֵא בֶֽצַע. יְדַבֵּר עֲנוּ בִי. וַיַּעַן וְיֹאמַר עֵד. אָדוֹן לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_12", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "וּבְטָלֵה חָלָב. יְכַפֵּר בַּעֲדֵנוּ. וּכְנֶֽגֶד שְׁנֵי עֳפָרִים. יַעַל לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_13", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זַֽעַף יֵרָא וְיֹאמַר. תְּהִי יָדְךָ בִי. אֲשֶׁר כְּלֵב אֱלֹהָיו. הוּא לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_14", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זָעַק וְהֵשִׁיב. חֶֽרֶב אֶל נְדָנָהּ. וְהוּשַׁת לוֹ כַּשֶּֽׁמֶשׁ. כֵּס לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_15", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "חִכֵּתִי בְּעֵת עֶצֶר. לְפוֹתֵחַ וּמַמְטִיר. כְּמֵשִׁיב רוּחַ לַיֶּֽלֶד. אָבוּד מִזִּכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_16", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "חַי לִרְאוֹת בְּרִית. בְּדַבְּרוֹ קִנֵּאתִי. כִּי עָזְבוּ עָם. בְּרִית וְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_17", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "טֶֽרֶם הָיָה לִי. מְכַפֵּר פָּנִים. מִנְחָה הֹלֶֽכֶת. כַּשֹּׁחַד לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_18", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "טֶֽרֶף נֵרְדְּ וְסַמִּים. לְמֵסַב חֲדָרָיו. דַּם וָחֵֽלֶב לְנִיחֹחַ. וְלֶֽחֶם הַפָּנִים לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_19", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "יֻצַּֽגְתִּי עַל גֶּחָלֵי רֵיקָה. כִּי לֹא אַלְמָן. שַׁתִּי לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_20", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "יָהּ אֶבְטַח בָּךְ. וְלֹא"}, {"page_start": true, "printed_page": "131", "scan": "s282", "text": "בִּנְדִיבִים. כִּי הֵם בַּקֶּבֶר. וְלָנֶצַח שִׁמְךָ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_21", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "כָּל אֵלֶּה סְמָכוּנִי. וְרַחֲמֶיךָ בִּקַּשְׁתִּי. לוּלֵא הֵם תַּמֹּתִי. וְאֵינִי לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_22", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "כִּי הֵם בִּזְרוֹעַ. עָדֶיךָ לֹא בָאוּ. רוֹמְמוּתֶיךָ בְּפִיהֶם. שָׂמוּ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_23", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "לְיוֹם זֶה נִכְמָס. סֶכֶם חֶשְׁבּוֹנוֹת. תְּחִלָּה לְיָמִים. וְרֹאשׁ לְזִכָּרֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_24", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "לְהִקָּרֵא בוֹ. כְּתַב עֵט וְשָׁמִיר. גָּלוּי וּבָאֵר. וְיָדוּעַ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_25", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "מָוֶת וְחַיִּים. שָׁלוֹם וּמִלְחָמוֹת. צַחֲצָחוֹת וָשׂוֹבַע. בָּאִים לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_26", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "מַעַלְלֵי גֶבֶר. וּמִסְפַּר צְעָדָיו. נִשְׁכְּחוּ מֵאֱנוֹשׁ. וְלָאֵל לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_27", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "נִסְתְּרָה דַרְכִּי. מִי יוּכַל שִׂיחַ. לַשָּׁוְא נִכְתַּב לִי. חֵטְא לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_28", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "נֶגֶד פְּנֵי גֶבֶר. מַעֲשָׂיו יוֹכִיחוּ. וְיַעֲנֶה בּוֹ כַּחֲשׁוֹ. עֵד לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_29", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "שִׂיחוּ מְזִמּוֹת אֵל. יַחַד כָּל בְּנֵי אִישׁ. עוֹבְרֵי תַּחַת שֵׁבֶט. כַּצֹּאן לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_30", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "סוֹגֵר"}, {"page_start": true, "printed_page": "132", "scan": "s284", "text": "דֶּלֶת. בְּעַד תְּמִימִים בְּזַעַם. עַד בֹּא קִצָּם. צֵאת לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "132", "scan": "s284", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "וַיִּזְכֹּר אֱלֹהִים אֶת־נֹחַ וְאֵת כָּל־הַחַיָּה וְאֶת־כָּל־הַבְּהֵמָה אֲשֶׁר אִתּוֹ בַּתֵּבָה וַיַּעֲבֵר אֱלֹהִים רוּחַ עַל־הָאָרֶץ וַיָּשֹׁכּוּ הַמָּיִם:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:genesis/8/1", "source_reference": "urn:x-opensiddur:text:bible:genesis/8/1", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8/1"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_31", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "132", "scan": "s284", "text": "עֲשֵׂה פֶלֶא לְחַיִּים. לְבַל יִהְיוּ כַּמֵּתִים. הֲיֵשׁ אֲמִתֶּךָ. בַּקֶּבֶר לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_32", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "עוֹרַרְתָּ אָז בְּפֹעַל. עוֹרְרֵנוּ בְּלֹא פֹעַל. הֲלֹא לְנִפְלְאוֹתֶיךָ. תַּעַשׂ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "132", "scan": "s284", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_4/psalms_111", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זֵכֶר עָשָׂה לְנִפְלְאוֹתָיו חַנּוּן וְרַחוּם יְיָ:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:psalms/111/4", "source_reference": "urn:x-opensiddur:text:bible:psalms/111/4", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_4/psalms_111/4"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/intro_2", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "וְנֶאֱמַר"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_5/psalms_111", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "טֶרֶף נָתַן לִירֵאָיו יִזְכֹּר לְעֹלָם בְּרִיתוֹ:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:psalms/111/5", "source_reference": "urn:x-opensiddur:text:bible:psalms/111/5", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_111_4_5/quotes/psalms_111_5/psalms_111/5"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_33", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "132", "scan": "s284", "text": "פְּנֵה אֱלֹהִים. בְּיוֹשְׁבֵי גַנִּים. מַקְשִׁיב לְנִדְבָּרֵימוֹ. בְּדַת לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_34", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "פָּעֳלָם לְפָנֶיךָ. וּשְׂכָרָם אִתָּךְ. אוֹכְלֵי לֶחֶם הָעֲצָבִים. בַּסֵּפֶר לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "133", "scan": "s286", "text": "כַּכָּתוּב עַל־יַד נְבִיאֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/quotes/malachi_3_16/malachi_3", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "אָז נִדְבְּרוּ יִרְאֵי יְיָ אִישׁ אֶל רֵעֵהוּ וַיַּקְשֵׁב יְיָ וַיִּשְׁמָע וַיִּכָּתֵב סֵפֶר זִכָּרוֹן לְפָנָיו לְיִרְאֵי יְיָ וּלְחוֹשְׁבֵי שְׁמוֹ:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:malachi/3/16", "source_reference": "urn:x-opensiddur:text:bible:malachi/3/16", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_malachi_3_16/quotes/malachi_3_16/malachi_3/16"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_35", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "133", "scan": "s286", "text": "צָצוּ שֻׁעָלִים. מְחַבְּלִים כְּרָמִים. לְהַכְרִית מִגֶּפֶן. שֹׁרֶשׁ וְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_36", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "צְרָרוּם בְּפֶרֶךְ. נָאֲקוּ וְנוֹשָׁעוּ. בְּכֹשֶׁר הֲרָרֵי קֶדֶם. הוּחַק לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "133", "scan": "s286", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/quotes/exodus_2_24/exodus_2", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "וַיִּשְׁמַע אֱלֹהִים אֶת־נַאֲקָתָם וַיִּזְכֹּר אֱלֹהִים אֶת־בְּרִיתוֹ אֶת־אַבְרָהָם אֶת־יִצְחָק וְאֶת־יַעֲקֹב:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:exodus/2/24", "source_reference": "urn:x-opensiddur:text:bible:exodus/2/24", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_2_24/quotes/exodus_2_24/exodus_2/24"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_37", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "133", "scan": "s286", "text": "קֶדֶם בַּנְתָּה לַדּוֹרוֹת. אֵין בָּהֶם חֵפֶץ. חִלַּפְתָּם וְאִבַּדְתָּם. מִהְיוֹת לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_38", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "קֲחְתָּה דּוֹר מֵאֶלֶף. אֲמָרֶיךָ הִנְחַלְתָּם. לְמַעֲנָם בְּכָל דּוֹר. חַקְתָּה לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "133", "scan": "s286", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/quotes/psalms_105_8/psalms_105", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "זָכַר לְעֹלָם בְּרִיתוֹ דָּבָר צִוָּה לְאֶלֶף דּוֹר:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:psalms/105/8", "source_reference": "urn:x-opensiddur:text:bible:psalms/105/8", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_psalms_105_8/quotes/psalms_105_8/psalms_105/8"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_39", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "134", "scan": "s288", "text": "רָם חָשַׁק מְאֹד. בְּכַלַּת נְעוּרִים. הֲרוּגֶיהָ וַעֲנִיֶּיהָ. תַּתָּה לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_40", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "רָצָה אַחֲרֶיךָ. בְּגֵיא צִיָּה וְצַלְמָוֶת. אַהֲבַת כְּלוּלוֹתֶיהָ. תַּעַשׂ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "134", "scan": "s288", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/quotes/jeremiah_2_2/jeremiah_2", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "הָלֹךְ וְקָרָאתָ בְאָזְנֵי יְרוּשָׁלַֽ͏ִם לֵאמֹר כֹּה אָמַר יְיָ זָכַרְתִּי לָךְ חֶסֶד נְעוּרַיִךְ אַהֲבַת כְּלוּלֹתָיִךְ לֶכְתֵּךְ אַחֲרַי בַּמִּדְבָּר בְּאֶרֶץ לֹא זְרוּעָה:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:jeremiah/2/2", "source_reference": "urn:x-opensiddur:text:bible:jeremiah/2/2", "source_reference_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_jeremiah_2_2/quotes/jeremiah_2_2/jeremiah_2/2"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_41", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "134", "scan": "s288", "text": "שִׁחֲתוּ עַם זוּ. שְׂאֵת שִׁמְצָה בְּקָמֵיהֶם. שֵׂם פֶּסֶל וְלֹא אֵל. שָׁתוּ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_42", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "שֶׁכָּלוּ כִּמְעַט רֶגַע. לוּלֵי קָם בַּפֶּרֶץ. מְעוֹרֵר שְׁבוּעָה. וּבְרִית לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_32_13/intro_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "134", "scan": "s288", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_exodus_32_13/quotes/exodus_32_13/exodus_32", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "זְכֹר לְאַבְ