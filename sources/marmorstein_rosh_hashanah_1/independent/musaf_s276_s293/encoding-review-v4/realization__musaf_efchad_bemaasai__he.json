ext:poem:efchad_bemaasai/shabbat_psalms_74_2/quotes/psalms_74_2/psalms_74/2"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_45", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "135", "scan": "s290", "text": "תָּר אִישׁ תָּם בְּמִי זַרְעוֹ יְכֻנֶּה. שִׂכֵּל יָדָיו. לְאוֹת וְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_46", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s290", "text": "תְּרַפֵּק מְשׁוּל אֶפְרַיִם. בְּשַׁעֲשׁוּעַ יֶלֶד וּבֵן יַקִּיר. הֲלֹא בְּכוֹרִי הוּא. חַקְתָּ לְזִכָּרוֹן:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}]}, "page_context": "rosh_hashanah/musaf/repetition/efchad_bemaasai", "review_encoding": true, "source_notes": {"en": [{"language": "en", "text": "This Shabbat poem continues through the biblical interludes to the final pair of tav strophes. The shared closing Zikhronot verse (Jeremiah 31:19) follows in the service sequence."}], "he": [{"language": "en", "text": "This Shabbat poem continues through the biblical interludes to the final pair of tav strophes. The shared closing Zikhronot verse (Jeremiah 31:19) follows in the service sequence."}]}, "stem": "musaf_efchad_bemaasai", "title": {"en": "I am anxious because of my deeds", "he": "אפחד במעשי"}, "urn": "urn:x-opensiddur:text:poem:efchad_bemaasai"}, "variants": []}
