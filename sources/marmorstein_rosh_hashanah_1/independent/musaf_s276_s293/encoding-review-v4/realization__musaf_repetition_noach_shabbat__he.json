tart": false, "printed_page": "128", "scan": "s276", "text": "וְגַם אֶת־נֹחַ בְּאַהֲבָה זָכַֽרְתָּ. וַתִּפְקְדֵֽהוּ בִּדְבַר יְשׁוּעָה וְרַחֲמִים בַּהֲבִיאֲךָ אֶת־מֵי הַמַּבּוּל לְשַׁחֵת כָּל־בָּשָׂר מִפְּנֵי רֽוֹעַ מַעַלְלֵיהֶם. עַל־כֵּן זִכְרוֹנוֹ בָּא לְפָנֶֽיךָ יְיָ אֱלֹהֵֽינוּ לְהַרְבּוֹת זַרְעוֹ כְּעַפְרוֹת תֵּבֵל. וְצֶֽאֱצָאָיו כְּחוֹל הַיָּם:"}], "paragraph": 1}]}, "review_encoding": true, "stem": "musaf_repetition_noach_shabbat", "title": {"en": "Noah also: Sabbath position", "he": "וגם את נח"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/noach_shabbat", "wording_selection": [{"features": {"urn:x-opensiddur:condition:prayer:amidah/attah_zokher_maaseh_olam/vegam_et_noach/en/first_printing": true, "urn:x-opensiddur:condition:prayer:amidah/attah_zokher_maaseh_olam/vegam_et_noach/en/zikhronot_printing": false, "urn:x-opensiddur:condition:prayer:amidah/attah_zokher_maaseh_olam/vegam_et_noach/he/first_printing": true, "urn:x-opensiddur:condition:prayer:amidah/attah_zokher_maaseh_olam/vegam_et_noach/he/zikhronot_printing": false}, "type": "opensiddur:variant"}]}, "variants": []}
