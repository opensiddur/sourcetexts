    {
      "stem": "psalm_81",
      "urn": "urn:x-opensiddur:text:bible:psalms/81",
      "title": {
        "he": "תהלים 81",
        "en": "Psalm 81"
      },
      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "לַמְנַצֵּֽחַ עַל־הַגִּתִּית לְאָסָף:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "הַרְנִֽינוּ לֵאלֹהִים עוּזֵּֽנוּ. הָרִֽיעוּ לֵאלֹהֵי יַעֲקֹב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "שְׂאוּ־זִמְרָה וּתְנוּ־תֹף. כִּנּוֹר נָעִים עִם־נָֽבֶל:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "תִּקְעוּ בַחֹדֶשׁ שׁוֹפָר. בַּכֶּֽסֶה לְיוֹם חַגֵּֽנוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "כִּי חֹק לְיִשְׂרָאֵל הוּא. מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "עֵדוּת בִּיהוֹסֵף שָׂמוֹ בְּצֵאתוֹ עַל־אֶֽרֶץ מִצְרָֽיִם. שְׂפַת לֹא־יָדַֽעְתִּי אֶשְׁמָע:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "הֲסִירֽוֹתִי מִסֵּֽבֶל שִׁכְמוֹ. כַּפָּיו מִדּוּד תַּעֲבֹֽרְנָה:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "בַּצָּרָה קָרָֽאתָ וָאֲחַלְּצֶֽךָּ אֶעֶנְךָ בְּסֵֽתֶר רַעַם. אֶבְחָנְךָ עַל־מֵי מְרִיבָה סֶֽלָה:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/9",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "שְׁמַע עַמִּי וְאָעִֽידָה בָּךְ. יִשְׂרָאֵל אִם־תִּשְׁמַע־לִי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/10",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "לֹא־יִהְיֶה בְךָ אֵל זָר. וְלֹא תִשְׁתַּחֲוֶה לְאֵל נֵכָר:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/11",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "אָנֹכִי יְיָ אֱלֹהֶֽיךָ הַמַּעַלְךָ מֵאֶֽרֶץ מִצְרָֽיִם. הַרְחֶב־פִּיךָ וַאֲמַלְאֵֽהוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/12",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "וְלֹא־שָׁמַע עַמִּי לְקוֹלִי. וְיִשְׂרָאֵל לֹא־אָֽבָה לִי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/13",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "וָאֲשַׁלְּחֵֽהוּ בִּשְׁרִירוּת לִבָּם. יֵלְכוּ בְּמוֹעֲצוֹתֵיהֶם:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/14",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "לוּ עַמִּי שֹׁמֵעַ לִי. יִשְׂרָאֵל בִּדְרָכַי יְהַלֵּֽכוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/15",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "כִּמְעַט אוֹיְבֵיהֶם אַכְנִֽיעַ. וְעַל־צָרֵיהֶם אָשִׁיב יָדִי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/16",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "מְשַׂנְאֵי יְיָ יְכַחֲשׁוּ־לוֹ. וִיהִי עִתָּם לְעוֹלָם:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/81/17",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "וַיַּאֲכִילֵֽהוּ מֵחֵֽלֶב חִטָּה. וּמִצּוּר דְּבַשׁ אַשְׂבִּיעֶֽךָ:",
                "page_start": false
              }
            ]
          }
        ]
      },
