{
  "status": "UNACCEPTED draft; glyph adjudication and canonical/export review pending",
  "units": [
    {
      "stem": "psalm_48",
      "urn": "urn:x-opensiddur:text:bible:psalms/48",
      "title": {
        "he": "תהלים 48",
        "en": "Psalm 48"
      },
      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "שִׁיר מִזְמוֹר לִבְנֵי קֹֽרַח:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "גָּדוֹל יְיָ וּמְהֻלָּל מְאֹד. בְּעִיר אֱלֹהֵֽינוּ הַר־קָדְשׁוֹ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "יְפֵה נוֹף מְשׂוֹשׂ כָּל־הָאָֽרֶץ. הַר־צִיּוֹן יַרְכְּתֵי צָפוֹן קִרְיַת מֶֽלֶךְ רָב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "אֱלֹהִים בְּאַרְמְנוֹתֶֽיהָ נוֹדַע לְמִשְׂגָּב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "כִּי־הִנֵּה הַמְּלָכִים נוֹעֲדוּ. עָבְרוּ יַחְדָּו:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "הֵמָּה רָאוּ כֵּן תָּמָֽהוּ. נִבְהֲלוּ נֶחְפָּֽזוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "רְעָדָה אֲחָזָֽתַם שָׁם. חִיל כַּיּוֹלֵדָה:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "בְּרוּחַ קָדִים. תְּשַׁבֵּר אֳנִיּוֹת תַּרְשִׁישׁ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/9",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "כַּאֲשֶׁר שָׁמַֽעְנוּ כֵּן רָאִֽינוּ בְּעִיר יְיָ צְבָאוֹת בְּעִיר אֱלֹהֵֽינוּ. אֱלֹהִים יְכוֹנְנֶֽהָ עַד־עוֹלָם סֶֽלָה:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/10",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "דִּמִּֽינוּ אֱלֹהִים חַסְדֶּֽךָ. בְּקֶֽרֶב הֵיכָלֶֽךָ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/11",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s351",
                "printed_page": null,
                "text": "כְּשִׁמְךָ אֱלֹהִים כֵּן תְּהִלָּתְךָ עַל־קַצְוֵי־",
                "page_start": false
              },
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אֶֽרֶץ. צֶֽדֶק מָלְאָה יְמִינֶֽךָ:",
                "page_start": true
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/12",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "יִשְׂמַח הַר־צִיּוֹן תָּגֵֽלְנָה בְּנוֹת יְהוּדָה. לְמַֽעַן מִשְׁפָּטֶֽיךָ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/13",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "סֹֽבּוּ צִיּוֹן וְהַקִּיפֽוּהָ. סִפְרוּ מִגְדָּלֶֽיהָ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/14",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "שִֽׁיתוּ לִבְּכֶם לְחֵילָה פַּסְּגוּ אַרְמְנוֹתֶֽיהָ. לְמַֽעַן תְּסַפְּרוּ לְדוֹר אַחֲרוֹן:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/48/15",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "כִּי זֶה אֱלֹהִים אֱלֹהֵֽינוּ עוֹלָם וָעֶד. הוּא יְנַהֲגֵֽנוּ עַל־מוּת:",
                "page_start": false
              }
            ]
          }
        ]
      },
      "citations": {
        "he": [
          {
            "scan": "s351",
            "printed_page": null,
            "text": "מח",
            "target": "urn:x-opensiddur:text:bible:psalms/48/1",
            "reference": "urn:x-opensiddur:text:bible:psalms/48"
          }
        ]
      }
    },
    {
      "stem": "psalm_82",
      "urn": "urn:x-opensiddur:text:bible:psalms/82",
      "title": {
        "he": "תהלים 82",
        "en": "Psalm 82"
      },
      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "מִזְמוֹר לְאָסָף. אֱלֹהִים נִצָּב בַּעֲדַת־אֵל בְּקֶֽרֶב אֱלֹהִים יִשְׁפֹּט:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "עַד־מָתַי תִּשְׁפְּטוּ־עָוֶל. וּפְנֵי רְשָׁעִים תִּשְׂאוּ־סֶֽלָה:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "שִׁפְטוּ־דַל וְיָתוֹם. עָנִי וָרָשׁ הַצְדִּֽיקוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "פַּלְּטוּ־דַל וְאֶבְיוֹן. מִיַּד רְשָׁעִים הַצִּֽילוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "לֹא יָדְעוּ וְלֹא יָבִֽינוּ בַּחֲשֵׁכָה יִתְהַלָּֽכוּ. יִמּוֹטוּ כָּל־מוֹסְדֵי אָֽרֶץ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אֲנִי אָמַֽרְתִּי אֱלֹהִים אַתֶּם. וּבְנֵי עֶלְיוֹן כֻּלְּכֶם:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אָכֵן כְּאָדָם תְּמוּתוּן. וּכְאַחַד הַשָּׂרִים תִּפֹּלוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/82/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "קוּמָה אֱלֹהִים שָׁפְטָה הָאָֽרֶץ. כִּי אַתָּה תִנְחַל בְּכָל־הַגּוֹיִם:",
                "page_start": false
              }
            ]
          }
        ]
      },
      "citations": {
        "he": [
          {
            "scan": "s352",
            "printed_page": null,
            "text": "פב",
            "target": "urn:x-opensiddur:text:bible:psalms/82/1",
            "reference": "urn:x-opensiddur:text:bible:psalms/82"
          }
        ]
      }
    },
    {
      "stem": "psalm_94",
      "urn": "urn:x-opensiddur:text:bible:psalms/94",
      "title": {
        "he": "תהלים 94",
        "en": "Psalm 94"
      },
      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/1",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אֵל־נְקָמוֹת יְיָ. אֵל נְקָמוֹת הוֹפִֽיעַ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/2",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "הִנָּשֵׂא שֹׁפֵט הָאָֽרֶץ. הָשֵׁב גְּמוּל עַל־גֵּאִים:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/3",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "עַד־מָתַי רְשָׁעִים יְיָ. עַד־מָתַי רְשָׁעִים יַעֲלֹֽזוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/4",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "יַבִּֽיעוּ יְדַבְּרוּ עָתָק. יִתְאַמְּרוּ כָּל־פֹּעֲלֵי אָֽוֶן:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/5",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "עַמְּךָ יְיָ יְדַכְּאוּ. וְנַחֲלָתְךָ יְעַנּוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/6",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אַלְמָנָה וְגֵר יַהֲרֹֽגוּ. וִיתוֹמִים יְרַצֵּֽחוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/7",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "וַיֹּאמְרוּ לֹא יִרְאֶה־יָּהּ. וְלֹא יָבִין אֱלֹהֵי יַעֲקֹב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/8",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "בִּֽינוּ בֹּעֲרִים בָּעָם. וּכְסִילִים מָתַי תַּשְׂכִּֽילוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/9",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "הֲנֹֽטַע אֹזֶן הֲלֹא יִשְׁמָע. אִם־יֹֽצֵר עַֽיִן הֲלֹא יַבִּיט:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/10",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "הֲיֹסֵר גּוֹיִם הֲלֹא יוֹכִֽיחַ. הַמְלַמֵּד אָדָם דָּֽעַת:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/11",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "יְיָ יֹדֵֽעַ מַחְשְׁבוֹת אָדָם. כִּי הֵֽמָּה הָֽבֶל:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/12",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "אַשְׁרֵי הַגֶּֽבֶר אֲשֶׁר תְּיַסְּרֶֽנּוּ יָּהּ. וּמִתּוֹרָתְךָ תְלַמְּדֶֽנּוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/13",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s352",
                "printed_page": null,
                "text": "לְהַשְׁקִיט לוֹ מִימֵי רָע. עַד־יִכָּרֶה",
                "page_start": false
              },
              {
                "scan": "s353",
                "printed_page": null,
                "text": "לָרָשָׁע שָֽׁחַת:",
                "page_start": true
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/14",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "כִּי לֹא־יִטֹּשׁ יְיָ עַמּוֹ. וְנַחֲלָתוֹ לֹא יַעֲזֹב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/15",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "כִּי־עַד־צֶֽדֶק יָשׁוּב מִשְׁפָּט. וְאַחֲרָיו כָּל־יִשְׁרֵי־לֵב:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/16",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "מִי־יָקוּם לִי עִם־מְרֵעִים. מִי־יִתְיַצֵּב לִי עִם־פֹּעֲלֵי אָֽוֶן:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/17",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "לוּלֵי יְיָ עֶזְרָֽתָה לִּי. כִּמְעַט שָׁכְנָה דוּמָה נַפְשִׁי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/18",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "אִם־אָמַֽרְתִּי מָטָה רַגְלִי. חַסְדְּךָ יְיָ יִסְעָדֵֽנִי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/19",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "בְּרֹב שַׂרְעַפַּי בְּקִרְבִּי. תַּנְחוּמֶֽיךָ יְשַׁעַשְׁעוּ נַפְשִׁי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/20",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "הַיְחָבְרְךָ כִּסֵּא הַוּוֹת. יוֹצֵר עָמָל עֲלֵי־חֹק:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/21",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "יָגוֹדּוּ עַל־נֶֽפֶשׁ צַדִּיק. וְדָם נָקִי יַרְשִֽׁיעוּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/22",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "וַיְהִי יְיָ לִי לְמִשְׂגָּב. וֵאלֹהַי לְצוּר מַחְסִי:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:bible:psalms/94/23",
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s353",
                "printed_page": null,
                "text": "וַיָּֽשֶׁב עֲלֵיהֶם אֶת־אוֹנָם וּבְרָעָתָם יַצְמִיתֵם. יַצְמִיתֵם יְיָ אֱלֹהֵֽינוּ:",
                "page_start": false
              }
            ]
          }
        ]
