            "condition_instruction": "לכהנים",
            "condition_instruction_language": "he"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s346",
                "printed_page": "20",
                "text": "שֶׁצִּוִּֽיתָ הַכֹּהֲנִים לְבָרְכֵֽנוּ",
                "page_start": false
              }
            ],
            "conditions": [
              {
                "type": "opensiddur:person",
                "features": {
                  "kohen": false
                }
              }
            ],
            "condition_instruction": "להעם",
            "condition_instruction_language": "he"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s346",
                "printed_page": "20",
                "text": "בְּרָכָה שְׁלֵמָה וְלֹא־יִהְיֶה בָּהּ מִכְשׁוֹל וְעָוֹן מֵעַתָּה וְעַד עוֹלָם:",
                "page_start": false
              }
