    },
    {
      "stem": "kohanim_veteerav",
      "urn": "urn:x-opensiddur:text:prayer:vetearev_lefanekha_atiratenu",
      "title": {
        "he": "ותערב עליך עתירתנו",
        "en": "ותערב עליך עתירתנו"
      },
      "review_encoding": true,
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s347",
                "printed_page": "21",
                "text": "וְתֶעֱרַב עָלֶֽיךָ עֲתִירָתֵֽנוּ כְּעוֹלָה וּכְקָרְבָּן. אָנָּא רַחוּם בְּרַחֲמֶֽיךָ הָרַבִּים הָשֵׁב שְׁכִינָתְךָ לְצִיּוֹן וְסֵֽדֶר הָעֲבוֹדָה לִירוּשָׁלָֽיִם. וְתֶחֱזֶֽינָה עֵינֵֽינוּ בְּשׁוּבְךָ לְצִיּוֹן בְּרַחֲמִים. וְשָׁם נַעֲבָדְךָ בְּיִרְאָה כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמוֹנִיּוֹת:",
                "page_start": false
              }
            ],
            "anchor": "kohanim_veteerav_footnote"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "canonical": "urn:x-opensiddur:text:siddur:regalim/musaf/text/veteerav",
            "fragments": [
              {
                "scan": "s311",
                "printed_page": "145",
                "text": "May our entreaty be pleasing to Thee like the whole-offering and the sacrifice. O Merciful One, restore Thy presence to Zion in Thy great mercies and the order of worship to Jerusalem. Let our eyes behold Thy return to Zion in compassion and let us serve Thee there in awe as in olden times and former years.",
                "page_start": false
              }
            ]
          }
        ]
      },
      "page_context": "rosh_hashanah/hosafot/birkat_kohanim/kohanim_veteerav",
