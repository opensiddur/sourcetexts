    {
      "stem": "kohanim_dream_prayer",
      "urn": "urn:x-opensiddur:text:prayer:ribbono_shel_olam_ani",
      "title": {
        "he": "רבונו של עולם — אני שלך",
        "en": "רבונו של עולם — אני שלך"
      },
      "review_encoding": true,
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s348",
                "printed_page": "22",
                "text": "רִבּוֹנוֹ שֶׁל עוֹלָם אֲנִי שֶׁלָּךְ וַחֲלוֹמוֹתַי שֶׁלָּךְ. חֲלוֹם חָלַמְתִּי וְאֵינִי יוֹדֵֽעַ מַה הוּא. יְהִי רָצוֹן מִלְּפָנֶֽיךָ יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי שֶׁיִּהְיוּ כָּל חֲלוֹמוֹתַי עָלַי וְעַל־כָּל־יִשְׂרָאֵל לְטוֹבָה בֵּין שֶׁחָלַמְתִּי עַל־עַצְמִי וּבֵין שֶׁחָלַמְתִּי עַל־אֲחֵרִים וּבֵין שֶׁחָלְמוּ אֲחֵרִים עָלַי. אִם טוֹבִים הֵם חַזְּקֵם וְאַמְּצֵם וְיִתְקַיְּמוּ בִי וּבָהֶם כַּחֲלוֹמוֹת יוֹסֵף הַצַּדִּיק. וְאִם צְרִיכִים רְפוּאָה רְפָאֵם כְּחִזְקִיָּהוּ מֶֽלֶךְ יְהוּדָה מֵחָלְיוֹ וּכְמִרְיָם הַנְּבִיאָה מִצָּרַעְתָּהּ וּכְנַעֲמָן מִצָּרַעְתּוֹ וּכְמֵי מָרָה עַל יְדֵי מֹשֶׁה רַבֵּֽינוּ וּכְמֵי יְרִחוֹ עַל יְדֵי אֱלִישָׁע. וּכְשֵׁם שֶׁהָפַֽכְתָּ אֶת־קִלְלַת בִּלְעָם הָרָשָׁע מִקְּלָלָה לִבְרָכָה כֵּן תַּהֲפֹךְ כָּל חֲלוֹמוֹתַי עָלַי וְעַל־כָּל־יִשְׂרָאֵל לְטוֹבָה וְתִשְׁמְרֵֽנִי וּתְחָנֵּֽנִי וְתִרְצֵֽנִי. אָמֵן:",
                "page_start": false
              }
            ]
          }
        ]
      }
