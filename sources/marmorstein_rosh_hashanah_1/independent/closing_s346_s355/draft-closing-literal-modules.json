              {
                "scan": "s346",
                "printed_page": "20",
                "text": "יְהִי רָצוֹן מִלְּפָנֶֽיךָ יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ שֶׁתְּהִי הַבְּרָכָה הַזֹּאת",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s346",
                "printed_page": "20",
                "text": "שֶׁצִּוִּיתָֽנוּ לְבָרֵךְ אֶת־עַמְּךָ יִשְׂרָאֵל",
                "page_start": false
              }
            ],
            "conditions": [
              {
                "type": "opensiddur:person",
