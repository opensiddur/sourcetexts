      },
      "review_encoding": true,
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s346",
                "printed_page": "20",
                "text": "יהי רצון מלפניך ה׳ אלהינו ואלהי אבותינו שכל טפה וטפה קרי שיצא ממני לבטלה ומכל ישראל בכלל ובפרט שלא במקום מצוה בין באונס ובין ברצון והנשמות העשוקות בקליפות הנפוצים מארבע כנפות הארץ והנשמות דאזלין ערטלאין הנפזרים בין הגוים ועל ידי זה חרב עירנו ושמם בית מקדשנו וגלה יקרנו ונטל כבוד מבית חיינו תפליטם הקליפות כל הניצוצות הקדושות שבעולם ויחזרו לקבצם בקדושה שנית וקרב פזורנו מבין הגוים ונפוצותינו כנס מירכתי ארץ ויקוים בנו מקרא שכתוב ושב ה׳ אלהיך את שבותך ורחמך ושב וקבצך מכל העמים אשר הפיצך ה׳ אלהיך שמה אם יהיה נדחך בקצה השמים משם יקבצך ה׳ אלהיך ומשם יקחך ויקוים בנו באהבתו ובחמלתו הוא גאלם וינטלם וינשאם כל ימי עולם בכח השם הקדוש הזה בי״ט ובשם הקדוש הזה חב״ו היוצא מפסוק ״חיל ״בלע ״ויקיאנו שתחזירם למקום קדושה ויגאלנו גאולת עולם לחבר האוהל להיות אחד:",
                "page_start": false,
                "quotations": [
                  {
                    "text": "ושב ה׳ אלהיך את שבותך ורחמך ושב וקבצך מכל העמים אשר הפיצך ה׳ אלהיך שמה",
                    "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/30/3",
                    "inline_scope": true,
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/deuteronomy/30",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/deuteronomy/30/3"
                  },
                  {
                    "text": "אם יהיה נדחך בקצה השמים משם יקבצך ה׳ אלהיך ומשם יקחך",
                    "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/30/4",
                    "inline_scope": true,
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/second/deuteronomy/30",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/second/deuteronomy/30/4"
                  },
                  {
                    "text": "באהבתו ובחמלתו הוא גאלם וינטלם וינשאם כל ימי עולם",
                    "source_reference": "urn:x-opensiddur:text:bible:isaiah/63/9",
                    "source_reference_part": {
                      "unit": "half-verse",
                      "n": "b",
                      "corresp": "urn:x-opensiddur:text:bible:isaiah/63/9/b"
                    }
                  },
                  {
                    "text": "״חיל ״בלע ״ויקיאנו",
                    "source_reference": "urn:x-opensiddur:text:bible:job/20/15",
                    "inline_scope": true,
                    "chapter_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/job/20",
                    "source_reference_corresp": "urn:x-opensiddur:text:prayer:yehi_ratzon_shekol_tippah/quotation/job/20/15"
                  }
                ]
              }
            ]
          }
        ]
