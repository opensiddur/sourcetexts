      "review_encoding": true,
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s355",
                "printed_page": null,
                "text": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא בְּעָלְמָא דִּיבְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל־בֵּית־יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב, וְאִמְרוּ אָמֵן.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:prayer:kaddish/yitgaddal",
            "language": "arc"
          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s355",
                "printed_page": null,
                "text": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:prayer:kaddish/yehe_shemeh",
            "language": "arc"
          },
          {
            "paragraph": 3,
            "fragments": [
              {
                "scan": "s355",
                "printed_page": null,
                "text": "יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא לְעֵֽלָּא וּלְעֵֽלָּא מִן־כָּל־בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא, וְאִמְרוּ אָמֵן:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:prayer:kaddish/yitbarakh",
            "language": "arc"
          },
          {
            "paragraph": 4,
            "fragments": [
              {
                "scan": "s355",
                "printed_page": null,
                "text": "יְהֵא שְׁלָמָא רַבָּא מִן־שְׁמַיָּא וְחַיִּים עָלֵֽינוּ וְעַל־כָּל־יִשְׂרָאֵל, וְאִמְרוּ אָמֵן:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shelama",
            "language": "arc",
            "anchor": "kaddish_yatom_resume"
          },
          {
            "paragraph": 5,
            "fragments": [
              {
                "scan": "s355",
                "printed_page": null,
                "text": "עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵֽינוּ וְעַל־כָּל־יִשְׂרָאֵל וְאִמְרוּ אָמֵן:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom",
            "language": "he"
          }
        ]
      }
