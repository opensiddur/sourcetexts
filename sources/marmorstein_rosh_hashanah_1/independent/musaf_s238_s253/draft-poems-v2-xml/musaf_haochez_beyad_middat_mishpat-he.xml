<tei:TEI xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:j="http://jewishliturgy.org/ns/jlptei/2" xml:lang="he"><tei:teiHeader><tei:fileDesc><tei:titleStmt><tei:title type="main">האוחז ביד מדת משפט</tei:title><tei:respStmt><tei:resp key="trc">AI-assisted scan reading and JLPTEI encoding</tei:resp><tei:name ref="urn:x-opensiddur:contributor:opensiddur.org/codex">Codex</tei:name></tei:respStmt></tei:titleStmt><tei:editionStmt><tei:edition>DRAFT: independent adjudication pending. Digitization in progress. Independent image readings and adjudications are recorded in sources/marmorstein_rosh_hashanah_1/.</tei:edition></tei:editionStmt><tei:publicationStmt><tei:distributor><tei:ref target="https://opensiddur.org">Open Siddur Project</tei:ref></tei:distributor><tei:idno type="urn">urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat@prayerbook_for_the_new_year-heidenheim-1965-he</tei:idno><tei:availability status="free"><tei:licence target="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</tei:licence></tei:availability></tei:publicationStmt><tei:sourceDesc><tei:bibl><tei:ptr target="/prayerbook_for_the_new_year-heidenheim-1965-he/index#project_source_bibl"/><tei:biblScope unit="pages" from="114" to="115"/></tei:bibl></tei:sourceDesc></tei:fileDesc></tei:teiHeader><tei:text><tei:body><tei:div corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n247.jpg"><tei:note type="description" xml:lang="he">ע״ס א״ב כפול.</tei:note><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/1"/>הָאוֹחֵז בְּיַד מִדַּת מִשְׁפָּט: וְכֹל מַאֲמִינִים שֶׁהוּא אֵל אֱמוּנָה: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/2"/>הַבּוֹחֵן וּבוֹדֵק גִּנְזֵי נִסְתָּרוֹת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא בּוֹחֵן כְּלָיוֹת: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/3"/>הַגּוֹאֵל מִמָּוֶת וּפוֹדֶה מִשַּׁחַת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא גּוֹאֵל חָזָק: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/4"/>הַדָּן יְחִידִי לְבָאֵי עוֹלָם: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא דַּיַּן אֱמֶת: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/5"/>הֶהָגוּי בְּאֶהְיֶה אֲשֶׁר אֶהְיֶה: <tei:choice><tei:abbr>וְמַ״</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהָיָה (וְהֹוֶה) וְיִהְיֶה: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/6"/>הַוַּדַּי שְׁמוֹ כֵּן תְּהִלָּתוֹ: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא וְאֵין בִּלְתּוֹ: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/7"/>הַזּוֹכֵר לְמַזְכִּירָיו טוֹבוֹת זִכְרוֹנוֹת: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא זוֹכֵר הַבְּרִית: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/8"/>הַחוֹתֵךְ חַיִּים לְכָל־חָי: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא חַי וְקַיָּם: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/9"/>הַטּוֹב וּמֵטִיב לָרָעִים וְלַטּוֹבִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא טוֹב לַכֹּל: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/10"/>הַיּוֹדֵעַ יֵצֶר כָּל יְצוּרִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא יוֹצְרָם בַּבָּטֶן: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/11"/>הַכֹּל יוֹכָל וְכֹלְלָם יַחַד: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא כֹּל יוֹכָל: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/12"/>הַלָּן בְּסֵתֶר בְּצֵל, שַׁדַּי: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא לְבַדּוֹ הוּא: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/13"/>הַמַּמְלִיךְ מְלָכִים וְלוֹ הַמְּלוּכָה: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא מֶלֶךְ עוֹלָם: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/14"/>הַנּוֹהֵג בְּחַסְדּוֹ כָּל־דּוֹר: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא נוֹצֵר חֶסֶד: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/15"/>הַסּוֹבֵל וּמַעֲלִים עַיִן מִסּוֹרְרִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא סוֹלֵחַ סֶלָה: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/16"/>הָעֶלְיוֹן, וְעֵינוֹ אֶל יְרֵאָיו: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא עוֹנֶה לָחַשׁ: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/17"/>הַפּוֹתֵחַ פִּתְחוֹ לְדוֹפְקֵי בִּתְשׁוּבָה: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא פְּתוּחָה יָדוֹ: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/18"/>הַצּוֹפֶה לָרָשָׁע וְחָפֵץ בְּהִצַּדְקוֹ: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא צַדִּיק וְיָשָׁר: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/19"/>הַקְּצַר בְּזַֽעַם וּמַאֲרִיךְ אַף: <tei:choice><tei:abbr>וְ״מ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא קָשֶׁה לִכְעוֹס: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/20"/>הָרַחוּם, וּמַקְדִּים רַחֲמִים לְרֹגֶז: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא רַךְ לִרְצוֹת: </tei:p><tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/21"/>הַשָּׁוֶה, וּמַשְׁוֶה קָטוֹן וְגָדוֹל: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא שׁוֹפֵט צֶדֶק: <tei:milestone unit="stanza"/></tei:p><tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader_and_congregation" xml:lang="he"><tei:choice><tei:abbr>קו״ח</tei:abbr><tei:expan>קהל וחזן</tei:expan></tei:choice></tei:note> <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/22"/>הַתָּם וּמִתַּמֵּם עִם תְּמִימִים: <tei:choice><tei:abbr>וְ״מַ</tei:abbr><tei:expan>וְכֹל מַאֲמִינִים</tei:expan></tei:choice> שֶׁהוּא תָּמִים פָּעֳלוֹ: <tei:milestone unit="stanza"/></tei:p></tei:div></tei:body></tei:text></tei:TEI>