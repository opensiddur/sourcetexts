{
  "units": [
    {
      "stem": "amidah_qedushah",
      "urn": "urn:x-opensiddur:text:prayer:amidah/qedushah",
      "title": {
        "he": "קדושה",
        "en": "Kedushah"
      },
      "instructions": [
        {
          "language": "he",
          "text": "קדושה לש״ץ בחזרת התפלה.",
          "type": "description",
          "source_script": "rashi"
        }
      ],
      "languages": {
        "he": [
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/neqaddesh",
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "נְקַדֵּשׁ אֶת שִׁמְךָ בָּעוֹלָם כְּשֵׁם שֶׁמַּקְדִּישִׁים אוֹתוֹ בִּשְׁמֵי מָרוֹם כַּכָּתוּב עַל־יַד נְבִיאֶךָ וְקָרָא זֶה אֶל־זֶה וְאָמַר.",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/qadosh",
            "speaker": {
              "abbr": "קו״ח",
              "expan": "קהל וחזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל־הָאָרֶץ כְּבוֹדוֹ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/leummatam",
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "לְעֻמָּתָם בָּרוּךְ יֹאמֵרוּ.",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/barukh_kevod",
            "speaker": {
              "abbr": "קו״ח",
              "expan": "קהל וחזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "בָּרוּךְ כְּבוֹד־יְיָ מִמְּקוֹמוֹ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/uvedivrei",
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר.",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/yimlokh",
            "speaker": {
              "abbr": "קו״ח",
              "expan": "קהל וחזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלֲלוּיָהּ:",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/ledor_vador",
            "speaker": {
              "abbr": "ח׳",
              "expan": "חזן"
            },
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה.",
                "page_start": false
              }
            ]
          },
          {
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushah/hael_haqadosh",
            "fragments": [
              {
                "scan": "s9",
                "printed_page": "3",
                "text": "בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:",
                "page_start": false
              }
            ]
          }
        ]
      },
      "conditions": [
        {
          "type": "opensiddur:recitation",
          "features": {
            "repetition": true
          }
        },
        {
          "type": "opensiddur:quorum",
          "features": {
            "minyan": true
          }
        }
      ]
    },
    {
      "stem": "rh_uvekhen_ten_pachdekha",
      "urn": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_pachdekha",
      "title": {
        "he": "ובכן תן פחדך",
        "en": "Evening Prayer for the New Year — Put the fear of Thee"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s26",
                "printed_page": "16",
                "text": "וּבְכֵן תֵּן פַּחְדְּךָ יְיָ אֱלֹהֵינוּ עַל כָּל־מַעֲשֶׂיךָ וְאֵימָתְךָ עַל כָּל־מַה־שֶּׁבָּרָאתָ וְיִירָאוּךָ כָּל הַמַּעֲשִׂים וְיִשְׁתַּחֲווּ לְפָנֶיךָ כָּל־הַבְּרוּאִים וְיֵעָשׂוּ כֻלָּם אֲגֻדָּה אַחַת לַעֲשׂוֹת רְצוֹנְךָ בְּלֵבָב שָׁלֵם כְּמוֹ שֶׁיָּדַעְנוּ יְיָ אֱלֹהֵינוּ שֶׁהַשָּׁלְטָן לְפָנֶיךָ עֹז בְּיָדְךָ וּגְבוּרָה בִּימִינֶךָ וְשִׁמְךָ נוֹרָא עַל כָּל־מַה־שֶּׁבָּרָאתָ:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s27",
                "printed_page": "16",
                "text": "And therefore put the fear of Thee, O Lord our God, upon all Thy works and awe of Thee upon all that Thou hast created, so that all works may fear Thee and all the created bow down before Thee and all of them may be made into one group for the performance of Thy will with a complete heart, since we know, O Lord our God, that dominion lies before Thee, that strength is in Thy hand and might in Thy right hand and that Thy Name inspires with awe all that Thou has created.",
                "page_start": false
              }
            ]
          }
        ]
      }
    },
    {
      "stem": "rh_uvekhen_ten_kavod",
      "urn": "urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod",
      "title": {
        "he": "ובכן תן כבוד",
        "en": "Evening Prayer for the New Year — Grant honour"
      },
      "languages": {
        "he": [
          {
            "fragments": [
              {
                "scan": "s26",
                "printed_page": "16",
                "text": "וּבְכֵן תֵּן כָּבוֹד יְיָ לְעַמֶּךָ תְּהִלָּה לִירֵאֶיךָ וְתִקְוָה לְדוֹרְשֶׁיךָ וּפִתְחוֹן פֶּה לַמְיַחֲלִים לָךְ שִׂמְחָה לְאַרְצֶךָ",
                "page_start": false
              },
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "וְשָׂשׂוֹן לְעִירֶךָ וּצְמִיחַת קֶרֶן לְדָוִד עַבְדֶּךָ וַעֲרִיכַת נֵר לְבֶן־יִשַׁי מְשִׁיחֶךָ בִּמְהֵרָה בְּיָמֵינוּ:",
                "page_start": true
              }
            ]
          }
        ],
        "en": [
          {
            "fragments": [
              {
                "scan": "s27",
                "printed_page": "16",
                "text": "And therefore grant honour, O Lord, to Thy people, fame to those who fear Thee and praise to those who seek Thee and confidence to those who wait for Thee, joy to Thy",
                "page_start": false
              },
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "land, happiness to Thy city and a rise of fortune to David Thy servant and an array of light to the son of Jesse Thine anointed speedily and in our days.",
                "page_start": true
              }
            ]
          }
        ]
      }
    },
    {
      "stem": "rh_uvekhen_tzaddiqim",
      "urn": "urn:x-opensiddur:text:prayer:amidah/uvekhen_tzaddiqim",
      "title": {
        "he": "ובכן צדיקים",
        "en": "Evening Prayer for the New Year — The righteous shall rejoice"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "וּבְכֵן צַדִּיקִים יִרְאוּ וְיִשְׂמָחוּ וִישָׁרִים יַעֲלֹזוּ וַחֲסִידִים בְּרִנָּה יָגִילוּ וְעוֹלָתָה תִּקְפָּץ־פִּיהָ. וְכָל־הָרִשְׁעָה כֻּלָּהּ כְּעָשָׁן תִּכְלֶה כִּי תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן־הָאָרֶץ:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "And thus may the righteous see and rejoice and the upright exult and the pious revel with joy. Vice shall close its mouth and all evil entirely disappear like smoke when Thou removest the dominion of arrogance from the earth.",
                "page_start": false
              }
            ]
          }
        ]
      }
    },
    {
      "stem": "rh_vetimlokh",
      "urn": "urn:x-opensiddur:text:prayer:amidah/vetimlokh_attah_hashem",
      "title": {
        "he": "ותמלוך אתה",
        "en": "Thou shalt reign"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "וְתִמְלוֹךְ אַתָּה יְיָ לְבַדֶּךָ עַל כָּל־מַעֲשֶׂיךָ בְּהַר צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ וּבִירוּשָׁלַיִם עִיר קָדְשֶׁךָ. כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "יִמְלֹךְ יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלֲלוּיָהּ:",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/146/10",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/146/10"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "And Thou, O Lord, shalt reign alone over all Thy works on Mount Zion, Thy glorious dwelling, and in Jerusalem, Thy Holy City, as it is written in Thy holy word,",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "the Lord shall reign for ever, your God, O Zion, from generation to generation. Halleluyah!",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:psalms/146/10",
            "source_reference": "urn:x-opensiddur:text:bible:psalms/146/10"
          }
        ]
      }
    },
    {
      "stem": "rh_qadosh_attah",
      "urn": "urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora",
      "title": {
        "he": "קדוש אתה ונורא",
        "en": "Evening Prayer for the New Year — Holy art Thou"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "קָדוֹשׁ אַתָּה וְנוֹרָא שְׁמֶךָ וְאֵין אֱלוֹהַּ מִבַּלְעָדֶיךָ. כַּכָּתוּב",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "וַיִּגְבַּהּ יְיָ צְבָאוֹת בַּמִּשְׁפָּט וְהָאֵל הַקָּדוֹשׁ נִקְדַּשׁ בִּצְדָקָה.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:isaiah/5/16",
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/5/16"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s28",
                "printed_page": "17",
                "text": "בָּרוּךְ אַתָּה יְיָ הַמֶּלֶךְ הַקָּדוֹשׁ:",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/hamelekh_haqadosh"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "Holy art Thou and awe-inspiring is Thy Name and there is no God beside Thee, as it is written,",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "exalted is the Lord of Hosts through judgment and the Holy God is sanctified through righteousness.",
                "page_start": false
              }
            ],
            "source": "urn:x-opensiddur:text:bible:isaiah/5/16",
            "source_reference": "urn:x-opensiddur:text:bible:isaiah/5/16"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s29",
                "printed_page": "17",
                "text": "Blessed art Thou, O Lord, the Holy King.",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/hamelekh_haqadosh"
          }
        ]
      }
    }
  ]
}