      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/misod_chakhamim" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n220.jpg">
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/misod_chakhamim/text"/><tei:seg source="urn:x-opensiddur:text:prayer:misod_chakhamim">Choosing from the counsel of wise and discerning men and from the teaching of those that understand knowledge, I open my mouth in prayer and supplication to entreat and implore the countenance of the King of kings and the Lord of lords.</tei:seg> <tei:milestone unit="prayer-part"/></tei:p>
