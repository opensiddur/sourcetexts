  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n199.jpg">
        <tei:pb ed="1965" n="90" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n199.jpg"/>
        <tei:note type="instruction" xml:lang="en">The Reader says half Kaddish.</tei:note>
        <tei:p><tei:milestone unit="prayer-part" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/text"/><tei:milestone unit="chapter" n="14" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/quotes/veattah/numbers_14"/><tei:milestone unit="verse" n="17" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/quotes/veattah/numbers_14/17"/><tei:seg source="urn:x-opensiddur:text:bible:numbers/14/17">וְעַתָּה יִגְדַּל־נָא כֹּחַ אֲדֹנָי כַּאֲשֶׁר דִּבַּרְתָּ לֵאמֹר:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:milestone unit="chapter" n="25" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/quotes/zekhor/psalms_25"/><tei:milestone unit="verse" n="6" corresp="urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/quotes/zekhor/psalms_25/6"/><tei:seg source="urn:x-opensiddur:text:bible:psalms/25/6">זְכֹר רַחֲמֶיךָ <j:divineName>יְיָ</j:divineName> וַחֲסָדֶיךָ כִּי מֵעוֹלָם הֵמָּה:</tei:seg><tei:milestone unit="verse"/><tei:milestone unit="chapter"/> </tei:p>
        <tei:p><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</tei:note> יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא בְּעָלְמָא דִּבְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל־בֵּית־יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב, וְאִמְרוּ אָמֵן. </tei:p>
        <tei:p>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. </tei:p>
        <tei:p>יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְקֻדְשָׁא בְּרִיךְ הוּא לְעֵלָּא וּלְעֵלָּא מִן־כָּל־בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן: <tei:milestone unit="prayer-part"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
</tei:TEI>
