    <tei:note type="commentary" target="#musaf_uppad_lindan_variant">
      <tei:p><tei:choice><tei:abbr>נ״א</tei:abbr><tei:expan>נוסח אחר</tei:expan></tei:choice> לַנֶּֽדֶן</tei:p>
    </tei:note>
  </tei:standOff>
  <tei:text>
    <tei:body>
      <tei:div corresp="urn:x-opensiddur:text:poem:uppad_meaz" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n221.jpg">
        <tei:pb ed="1965" n="101" facs="https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n221.jpg"/>
        <tei:note type="description" xml:lang="he">מיוסד <tei:choice><tei:abbr>ע״ס</tei:abbr><tei:expan>על סדר</tei:expan></tei:choice> <tei:choice><tei:abbr>א״ב</tei:abbr><tei:expan>אלף בית</tei:expan></tei:choice>.</tei:note>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/1"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he"><tei:choice><tei:abbr>ק׳</tei:abbr><tei:expan>קהל</tei:expan></tei:choice></tei:note> אֻפָּד מֵאָז לְשֶׁפֶט הַיּוֹם. בְּחוּן מַעֲשֵׂה כָל יוֹם. גִּשַּׁת יְקוּמִים פְּנֵי אָיוֹם. דִּינָם בּוֹ לְפַלֵּס לְפִדְיוֹם: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/2"/>הָרִאשׁוֹן אָדָם בּוֹ נוּצַר. וְצֻוָּה חֹק וְלֹא נָצַר. זֶה מֵלִיץ כְּהִרְחִיב בַּצַּר. חֻקּוֹ לְמִשְׁפָּט וּלְדוֹרוֹת מִנְצָר: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/3"/>טִיעַת חוֹצֵב גְּבָעוֹת וְצוּרִים. יַלְדֵי בוֹ מֵרֹאשׁ צוּרִים. כְּיוֹשְׁבֵי נְטָעִים הֵמָּה הַיּוֹצְרִים. לְלַמֵּד בּוֹ צֶדֶק לָעֲצוּרִים: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/4"/>מְיוּחָס שְׁמוֹ בְּשֵׁם אֵיתָנִים. נָם לְהִתְנוֹסֵס עֶלְיוֹנִים וְתַחְתּוֹנִים. סְפָרִים נִפְתָּחִים וּמַעֲשִׂים מְתַנִּים. עוֹבְרִים לְפָנֶיךָ וְחֶשְׁבּוֹן נוֹתְנִים: <tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/5"/>פָּקִיד הוּכַן לְתִקּוּן מוֹעֲדֶיךָ. צֹאן לְהַעֲבִיר כְּשֵׁבֶט עֲדָיֶךָ: <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he"><tei:choice><tei:abbr>ח׳</tei:abbr><tei:expan>חזן</tei:expan></tei:choice></tei:note>  <j:conditional xml:id="musaf_uppad_meaz_segment_6"><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="false"/></tei:f></tei:fs></j:all></j:conditional>קֶרֶן בְּמָשְׁכָם <j:endConditional target="#musaf_uppad_meaz_segment_6"/><j:conditional type="marked" xml:id="musaf_uppad_meaz_segment_7"><tei:note type="instruction" xml:lang="he">אם שבת</tei:note><j:all><tei:fs type="opensiddur:holiday-aggregate"><tei:f name="shabbat"><tei:binary value="true"/></tei:f></tei:fs></j:all></j:conditional>קֶרֶן בְּזָכְרָם <j:endConditional target="#musaf_uppad_meaz_segment_7"/>הַיּוֹם עָדֶיךָ. רַחוּם זְכוֹר שְׁבוּעַת עֲבָדֶיךָ: </tei:p>
        <tei:p><tei:milestone unit="stanza" corresp="urn:x-opensiddur:text:poem:uppad_meaz/6"/><tei:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל</tei:note> נַעֲלֶה שׁוֹפָר עִם תַּחֲנוּן. שַׁדַּי לְפַתּוֹתְךָ בָּם בְּחִנּוּן. <tei:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</tei:note> תָּשִׁיב <tei:choice xml:id="musaf_uppad_lindan_variant"><j:option>לִנְדָן</j:option><j:option>לַנֶּֽדֶן</j:option></tei:choice> בְּרַק הַשָּׁנוּן. תַּחֲזֵק מָגֵן לְגוֹנְנֵי בְּגִנּוּן: <tei:milestone unit="stanza"/></tei:p>
      </tei:div>
    </tei:body>
  </tei:text>
