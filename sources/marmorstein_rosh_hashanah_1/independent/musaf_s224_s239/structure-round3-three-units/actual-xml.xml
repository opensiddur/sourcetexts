        <tei:p><tei:choice><j:option>And thus <tei:milestone unit="chapter" n="33"/><tei:milestone unit="verse" n="5"/><tei:milestone unit="half-verse" n="a" corresp="urn:x-opensiddur:text:bible:deuteronomy/33/5/a"/><tei:seg source="urn:x-opensiddur:text:bible:deuteronomy/33/5">was He King in Yeshurun</tei:seg><tei:milestone unit="half-verse"/><tei:milestone unit="verse"/><tei:milestone unit="chapter"/></j:option><j:option>Therefore let us crown Thee, Supreme King.</j:option></tei:choice> </tei:p>
