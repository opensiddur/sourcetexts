[
  {
    "stem": "rh_gevurot",
    "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/gevurot",
    "title": {
      "he": "גבורות",
      "en": "Evening Prayer for the New Year — Divine might"
    },
    "languages": {
      "he": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s26",
              "printed_page": "16",
              "text": "אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s26",
              "printed_page": "16",
              "text": "מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s26",
              "printed_page": "16",
              "text": "מִי כָמוֹךָ אַב הָרַחֲמִים. זוֹכֵר יְצוּרָיו לַחַיִּים בְּרַחֲמִים.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s26",
              "printed_page": "16",
              "text": "וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה יְיָ מְחַיֵּה הַמֵּתִים:",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"
        }
      ],
      "en": [
        {
          "paragraph": 1,
          "fragments": [
            {
              "scan": "s27",
              "printed_page": "16",
              "text": "Thou art for ever mighty, O Lord the reviver of the dead, Thou art great to save.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"
        },
        {
          "paragraph": 2,
          "fragments": [
            {
              "scan": "s27",
              "printed_page": "16",
              "text": "Sustaining life with kindness, reviving the dead with great compassion, supporting the falling and healing the sick and releasing captives and keeping His faith with those who sleep in the dust. Who is like Thee, Master of might, and who resembles Thee, O King, who slays and revives and causes salvation to spring forth.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"
        },
        {
          "paragraph": 3,
          "fragments": [
            {
              "scan": "s27",
              "printed_page": "16",
              "text": "Who is like Thee, Father of compassion, who remembers His creatures for life in compassion.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"
        },
        {
          "paragraph": 4,
          "fragments": [
            {
              "scan": "s27",
              "printed_page": "16",
              "text": "And Thou art faithful to revive the dead. Blessed art Thou, O Lord who revives the dead.",
              "page_start": false
            }
          ],
          "corresp": "urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"
        }
      ]
    }
