      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_33",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s284",
            "printed_page": "132",
            "text": "זֵכֶר וְכַח",
            "page_start": false
          },
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "כָּל פֹּעַל. בְּקַו וָפֶלֶס יַעַל. וְאִם בְּמֶרֶד וְאִם בְּמַעַל. רַב חֶסֶד יִזְכֹּר:",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_34",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "וְאִם טוֹב וְאִם רַע. אֲשֶׁר בּוֹ יֵאָרַע. וֶסְתּוֹ יִפָּרַע. בְּסַאסְּאָה מִלִּזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_35",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "זֵכֶר הַחַיִּים. עַד כַּמֶּה הֵם חַיִּים. הֵן לַמָּוֶת אִם לַחַיִּים. חַי חַי יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_36",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "הֲמוֹן שְׁאוֹן בְּרוּאִים. יַעַבְרוּ לְפָנָיו כִּמְרִיאִים. הֲלֹא כְּמוֹ רְאוּיִים. לְכָל אֶחָד יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_37",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "זֵכֶר דַּלּוּת וָעֹשֶׁר. בַּצֹּרֶת וָחֹשֶׁר. דּוֹפִי וְגַם יֹשֶׁר. בַּדִּין הוּא יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_38",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "דְּבַר גָּלוּי וָסֵתֶר. בִּנְיָנוֹת וְסוֹתֵר. דֵּי חָסֵר וָיֶתֶר. לְקֶצֶב יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_39",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "זֵכֶר גְּנוּנִים לְיַשֵּׁב. בַּמִּדְבָּר וְיוֹשֵׁב. גֶּשֶׁם וְרוּחַ לְנַשֵּׁב. מֵהַיּוֹם יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_40",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "גָּרוֹן לְהַקְשֵׁב. מֵעַם שְׁמוֹ חוֹשֵׁב. גָּלְיוֹת לְהָשֵׁב. בְּיוֹם תֶּקַע יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_41",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s286",
            "printed_page": "133",
            "text": "זֵכֶר בַּהַל וְחֵמָה. קְרָב",
            "page_start": false
          },
          {
            "scan": "s288",
            "printed_page": "134",
            "text": "וּמִלְחָמָה. בִּקּוּעַ חוֹמָה. לְחוֹמַת יָם יִזְכֹּר:",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_42",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s288",
            "printed_page": "134",
            "text": "בָּאָדָם וּבַבְּהֵמָה. אִם הָקְנַס מְהוּמָה. בְּצוּר קוֹל הוֹמָה. לָאֲדָמָה יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_43",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s288",
            "printed_page": "134",
            "text": "זֵכֶר אֱמוּנָה וָשֶׁקֶר. אוֹזֶן שִׂיחַ וָסֶקֶר. אוֹת פְּקֻדַּת בֹּקֶר. לִרְגָעִים יִזְכּוֹר:",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_44",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s288",
            "printed_page": "134",
            "text": "אִם לְזוֹל אִם לִיקֶר. אוֹ לָטַעַת אוֹ לְעַקֶּר. אֱנוֹשׁ בְּדִקְדּוּק וָחֵקֶר. לַמִּשְׁפָּט יִזְכֹּר:",
            "page_start": false
          }
        ],
        "end_reference": true,
        "speaker": {
          "abbr": "ח׳",
          "expan": "חזן"
        },
        "speaker_before_reference": true
      }
    ],
    "en": [
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_1",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "On the day of memory of the beginning of all action, let the Creator not remember those of the deeds of the whole year that are in conflict with Israel’s hopes.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_2",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "If reproof for those deeds has gone forth in anger, may He grant help for His own sake and remember the creatures.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_3",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "May He look and recall the memory of the people He first appointed, the first harvest, the root of the first fruit.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_4",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "When in His anger He determines to send severe punishment, may He remember the atonement which He has ordained for the faithless.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_5",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "He remembers the first man who was formed from dust, the countless generations and the inscribed (good deeds) on behalf of the people that is like the sand in number.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_6",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "He remembers those counted in four camps who implore expiation and sound the Shofar in order to purify themselves.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_7",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "He remembers what was read out from the book that was bestowed by Him upon the first man even before its completion. He had decided in that book that He was to be remembered in every generation.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_8",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s279",
            "printed_page": "129",
            "text": "When anger is written down in the book and no",
            "page_start": false
          },
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "atonement can be found, then He remembers the confirmation of this book.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_9",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "He remembers the hidden one (Noah) in the age of open rebels, the perfect and the pure; when He is angry and wishes to curse the earth, He remembers those acquired by Him (Israel).",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_10",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "As to those who stand crowded together before the countenance of the Awe-inspiring, may He bring to light their judgment; may He not in strife recall the ugly evil leaven.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_11",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "He remembers the work of that strong one whom He told to rise up from the east (Abraham). May He soon recall his shining act.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_12",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "When destruction threatens to annihilate his offspring, may his supplication become audible that He may remember them kindly.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_13",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "He remembers the sacrifice on Moriah (Isaac) whose eyes become dim; for the sake of people naked and bare, may He recall the ram caught in the thicket.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_14",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "When the fruitful people is afflicted with a festering wound, may his prayer be manifest that God may remember his merit.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_15",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "He remembers him who saw the ladder in the dream (Jacob); above it the Creator appeared to him, showed him the princes of the four empires and their yoke. He will remember him, as in former days.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_16",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s281",
            "printed_page": "130",
            "text": "When His",
            "page_start": false
          },
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "adherents are faithless and the Lord intends to reject them, may his prayer avail them that on their behalf the covenant may be remembered.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_17",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "He remembers the noble tribes (twelve), the oath of the tribes, the wanderings of the tribes does He recall, to strengthen them.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_18",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "When He says that He will crush those who bear the heavy yoke, then He remembers as an atonement the destruction of the site of the Sanctuary.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_19",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "He remembers the foundation stones (forefathers), who groan in Egyptian slavery.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_20",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "The sucklings who praised the Lord at the Sea of Reeds, the promise of the covenant (the circumcision) and the statutes (of the Torah), His holy word, all these does He remember.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_21",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "The memory of those who live austerely (students of the Torah) and study His beautiful sayings, who with their lips provide a substitute for sacrificial bullocks, He does remember.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_22",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "When the books that announce what is hidden, are examined, He remembers in love the wonderful pair of brothers.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_23",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "He remembers the honour of the sanctuary, the place where He, the Beloved, did dwell, where He allowed the Cherubim to rest, the love of our youth He remembers.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_24",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s283",
            "printed_page": "131",
            "text": "The basin on its frame, the delightful voice (of the Levites) on the Temple steps, the Almighty recalls them in favour of the discerning on the appointed day of judgment.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_25",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "He remembers (Joshua) the son of Nun, and the illuminating words of him who comes from Yephuneh, (Caleb), may they be recalled in prayer so that their deeds should be remembered.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_26",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "When the destructive gleaming sword is drawn for grief, may He hear and remember the supplications of those He has favoured.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_27",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "He remembers the noble judges and the sign given by Samuel at the time of the wheat harvest. He heals the folly of the simple, so that it is no longer remembered.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_28",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "When the destructive gleaming sword is drawn for the four punishments, may He remember the nature of the judgments He gave them.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_29",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "May He remember the hymns of praise in which David, at midnight, praised the rules of the night, may He remember his song in the darkness of the night on their behalf.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_30",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "May He illuminate the nightly search by the fire of the night upon the altar; the law in which they study by day and by night, may He remember for their healing.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_31",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "He remembers the palace that was taken from me on account of my selfishness. May He no longer recall that it was laden with deliberate sins.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_32",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "When anger, as at the time of the flood, is aroused in destruction, let Him remember the month of Bul (the completion of the Temple) in compassion.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_33",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s285",
            "printed_page": "132",
            "text": "He re",
            "page_start": false,
            "join_next": true
          },
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "members the test of every creature according to measure and in the scales; when they have committed acts of rebellion and faithlessness, may He remember them, full of compassion.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_34",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "As to the good and the evil whose deeds and way of life should be requited, may He not remember them according to the severity of the law.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_35",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "He remembers life, how long their life shall be; for death or for life He remembers all the living.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_36",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "The noisy throng of creatures passes before Him like lambs; He remembers each according to his worth.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_37",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "He remembers poverty and wealth, need and plenty, vice and virtue; in judgment does He remember.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_38",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "The open and the hidden, building and tearing down, death and superfluity, does He measure and remember.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_39",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "He remembers those who should live sheltered in the wilderness or in settlements; to send rain and wind does He remember.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_40",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "To hear the prayer of the people that reveres His Name and to lead back the exiles does He remember on the day of the Tekiah.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_41",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s287",
            "printed_page": "133",
            "text": "He recalls terror and wrath, battle and wars; the destruction of",
            "page_start": false
          },
          {
            "scan": "s289",
            "printed_page": "134",
            "text": "the wall (Jerusalem) He remembers against the wall of the sea.",
            "page_start": true
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_42",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s289",
            "printed_page": "134",
            "text": "When confusion has been decreed as punishment for man and beast, He remembers the loud entreaty of the earth.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_43",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s289",
            "printed_page": "134",
            "text": "He remembers fidelity and falsehood by ear, speech and glance, the test of every morning and every moment does He recall.",
            "page_start": false
          }
        ]
      },
      {
        "paragraph": 1,
        "corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_44",
        "reference_unit": "stanza",
        "fragments": [
          {
            "scan": "s289",
            "printed_page": "134",
            "text": "He remembers abundance or scarcity, planting or uprooting, for mankind with care and searching in judgment.",
            "page_start": false
          }
        ],
        "end_reference": true
      }
    ]
