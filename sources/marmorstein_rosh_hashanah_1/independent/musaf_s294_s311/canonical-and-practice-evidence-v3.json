    "musaf_hayom_shabbat_custom": {
      "text": "יש קהלות שאין אומרים בשבת לא היום ולא ארשת, ויש שאומרים היום אבל לא ארשת. ויש שאומרים שניהם אבל אין הש״ץ חוזר, ויש שהש״ץ חוזר היום ואינו חוזר ארשת, ויש שהש״ץ חוזר שניהם וכן נוהג ק״ק פפד״מ.",
      "language": "he",
      "witnesses": [
        "he"
      ],
      "scan": "s274",
      "printed_page": "127",
      "page_start": false,
      "type": "instruction"
    },
    "musaf_areshet_custom": {
      "text": "ואומרים ארשת והש״ץ חוזר, ויש קהלות שא״א בשבת, ויש שאין הש״ץ חוזר.",
      "language": "he",
      "witnesses": [
        "he"
      ],
      "scan": "s274",
