{"end":"t:foreign"}
{"tail":" "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"The Holy Ark is closed."}
{"end":"t:foreign"}
{"tail":" "}
{"end":"t:note"}
{"tail":"\n                    "}
