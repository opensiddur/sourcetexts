{"text":"חזן"}
{"end":"t:note"}
{"tail":"\n                        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/attah_horeta_quiet"}}
