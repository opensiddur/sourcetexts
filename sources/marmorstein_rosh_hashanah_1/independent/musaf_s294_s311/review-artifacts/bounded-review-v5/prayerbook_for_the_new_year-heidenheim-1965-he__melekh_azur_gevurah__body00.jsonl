{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n97.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n97.jpg","n":"35"}}
{"end":"t:pb"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/1"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ אָזוּר גְּבוּרָה. גָּדוֹל שִׁמְךָ בִּגְבוּרָה. לְךָ זְרוֹעַ עִם גְּבוּרָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/2"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ בִּגְדֵי נָקָם. לָבֵשׁ בְּיוֹם נָקָם. לְצָרָיו יָשִׁיב אֶל־חֵיקָם: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/3"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ גֵּאוּת לָבֵשׁ. יַמִּים מְיַבֵּשׁ. וְגַאֲוַת אֲפִיקִים מְכַבֵּשׁ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/4"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ בַּעֲשָׂרָה לְבוּשִׁים. הִתְאַזָּר בִּקְדוֹשִׁים. אֵל נַעֲרָץ בְּסוֹד קְדוֹשִׁים. קָדוֹשׁ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/5"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ דָּר בִּנְהוֹרָא. עוֹטֶה כַשַּׂלְמָה אוֹרָה. מִשְׁפָּטֵנוּ יוֹצִיא כָאוֹרָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/6"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ הִתְאַזָּר עֹז. יְמִינוֹ תָּעוֹז. וֶאֱנוֹשׁ אַל יָעוֹז: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/7"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ וַיִּלְבַּשׁ צְדָקָה. וְנִקְדַּשׁ בִּצְדָקָה. לְךָ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" הַצְּדָקָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/8"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ זֶה הָדוּר בִּלְבוּשׁוֹ. וְכוֹבַע יְשׁוּעָה בְּרֹאשׁוֹ. אֱלֹהִים יָשַׁב עַל כִּסֵּא קָדְשׁוֹ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/9"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ חֲמוּץ בְּגָדִים. בְּדָרְכוֹ בוֹגְדִים. יִבְצֹר רוּחַ נְגִידִים: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/10"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ טַלִּיתוֹ כַשֶּׁלֶג מְצֻחְצָח. צַח וּבְצַחְצָחוֹת יְצַחְצַח. מְצַחְצְחִים פָּעֳלָם לְנַצַּח: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/11"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ יָעַט קִנְאָה. קַנֹּא קִנֵּא גָּאֹה גָאָה. כְּאִישׁ מִלְחָמוֹת יָעִיר קִנְאָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/12"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ, כָּל־אַפְסֵי אָרֶץ. יִשְׁתַּחֲווּ לְמֶלֶךְ עַל כָּל־הָאָרֶץ. כִּי בָא לִשְׁפּוֹט אֶת־הָאָרֶץ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/13"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ לְיוֹם קוּמוֹ לָעַד. כָּל־יְצוּר לְפָנָיו יִרְעַד. רָם וְנִשָּׂא שׁוֹכֵן עַד: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/14"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ "}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n99.jpg","n":"36"}}
{"end":"t:pb"}
{"tail":"מוֹשֵׁל עוֹלָם בִּגְבוּרָתוֹ. יִרְעֲשׁוּ הָרִים מִגַּאֲוָתוֹ. וּכְאֵילִים יִרְקְדוּ מִגַּעֲרָתוֹ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/15"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ נוֹרָא לְמַלְכֵי אָרֶץ. חוֹל תָּחוּל הָאָרֶץ. מִיּוֹשֵׁב הַכְּרוּבִים תָּנוּט הָאָרֶץ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/16"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ שְׂאֵתוֹ מִי יַעֲצָר־כֹּחַ. וְהוּא נוֹשֵׂא כֹל בַּכֹּחַ. נוֹתֵן לַיָּעֵף כֹּחַ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/17"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ עָמְדוֹ לָדִין. בְּיוֹם הַדִּין. שְׁפּוֹט גֵּאִים בַּדִּין: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/18"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ פִּלֵּשׂ סוֹד הַמַּעֲמִיקִים. לַסְתִּיר עֵצָה בְּמַעֲמַקִּים. יֶחֱשֹׂף וִיגַלֶּה עֲמוּקִים: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/19"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ צַוֵּה מִכָּל־רוּחַ. עָרִיצֵי גַּסֵּי הָרוּחַ. לְאַפְּפָם בְּשֶׁטֶף רוּחַ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/20"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ קְהֵל מַלְכֵי אֲדָמָה. בְּסַעֲרוֹ מַשָּׂא דוּמָה. יִפְקֹד עַל צְבָא רוּמָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/21"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ רָם וְגָבֹהַּ בַּמִּשְׁפָּט. וְעֹז מֶלֶךְ אָהֵב מִשְׁפָּט. מְכוֹן כִּסְאוֹ צֶדֶק וּמִשְׁפָּט: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/22"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ שׁוֹפֵט צֶדֶק. לְפָנָיו יְהַלֵּךְ צֶדֶק. לְהָלִיץ בְּעַד רוֹדְפֵי צֶדֶק: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/23"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ תַּקִּיף בְּמֶמְשָׁלָה. וְכִסְאוֹ תָּלָה לְמַעְלָה. וּמַלְכוּתוֹ בַּכֹּל מָשָׁלָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"ח׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"חזן"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/24"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ תִחֵת חֶלֶד מֵהַבִּיטוֹ. מַרְעִיד יְסוֹד בְּהַבִּיטוֹ. בַּכֹּל מְשׁוֹטֵט מַבָּטוֹ: "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/25"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ תָּר בְּכָל־פֹּעַל. בַּכֹּל מַה יִפְעַל. בְּמַטָּה וּבְמָֽעַל: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_azur_gevurah/26"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ אֱלֹהֵי עוֹלָם. הִמְלִיכֽוּהוּ עַם עוֹלָם. "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" יִמְלֹךְ לְעוֹלָם. קָדוֹשׁ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
