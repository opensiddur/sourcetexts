{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/gevurot","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n199.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
