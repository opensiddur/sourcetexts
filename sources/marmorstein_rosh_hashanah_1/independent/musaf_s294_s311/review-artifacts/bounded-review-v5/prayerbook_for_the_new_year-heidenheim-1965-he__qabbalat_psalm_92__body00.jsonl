{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n16.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"92"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/1","n":"1"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/1"}}
{"text":"מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/2","n":"2"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/2"}}
{"text":"טוֹב לְהֹדוֹת לַ"}
{"start":"j:divineName","attrs":{}}
{"text":"יהֹוָה"}
{"end":"j:divineName"}
{"tail":" וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/3","n":"3"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/3"}}
{"text":"לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/4","n":"4"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/4"}}
{"text":"עֲלֵי־עָשׂוֹר וַעֲלֵי־נָבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/5","n":"5"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/5"}}
{"text":"כִּי שִׂמַּחְתַּנִי "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" בְּפָעֳלֶךָ בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/6","n":"6"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/6"}}
{"text":"מַה־גָּדְלוּ מַעֲשֶׂיךָ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/7","n":"7"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/7"}}
{"text":"אִישׁ בַּעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/8","n":"8"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/8"}}
{"text":"בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן לְהִשָּׁמְדָם עֲדֵי־עַד:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/9","n":"9"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/9"}}
{"text":"וְאַתָּה מָרוֹם לְעֹלָם "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":":"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/10","n":"10"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/10"}}
{"text":"כִּי הִנֵּה אֹיְבֶיךָ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" כִּי־הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/11","n":"11"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/11"}}
{"text":"וַתָּרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶׁמֶן רַעֲנָן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/12","n":"12"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/12"}}
{"text":"וַתַּבֵּט עֵינִי בְּשׁוּרָי בַּקָּמִים עָלַי מְרֵעִים תִּשְׁמַעְנָה אָזְנָי:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/13","n":"13"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/13"}}
{"text":"צַדִּיק כַּתָּמָר יִפְרָח כְּאֶרֶז בַּלְּבָנוֹן יִשְׂגֶּה:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/14","n":"14"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/14"}}
{"text":"שְׁתוּלִים בְּבֵית "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" בְּחַצְרוֹת אֱלֹהֵינוּ יַפְרִיחוּ:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/15","n":"15"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/15"}}
{"text":"עוֹד יְנוּבוּן בְּשֵׂיבָה דְּשֵׁנִים וְרַעֲנַנִּים יִהְיוּ:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/qabbalat_psalm_92/16","n":"16"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/92/16"}}
{"text":"לְהַגִּיד כִּי־יָשָׁר "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" צוּרִי וְלֹא־עַוְלָתָה בּוֹ:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n      "}
{"end":"t:div"}
