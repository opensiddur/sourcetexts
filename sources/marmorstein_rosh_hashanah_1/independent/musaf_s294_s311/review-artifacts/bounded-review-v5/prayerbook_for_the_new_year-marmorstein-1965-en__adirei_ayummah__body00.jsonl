{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adirei_ayummah/23"}}
{"end":"t:milestone"}
{"tail":"Those who affirm Thy glory speak sincerely and aloud: The Lord has reigned. "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adirei_ayummah/24"}}
{"end":"t:milestone"}
