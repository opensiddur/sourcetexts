{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:exodus/15/18"}}
{"text":"The Lord will reign for ever and ever."}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adirei_ayummah/4"}}
{"end":"t:milestone"}
{"tail":"The fiery in their haste utter aloud: The Lord is King. "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adirei_ayummah/5"}}
{"end":"t:milestone"}
{"tail":"The massed multitude praise aloud: The Lord has reigned. "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adirei_ayummah/6"}}
{"end":"t:milestone"}
