{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n162.jpg","n":"70"}}
