{"start":"t:milestone","attrs":{"unit":"chapter","n":"69","corresp":"urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/vaani"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"14","corresp":"urn:x-opensiddur:text:prayer:ribbono_shel_olam/malle_mishalot/quotations/vaani/14"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/69/14"}}
{"text":"My prayer goes out to Thee, O Lord, at a time of favour, O God, in Thine abundant mercy, answer me with the truth of Thy salvation."}
{"end":"t:seg"}
