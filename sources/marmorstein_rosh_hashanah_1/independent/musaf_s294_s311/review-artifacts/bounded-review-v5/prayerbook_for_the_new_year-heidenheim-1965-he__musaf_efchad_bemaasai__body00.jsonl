{"tail":"כַּכָּתוּב בְּתוֹרָתֶךָ "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"8","corresp":"urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"1","corresp":"urn:x-opensiddur:text:poem:efchad_bemaasai/shabbat_genesis_8_1/quotes/genesis_8_1/genesis_8/1"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:genesis/8/1"}}
{"text":"וַיִּזְכֹּר אֱלֹהִים אֶת־נֹחַ וְאֵת כָּל־הַחַיָּה וְאֶת־כָּל־הַבְּהֵמָה אֲשֶׁר אִתּוֹ בַּתֵּבָה וַיַּעֲבֵר אֱלֹהִים רוּחַ עַל־הָאָרֶץ וַיָּשֹׁכּוּ הַמָּיִם:"}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:efchad_bemaasai/stanza_31"}}
{"end":"t:milestone"}
{"tail":"עֲשֵׂה פֶלֶא לְחַיִּים. לְבַל יִהְיוּ כַּמֵּתִים. הֲיֵשׁ אֲמִתֶּךָ. בַּקֶּבֶר לְזִכָּרוֹן: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
