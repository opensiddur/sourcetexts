                        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan"/>
                      </t:div>
                    </t:div>
                    <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/veal_kullam"/>
                    <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/ukhetov"/>
                    <j:transclude type="external" target="urn:x-opensiddur:text:siddur:rosh_hashanah/text/vekhol_hachayyim"/>
                    <t:div xml:id="section_musaf_repetition_kohanim_intro">
                      <t:div>
                        <t:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</t:note>
                        <t:div xml:id="section_musaf_kohanim_aloud">
                          <j:conditional xml:id="section_musaf_kohanim_aloud_condition">
                            <j:all>
                              <t:fs type="opensiddur:practice">
                                <t:f name="birkat-kohanim">
                                  <t:binary value="true"/>
                                </t:f>
                              </t:fs>
                            </j:all>
                          </j:conditional>
                          <t:div>
                            <t:note type="description" xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">כשנושאים כפיים, הש״ץ אומר את המילה כהנים בקול.</t:note>
                            <t:note type="description" xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">When there is a priestly blessing, the cantor says the word Kohanim aloud.</t:note>
                          </t:div>
