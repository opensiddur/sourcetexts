                              </t:f>
                            </t:fs>
                            <t:fs type="opensiddur:practice">
                              <t:f name="musaf-shabbat-responses">
                                <t:symbol value="both_cantor_repeat"/>
                              </t:f>
                            </t:fs>
                          </j:any>
                        </j:all>
                      </j:conditional>
                      <t:div>
                        <j:declare xml:id="section_shofarot_musaf_areshet_inclusion_settings">
                          <t:fs type="opensiddur:variant">
                            <t:f name="urn:x-opensiddur:condition:prayer:areshet_sefatenu/conclusion/he/first_printing">
                              <t:binary value="false"/>
                            </t:f>
                            <t:f name="urn:x-opensiddur:condition:prayer:areshet_sefatenu/conclusion/he/zikhronot_printing">
                              <t:binary value="false"/>
                            </t:f>
                            <t:f name="urn:x-opensiddur:condition:prayer:areshet_sefatenu/conclusion/teqiot_veseder_shofarot">
                              <t:binary value="true"/>
                            </t:f>
                            <t:f name="urn:x-opensiddur:condition:prayer:areshet_sefatenu/conclusion/en/first_printing">
                              <t:binary value="false"/>
                            </t:f>
                            <t:f name="urn:x-opensiddur:condition:prayer:areshet_sefatenu/conclusion/en/zikhronot_printing">
                              <t:binary value="false"/>
                            </t:f>
                          </t:fs>
                        </j:declare>
                        <t:div xml:id="section_shofarot_musaf_areshet_first">
                          <t:div>
                            <t:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל</t:note>
                            <t:div xml:id="section_shofarot_areshet_words_2">
                              <t:div>
                                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/opening"/>
                                <t:div xml:id="section_shofarot_areshet_zikhron_2">
                                  <j:conditional xml:id="section_shofarot_areshet_zikhron_2_condition">
                                    <j:all>
                                      <t:fs type="opensiddur:holiday-aggregate">
                                        <t:f name="shabbat">
                                          <t:binary value="true"/>
                                        </t:f>
                                      </t:fs>
                                    </j:all>
                                  </j:conditional>
                                  <t:div>
                                    <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/zikhron"/>
                                  </t:div>
                                  <j:endConditional target="#section_shofarot_areshet_zikhron_2_condition"/>
                                </t:div>
                                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/conclusion"/>
                              </t:div>
                            </t:div>
                          </t:div>
                        </t:div>
                        <t:div xml:id="section_shofarot_musaf_areshet_cantor_repeat">
                          <j:conditional xml:id="section_shofarot_musaf_areshet_cantor_repeat_condition">
                            <t:note type="instruction"><t:foreign xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">הש״ץ חוזר לפי מנהג הקהל; בחול יש שאין הש״ץ חוזר.</t:foreign> <t:foreign xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">The cantor repeats according to the community’s custom; on weekdays some do not repeat.</t:foreign> </t:note>
                            <j:all>
                              <j:any>
                                <t:fs type="opensiddur:rite">
                                  <t:f name="frankfurt_am_main">
                                    <t:binary value="true"/>
                                  </t:f>
                                </t:fs>
                                <j:all>
                                  <t:fs type="opensiddur:holiday-aggregate">
                                    <t:f name="shabbat">
                                      <t:binary value="true"/>
                                    </t:f>
                                  </t:fs>
                                  <t:fs type="opensiddur:practice">
                                    <t:f name="musaf-shabbat-responses">
                                      <t:symbol value="both_cantor_repeat"/>
                                    </t:f>
                                  </t:fs>
                                </j:all>
                                <j:all>
                                  <t:fs type="opensiddur:holiday-aggregate">
                                    <t:f name="shabbat">
                                      <t:binary value="false"/>
                                    </t:f>
                                  </t:fs>
                                  <t:fs type="opensiddur:practice">
                                    <t:f name="musaf-areshet-cantor-repeat">
                                      <t:binary value="true"/>
                                    </t:f>
                                  </t:fs>
                                </j:all>
                              </j:any>
                            </j:all>
                          </j:conditional>
                          <t:div>
                            <t:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</t:note>
                            <t:div xml:id="section_shofarot_areshet_words_2_2">
                              <t:div>
                                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/opening"/>
                                <t:div xml:id="section_shofarot_areshet_zikhron_2_2">
                                  <j:conditional xml:id="section_shofarot_areshet_zikhron_2_2_condition">
                                    <j:all>
                                      <t:fs type="opensiddur:holiday-aggregate">
                                        <t:f name="shabbat">
                                          <t:binary value="true"/>
                                        </t:f>
                                      </t:fs>
                                    </j:all>
                                  </j:conditional>
                                  <t:div>
                                    <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/zikhron"/>
                                  </t:div>
                                  <j:endConditional target="#section_shofarot_areshet_zikhron_2_2_condition"/>
                                </t:div>
                                <j:transclude type="external" target="urn:x-opensiddur:text:prayer:areshet_sefatenu/conclusion"/>
                              </t:div>
                            </t:div>
                          </t:div>
