                      </t:div>
                      <j:endConditional target="#section_shofarot_musaf_areshet_inclusion_condition"/>
                    </t:div>
                    <t:div xml:id="section_musaf_repetition_retzeh">
                      <t:div>
                        <t:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</t:note>
                        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/retzeh"/>
                      </t:div>
                    </t:div>
                    <t:div xml:id="section_musaf_priests_avodah">
                      <j:conditional xml:id="section_musaf_priests_avodah_condition">
                        <j:all>
                          <t:fs type="opensiddur:practice">
                            <t:f name="birkat-kohanim">
                              <t:binary value="true"/>
                            </t:f>
                          </t:fs>
                        </j:all>
                      </j:conditional>
                      <t:div>
                        <t:note type="description" xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">כשהכהנים עולים לדוכן, הקהל אומר ותערב והש״ץ מסיים.</t:note>
                        <t:note type="description" xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">As the priests go to the dukhan, the congregation says Veteerav and the cantor concludes.</t:note>
                        <t:div xml:id="section_musaf_veteerav_congregation">
                          <t:div>
                            <t:note type="description" corresp="urn:x-opensiddur:instruction:role/congregation" xml:lang="he">קהל</t:note>
                            <j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/veteerav"/>
                          </t:div>
                        </t:div>
                        <t:div xml:id="section_musaf_veteerav_cantor_conclusion">
                          <t:div>
                            <t:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</t:note>
                            <j:transclude type="external" target="urn:x-opensiddur:text:siddur:regalim/musaf/text/sheotekha"/>
                          </t:div>
                        </t:div>
                      </t:div>
                      <j:endConditional target="#section_musaf_priests_avodah_condition"/>
                    </t:div>
                    <t:div xml:id="section_musaf_no_priests_avodah">
                      <j:conditional xml:id="section_musaf_no_priests_avodah_condition">
                        <t:note type="instruction"><t:foreign xml:lang="he" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">כשאין ברכת כהנים.</t:foreign> <t:foreign xml:lang="en" resp="urn:x-opensiddur:contributor:opensiddur.org/codex">When there is no priestly blessing.</t:foreign> </t:note>
                        <j:all>
                          <t:fs type="opensiddur:practice">
                            <t:f name="birkat-kohanim">
                              <t:binary value="false"/>
                            </t:f>
                          </t:fs>
                        </j:all>
                      </j:conditional>
                      <t:div>
                        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/avodah/vetechezeinah"/>
                      </t:div>
                      <j:endConditional target="#section_musaf_no_priests_avodah_condition"/>
                    </t:div>
                    <t:div xml:id="section_musaf_repetition_modim">
