                        <t:note type="description" corresp="urn:x-opensiddur:instruction:role/reader" xml:lang="he">חזן</t:note>
                        <j:transclude type="external" target="urn:x-opensiddur:text:prayer:amidah/hodaah/modim"/>
                      </t:div>
                    </t:div>
                    <t:div xml:id="section_musaf_repetition_modim_derabbanan">
