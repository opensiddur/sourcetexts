{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"מלכנו"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#musaf_malkhuyot_close_segment_6"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":" אֱמֶת וְקַיָּם לָעַד. בָּרוּךְ אַתָּה "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" מֶלֶךְ עַל כָּל־הָאָרֶץ מְקַדֵּשׁ "}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"musaf_malkhuyot_close_segment_8"}}
