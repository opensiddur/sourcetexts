{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ רְצֵה בִמְנוּחָתֵנוּ"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#musaf_malkhuyot_close_segment_2"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":" קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ שַׂבְּעֵנוּ מִטּוּבֶךָ וְשַׂמְּחֵנוּ בִּישׁוּעָתֶךָ. "}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"musaf_malkhuyot_close_segment_4"}}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"de-Hebr"}}
{"text":"אַם שַׁבָּת."}
{"end":"t:note"}
