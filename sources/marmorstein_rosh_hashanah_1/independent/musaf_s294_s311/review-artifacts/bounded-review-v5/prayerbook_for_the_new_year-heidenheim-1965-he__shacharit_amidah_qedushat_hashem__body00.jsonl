{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n115.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/attah_qadosh"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/qedushat_hashem/attah_qadosh"}}
{"text":"אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלוּךָ סֶּֽלָה:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n117.jpg","n":"45"}}
{"end":"t:pb"}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_pachdekha"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_pachdekha"}}
{"text":"וּבְכֵן תֵּן פַּחְדְּךָ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵֽינוּ עַל כָּל־מַעֲשֶׂיךָ וְאֵימָתְךָ עַל כָּל־מַה־שֶּׁבָּרָֽאתָ וְיִירָאוּךָ כָּל־הַמַּעֲשִׂים וְיִשְׁתַּחֲווּ לְפָנֶיךָ כָּל־הַבְּרוּאִים וְיֵעָשׂוּ כֻלָּם אֲגֻדָּה אַחַת לַעֲשׂוֹת רְצוֹנְךָ בְּלֵבָב שָׁלֵם כְּמוֹ שֶׁיָּדַֽעְנוּ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵֽינוּ שֶׁהַשָּׁלְטָן לְפָנֶֽיךָ עֹז בְּיָדַֽךָ וּגְבוּרָה בִּימִינֶךָ וְשִׁמְךָ נוֹרָא עַל כָּל־מַה־שֶּׁבָּרָֽאתָ:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_ten_kavod"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/uvekhen_ten_kavod"}}
{"text":"וּבְכֵן תֵּן כָּבוֹד "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" לְעַמֶּךָ תְּהִלָּה לִירֵאֶיךָ וְתִקְוָה לְדוֹרְשֶׁיךָ וּפִתְחוֹן פֶּה לַמְיַחֲלִים לָךְ שִׂמְחָה לְאַרְצֶךָ וְשָׂשׂוֹן לְעִירֶךָ וּצְמִיחַת קֶרֶן לְדָוִד עַבְדֶּךָ וַעֲרִיכַת נֵר לְבֶן־יִשַׁי מְשִׁיחֶךָ בִּמְהֵרָה בְיָמֵינוּ:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/uvekhen_tzaddiqim"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/uvekhen_tzaddiqim"}}
{"text":"וּבְכֵן צַדִּיקִים יִרְאוּ וְיִשְׂמָחוּ וִישָׁרִים יַעֲלֹזוּ וַחֲסִידִים בְּרִנָּה יָגִילוּ וְעוֹלָתָה תִּקְפָּץ־פִּיהָ. וְכָל־הָרִשְׁעָה כֻּלָּהּ כְּעָשָׁן תִּכְלֶה כִּי תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן־הָאָרֶץ:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/vetimlokh"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vetimlokh_attah_hashem"}}
{"text":"וְתִמְלוֹךְ אַתָּה "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" לְבַדֶּךָ עַל כָּל־מַעֲשֶׂיךָ בְּהַר צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ וּבִירוּשָׁלַיִם עִיר קָדְשֶׁךָ. כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"146","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"10","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_psalms_146_10/10"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/146/10"}}
{"text":"יִמְלֹךְ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְהֹוָה"}
{"end":"j:divineName"}
{"tail":" לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ:"}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/qadosh_attah"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"}}
{"text":"קָדוֹשׁ אַתָּה וְנוֹרָא שְׁמֶךָ וְאֵין אֱלוֹהַּ מִבַּלְעָדֶיךָ. כַּכָּתוּב"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"5","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"16","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hashem/quotations/quoted_isaiah_5_16/16"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:isaiah/5/16"}}
{"text":"וַיִּגְבַּהּ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" צְבָאוֹת בַּמִּשְׁפָּט וְהָאֵל הַקָּדוֹשׁ נִקְדָּשׁ בִּצְדָקָה."}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/qadosh_attah_venora"}}
{"text":"בָּרוּךְ אַתָּה "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" הַמֶּלֶךְ הַקָּדוֹשׁ:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
