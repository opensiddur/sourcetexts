{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n249.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/1"}}
{"end":"t:milestone"}
{"tail":"וְיֶאֱתָיוּ כל לְעָבְדֶךָ. וִיבָרְכוּ שֵׁם כְּבוֹדֶךָ. וְיַגִּידוּ בָאִיִּים צִדְקֶךָ.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/2"}}
{"end":"t:milestone"}
{"tail":"וְיִדְרְשׁוּךָ עַמִּים לֹא יְדָעוּךָ. וִיהַלְלוּךָ כָּל־אַפְסֵי אָרֶץ. וְיוֹמְרוּ תָמִיד יִגְדַּל "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":".  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/3"}}
{"end":"t:milestone"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"musaf_v_yeetayu_kol_leavdekha_segment_3"}}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:variant"}}
{"start":"t:f","attrs":{"name":"urn:x-opensiddur:condition:poem:v_yeetayu_kol_leavdekha/veyizbechu"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"tail":"וְיִזְבְּחוּ לְךָ אֶת־זִבְחֵיהֶם. "}
{"start":"j:endConditional","attrs":{"target":"#musaf_v_yeetayu_kol_leavdekha_segment_3"}}
{"end":"j:endConditional"}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n251.jpg","n":"116"}}
{"end":"t:pb"}
{"tail":" וְיִזְנְחוּ אֶת־עֲצַבֵּיהֶם. וְיַחְפְּרוּ עִם פְּסִילֵיהֶם: וְיַטּוּ שְׁכֶם אֶחָד לְעָבְדֶךָ.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/4"}}
{"end":"t:milestone"}
{"tail":"וְיִירָאוּךָ עִם־שֶׁמֶשׁ מְבַקְשֵׁי פָנֶיךָ. וְיַכִּירוּ כֹּחַ מַלְכוּתֶךָ. וִילַמְּדוּ תוֹעִים בִּינָה.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/5"}}
{"end":"t:milestone"}
{"tail":"וִימַלְּלוּ אֶת־גְּבוּרָתֶךָ. וִינַשְּׂאוּךָ מִתְנַשֵּׂא לְכֹל לְרֹאשׁ.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/6"}}
{"end":"t:milestone"}
{"tail":"וִיסַלְּדוּ בְּחִילָה פָּנֶיךָ. וִיעַטְּרוּךָ נֵזֶר תִּפְאָרָה.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/7"}}
{"end":"t:milestone"}
{"tail":"וְיִפְצְחוּ הָרִים רִנָּה. וְיִצְהֲלוּ אִיִּים בְּמָלְכֶךָ: וִיקַבְּלוּ עֹל מַלְכוּתְךָ עֲלֵיהֶם. וִירוֹמְמוּךָ בִּקְהַל עָם.  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/8"}}
{"end":"t:milestone"}
{"tail":"וְיִשְׁמְעוּ רְחוֹקִים וְיָבוֹאוּ. וְיִתְּנוּ לְךָ כֶּתֶר מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n      "}
