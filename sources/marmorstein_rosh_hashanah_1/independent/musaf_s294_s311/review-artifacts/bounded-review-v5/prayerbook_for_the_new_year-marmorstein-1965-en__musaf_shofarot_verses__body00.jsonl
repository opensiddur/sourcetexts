{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"81","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/psalms_81_5/psalms_81"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/psalms_81_5/psalms_81/5","n":"5"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/81/5"}}
{"text":"for it is a statute for Israel, a judgment for the God of Jacob’."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
