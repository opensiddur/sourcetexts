{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"9","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"15","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9/15"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse-part","n":"adonai_tzevaot_yagen","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9/15/adonai_tzevaot_yagen"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:zechariah/9/15/adonai_tzevaot_yagen"}}
{"text":"The Lord of Hosts will protect them’."}
{"end":"t:seg"}
