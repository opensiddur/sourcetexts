{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/exodus_20_18/exodus_20/18","n":"18"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:exodus/20/18"}}
