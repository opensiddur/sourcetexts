{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:anna_bekhoach","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n55.jpg"}}
{"text":"\n        "}
{"start":"t:lg","attrs":{}}
{"text":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/1"}}
{"end":"t:milestone"}
{"tail":"אָנָּא בְּכֹחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה. "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/2"}}
{"end":"t:milestone"}
{"tail":"קַבֵּל רִנַּת עַמְּךָ שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא. "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/3"}}
{"end":"t:milestone"}
{"tail":"נָא גִבּוֹר דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם. "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/4"}}
{"end":"t:milestone"}
{"tail":"בָּרְכֵם טַהֲרֵם רַחֲמֵם צִדְקָתְךָ תָּמִיד גָּמְלֵם: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/5"}}
{"end":"t:milestone"}
{"tail":"חֲסִין קָדוֹשׁ בְּרֹב טוּבְךָ נַהֵל עֲדָתֶךָ. "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/6"}}
{"end":"t:milestone"}
{"tail":"יָחִיד גֵּאֶה לְעַמְּךָ פְנֵה זוֹכְרֵי קְדֻשָּׁתֶךָ. "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anna_bekhoach/7"}}
{"end":"t:milestone"}
{"tail":"שַׁוְעָתֵנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵנוּ יוֹדֵעַ תַּעֲלֻמוֹת. "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:l"}
{"tail":"\n        "}
{"end":"t:lg"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
