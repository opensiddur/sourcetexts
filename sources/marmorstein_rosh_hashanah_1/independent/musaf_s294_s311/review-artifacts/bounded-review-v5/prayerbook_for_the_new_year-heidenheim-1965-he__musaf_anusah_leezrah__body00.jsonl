{"tail":"אָנוּסָה לְעֶזְרָה. אֶמְצָא נֶגְדִּי. אֵל קָרוֹב לִי. בְּעֵת קָרְאִי בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/asher"}}
{"end":"t:milestone"}
{"tail":"אֲשֶׁר בַּעֲדַת אֵל. בְּקִרְבִּי נִצָּב. וּפֹה בְּמִקְדָּשׁ מְעָט. אֲצַפְצֵף לוֹ בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/baqqereni"}}
{"end":"t:milestone"}
{"tail":"בַּקְּרֵנִי דָּרְשֵׁנִי. שֶׂה פְזוּרָה אָנִי. נִגְזַרְתִּי וְנֶאֱלַמְתִּי. בְּלִי לְהָרִים קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/beemor"}}
{"end":"t:milestone"}
{"tail":"בֶּאֱמוֹר גּוֹזְזַי. נִדָּחָה הִיא. שׁוֹמְרָהּ וְצִלָּהּ. לֹא יִשְׁאַג בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/galti"}}
{"end":"t:milestone"}
{"tail":"גַּלְתִּי שִׂיחַ בְּחֻקָּיו. וְחִכִּי עָרֵב. הִטָּה אֹזֶן וְשָׂח. הַשְׁמִיעִנִי אֶת קוֹלֵךְ קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/gaz"}}
{"end":"t:milestone"}
{"tail":"גָּז וּבָרַח מֶנִּי. כְּעֹפֶר עַל הָרֵי בָתֶר. בְּבַקְּשׁוֹ דָת וָאוֹת. בְּמִשְׁכְּנוֹתַי וְאֵין קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/dilleg"}}
{"end":"t:milestone"}
{"tail":"דִּלֵּג מִבֶּתֶר לְבֶתֶר. הֲשִׁיבֵהוּ אֵלַי. אוּלַי יִשָּׂא פָנֶיךָ. עֵקֶב שָׁמְעֵךְ בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/derosh"}}
{"end":"t:milestone"}
{"tail":"דְּרוֹשׁ טוֹבָה לָמוֹ. וּרְאֵה שֵׂה מוֹרִיָּה. אֵלֶם פִּיהוּ יְהִי צֶדֶק. לְלֹא שָׁמְעָה בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/haser"}}
{"end":"t:milestone"}
{"tail":"הָסֵר מֵחָלָק. יָדַיִם "}
{"start":"t:pb","attrs":{"ed":"1965 rosh_hashanah/musaf/repetition/anusah_leezrah","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n295.jpg","n":"138"}}
{"end":"t:pb"}
{"tail":"שְׂעִירוֹת. הוֹגֶה בְּתַחֲנוּנִים. כִּי לְךָ הַקּוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/hosha"}}
{"end":"t:milestone"}
{"tail":"הוֹשַׁע. אֲשֶׁר לֹא תִשָּׁכַח עֵדוּת. וּמִפִּי זַרְעוֹ. לֹא יָסוּף קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/vechozai"}}
{"end":"t:milestone"}
{"tail":"וְחוֹזַי וּמְלִיצַי. הֵם בְּנֵי אִמִּי. וְאָז נִחֲרוּ בִי. לְמַעַן אֶשְׁמַע קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/veal"}}
{"end":"t:milestone"}
{"tail":"וְעַל מִשְׁמַרְתָּם. יַעַמְדוּ וְיִזְעָקוּ. וְגַל לָהֶם סוֹד. וְהוּא יַעֲנֵם בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/zeh"}}
{"end":"t:milestone"}
{"tail":"זֶה חָמַק מֶנִּי. אֲסוֹבֵב וַאֲבַקְשֶׁנּוּ. בְּכָל מָקוֹם הוּא. אָנָה אֶשָּׂא קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/zekher"}}
{"end":"t:milestone"}
{"tail":"זֵכֶר דּוֹדִי לְמַטָּה. אַדִּיר בַּמָּרוֹם. מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ. לְמַעְלָה קוֹרְאִים בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/chayalei"}}
{"end":"t:milestone"}
{"tail":"חֲיָלֵי מַיִם. אֲשֶׁר בָּם שְׁבִילוֹ. דִּבְּרוּ תְּמוּנָה לֹא רָאִינוּ. זוּלָתִי קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/chippasti"}}
{"end":"t:milestone"}
{"tail":"חִפַּשְׂתִּי יְשִׁימוֹן הֲיֵשׁ. וְאָמְרוּ אָיִן. קֶדֶם תִּתּוֹ עֹז. בִּעֲתַנִי בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/tahor"}}
{"end":"t:milestone"}
{"tail":"טָהוֹר דִּלֵּג. הָרִים וְעָבַר. וּמִמְּעוֹן הַר מוֹר. אָז נָתַן קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/timmeti"}}
{"end":"t:milestone"}
{"tail":"טִמֵּאתִי יְדִידוּת שִׁכְנוֹ וְעָלָה. לְיוֹם כֶּסֶא יָבֹא. בְּאָזְנַי קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/yaqarti"}}
{"end":"t:milestone"}
{"tail":"יָקַרְתִּי בְּעֵינָיו. "}
{"start":"t:pb","attrs":{"ed":"1965 rosh_hashanah/musaf/repetition/anusah_leezrah","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n297.jpg","n":"139"}}
{"end":"t:pb"}
{"tail":"וְנִלְוָה לִי בַּשְּׁבִי. עִמּוֹ אָנֹכִי. אָז הִבְטִיחַנִי בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/yarad"}}
{"end":"t:milestone"}
{"tail":"יָרַד לְשִׁנְעָר. וְשָׂם כֵּס בְּעֵילָם. הִשְׁמִיעַ כַּאֲרִי. וּכְנָחָשׁ קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/killah"}}
{"end":"t:milestone"}
{"tail":"כִּלָּה מֶנִּי דּוֹב. כְּהִתְרַפָּה מִמְּלֶאכֶת. חַק בַּמִּכְתָּב. וַיַּעֲבֶר קֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/kavash"}}
{"end":"t:milestone"}
{"tail":"כָּבַשׁ לִי. אַרְבָּעָה רָאשֵׁי נָמֵר. וְגַם אֲנִי בְּהוֹדָיוֹת סֶלָה. אַשְׁמִיעַ לוֹ קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/lechayyat"}}
{"end":"t:milestone"}
{"tail":"לְחַיַּת קָנֶה. אָז מָכַר אֶרֶץ. מִי לִי בַשָּׁמַיִם. אָז הֵרִימָה קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/lelohei"}}
{"end":"t:milestone"}
{"tail":"לֵאלֹהֵי יִשְׁעִי. מִשִּׁנֵּי בַרְזֶל שִׁוַּעְתִּי. וּמֵרֶגֶל עַבְטִיט. הִצְרַחְתִּי בְּקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/middat"}}
{"end":"t:milestone"}
{"tail":"מִדַּת קִצִּי. לֹא הוֹדִיעַנִי. מָתַי בְּאַרְצִי. תּוֹר יַשְׁמִיעַ קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/miyodeei"}}
{"end":"t:milestone"}
{"tail":"מִיּוֹדְעֵי סֵפֶר. חָתַם קִצִּי. לְבַל דַּעַת צוֹפַי. עֵת יִשְׂאוּ קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/na"}}
{"end":"t:milestone"}
{"tail":"נָא הַבֵּט וּרְאֵה. עָנְיִי וּמְרוּדִי. אֵין לִי מַכִּיר. לְמִי אֶשָּׂא קוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/netzach"}}
{"end":"t:milestone"}
{"tail":"נֶצַח אֲקַוֶּה. כִּי לֹא יִפֹּל דָּבָר. מִמַּקְשִׁיבֵי. דְּמָמָה וָקוֹל: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/sos"}}
{"end":"t:milestone"}
{"tail":"שׂוֹשׂ יָשִׂישׂ. לִבִּי בְּקִרְבִּי. בְּשָׁמְעִי דּוֹדִי דּוֹפֵק. עַל פְּתָחַי קוֹל: "}
