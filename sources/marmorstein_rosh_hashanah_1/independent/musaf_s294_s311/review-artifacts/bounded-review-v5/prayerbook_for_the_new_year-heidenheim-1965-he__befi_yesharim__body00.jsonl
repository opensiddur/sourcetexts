{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:prayer:befi_yesharim","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n94.jpg"}}
{"text":"\n        "}
{"start":"t:lg","attrs":{}}
{"text":"\n          "}
{"start":"t:l","attrs":{}}
{"text":"בְּפִי יְשָׁרִים תִּתְרוֹמָם: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"text":"וּבְדִבְרֵי צַדִּיקִים תִּתְבָּרַךְ: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"text":"וּבִלְשׁוֹן חֲסִידִים תִּתְקַדָּשׁ: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"text":"וּבְקֶרֶב קְדוֹשִׁים תִּתְהַלָּל: "}
{"end":"t:l"}
{"tail":"\n        "}
{"end":"t:lg"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
