{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:lekhah_dodi","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n15.jpg"}}
{"text":"\n        "}
{"start":"t:note","attrs":{"type":"description","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"הש״ץ"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"השליח ציבור"}
{"end":"t:expan"}
{"end":"t:choice"}
{"tail":" מנגן בנעימה."}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"t:note","attrs":{"type":"description","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ראשי החרוזים שלמה הלוי."}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"refrain","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain"}}
{"end":"t:milestone"}
{"tail":"לְכָה דוֹדִי לִקְרַאת כַּלָּה. פְּנֵי שַׁבָּת נְקַבְּלָה: "}
{"start":"t:milestone","attrs":{"unit":"refrain"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/1"}}
{"end":"t:milestone"}
{"tail":"שָׁמוֹר וְזָכוֹר בְּדִבּוּר אֶחָד. הִשְׁמִיעָנוּ אֵל הַמְיֻחָד. "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֶחָד וּשְׁמוֹ אֶחָד. לְשֵׁם וּלְתִפְאֶרֶת וְלִתְהִלָּה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/2"}}
{"end":"t:milestone"}
{"tail":"לִקְרַאת שַׁבָּת לְכוּ וְנֵלְכָה. כִּי הִיא מְקוֹר הַבְּרָכָה. מֵרֹאשׁ מִקֶּדֶם נְסוּכָה. סוֹף מַעֲשֶׂה בְּמַחֲשָׁבָה תְּחִלָּה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/3"}}
{"end":"t:milestone"}
{"tail":"מִקְדַּשׁ מֶלֶךְ עִיר מְלוּכָה. קוּמִי צְאִי מִתּוֹךְ הַהֲפֵכָה. רַב לָךְ שֶׁבֶת בְּעֵמֶק הַבָּכָא. וְהוּא יַחֲמוֹל עָלַיִךְ חֶמְלָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/4"}}
{"end":"t:milestone"}
{"tail":"הִתְנַעֲרִי מֵעָפָר קוּמִי. לִבְשִׁי בִּגְדֵי תִפְאַרְתֵּךְ עַמִּי. עַל־יַד בֶּן־יִשַׁי בֵּית הַלַּחְמִי. קָרְבָה אֶל־נַפְשִׁי גְאָלָהּ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/5"}}
{"end":"t:milestone"}
{"tail":"הִתְעוֹרְרִי הִתְעוֹרְרִי. כִּי בָא אוֹרֵךְ קוּמִי אוֹרִי. עוּרִי עוּרִי שִׁיר דַּבֵּרִי. כְּבוֹד "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" עָלַיִךְ נִגְלָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/6"}}
{"end":"t:milestone"}
{"tail":"לֹא תֵבֹשִׁי וְלֹא תִכָּלְמִי. מַה תִּשְׁתּוֹחֲחִי וּמַה תֶּהֱמִי. בָּךְ יֶחֱסוּ עֲנִיֵּי עַמִּי. וְנִבְנְתָה עִיר עַל־תִּלָּהּ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/7"}}
{"end":"t:milestone"}
{"tail":"וְהָיוּ לִמְשִׁסָּה שֹׁאסָיִךְ. וְרָחֲקוּ כָּל־מְבַלְּעָיִךְ. יָשִׂישׂ עָלַיִךְ אֱלֹהָיִךְ. כִּמְשׂוֹשׂ חָתָן עַל־כַּלָּה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n16.jpg","n":"11"}}
{"end":"t:pb"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/8"}}
{"end":"t:milestone"}
{"tail":"יָמִין וּשְׂמֹאל תִּפְרוֹצִי. וְאֶת־"}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" תַּעֲרִיצִי. עַל יַד־אִישׁ בֶּן פַּרְצִי. וְנִשְׂמְחָה וְנָגִילָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:lekhah_dodi/9"}}
{"end":"t:milestone"}
{"tail":"בּוֹאִי בְשָׁלוֹם עֲטֶרֶת בַּעְלָהּ. גַּם בְּשִׂמְחָה וּבְצָהֳלָה. תּוֹךְ אֱמוּנֵי עַם סְגֻלָּה. בּוֹאִי כַלָּה. בּוֹאִי כַלָּה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:ref","attrs":{"target":"urn:x-opensiddur:text:poem:lekhah_dodi/refrain@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"text":"לכה"}
{"end":"t:ref"}
{"end":"t:note"}
{"end":"t:p"}
{"tail":"\n      "}
{"end":"t:div"}
