{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:adon_olam","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n43.jpg"}}
{"text":"\n        "}
{"start":"t:lg","attrs":{}}
{"text":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/adon_olam"}}
{"end":"t:milestone"}
{"tail":"אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ. בְּטֶרֶם כָּל־יְצִיר נִבְרָא: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/leet_naasah"}}
{"end":"t:milestone"}
{"tail":"לְעֵת נַעֲשָׂה בְחֶפְצוֹ כֹּל. אֲזַי מֶלֶךְ שְׁמוֹ נִקְרָא: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/veacharei"}}
{"end":"t:milestone"}
{"tail":"וְאַחֲרֵי כִּכְלוֹת הַכֹּל. לְבַדּוֹ יִמְלוֹךְ נוֹרָא: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/vehu_hayah"}}
{"end":"t:milestone"}
{"tail":"וְהוּא הָיָה וְהוּא הֹוֶה. וְהוּא יִהְיֶה בְּתִפְאָרָה: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/vehu_echad"}}
{"end":"t:milestone"}
{"tail":"וְהוּא אֶחָד וְאֵין שֵׁנִי לְהַמְשִׁיל לוֹ לְהַחְבִּירָה: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/beli_reshit"}}
{"end":"t:milestone"}
{"tail":"בְּלִי רֵאשִׁית בְּלִי תַכְלִית. וְלוֹ הָעֹז וְהַמִּשְׂרָה: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/vehu_eli"}}
{"end":"t:milestone"}
{"tail":"וְהוּא אֵלִי וְחַי גֹּאֲלִי. וְצוּר חֶבְלִי בְּעֵת צָרָה: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/vehu_nissi"}}
{"end":"t:milestone"}
{"tail":"וְהוּא נִסִּי וּמָנוֹס לִי. מְנָת כּוֹסִי בְּיוֹם אֶקְרָא: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/beyado"}}
{"end":"t:milestone"}
{"tail":"בְּיָדוֹ אַפְקִיד רוּחִי. בְּעֵת אִישַׁן וְאָעִירָה: "}
{"end":"t:l"}
{"tail":"\n          "}
{"start":"t:l","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:adon_olam/veim_ruchi"}}
{"end":"t:milestone"}
{"tail":"וְעִם־רוּחִי גְּוִיָּתִי. "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" לִי וְלֹא אִירָא: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:l"}
{"tail":"\n        "}
{"end":"t:lg"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
