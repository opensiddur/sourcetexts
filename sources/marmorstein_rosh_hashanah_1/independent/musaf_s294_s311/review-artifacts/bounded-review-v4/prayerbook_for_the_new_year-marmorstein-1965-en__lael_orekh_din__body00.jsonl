{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader","resp":"urn:x-opensiddur:contributor:opensiddur.org/codex","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
