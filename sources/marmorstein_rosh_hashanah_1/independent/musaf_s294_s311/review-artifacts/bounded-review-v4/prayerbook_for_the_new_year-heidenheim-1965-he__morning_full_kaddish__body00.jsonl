{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitgaddal"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"חזן"}
{"end":"t:note"}
{"tail":" "}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/yitgaddal"}}
{"text":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא בְּעָלְמָא דִּי־בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל־בֵּית־יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמַן קָרִיב, וְאִמְרוּ אָמֵן."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yehe_shemeh"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/yehe_shemeh"}}
{"text":"יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yitbarakh"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/yitbarakh"}}
{"text":"יִתְבָּרַךְ וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא לְעֵלָּא וּלְעֵלָּא מִן־כָּל־בִּרְכָתָא וְשִׁירָתָא תֻּשְׁבְּחָתָא וְנֶחֱמָתָא דַּאֲמִירָן בְּעָלְמָא, וְאִמְרוּ אָמֵן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_1"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"ק׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" קַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת־תְּפִלָּתֵנוּ: "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/titqabbal_text"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/titqabbal/text"}}
{"text":"תִּתְקַבַּל צְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל־יִשְׂרָאֵל קֳדָם אֲבוּהוֹן דִּי בִשְׁמַיָּא, וְאִמְרוּ אָמֵן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_2"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"ק׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"113","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"2","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_113/2"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/113/2"}}
{"text":"יְהִי שֵׁם "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" מְבֹרָךְ מֵעַתָּה וְעַד עוֹלָם:"}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_yehe_shelama"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/yatom/yehe_shelama"}}
{"text":"יְהֵא שְׁלָמָא רַבָּא מִן־שְׁמַיָּא וְחַיִּים עָלֵינוּ וְעַל־כָּל־יִשְׂרָאֵל, וְאִמְרוּ אָמֵן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/response_3"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"ק׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"chapter","n":"121","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"verse","n":"2","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/quotations/response_psalms_121/2"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/121/2"}}
{"text":"עֶזְרִי מֵעִם "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" עֹשֵׂה שָׁמַיִם וָאָרֶץ:"}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/full_kaddish/yatom_oseh_shalom"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:kaddish/yatom/oseh_shalom"}}
{"text":"עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל־כָּל־יִשְׂרָאֵל, וְאִמְרוּ אָמֵן:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part"}}
{"end":"t:milestone"}
