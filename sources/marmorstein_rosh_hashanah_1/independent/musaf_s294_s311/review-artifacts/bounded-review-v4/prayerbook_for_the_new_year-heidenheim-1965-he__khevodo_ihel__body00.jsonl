{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"tail":"קְשׁוֹב קוֹל תְּקִיעָה מְתוֹקְעֵי "}
{"start":"j:endConditional","attrs":{"target":"#khevodo_ihel_segment_18"}}
{"end":"j:endConditional"}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"khevodo_ihel_segment_19"}}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"de-Hebr"}}
{"text":"אַם שַׁבָּת"}
{"end":"t:note"}
