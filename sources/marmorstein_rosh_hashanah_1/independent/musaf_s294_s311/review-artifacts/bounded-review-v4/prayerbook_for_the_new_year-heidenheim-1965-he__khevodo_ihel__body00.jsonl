{"tail":"קְשׁוֹב זִכְרוֹן תְּקִיעָה מְזוֹכְרֵי "}
{"start":"j:endConditional","attrs":{"target":"#khevodo_ihel_segment_19"}}
{"end":"j:endConditional"}
{"tail":"לְךָ הַיּוֹם מֶֽלֶךְ. רַחֲמִים תְּעוֹרֵר לִמְחַכֶּֽיךָ מֶֽלֶךְ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:khevodo_ihel/6"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader_and_congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"קו״ח"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל וחזן"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" שְׁעֵה שַׁוְעַת עַם מְשַׁחֲרֶֽיךָ מֶֽלֶךְ. תֵּֽפֶן בְּתוֹמְכֵי בָרוּךְ וּנְבָרֶכְךָ אֱלֹהִים חַיִּים וָמֶֽלֶךְ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n      "}
