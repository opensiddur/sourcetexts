{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/hodaah_tail","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n309.jpg"}}
