{"tail":"אֵל אָדוֹן עַל כָּל־הַמַּעֲשִׂים. בָּרוּךְ וּמְבֹרָךְ בְּפִי כָּל־נְשָׁמָה: גָּדְלוֹ וְטוּבוֹ מָלֵא עוֹלָם. דַּֽעַת וּתְבוּנָה סֹבְבִים אוֹתוֹ:  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:el_adon/2"}}
{"end":"t:milestone"}
{"tail":"הַמִּתְגָּאֶה עַל־חַיּוֹת הַקֹּֽדֶשׁ. וְנֶהְדָּר בְּכָבוֹד עַל־הַמֶּרְכָּבָה: "}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n103.jpg","n":"38"}}
{"end":"t:pb"}
{"start":"j:conditional","attrs":{"{http://www.w3.org/XML/1998/namespace}id":"el_adon_segment_2"}}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"de-Hebr"}}
{"text":"אַם שַׁבָּת."}
{"end":"t:note"}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:holiday-aggregate"}}
{"start":"t:f","attrs":{"name":"shabbat"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"tail":"זְכוּת וּמִישׁוֹר לִפְנֵי כִסְאוֹ. חֶֽסֶד וְרַחֲמִים לִפְנֵי כְבוֹדוֹ:  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:el_adon/3"}}
{"end":"t:milestone"}
{"tail":"טֹבִים מְאוֹרוֹת שֶׁבָּרָא אֱלֹהֵֽינוּ. יְצָרָם בְּדַֽעַת בְּבִינָה וּבְהַשְׂכֵּל: כֹּחַ וּגְבוּרָה נָתַן בָּהֶם. לִהְיוֹת מוֹשְׁלִים בְּקֶֽרֶב תֵּבֵל:  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:el_adon/4"}}
{"end":"t:milestone"}
{"tail":"מְלֵאִים זִיו וּמְפִיקִים נֹגַהּ. נָאֶה זִיוָם בְּכָל־הָעוֹלָם: שְׂמֵחִים בְּצֵאתָם וְשָׂשִׂים בְּבוֹאָם. עוֹשִׂים בְּאֵימָה רְצוֹן קוֹנָם:  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:el_adon/5"}}
{"end":"t:milestone"}
{"tail":"פְּאֵר וְכָבוֹד נוֹתְנִים לִשְׁמוֹ. צָהֳלָה וְרִנָּה לְזֵֽכֶר מַלְכוּתוֹ: קָרָא לַשֶּֽׁמֶשׁ וַיִּזְרַח אוֹר. רָאָה וְהִתְקִין צוּרַת הַלְּבָנָה:  "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:el_adon/6"}}
{"end":"t:milestone"}
{"tail":"שֶֽׁבַח נוֹתְנִים־לוֹ כָּל־צְבָא מָרוֹם. תִּפְאֶֽרֶת וּגְדֻלָּה שְׂרָפִים וְאוֹפַנִּים וְחַיּוֹת הַקֹּֽדֶשׁ: "}
{"start":"j:endConditional","attrs":{"target":"#el_adon_segment_2"}}
