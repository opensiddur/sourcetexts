{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg"}}
{"text":"\n        "}
{"start":"t:note","attrs":{"type":"description","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ע״ס א״ב."}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n131.jpg","n":"52"}}
{"end":"t:pb"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/1"}}
{"end":"t:milestone"}
{"tail":"אַתָּה הוּא אֱלֹהֵינוּ. בַּשָּׁמַיִם וּבָאָרֶץ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/2"}}
{"end":"t:milestone"}
{"tail":"גִּבּוֹר וְנַעֲרָץ. דָּגוּל מֵרְבָבָה: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/3"}}
{"end":"t:milestone"}
{"tail":"הוּא שָׂח וַיֶּהִי. וְצִוָּה וְנִבְרָאוּ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/4"}}
{"end":"t:milestone"}
{"tail":"זִכְרוֹ לָנֶצַח. חַי עוֹלָמִים: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/5"}}
{"end":"t:milestone"}
{"tail":"טְהוֹר עֵינַיִם. יוֹשֵׁב סֵתֶר: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/6"}}
{"end":"t:milestone"}
{"tail":"כִּתְרוֹ יְשׁוּעָה. לְבוּשׁוֹ צְדָקָה: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/7"}}
{"end":"t:milestone"}
{"tail":"מַעֲטֵהוּ קִנְאָה. נֶאְפָּד נְקָמָה: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/8"}}
{"end":"t:milestone"}
{"tail":"סִתְרוֹ יֹשֶׁר. עֲצָתוֹ אֱמוּנָה: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/9"}}
{"end":"t:milestone"}
{"tail":"פְּעֻלָּתוֹ אֱמֶת. צַדִּיק וְיָשָׁר: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/10"}}
{"end":"t:milestone"}
{"tail":"קָרוֹב לְקוֹרְאָיו בֶּאֱמֶת. רָם וּמִתְנַשֵּׂא: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/11"}}
{"end":"t:milestone"}
{"tail":"שׁוֹכֵן שְׁחָקִים. תּוֹלֶה אֶרֶץ עַל בְּלִימָה: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:attah_hu_eloheinu/12"}}
{"end":"t:milestone"}
{"tail":"חַי וְקַיָּם נוֹרָא בַמָּרוֹם וְקָדוֹשׁ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
