{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" לַעֲדֵי עַד יִמְלוֹךְ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_elyon/12"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ עֶלְיוֹן.  "}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader_and_congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"קו״ח"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל וחזן"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" תָּקְפּוֹ לָעַד. תִּפְאַרְתּוֹ עֲדֵי עַד. תְּהִלָּתוֹ עוֹמֶדֶת לָעַד.  לַעֲדֵי עַד יִמְלוֹךְ: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
