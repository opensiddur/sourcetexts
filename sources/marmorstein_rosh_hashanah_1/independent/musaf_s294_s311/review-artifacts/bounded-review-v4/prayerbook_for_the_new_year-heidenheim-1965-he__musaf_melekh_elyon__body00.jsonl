{"text":"ק׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" לַעֲדֵי עַד יִמְלוֹךְ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_elyon/5"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ עֶלְיוֹן. טוֹב שׁוֹכֵן עַד. טוּבוֹ לָעַד. טִפַּח שְׁמֵי עַד.  "}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
