{"end":"t:choice"}
{"end":"t:note"}
{"tail":" לַעֲדֵי עַד יִמְלוֹךְ: "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:melekh_elyon/6"}}
{"end":"t:milestone"}
{"tail":"מֶלֶךְ עֶלְיוֹן. כַּשַּׂלְמָה עוֹטֶה אוֹר. כָּל מְאוֹרֵי אוֹר. כַּבִּיר וְנָאוֹר.  "}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
