{"start":"t:expan","attrs":{}}
{"text":"קהל"}
{"end":"t:expan"}
{"end":"t:choice"}
{"end":"t:note"}
{"tail":" לַעֲדֵי עַד יִמְלוֹךְ: "}
{"end":"t:p"}
