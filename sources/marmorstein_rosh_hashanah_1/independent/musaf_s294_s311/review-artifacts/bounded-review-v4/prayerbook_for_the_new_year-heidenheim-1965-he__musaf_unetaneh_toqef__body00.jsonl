{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ושמנו קראת בשמך"}
{"end":"t:foreign"}
{"tail":"."}
{"end":"t:note"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:prayer:unetaneh_toqef_in_hebrew/7"}}
{"end":"t:milestone"}
{"tail":"כִּי כְשִׁמְךָ כֵּן תְּהִלָּתֶךָ. קָשֶׁה לִכְעוֹס וְנוֹחַ לִרְצוֹת. כִּי לֹא תַחְפּוֹץ בְּמוֹת הַמֵּת. כִּי אִם בְּשׁוּבוֹ מִדַּרְכּוֹ וְחָיָה. וְעַד יוֹם מוֹתוֹ תְּחַכֶּה לּוֹ. אִם יָשׁוּב מִיָּד תְּקַבְּלוֹ:  "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"start":"t:choice","attrs":{}}
{"start":"t:abbr","attrs":{}}
{"text":"ח׳"}
{"end":"t:abbr"}
{"start":"t:expan","attrs":{}}
{"text":"חזן"}
{"end":"t:expan"}
