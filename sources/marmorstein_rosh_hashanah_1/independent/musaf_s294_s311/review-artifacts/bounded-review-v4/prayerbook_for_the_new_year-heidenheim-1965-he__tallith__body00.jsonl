{"start":"t:body","attrs":{}}
{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:prayer:tallith"}}
{"text":"\n        "}
{"start":"t:pb","attrs":{"ed":"1965","n":"1","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg"}}
{"end":"t:pb"}
{"tail":"\n        "}
{"start":"t:head","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"סֵֽדֶר עֲטִיפַת הַטַּלִּית."}
{"end":"t:head"}
{"tail":"\n        "}
{"start":"t:note","attrs":{"type":"description","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Before draping oneself in the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" the following is said:"}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/hineni_mitattef@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"end":"j:transclude"}
{"tail":"\n        "}
{"start":"t:note","attrs":{"type":"description","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Then this "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ברכה"}
{"end":"t:foreign"}
{"tail":" is recited while standing:"}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/lehitattef@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"end":"j:transclude"}
{"tail":"\n        "}
{"start":"t:note","attrs":{"type":"instruction","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"One then drapes oneself in the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" and says:"}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/mah_yaqar@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"end":"j:transclude"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/yehi_ratzon@prayerbook_for_the_new_year-heidenheim-1965-he"}}
{"end":"j:transclude"}
{"tail":"\n        "}
{"start":"t:note","attrs":{"type":"instruction","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n38.jpg","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"One then removes the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" from the face and drapes oneself in such a way that there should be one "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ציצת"}
{"end":"t:foreign"}
{"tail":" in front and one behind on each side."}
{"end":"t:note"}
{"tail":"\n      "}
{"end":"t:div"}
{"tail":"\n    "}
{"end":"t:body"}
