{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n115.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/attah_gibbor"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/gevurot/attah_gibbor"}}
{"text":"אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי מְחַיֵּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ."}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mekhalkel_chayyim"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/gevurot/mekhalkel_chayyim"}}
{"text":"מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֵּה מֵתִים בְּרַחֲמִים רַבִּים סוֹמֵךְ נוֹפְלִים וְרוֹפֵא חוֹלִים וּמַתִּיר אֲסוּרִים וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דּוֹמֶה לָּךְ מֶלֶךְ מֵמִית וּמְחַיֶּה וּמַצְמִיחַ יְשׁוּעָה:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mi_khamokha"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/gevurot/mi_khamokha"}}
{"text":"מִי כָמוֹךָ אַב הָרַחֲמִים. זוֹכֵר יְצוּרָיו לַחַיִּים בְּרַחֲמִים."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/gevurot/mechayyeh_hametim"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/gevurot/mechayyeh_hametim"}}
{"text":"וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" מְחַיֵּה הַמֵּתִים:"}
{"end":"t:seg"}
{"tail":" "}
