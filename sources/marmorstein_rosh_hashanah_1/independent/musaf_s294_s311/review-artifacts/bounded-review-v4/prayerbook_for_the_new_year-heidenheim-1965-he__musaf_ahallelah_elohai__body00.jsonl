{"text":"\n      "}
{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n259.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/congregation","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"קהל."}
{"end":"t:note"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/1"}}
{"end":"t:milestone"}
{"tail":"אֲהַלְלָה אֱלֹהַי. אָשִׁירָה עֻזּוֹ. אֲסַפְּרָה כְבוֹדוֹ. אֲאַפְּדֶנּוּ מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/2"}}
{"end":"t:milestone"}
{"tail":"אֲשַׂגֵּב לְפוֹעֵל. אֲשֶׁר שָׂח וּפָעַל. אֲנַוֵּהוּ. כִּי לוֹ יָאֲתָה מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/3"}}
{"end":"t:milestone"}
{"tail":"בְּעֻזּוֹ נֶצַח אֲשַׁנֵּן. כִּי צְבָאוֹ אָנִי. וְלִי נָאֶה שִׂיחַ. גֹּדֶל הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/4"}}
{"end":"t:milestone"}
{"tail":"בְּקָהָל אֲבַשֵּׂר. בְּרָב עָם אֲדַבֵּר. לְמִי שְׂאֵת וְיֶתֶר עָז. וּלְמִי הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/5"}}
{"end":"t:milestone"}
{"tail":"גּוֹשׁוּ גּוֹיִם. וּבֹאוּ מַמְלָכוֹת. רְאוּ מַה נֶהְדָּר. בְּמֵצַח הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/6"}}
{"end":"t:milestone"}
{"tail":"גַּדְּלוּהוּ אִתִּי. וּנְרוֹמְמֶנְהוּ יַחַד. וְאַל תִּתְגָּאוּ. בְּנֵזֶר הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/7"}}
{"end":"t:milestone"}
{"tail":"דְּרָכִים בְּעֵת. נֶעֶשְׂתָה מְצוּלָה. הִתְבּוֹנְנוּ יַחַד. לְמִי נִזְרְקָה מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/8"}}
{"end":"t:milestone"}
{"tail":"דָּרַךְ סוּס בַּיָּם. כְּנֶגֶד שֵׁשׁ מֵאוֹת רֶכֶב. וּמַה יוֹעִיל גֶּבֶר. עֹז בִּמְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/9"}}
{"end":"t:milestone"}
{"tail":"הֶאֱזִינוּ רוֹזְנִים. אָז וַיִּרְגָּזוּ. הִבִּיטוּ חֲתַת. וּמָאֲסוּ מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/10"}}
{"end":"t:milestone"}
{"tail":"הִגִּידוּ כֹחוֹ. לְאֻמִּים וְדִבֵּרוּ. לָזֶה יִכָּתֵב. שֵׁם הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/11"}}
{"end":"t:milestone"}
{"tail":"וְנִלְחַם רֵאשִׁית. גּוֹיִם "}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n261.jpg","n":"121"}}
{"end":"t:pb"}
{"tail":"וְאָבַד. כִּי נִשְׁבַּע חַי. בְּכִסֵּא מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/12"}}
{"end":"t:milestone"}
{"tail":"וַיָּלְעַג בְּכָל דּוֹר. כִּי לֹא לָמַד. מִי נִלְחַם בַּיָּם. וְעָטָה מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/13"}}
{"end":"t:milestone"}
{"tail":"זָד עַל אֲדוֹנָיו. עֶבֶד יֹשֵׁב נֶגֶב. בְּזֹאת תִּרְגַּז אֶרֶץ. בִּשְׂאֵת עֶבֶד מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/14"}}
{"end":"t:milestone"}
{"tail":"זֶרַע בְּרוּכִים. הֶחֱרִימוּ אֲרוּרִים. כִּי נָתְנוּ קוֹל. לְאַדִּיר בִּמְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/15"}}
{"end":"t:milestone"}
{"tail":"חֶשְׁבּוֹן וּבָשָׁן. עוֹרְרוּ מִלְחֶמֶת. בְּלִי לָתֵת דֶּרֶךְ. לְצִבְאוֹת מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/16"}}
{"end":"t:milestone"}
{"tail":"חֵילָם נִשְׁמַד. וְאַרְצָם חֻלָּקָה. וּמֵעַל זְרוּעָם. נָפְלָה מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/17"}}
{"end":"t:milestone"}
{"tail":"טָפְשׁוּ בְּנֵי כְנַעַן. כִּי נָכְרִים הֵם. בְּאַדְמַת בְּנֵי שֵׁם. זֶרַע מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/18"}}
{"end":"t:milestone"}
{"tail":"טְבָחָם בִּן נוּן. עַד פִּנָּה אֶרֶץ. לִפְנֵי אֲרוֹן הַבְּרִית. אֲדוֹן הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/19"}}
{"end":"t:milestone"}
{"tail":"יוֹשְׁבֵי חֲרוֹשֶׁת. אָז הִקְשָׁה לַחַץ. עֲזָרוּהוּ בְּלִי בֶצַע. אַפְסֵי מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/20"}}
{"end":"t:milestone"}
{"tail":"יָהּ נִלְחַם בָּם. צָבָא בְּלִי בֶצַע. כֵּן יֹאבְדוּ שְׁאָר. וְלָאֵל הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/21"}}
{"end":"t:milestone"}
{"tail":"כְּאֶרֶז בַּלְּבָנוֹן. אַשּׁוּר גָּדַל. וְחֵרֵף אוֹרִיד. "}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n263.jpg","n":"122"}}
{"end":"t:pb"}
{"tail":"כַּבִּיר הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/22"}}
{"end":"t:milestone"}
{"tail":"כְּלִיל אֵשׁ הֲמָמָם. בְּלֵיל שִׁמּוּרִים. וְאָז יָדְעוּ כֹל. כִּי לָאֵל הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/23"}}
{"end":"t:milestone"}
{"tail":"לַשַּׁחַת כָּרַע בֵּל. כְּחָשְׁבוֹ עֲלוֹת לַשַּׁחַק. וְסָר מֶנּוּ לְבַב אֱנוֹשׁ. וְרָד הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/24"}}
{"end":"t:milestone"}
{"tail":"לְכַנּוֹ הוּשַׁב. וְכֹחַ אֵל הִכִּיר. לְמֵרִים וּמַשְׁפִּיל. הִשְׁלִים מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/25"}}
{"end":"t:milestone"}
{"tail":"מֻגָּרָה צֹאן לָטֶבַח. וְנִתְכְּנוּ עֲלִילוֹת. בִּלְבוּשׁ צָעִיר. רֹדֶם הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/26"}}
{"end":"t:milestone"}
{"tail":"מְכוּרֵי בְלֹא הוֹן. פְּדוּיֵי בְלֹא כֶסֶף. סֹלּוּ לְמַטֵּה כַּמַּיִם. לֵב הַמְּלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/27"}}
{"end":"t:milestone"}
{"tail":"נִמְכְּרוּ יוֹנִים. לִבְנֵי יְוָנִים. וְרִחֲקוּם מֵעַל גְּבוּל מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/28"}}
{"end":"t:milestone"}
{"tail":"נֵאֲרוּ בְּרִית וָדָת. וְהִמְרִידוּ עָם בָּאֵל. וּמִגְּרוּם בְּלֹא כֹחַ. מְכַהֲנֵי מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/29"}}
{"end":"t:milestone"}
{"tail":"שָׂעִיר הֶחֱנִיף. לְהוֹרֵהוּ בְּצֵדוֹ. וַיִּירַשׁ בְּקוֹל בֶּכִי. חֶרֶב וּמְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"start":"t:note","attrs":{"type":"description","corresp":"urn:x-opensiddur:instruction:role/reader","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"חזן"}
{"end":"t:note"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"stanza","corresp":"urn:x-opensiddur:text:poem:ahallelah_elohai/30"}}
{"end":"t:milestone"}
{"tail":"שֻׂגַּב חָלָק. הֱיוֹת גְּבִיר לְאֶחָיו. וְעוֹד תִּסּוֹב. לִישֻׁרוּן מְלוּכָה: "}
{"start":"t:milestone","attrs":{"unit":"stanza"}}
{"end":"t:milestone"}
{"end":"t:p"}
{"tail":"\n        "}
