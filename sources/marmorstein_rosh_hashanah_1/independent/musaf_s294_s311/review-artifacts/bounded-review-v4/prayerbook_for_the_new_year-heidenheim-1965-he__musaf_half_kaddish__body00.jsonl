{"start":"t:milestone","attrs":{"unit":"verse","n":"6","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/half_kaddish/quotes/zekhor/psalms_25/6"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/25/6"}}
{"text":"זְכֹר רַחֲמֶֽיךָ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" וַחֲסָדֶֽיךָ כִּי מֵעוֹלָם הֵֽמָּה:"}
{"end":"t:seg"}
{"start":"t:milestone","attrs":{"unit":"verse"}}
{"end":"t:milestone"}
{"start":"t:milestone","attrs":{"unit":"chapter"}}
{"end":"t:milestone"}
