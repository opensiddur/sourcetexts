{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/150/1"}}
{"text":"Halleluyah, praise God in His sanctuary, praise Him in His strong firmament."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150/2","n":"2"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:bible:psalms/150/2"}}
{"text":"Praise Him for His mighty deeds, praise Him for the abundance of His greatness."}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:milestone","attrs":{"unit":"verse","corresp":"urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150/3","n":"3"}}
