{"end":"t:head"}
{"tail":"\n                "}
{"start":"t:head","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Wrapping in the tallit"}
{"end":"t:head"}
{"tail":"\n                "}
{"start":"t:note","attrs":{"type":"description","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Before draping oneself in the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" the following is said:"}
{"end":"t:note"}
{"tail":"\n                "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/hineni_mitattef"}}
{"end":"j:transclude"}
{"tail":"\n                "}
{"start":"t:note","attrs":{"type":"description","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Then this "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ברכה"}
{"end":"t:foreign"}
{"tail":" is recited while standing:"}
{"end":"t:note"}
{"tail":"\n                "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/lehitattef"}}
{"end":"j:transclude"}
{"tail":"\n                "}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"One then drapes oneself in the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" and says:"}
{"end":"t:note"}
{"tail":"\n                "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/mah_yaqar"}}
{"end":"j:transclude"}
{"tail":"\n                "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:tallith/yehi_ratzon"}}
{"end":"j:transclude"}
{"tail":"\n                "}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"One then removes the "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"טלית"}
{"end":"t:foreign"}
{"tail":" from the face and drapes oneself in such a way that there should be one "}
{"start":"t:foreign","attrs":{"{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"ציצת"}
{"end":"t:foreign"}
{"tail":" in front and one behind on each side."}
{"end":"t:note"}
