{"start":"t:div","attrs":{"corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n117.jpg"}}
{"text":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/attah_vechartanu"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/attah_vechartanu_mikol"}}
{"text":"אַתָּה בְחַרְתָּֽנוּ מִכָּל הָעַמִּים. אָהַבְתָּ אוֹתָֽנוּ וְרָצִיתָ בָּֽנוּ. וְרוֹמַמְתָּֽנוּ מִכָּל הַלְּשׁוֹנוֹת. וְקִדַּשְׁתָּֽנוּ בְּמִצְוֹתֶיךָ. וְקֵרַבְתָּֽנוּ מַלְכֵּנוּ לַעֲבוֹדָתֶךָ. וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עָלֵֽינוּ קָרָֽאתָ:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/vattitten_lanu"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"}}
{"text":"וַתִּתֶּן־לָֽנוּ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵינוּ בְּאַהֲבָה אֶת־יוֹם"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"shacharit_amidah_qedushat_hayom_segment_2"}}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:holiday-aggregate"}}
{"start":"t:f","attrs":{"name":"shabbat"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"}}
{"text":"הַשַּׁבָּת הַזֶּה וְאֶת יוֹם"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#shacharit_amidah_qedushat_hayom_segment_2"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"}}
{"text":"הַזִּכָּרוֹן הַזֶּה. יוֹם"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"shacharit_amidah_qedushat_hayom_segment_4"}}
