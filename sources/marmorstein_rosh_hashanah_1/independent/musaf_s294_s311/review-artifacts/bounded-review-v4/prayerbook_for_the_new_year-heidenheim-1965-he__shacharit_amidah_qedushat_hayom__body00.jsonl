{"end":"j:all"}
{"end":"j:conditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"}}
{"text":"בְּאַהֲבָה"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#shacharit_amidah_qedushat_hayom_segment_6"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/vattitten_lanu_hashem"}}
{"text":"מִקְרָא קֹֽדֶשׁ זֵֽכֶר לִיצִיאַת מִצְרָֽיִם:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:pb","attrs":{"ed":"1965","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n119.jpg","n":"46"}}
{"end":"t:pb"}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/yaaleh_veyavo"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:yaaleh_veyavo"}}
{"text":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ. יַעֲלֶה וְיָבֹא וְיַגִּיעַ וְיֵרָאֶה וְיֵרָצֶה וְיִשָּׁמַע וְיִפָּקֵד וְיִזָּכֵר זִכְרֹנֵֽנוּ וּפִקְדֹּנֵֽנוּ וְזִכְרוֹן אֲבוֹתֵינוּ. וְזִכְרוֹן מָשִׁיחַ בֶּן־דָּוִד עַבְדֶּךָ. וְזִכְרוֹן יְרוּשָׁלַיִם עִיר קָדְשֶׁךָ. וְזִכְרוֹן כָּל־עַמְּךָ בֵּית יִשְׂרָאֵל לְפָנֶיךָ. לִפְלֵטָה וּלְטוֹבָה וּלְחֵן וּלְחֶסֶד וּלְרַחֲמִים וּלְחַיִּים וּלְשָׁלוֹם בְּיוֹם הַזִּכָּרוֹן הַזֶּה. זָכְרֵֽנוּ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵֽינוּ בּוֹ לְטוֹבָה וּפָקְדֵֽנוּ בוֹ לִבְרָכָה וְהוֹשִׁיעֵנוּ בוֹ לְחַיִּים. וּבִדְבַר יְשׁוּעָה וְרַחֲמִים. חוּס וְחָנֵּנוּ. וְרַחֵם עָלֵֽינוּ וְהוֹשִׁיעֵנוּ. כִּי אֵלֶיךָ עֵינֵֽינוּ. כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה:"}
{"end":"t:seg"}
{"tail":" "}
{"end":"t:p"}
{"tail":"\n        "}
{"start":"t:p","attrs":{}}
{"start":"t:milestone","attrs":{"unit":"prayer-part","corresp":"urn:x-opensiddur:text:siddur:rosh_hashanah/shacharit/silent_amidah/qedushat_hayom/melokh"}}
{"end":"t:milestone"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ. מְלוֹךְ עַל כָּל־הָעוֹלָם כֻּלּוֹ בִּכְבוֹדֶךָ וְהִנָּשֵׂא עַל כָּל־הָאָרֶץ בִּיקָרֶךָ וְהוֹפַע בַּהֲדַר גְּאוֹן עֻזֶּךָ עַל כָּל־יוֹשְׁבֵי תֵבֵל אַרְצֶךָ. וְיֵדַע כָּל־פָּעוּל כִּי אַתָּה פְעַלְתּוֹ וְיָבִין כָּל־יָצוּר כִּי אַתָּה יְצַרְתּוֹ וְיֹאמַר כֹּל אֲשֶׁר נְשָׁמָה בְּאַפּוֹ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵי יִשְׂרָאֵל מֶלֶךְ וּמַלְכוּתוֹ בַּכֹּל מָשָׁלָה:"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"shacharit_amidah_qedushat_hayom_segment_10"}}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"אַם שַׁבָּת"}
{"end":"t:note"}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:holiday-aggregate"}}
{"start":"t:f","attrs":{"name":"shabbat"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ רְצֵה בִמְנוּחָתֵנוּ"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#shacharit_amidah_qedushat_hayom_segment_10"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ שַׂבְּעֵנוּ מִטּוּבֶךָ וְשַׂמְּחֵנוּ בִּישׁוּעָתֶךָ."}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"shacharit_amidah_qedushat_hayom_segment_12"}}
{"start":"t:note","attrs":{"type":"instruction","{http://www.w3.org/XML/1998/namespace}lang":"he"}}
{"text":"אַם שַׁבָּת"}
{"end":"t:note"}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:holiday-aggregate"}}
{"start":"t:f","attrs":{"name":"shabbat"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"וְהַנְחִילֵנוּ "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" אֱלֹהֵינוּ בְּאַהֲבָה וּבְרָצוֹן שַׁבַּת קָדְשֶׁךָ וְיָנוּחוּ בָהּ יִשְׂרָאֵל מְקַדְּשֵׁי שְׁמֶךָ."}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:endConditional","attrs":{"target":"#shacharit_amidah_qedushat_hayom_segment_12"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"וְטַהֵר לִבֵּנוּ לְעָבְדְּךָ בֶּאֱמֶת כִּי אַתָּה אֱלֹהִים אֱמֶת וּדְבָרְךָ"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:anchor","attrs":{"{http://www.w3.org/XML/1998/namespace}id":"malkeinu_alternative"}}
{"end":"t:anchor"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"(מלכנו)"}
{"end":"t:seg"}
{"tail":" "}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"אֱמֶת וְקַיָּם לָעַד. בָּרוּךְ אַתָּה "}
{"start":"j:divineName","attrs":{}}
{"text":"יְיָ"}
{"end":"j:divineName"}
{"tail":" מֶלֶךְ עַל כָּל־הָאָרֶץ מְקַדֵּשׁ"}
{"end":"t:seg"}
{"tail":" "}
{"start":"j:conditional","attrs":{"type":"marked","{http://www.w3.org/XML/1998/namespace}id":"shacharit_amidah_qedushat_hayom_segment_16"}}
{"start":"j:all","attrs":{}}
{"start":"t:fs","attrs":{"type":"opensiddur:holiday-aggregate"}}
{"start":"t:f","attrs":{"name":"shabbat"}}
{"start":"t:binary","attrs":{"value":"true"}}
{"end":"t:binary"}
{"end":"t:f"}
{"end":"t:fs"}
{"end":"j:all"}
{"end":"j:conditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"הַשַּׁבָּת וְ"}
{"end":"t:seg"}
{"start":"j:endConditional","attrs":{"target":"#shacharit_amidah_qedushat_hayom_segment_16"}}
{"end":"j:endConditional"}
{"start":"t:seg","attrs":{"source":"urn:x-opensiddur:text:prayer:amidah/melokh_al_kol_haolam"}}
{"text":"יִשְׂרָאֵל וְיוֹם הַזִּכָּרוֹן:"}
{"end":"t:seg"}
{"tail":" "}
