{"text":"Blessings after the Haphtorah:"}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:birkhot_haftarah/after@prayerbook_for_the_new_year-marmorstein-1965-en"}}
