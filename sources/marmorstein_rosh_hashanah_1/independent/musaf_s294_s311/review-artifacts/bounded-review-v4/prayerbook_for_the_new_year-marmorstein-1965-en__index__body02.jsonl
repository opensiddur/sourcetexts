{"start":"t:note","attrs":{"type":"description","facs":"https://archive.org/download/mahzor-lyom-rishon-shel-rosh-hashanah-day-one-jenny-marmorstein-1965/page/n174.jpg","{http://www.w3.org/XML/1998/namespace}lang":"en"}}
{"text":"Blessing before the Haphtorah:"}
{"end":"t:note"}
{"tail":"\n        "}
{"start":"j:transclude","attrs":{"type":"external","target":"urn:x-opensiddur:text:prayer:birkhot_haftarah/asher_bachar@prayerbook_for_the_new_year-marmorstein-1965-en"}}
