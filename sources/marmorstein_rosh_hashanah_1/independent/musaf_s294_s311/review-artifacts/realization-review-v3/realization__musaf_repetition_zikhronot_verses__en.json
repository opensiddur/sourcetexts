etition/zikhronot_verses/quotes/psalms_111_4/psalms_111", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s291", "text": "‘A memorial has He made for His wonders, gracious and compassionate is the Lord’."}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:psalms/111/4", "source_reference": "urn:x-opensiddur:text:bible:psalms/111/4", "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_4/psalms_111/4"}, {"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_5", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s291", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_5/psalms_111", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s291", "text": "‘He gave food to those that fear Him, He will remember His covenant for ever’."}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:psalms/111/5", "source_reference": "urn:x-opensiddur:text:bible:psalms/111/5", "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_111_5/psalms_111/5"}, {"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/intro_6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s291", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/zikhronot_verses/quotes/psalms_106_45/psalms_106", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "135", "scan": "s291", "text": "‘He remembered unto them His covenant and He reversed the decree according to the abundance of His kindness’."}], "paragraph": 1, "source": "urn:x-