gments": [{"page_start": true, "printed_page": "143", "scan": "s306", "text": "תַּחַת בְּנֵי צִיּוֹן. בְּנֵי יָוָן שָׁחוּ. הִבְרַקְתָּ חִצִּים. וַתְּהֻמֵּם בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tarem", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "143", "scan": "s306", "text": "תַּרְעֵם לְבוֹזְזַי. תִּתְקַע בַּשּׁוֹפָר. בְּסַעֲרוֹת תֵּימָן. אָז יֵלֵךְ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15/intro_zechariah_9_14", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "143", "scan": "s306", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15/quotes/zechariah_9", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15/quotes/zechariah_9/14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "143", "scan": "s306", "text": "וַייָ עֲלֵיהֶם יֵרָאֶה וְיָצָא כַבָּרָק חִצּוֹ וַאדֹנָי יֱהֹוִה בַּשּׁוֹפָר יִתְקָע וְהָלַךְ בְּסַעֲרוֹת תֵּימָן:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:zechariah/9/14"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15/quotes/zechariah_9/partial_15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "143", "scan": "s306", "text": "יְיָ צְבָאוֹת יָגֵן עֲלֵיהֶם:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:zechariah/9/15/adonai_tzevaot_yagen", "source_reference": "urn:x-opensiddur:text:bible:zechariah/9/15", "source_reference_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15/quotes/zechariah_9/partial_15/15", "source_reference_part": {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zechariah_9_14_15