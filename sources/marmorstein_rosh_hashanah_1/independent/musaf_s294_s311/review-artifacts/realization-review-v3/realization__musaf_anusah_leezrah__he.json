{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/anusah", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "137", "scan": "s294", "text": "אָנוּסָה לְעֶזְרָה. אֶמְצָא נֶגְדִּי. אֵל קָרוֹב לִי. בְּעֵת קָרְאִי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ק׳", "expan": "קהל"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/asher", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "אֲשֶׁר בַּעֲדַת אֵל. בְּקִרְבִּי נִצָּב. וּפֹה בְּמִקְדָּשׁ מְעָט. אֲצַפְצֵף לוֹ בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/baqqereni", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "בַּקְּרֵנִי דָּרְשֵׁנִי. שֶׂה פְזוּרָה אָנִי. נִגְזַרְתִּי וְנֶאֱלַמְתִּי. בְּלִי לְהָרִים קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/beemor", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "בֶּאֱמוֹר גּוֹזְזַי. נִדָּחָה הִיא. שׁוֹמְרָהּ וְצִלָּהּ. לֹא יִשְׁאַג בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/galti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "גַּלְתִּי שִׂיחַ בְּחֻקָּיו. וְחִכִּי עָרֵב. הִטָּה אֹזֶן וְשָׂח. הַשְׁמִיעִנִי אֶת קוֹלֵךְ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/gaz", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "גָּז וּבָרַח מֶנִּי. כְּעֹפֶר עַל הָרֵי בָתֶר. בְּבַקְּשׁוֹ דָת וָאוֹת. בְּמִשְׁכְּנוֹתַי וְאֵין קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/dilleg", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "דִּלֵּג מִבֶּתֶר לְבֶתֶר. הֲשִׁיבֵהוּ אֵלַי. אוּלַי יִשָּׂא פָנֶיךָ. עֵקֶב שָׁמְעֵךְ בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/derosh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "דְּרוֹשׁ טוֹבָה לָמוֹ. וּרְאֵה שֵׂה מוֹרִיָּה. אֵלֶם פִּיהוּ יְהִי צֶדֶק. לְלֹא שָׁמְעָה בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/haser", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "הָסֵר מֵחָלָק. יָדַיִם"}, {"page_start": true, "printed_page": "138", "scan": "s296", "text": "שְׂעִירוֹת. הוֹגֶה בְּתַחֲנוּנִים. כִּי לְךָ הַקּוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/hosha", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "הוֹשַׁע. אֲשֶׁר לֹא תִשָּׁכַח עֵדוּת. וּמִפִּי זַרְעוֹ. לֹא יָסוּף קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/vechozai", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "וְחוֹזַי וּמְלִיצַי. הֵם בְּנֵי אִמִּי. וְאָז נִחֲרוּ בִי. לְמַעַן אֶשְׁמַע קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/veal", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "וְעַל מִשְׁמַרְתָּם. יַעַמְדוּ וְיִזְעָקוּ. וְגַל לָהֶם סוֹד. וְהוּא יַעֲנֵם בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zeh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "זֶה חָמַק מֶנִּי. אֲסוֹבֵב וַאֲבַקְשֶׁנּוּ. בְּכָל מָקוֹם הוּא. אָנָה אֶשָּׂא קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/zekher", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "זֵכֶר דּוֹדִי לְמַטָּה. אַדִּיר בַּמָּרוֹם. מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ. לְמַעְלָה קוֹרְאִים בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/chayalei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "חֲיָלֵי מַיִם. אֲשֶׁר בָּם שְׁבִילוֹ. דִּבְּרוּ תְּמוּנָה לֹא רָאִינוּ. זוּלָתִי קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/chippasti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "חִפַּשְׂתִּי יְשִׁימוֹן הֲיֵשׁ. וְאָמְרוּ אָיִן. קֶדֶם תִּתּוֹ עֹז. בִּעֲתַנִי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tahor", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "טָהוֹר דִּלֵּג. הָרִים וְעָבַר. וּמִמְּעוֹן הַר מוֹר. אָז נָתַן קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/timmeti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "טִמֵּאתִי יְדִידוּת שִׁכְנוֹ וְעָלָה. לְיוֹם כֶּסֶא יָבֹא. בְּאָזְנַי קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/yaqarti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "יָקַרְתִּי בְּעֵינָיו."}, {"page_start": true, "printed_page": "139", "scan": "s298", "text": "וְנִלְוָה לִי בַּשְּׁבִי. עִמּוֹ אָנֹכִי. אָז הִבְטִיחַנִי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/yarad", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "יָרַד לְשִׁנְעָר. וְשָׂם כֵּס בְּעֵילָם. הִשְׁמִיעַ כַּאֲרִי. וּכְנָחָשׁ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/killah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "כִּלָּה מֶנִּי דּוֹב. כְּהִתְרַפָּה מִמְּלֶאכֶת. חַק בַּמִּכְתָּב. וַיַּעֲבֶר קֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/kavash", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "כָּבַשׁ לִי. אַרְבָּעָה רָאשֵׁי נָמֵר. וְגַם אֲנִי בְּהוֹדָיוֹת סֶלָה. אַשְׁמִיעַ לוֹ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/lechayyat", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "לְחַיַּת קָנֶה. אָז מָכַר אֶרֶץ. מִי לִי בַשָּׁמַיִם. אָז הֵרִימָה קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/lelohei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "לֵאלֹהֵי יִשְׁעִי. מִשִּׁנֵּי בַרְזֶל שִׁוַּעְתִּי. וּמֵרֶגֶל עַבְטִיט. הִצְרַחְתִּי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/middat", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "מִדַּת קִצִּי. לֹא הוֹדִיעַנִי. מָתַי בְּאַרְצִי. תּוֹר יַשְׁמִיעַ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/miyodei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "מִיּוֹדְעֵי סֵפֶר. חָתַם קִצִּי. לְבַל דַּעַת צוֹפַי. עֵת יִשְׂאוּ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/na", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "נָא הַבֵּט וּרְאֵה. עָנְיִי וּמְרוּדִי. אֵין לִי מַכִּיר. לְמִי אֶשָּׂא קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/netzach", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "נֶצַח אֲקַוֶּה. כִּי לֹא יִפֹּל דָּבָר. מִמַּקְשִׁיבֵי. דְּמָמָה וָקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/sos", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "שׂוֹשׂ יָשִׂישׂ. לִבִּי בְּקִרְבִּי. בְּשָׁמְעִי דּוֹדִי דּוֹפֵק. עַל פְּתָחַי קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/selah", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "140", "scan": "s300", "text": "סֶלָה יְשִׂימֵנִי. כַּחוֹתָם עַל לֵב. כְּאָז תַּֽחַת הַתַּפּוּחַ. עוֹרְרַֽנִי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_16/intro_exodus_19_16", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "140", "scan": "s300", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_16/quotes/exodus_19", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_16/quotes/exodus_19/16", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "וַיְהִי בַיּוֹם הַשְּׁלִישִׁי בִּהְיֹת הַבֹּקֶר וַיְהִי קֹלֹת וּבְרָקִים וְעָנָן כָּבֵד עַל־הָהָר וְקֹל שֹׁפָר חָזָק מְאֹד וַיֶּחֱרַד כָּל־הָעָם אֲשֶׁר בַּמַּחֲנֶה:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/19/16"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/illitani", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "140", "scan": "s300", "text": "עִלִּיתַֽנִי אֵל. עַל כָּל בָּנוֹת. כִּי בַעֲבוּרִי. בְּחוֹרֵב תַּתָּה קוֹל"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/al", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "עַל כָּל אֱלֹהִים מְאֹד נִתְעַלֵּיתָ. נֶצַח תִּתְעַלֶּה. בִּתְרוּעַת קוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/intro_psalms_47_6", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "140", "scan": "s300", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/quotes/psalms_47", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/quotes/psalms_47/6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "עָלָה אֱלֹהִים בִּתְרוּעָה יְיָ בְּקוֹל שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/47/6"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/intro_psalms_98_6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "וְנֶאֱמַר"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/quotes/psalms_98", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_47_6_98_6/quotes/psalms_98/6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "בַּחֲצֹצְרוֹת וְקוֹל שׁוֹפָר הָרִיעוּ לִפְנֵי הַמֶּלֶךְ יְיָ:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/98/6"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/paah", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "140", "scan": "s300", "text": "פָּעָה מִמִּדְבָּר. צִפּוֹר מִמִּצְרַיִם. וְיוֹנָה הִשְׁמִיעָה. מֵאַשּׁוּר קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/peqod", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "פְּקוֹד צִפּוֹר בַּיִת. דְּרוֹשׁ יוֹנַת אֵלֶם. תְּקַע לָמוֹ בַּשּׁוֹפָר. וּשְׁרֹק לָמוֹ בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_27_13/intro_isaiah_27_13", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "141", "scan": "s302", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_27_13/quotes/isaiah_27", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_27_13/quotes/isaiah_27/13", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "וְהָיָה בַּיּוֹם הַהוּא יִתָּקַע בְּשׁוֹפָר גָּדוֹל וּבָאוּ הָאֹבְדִים בְּאֶרֶץ אַשּׁוּר וְהַנִּדָּחִים בְּאֶרֶץ מִצְרָיִם וְהִשְׁתַּחֲווּ לַייָ בְּהַר הַקֹּדֶשׁ בִּירוּשָׁלָֽ͏ִם:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:isaiah/27/13"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tzor", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "141", "scan": "s302", "text": "צֹר חֻקִּים מֶנִּי. לְבַל יָעוּפוּ כַנֶּשֶׁר. לְבַל יִכָּנְפוּ. מַשְׁמִיעֵי קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tzerufah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "צְרוּפָה אֶלְמַד. וְעֵינַי לְמוֹרִי. כְּאָז צִיר מְדַבֵּר. וְאֵל מְשִׁיבוֹ בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_19/intro_exodus_19_19", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "141", "scan": "s302", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_19/quotes/exodus_19", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_19_19/quotes/exodus_19/19", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "וַיְהִי קוֹל הַשֹּׁפָר הוֹלֵךְ וְחָזֵק מְאֹד מֹשֶׁה יְדַבֵּר וְהָאֱלֹהִים יַעֲנֶנּוּ בְקוֹל:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/19/19"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/qarev", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "141", "scan": "s302", "text": "קָרֵב קֵץ. בָּא עֵת מִשְׁפָּט. קָם מֵלִיץ יֹשֶׁר. לְהִתְחַנֵּן בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/quddash", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "קֻדַּשׁ חֹדֶשׁ. וְהוּכַן מוֹעֵד. וָאֶתְקַע בַּשּׁוֹפָר. וְיַעֲנֶה לִי בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_81_4_5/intro_psalms_81_4", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "141", "scan": "s302", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_81_4_5/quotes/psalms_81", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_81_4_5/quotes/psalms_81/4", "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "תִּקְעוּ בַחֹדֶשׁ שׁוֹפָר בַּכֶּסֶה לְיוֹם חַגֵּנוּ:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/81/4"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_81_4_5/quotes/psalms_81", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalms_81_4_5/quotes/psalms_81/5", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "כִּי חֹק לְיִשְׂרָאֵל הוּא מִשְׁפָּט לֵאלֹהֵי יַעֲקֹב:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/81/5"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/regesh", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "142", "scan": "s304", "text": "רֶגֶשׁ מִקֶּבֶר. צְוָחָה מִסֶּלַע. בְּתֵת יְבֵשֵׁי עֶצֶם. מֵעָפָר קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/reu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "רְאוּ נֵס בֶּהָרִים. וְקוֹל שׁוֹפָר בָּאָרֶץ. לְהַשְׁמִיעַ רֶנֶן. מְדוּמֵּי קוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_18_3/intro_isaiah_18_3", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "142", "scan": "s304", "text": "כַּכָּתוּב עַל יַד נְבִיאֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_18_3/quotes/isaiah_18", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/isaiah_18_3/quotes/isaiah_18/3", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "כָּל־יֹשְׁבֵי תֵבֵל וְשֹׁכְנֵי אָרֶץ כִּנְשֹׂא־נֵס הָרִים תִּרְאוּ וְכִתְקֹעַ שׁוֹפָר תִּשְׁמָֽעוּ:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:isaiah/18/3"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/shegeg", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "142", "scan": "s304", "text": "שֶׁגֶג לֵב הוּתַל. עוֹד בַּל יַטֶּנוּ. בְּלִי לְהַכְבִּיד אֹזֶן. מִשְּׁמוֹעַ קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/shovev", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "שׁוֹבֵב לִי כְּקֶדֶם. דַּת מוֹרָשָׁה. אֲשֶׁר בָּהּ עִלַּפְתַּנִי. בְּלַפִּידִים וָקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_20_15/intro_exodus_20_15", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "142", "scan": "s304", "text": "כַּכָּתוּב בְּתוֹרָתֶךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_20_15/quotes/exodus_20", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/exodus_20_15/quotes/exodus_20/15", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "וְכָל־הָעָם רֹאִים אֶת־הַקּוֹלֹת וְאֶת־הַלַּפִּידִם וְאֵת קוֹל הַשֹּׁפָר וְאֶת־הָהָר עָשֵׁן וַיַּרְא הָעָם וַיָּנֻֽעוּ וַיַּעַמְדוּ מֵרָחֹק:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/20/15"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tevunah", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "142", "scan": "s304", "text": "תְּבוּנָה הֵפִיק. אִישׁ נְבוֹן דָּבָר. וְחַק נֹעַם זְמִירוֹת."}, {"page_start": true, "printed_page": "143", "scan": "s306", "text": "בִּנְעִימוֹת קוֹל:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/tehillah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "143", "scan": "s306", "text": "תְּהִלָּה יִתַּנוּ. אָז לַכֹּל הִשְׁמִיעַ. לָאֵל מוֹשֵׁל בַּכֹּל. יַמְתִּיקוּ בְּקוֹל:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/intro_psalms_150_1", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "143", "scan": "s306", "text": "כַּכָּתוּב בְּדִבְרֵי קָדְשֶׁךָ"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150/1", "fragments": [{"page_start": false, "printed_page": "143", "scan": "s306", "text": "הַלֲלוּיָהּ הַלְלוּ אֵל בְּקָדְשׁוֹ הַלְלוּהוּ בִּרְקִיעַ עֻזּוֹ:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/150/1"}, {"chapter_corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150", "corresp": "urn:x-opensiddur:text:poem:anusah_leezrah/psalm_150/quotes/psalms_150/2", "fragments": [{"page_start": false, "pri