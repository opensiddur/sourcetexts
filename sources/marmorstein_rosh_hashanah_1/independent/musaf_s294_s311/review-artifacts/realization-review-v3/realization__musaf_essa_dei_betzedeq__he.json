{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/essa", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "אֶשָּׂא דֵעִי בְּצֶדֶק. תֵּת לְפוֹעֲלִי צֶדֶק. אֶשְׁאֲלָה מִשְׁפְּטֵי צֶדֶק. קוֹל לְהָרִים כַּשּׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ק׳", "expan": "קהל"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/ein", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "אֵין קוֹרֵא בְצֶדֶק. רוֹדֵף צֶדֶק צֶדֶק. אֶקְרָא שִׁמְעָה צֶדֶק. בְּקוֹל בָּלוּל כַּשּׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/banti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "בַּנְתִּי בְמַדָּעִי. לְמֵרָחוֹק שְׂאֵת דֵעִי. בִּטּוּי תְּרוּעָה בְּיָדְעִי. בְּקוֹל מַתַּן שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/bo", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "בּוֹ בְהָרִיעִי. אֲרַצֶּה לִי רוֹעִי. בְּאָמְצוֹ זְרוֹעִי. בְּקוֹל כֹּחַ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/gashti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "גַּשְׁתִּי בְּיוֹם דִּין. לְהִתְוַכֵּחַ בַּדִּין. גּוֹלֶה עֹמֶק הַדִּין. בְּקוֹל קִפָּאוֹן שֹׁפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/gezerat", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "גְּזֵרַת דַּת וָדִין. אִם חִיַּבְתִּי בַּדִּין. גְּרוֹנִי יְעַכֵּב מוֹרַע דִּין. בְּקוֹל עִם שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/derosh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "דְּרֹשׁ וְהַעַל רְטִיָּה. לִפְנֵי טְרִיָּה. דַּעַת לִטְרוּיָה. קוֹל חֲבֵשׁ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/dachuy", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "137", "scan": "s294", "text": "דָּחוּי לִכְרוּיָה. בְּעַד נָכְרִיָּה."}, {"page_start": true, "printed_page": "138", "scan": "s296", "text": "דְּרוֹר לְכָל בְּרִיָּה. בְּקוֹל הַעֲבָרַת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/hakhshal", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "הָכְשַׁל בְּנַאֲפוּף. בְּזָרַת גִּפּוּף. הֻצַּג בְּרִיב צָפוּף. בְּקוֹל חֶרְדַּת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/haonash", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "הָעֳנַשׁ בְּאַפּוּף. וְשָׁב הֱיוֹת חָפוּף. הוֹעִילוֹ לֵב כָּפוּף. בְּקוֹל כְּפִיפַת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/veim", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "וְאִם שׁוֹד יַעַלְזוֹ. וּבַדִּין יְלִיזוֹ. וְצֶדֶק יָרוּץ לְאָחֲזוֹ. בְּקוֹל חִיל שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/ukhemo", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "וּכְמוֹ מַכְנִים בְּזוֹ. וּמוֹצִיא בְּזוֹ. וְכֵן מֶנּוּ יְגִיזוֹ. בְּקוֹל רוּחַ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/zeh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "זֶה מִכָּל קוֹלוֹת. אֲשֶׁר בְּמַקְהֵלוֹת. זִקֵּק לִקְהִלּוֹת. קוֹל תֵּקַע שֹׁפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/zemamei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "זְמַמֵי עֲקַלְקַלֹּת. מְחֻיְּבֵי סְקִילוֹת. זָעוּ בְּגִדּוּעַ מַקְלוֹת. בְּקוֹל שֵׁמַע שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/chai", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "חַי מִכָּל שָׁנָה. יוֹם זֶה שִׁנָּה. חָקוּק לְשׁוֹשַׁנָּה. לְקוֹל חֵרוּת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/chibbato", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "138", "scan": "s296", "text": "חִבָּתוֹ מִשְׁנֶה. שְׁנִיָּה"}, {"page_start": true, "printed_page": "139", "scan": "s298", "text": "מֵרִאשׁוֹנָה. חֵטְא כָּל הַשָּׁנָה. דְּחוּת בְּקוֹל שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/teva", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "טֶבַע בְּרָכוֹת תֵּשַׁע. מוּל שׁוֹפָרוֹת תֵּשַׁע. טָהוֹר מֵהֶם יִשַּׁע. בְּקוֹל דַּת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/tenef", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "טֶנֶף צְחוּנֵי רֶשַׁע. בְּשׁוּבָם מִפֶּשַׁע. טְרִיָּתָם תְּשַׁעֲשַׁע. בְּקוֹל שֶׁוַע שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/yitav", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "יִיטַב מִשּׁוֹר פָּר. וּמֵאֵיל הַמְּשֻׁפָּר. יוֹם הַמְּסֻפָּר. לְקוֹל חִדּוּשׁ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/yoqesh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "יֹקֶשׁ יוּפָר. וְסוֹטֵן יֻחְפָּר. יֹשֶׁר לֵב יָשְׁפָּר. בְּקוֹל שִׁפּוּר שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/keet", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "כְּעֵת הֵם תֹּקְעִים. גֵּיא מַבְקִיעִים. כְּרַכִּים מַשְׁקִיעִים. בְּקוֹל שְׁאוֹן שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/kol", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "כָּל הֲמוֹן מְרֵעִים. בְּחִיל מִתְרוֹעֲעִים. כַּאֲשֶׁר הֵם מַתְרִיעִים. קוֹל יָרִיעַ כַּשּׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/leqolo", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "139", "scan": "s298", "text": "לְקוֹלוֹ כְּיָקְשַׁב. יָבְעַת כָּל מוֹשָׁב. לְאֻמִּים בְּסַעַר יִנְשַׁב."}, {"page_start": true, "printed_page": "140", "scan": "s300", "text": "בְּקוֹל סַעֲרַת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/leyodeav", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "לְיוֹדְעָיו יוּשַׁב. לְאוֹת טוֹב יִתְחַשַּׁב. לְעֵת יִתְיַשַּׁב. בְּקוֹל טַעַם שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/moasav", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "מוֹאֲסָיו לְהַבְקִיעַ. בּוֹגְדָיו לְקַעֲקֵעַ. מוֹרְדָיו לְהַשְׁקִיעַ. בְּקוֹל חִזּוּק שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/maarikh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "מַאֲרִיךְ בְּהִתָּקֵעַ. מְקַצֵּר בְּהִבָּקֵעַ. מֵרִיעַ וְתוֹקֵעַ. בְּקוֹל שִׁלּוּשׁ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/noten", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "נוֹתֵן אֵימוֹת. מַחְפִּיז אֻמּוֹת. נוּסוּ נוֹאֲמוֹת. מִקּוֹל בּוֹךְ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/notetz", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "נוֹתֵץ חוֹמוֹת. מַשְׁבִּית מִלְחָמוֹת. נוֹהֵם כַּהֲמוֹת. קוֹל שַׁאַג שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/sodo", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "סוֹדוֹ כְּגִלָּה. בְּסִין לְסֶגֻלָּה. סִים מְגִלָּה. בְּקוֹל הִלּוּךְ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/sod", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "סוֹד יוֹם גְּאֻלָּה. בְּחָסְפּוֹ לִדְגוּלָה. שָׂשׂוֹן וְגִילָה. קוֹל יַשְׁמִיעַ שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/asor", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "140", "scan": "s300", "text": "עָשׂוֹר דּוֹחֶה. עֹנֶג מַדְחֶה. עֲבֵרוֹת מְמַחֶה."}, {"page_start": true, "printed_page": "141", "scan": "s302", "text": "בְּקוֹל צֶרַח שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/avonot", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "עֲוֹנוֹת מוֹחֶה. עַבְדוּת מְאַחֶה. עֲבוֹדוֹת מַנְחֶה. קוֹל חִצּוּר שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/pagger", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "פַּגֵּר וְהַסְעִיר. מַמְלְכוּת שָׂעִיר. פִּשְׁעָהּ תָּעִיר. בְּקוֹל קוֹלוֹת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/pitchei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "פִּתְחֵי הָעִיר. תַּשְׁקִיעַ וְתַבְעִיר. פַּחַד רַב וְצָעִיר. מִקּוֹל הֶמְיַת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/tziyyun", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "צִיּוּן רֶמֶז אוֹת. שׁוֹפָרוֹת שְׁלֹשׁ מֵאוֹת. צְוָחָה בְּמִדְיָן דְּאוֹת. בְּקוֹל שִׁתּוּף שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/tziftzefu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "צִפְצְפוּ צְבָאוֹת. כְּשָׁרוּ פְּלָאוֹת. צוּר כְּעַשׂ נִפְלָאוֹת. בְּקוֹל עָרֵב שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/qol", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "קוֹל חֲלוּשָׁה. בְּאַרְקָא חֲלָשָׁה. קֹלוֹת מַתַּן שְׁלֹשָׁה. קוֹלוֹת כְּנִתְּנוּ בַּשּׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/qeren", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "קֶרֶן מְשֻׁלָּשָׁה. הַיּוֹם לְזֵכֶר אֲשַׁלְּשָׁה. קְרוֹא עוֹד שְׁלֹשָׁה. בְּקוֹל עִתּוּד שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/rachashti", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "141", "scan": "s302", "text": "רָחַשְׁתִּי לַעֲלִית."}, {"page_start": true, "printed_page": "142", "scan": "s304", "text": "וְעֵינַי תְּלוּיוֹת. רְאוֹת כְּנוּס גָּלֻיּוֹת. בְּקוֹל גֹּדֶל שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/reviit", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "רְבִיעִית חַיּוֹת. לִיקוֹד לִהְיוֹת. רֶשֶׁף שַׁלְהֲבִיוֹת. בְּקוֹל לַהַב שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/shenah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "שֵׁנָה תְּעוֹרֵר. לְשַׁלֵּם גְּמוּל לְצוֹרֵר. שְׁאוֹנוֹ תְפוֹרֵר. בְּקוֹל גְּבוּרוֹת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/shoshan", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "שׁוֹשָׁן תַּדְרֵר. גְּאֻלָּה תְבָרֵר. שׁוֹכְנִים תְּזוֹרֵר. בְּקוֹל הַעֲרַת שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/teyasher", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "תְּיַשֵּׁר מֵחֶרְמוֹן. לְרוֹעַ אַדְמוֹן. תַּשְׁלֵג בְּצַלְמוֹן. בְּקוֹל הֲמוֹן שׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:essa_dei_betzedeq/titzad", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "142", "scan": "s304", "text": "תִּצְעַד כְּבִישִׁימוֹן. בְּמַתַּן אָמוֹן. תַּשְׁמִיעַ בְּאַרְמוֹן. קוֹל קוֹרֵא כַּשּׁוֹפָר:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"label": "חזן", "role": "reader"}, "speaker_before_reference": true}]}, "review_encoding": true, "stem": "musaf_essa_dei_betzedeq", "title": {"en": "I meditate on righteousness", "he": "אשא דעי בצדק"}, "urn": "urn:x-opensiddur:text:poem:essa_dei_betzedeq"}, "variants": []}
