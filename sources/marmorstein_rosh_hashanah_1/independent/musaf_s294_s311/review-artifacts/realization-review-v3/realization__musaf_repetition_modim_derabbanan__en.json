{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [{"attesting_controls": [{"enclosing_scopes": [], "lang": "en", "segment": {}, "segment_index": 0, "stem": "musaf_repetition_modim_derabbanan", "unit": {"instructions": [{"language": "he", "text": "מודים דרבנן.", "type": "description", "witnesses": ["he"]}, {"language": "en", "text": "Congregation:", "type": "description", "witnesses": ["en"]}]}}], "corrected_sha256": "f67c5430c145866587036d3ee85f08bda906c5d37defe1d16d0b17d14b812229", "corrections": [], "literal_sha256": "f67c5430c145866587036d3ee85f08bda906c5d37defe1d16d0b17d14b812229", "resolved_sha256": "f67c5430c145866587036d3ee85f08bda906c5d37defe1d16d0b17d14b812229", "settings": {}, "target": "urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan", "target_end": null}], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"en": []}, "instructions": [{"language": "en", "text": "Congregation:", "type": "description", "witnesses": ["en"]}], "languages": {"en": [{"canonical": "urn:x-opensiddur:text:prayer:amidah/hodaah/modim_derabbanan", "fragments": [{"page_start": false, "printed_page": "145", "scan": "s311", "text": "We thank Thee because Thou art the Lord our God and the God of our fathers, the God of all flesh, our Creator, the Creator of the beginning. Blessings and thanks to Thy Great and Holy Name for having kept us alive and let us survive. So mayest Thou further keep us alive and let us survive and gather our exiles to the court-yards of Thy Sanctuary in order to observe Thy statutes and do Thy will and serve Thee whole-heartedly; wherefore we thank Thee. Blessed be God to whom thanks are due."}], "paragraph": 1}]}, "review_encoding": true, "stem": "musaf_repetition_modim_derabbanan", "title": {"en": "Congregational thanksgiving", "he": "מודים דרבנן"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/modim_derabbanan"}, "variants": []}
