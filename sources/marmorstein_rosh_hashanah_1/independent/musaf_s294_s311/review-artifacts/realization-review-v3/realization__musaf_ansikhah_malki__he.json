{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": [{"abbreviations": [{"abbr": "נ״א", "expan": "נוסח אחר"}], "note_type": "annotation", "scan": "s270", "target": "#musaf_ansikhah_shinan_variant", "text": "נ״א"}]}, "instructions": [{"language": "he", "text": "מיוסד ע״פ א״ב מרובע.", "type": "description", "witnesses": ["he"]}], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/ansikhah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "אַנְסִיכָה מַלְכִּי. לְפָנָיו בְּהִתְהַלְּכִי. אָמְצוֹ בְּהַמְלִיכִי. יֶאֱזוֹר עֹז וְיִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"label": "קהל.", "role": "congregation"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/elil", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "אֱלִיל בְּהַשְׁלִיכִי. לִפְנֵי בוֹא יוֹם מַלְכִּי. אִישׁ מַלְאָכִי יִשְׁלַח, וְאָז יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/bevoo", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "בְּבוֹאוֹ לַהֲלוֹךְ. נְתוֹשׁ חָנֵף מִמְּלוֹךְ. בֵּית גֵּאִים בְּלִי מְלוֹךְ. יִסַּח לְבַל יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/betokhi", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "בְּתוֹכִי יַהֲלוֹךְ. בְּהוֹפִיעוֹ לִמְלוֹךְ. בְּמַלְכוּתוֹ אֶמְלוֹךְ. וְאָז יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/geveret", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "גְּבֶרֶת מַמְלָכוֹת. בְּמַגְּרוֹ מַמְלָכוֹת. גּוֹיִם וּמַמְלָכוֹת. יָהוֹם וְהוּא יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/gilyon", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "120", "scan": "s260", "text": "גִּלְיוֹן הֲלִיכוֹת. וְסֵפֶר תַּהֲלוּכוֹת. גַּל הַיּוֹם לְזַכּוֹת. חוֹכָיו לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/dorekhet", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "121", "scan": "s262", "text": "דּוֹרֶכֶת נְסִיכוּת. בְּחִנּוּן קוֹל בָּכוּת. דִּבְּרָה אֲנִי בְּמַלְכוּת. וּמִי יוּכַל לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/dakkei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "דַּכְּאֵי רוּחַ נְמִיכוּת. מְחַפְּשֵׂי בְּיוֹם דִּין זְכוּת. דָּשָׁה בְּעֹל מַלְכוּת. עַד צוּר יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/hillukh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "הִלּוּךְ מַהֲלָךְ. חֲמֵשׁ מֵאוֹת הִלַּךְ. הָדוּר עַד הָמְלַךְ. בְּעֻזּוֹ לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/havel", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "הַבֵּל הַמָּמְלָךְ. עַל מֶה מָלַךְ. הֲלֹא בְּמִי נִמְלָךְ. כִּי אָץ לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/umillifnei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "וּמִלִּפְנֵי מְלֹךְ מֶלֶךְ. חַי מִלְּפָנִים מֶלֶךְ. וְעַד תִּכֶל כָּל מֶלֶךְ. הוּא לְבַדּוֹ יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/umah", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "וּמַה יָעֹז מֹלֶךְ. בְּעֹז מִשְׁפַּט מֶלֶךְ. וְכַעֲבוֹר סוּפָה בְּהֵלֶךְ. יַחֲלוֹף מִמְּלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/zakh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "121", "scan": "s262", "text": "זָךְ דִּין בְּעָרְכוֹ. יֹאחֵז דַּרְכּוֹ. זֵדִים בְּדָרְכוֹ. נָקָם יַעַט וְיִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/zer", "end_reference": true, "fragments": [{"page_start": true, "printed_page": "122", "scan": "s264", "text": "זֵר בְּשַׁלְּכוֹ. יִתֵּן עֹז לְמַלְכּוֹ. זַכִּים בְּהַמְלִיכוֹ. עַל כֹּל יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/chiddeshu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "חִדְּשׁוּ מְלוּכָה. כַּדָּת וְכַהֲלָכָה. חֹטֶר מַמְלָכָה. בְּמִישׁוֹר יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/chovesh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "חֹבֶשׁ אֲרוּכָה. וְאֹרֶךְ יוֹם מְבוּכָה. חֲתֻלָּה לְמַכָּה. יַעַל בְּעֵת יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/torach", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "טֹרַח מַלְכִיּוֹת. עוֹבְדֵי מַשְׂכִּיּוֹת. טִמְּאוּ חֶמֶד שְׂכִיּוֹת. בְּגַאֲוָה לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/tohar", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "טֹהַר זָכִיּוֹת. וְשַׁאַג קוֹל בְּכִיוֹת. טֶבַע צוּל דָּכְיוֹת. יִפֶן וּבָם יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/yahav", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "יָהַב מַשְׁלִיכִים. עָלָיו בְּנֵי מְלָכִים. יוֹם זֶה לוֹ מְחַכִּים. בּוֹ יָבֹא לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/yaavru", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "יַעַבְרוּ מִתְהַלְּכִים. לְפָנָיו כְּמַלְאָכִים. יַחַד מַמְלִיכִים. יְיָ יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/kittim", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "122", "scan": "s264", "text": "כִּתִּים בְּכַתְּתוֹ. אִיִּים בְּהַכֹּתוֹ. כֵּס מַמְלַכְתּוֹ."}, {"page_start": true, "printed_page": "123", "scan": "s266", "text": "יִכּוֹן וְיִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/kevod", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "כְּבוֹד מַלְכוּתוֹ. וְקָדוֹשׁ הֲלִיכָתוֹ. בְּגָמְרוֹ מְלַאכְתּוֹ. לְעֵין כֹּל יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/lekhol", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "לְכָל גֹּבַהּ יַפִּיל. וְהַר וָגֶבַע יַשְׁפִּיל. לְכָל אוֹם יַאְפִּיל. וּכְאוֹר זָרוּעַ יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/leroi", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "לְרָאִי יַקְפִּיל. וַחֲדָשִׁים יַכְפִּיל. לְיוֹם זֶה פּוּר הִפִּיל. מִצִּיּוֹן לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/matu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "מָטוּ גוֹיִם. הָמוּ גֵּאִים. מָעֲדוּ מִתְגָּאִים. גֵּאֶה בְּבֹאוֹ לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/malkhu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "מָלְכוּ דְגוּיִם. נִטָּלוּ סְגוּיִם. מֶלֶךְ הַגּוֹיִם. עֵת אָתָא לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/nedivei", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "נְדִיבֵי עַמִּים. יֵאָסְפוּ מֵעַמִּים. נְשׂוֹא מְעֻטֵּי עַמִּים. אֶל מְקוֹמָם יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/niggun", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "נִגּוּן נְעִימִים. לְמוּלָם מַנְעִימִים. נְשָׂאָם מֵעֲמָמִים. עֲלֵיהֶם לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/sikkut", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "123", "scan": "s266", "text": "סִכּוּת אֱלִילִים. כִּיּוּן"}, {"page_start": true, "printed_page": "124", "scan": "s268", "text": "גִּלּוּלִים. סָחוֹב כְּמוֹ חֲלָלִים. יָשְׁלָכוּ בְּלִי לִמְלוֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/sod", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "סוֹד אֵל אֵלִים. הָבוּ בְּנֵי אֵלִים. שְׂאוּ זִמְרָה וְהִלּוּלִים. לָאָדוֹן כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/izzuz", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "עִזּוּז יָד בְּהַשִּׂיאוֹ. לְהָרִים נְשִׂיאוֹ. עֲמֻסָיו בְּנַשְּׂאוֹ. יָעֹז וְיִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/al_rum", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "עַל רוֹם מַשָּׂאוֹ. יָדֵיהוּ בְּנָשְׂאוֹ. עַל הוֹד כִּסְאוֹ. יֵשֵׁב וְיִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/pur", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "פּוּר תְּפוֹרֵר אֶרֶץ. בְּכִלָּיוֹן וָחֶרֶץ. פַּח בְּיוֹשְׁבֵי הָאָרֶץ. יַרְגִּיז וְיִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/pachad", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "פַּחַד שׁוֹפְרוֹת עֶרֶץ. יְשַׁלֵּשׁ וּבָם יִרֶץ. פְּאֵר מִכְּנַף הָאָרֶץ. יַעֲלוּ כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/tzevi", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "צְבִי מֵהֲדֹם יַעַל. וְאֶדֶר מִשַּׁעַל. צַהַל מִשְּׁמֵי מַעַל. יְרַנְּנוּ כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/tzevaot", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "צִבְאוֹת כָּל פֹּעַל. לְצַלְעָם יַרְמֵי תַּעַל. צְפִירַת פְּאֵר לְהַעַל. הֵן לְצֶדֶק יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/qetzinim", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "124", "scan": "s268", "text": "קְצִינִים אֲשֶׁר מָלְכוּ. אַדֶּרֶת יַשְׁלִיכוּ."}, {"page_start": true, "printed_page": "125", "scan": "s270", "text": "קוֹל יְתַנּוּ וְיַמְלִיכוּ. לָאָדוֹן כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/qeruim", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "קְרוּאִים יִמְלוֹכוּ. וְאַחֲרָיו יַהֲלוֹכוּ. קוֹמֲמִיּוּת יֵלֵכוּ. וּבְרֹאשָׁם יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/raz", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "רָז הַמְּכֻמָּן. לְיוֹם זֶה מְזֻמָּן. רָשׁוּם לְמוֹעֵד וּזְמַן. וּבוֹ נוֹקֵם יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/roeh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "רוֹעֶה נֶאֱמָן. בְּבֹאוֹ מִתֵּימָן. רוּחַ יַסְעִיר כְּתֵימָן. בְּגִלְעָד יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/shinan", "end_reference": true, "fragments": [{"alternatives": [{"printed": "פְּלִיאִיּוֹת", "readings": ["פְּלִיאִיּוֹת", "פְּלִילִיּוֹת"], "xml_id": "musaf_ansikhah_shinan_variant"}], "page_start": false, "printed_page": "125", "scan": "s270", "text": "שִׁנְאַן עֲלִיּוֹת. וְסוֹד פְּלִיאִיּוֹת. שִׁיר מִתְלוּלִיּוֹת. יִפְצְחוּ כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/sheiyyot", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "שְׁאִיּוֹת תַּחְתִּיּוֹת. וְהוֹד אוֹתִיּוֹת. שְׁאוֹן הֲמוֹן בְּרִיּוֹת. יָרִיעוּ כִּי יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/tekhan", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "תְּכַן כֵּס כַּשֶּׁמֶשׁ. שְׁמוֹ לִפְנֵי שֶׁמֶשׁ. תָּאֳרוֹ כְּצֵאת הַשֶּׁמֶשׁ. בְּמָלְכוֹ יִמְלֹךְ:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:ansikhah_malki/tomekh", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "125", "scan": "s270", "text": "תּוֹמֵךְ מִמִּזְרַח שֶׁמֶשׁ. וְעַד מְבוֹאַת שֶׁמֶשׁ. תַּמָּה בָּרָה כַּשֶּׁמֶשׁ. יְרוֹמֵם וְיִמְלֹךְ:"}], "paragraph": 2, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן", "role": "reader"}, "speaker_before_reference": true}]}, "review_encoding": true, "source_notes": {"en": [{"language": "en", "text": "The source does not translate the Hebrew stanza beginning לכל גבה יפיל (scan 266). The English continues at לראי יקפיל; no substitute translation is supplied."}]}, "stem": "musaf_ansikhah_malki", "title": {"en": "I pay homage to my King", "he": "אנסיכה מלכי"}, "urn": "urn:x-opensiddur:text:poem:ansikhah_malki"}, "variants": []}
