{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"fragments": [{"page_start": false, "printed_page": "144", "scan": "s308", "text": "הַיּוֹם הֲרַת עוֹלָם. הַיּוֹם יַעֲמִיד בַּמִּשְׁפָּט. כָּל יְצוּרֵי עוֹלָמִים. אִם כְּבָנִים. אִם כַּעֲבָדִים. אִם כְּבָנִים רַחֲמֵנוּ כְּרַחֵם אָב עַל בָּנִים. וְאִם כַּעֲבָדִים עֵינֵינוּ לְךָ תְלוּיוֹת. עַד שֶׁתְּחָנֵּנוּ וְתוֹצִיא כָאוֹר מִשְׁפָּטֵנוּ אָיוֹם קָדוֹשׁ:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:prayer:hayom_harat_olam"}]}, "review_encoding": true, "stem": "musaf_repetition_shofarot_hayom", "title": {"en": "On this day the world was completed", "he": "היום הרת עולם"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/shofarot_hayom"}, "variants": []}
