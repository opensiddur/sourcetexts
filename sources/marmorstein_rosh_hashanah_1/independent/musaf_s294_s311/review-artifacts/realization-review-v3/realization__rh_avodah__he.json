:prayer:amidah/avodah/vetechezeinah", "fragments": [{"page_start": false, "printed_page": "18", "scan": "s30", "text": "וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְצִיּוֹן בְּרַחֲמִים. בָּרוּךְ אַתָּה יְיָ הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:"}], "paragraph": 2}]}, "stem": "rh_avodah", "title": {"en": "Evening Prayer for the New Year — Service", "he": "עבודה"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/minchah_maariv/amidah/avodah"}, "variants": []}
