{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"en": []}, "instructions": [], "languages": {"en": [{"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/aleinu/text/opening", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "118", "scan": "s257", "text": "It is right for us to praise the Master of everything, and ascribe greatness to the Creator of the beginning, that He has not made us like the nations of the lands and has not placed us like the families of the earth, that He has not made our portion like theirs nor our destiny like that of all their multitude. We kneel, bow down and give thanks before the Supreme King of kings, the Holy One blessed be He, who has extended the heavens and founded the earth and His glorious dwelling is in Heaven above and His mighty presence in the loftiest heights."}], "paragraph": 1, "reference_unit": "prayer-part"}, {"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/aleinu/text/hu_eloheinu", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "118", "scan": "s257", "text": "He is our God, there is no other. In truth He is our King, there is none besides Him."}], "paragraph": 1, "reference_unit": "prayer-part"}, {"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/aleinu/text/kakkatuv_betorato", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "118", "scan": "s257", "text": "As it is written in His Torah:"}], "paragraph": 1, "reference_unit": "prayer-part"}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/aleinu/quotes/deuteronomy_4_39/deuteronomy_4", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "118", "scan": "s257", "text": "‘And you shall know this day and repeat it in your heart that the Lord is God in the heavens above and that on earth below there is no other.’"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:deuteronomy/4/39", "source_reference": "urn:x-opensiddur:text:bible:deuteronomy/4/39", "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/aleinu/quotes/deuteronomy_4_39/deuteronomy_4/39"}]}, "review_encoding": true, "stem": "musaf_repetition_aleinu", "title": {"en": "Aleinu", "he": "עלינו לשבח"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/aleinu"}, "variants": []}
