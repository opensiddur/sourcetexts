{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/1", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "וְיֶאֱתָיוּ כל לְעָבְדֶךָ. וִיבָרְכוּ שֵׁם כְּבוֹדֶךָ. וְיַגִּידוּ בָאִיִּים צִדְקֶךָ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/2", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "וְיִדְרְשׁוּךָ עַמִּים לֹא יְדָעוּךָ. וִיהַלְלוּךָ כָּל־אַפְסֵי אָרֶץ. וְיוֹמְרוּ תָמִיד יִגְדַּל יְיָ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/3", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": ""}], "paragraph": 1, "reference_unit": "stanza"}, {"conditions": [{"features": {"urn:x-opensiddur:condition:poem:v_yeetayu_kol_leavdekha/veyizbechu": true}, "type": "opensiddur:variant"}], "fragments": [{"page_start": false, "printed_page": "115", "scan": "s250", "text": "(וְיִזְבְּחוּ"}, {"page_start": false, "printed_page": "116", "scan": "s252", "text": "לְךָ אֶת־זִבְחֵיהֶם.)"}], "marked": true, "paragraph": 1}, {"deferred_page_boundary": true, "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": " וְיִזְנְחוּ אֶת־עֲצַבֵּיהֶם. וְיַחְפְּרוּ עִם פְּסִילֵיהֶם: וְיַטּוּ שְׁכֶם אֶחָד לְעָבְדֶךָ. "}], "paragraph": 1}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/4", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִירָאוּךָ עִם־שֶׁמֶשׁ מְבַקְשֵׁי פָנֶיךָ. וְיַכִּירוּ כֹּחַ מַלְכוּתֶךָ. וִילַמְּדוּ תוֹעִים בִּינָה. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/5", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וִימַלְּלוּ אֶת־גְּבוּרָתֶךָ. וִינַשְּׂאוּךָ מִתְנַשֵּׂא לְכֹל לְרֹאשׁ. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/6", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וִיסַלְּדוּ בְּחִילָה פָּנֶיךָ. וִיעַטְּרוּךָ נֵזֶר תִּפְאָרָה. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/7", "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִפְצְחוּ הָרִים רִנָּה. וְיִצְהֲלוּ אִיִּים בְּמָלְכֶךָ: וִיקַבְּלוּ עֹל מַלְכוּתְךָ עֲלֵיהֶם. וִירוֹמְמוּךָ בִּקְהַל עָם. "}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha/8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "116", "scan": "s252", "text": "וְיִשְׁמְעוּ רְחוֹקִים וְיָבוֹאוּ. וְיִתְּנוּ לְךָ כֶּתֶר מְלוּכָה:"}], "paragraph": 1, "reference_unit": "stanza"}]}, "review_encoding": true, "stem": "musaf_v_yeetayu_kol_leavdekha", "title": {"en": "All will come to serve Thee", "he": "ויאתיו"}, "urn": "urn:x-opensiddur:text:poem:v_yeetayu_kol_leavdekha"}, "variants": []}
