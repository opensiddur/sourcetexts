al": "urn:x-opensiddur:text:poem:zekhor_berit_avraham/stanza_1", "fragments": [{"page_start": false, "printed_page": "136", "scan": "s292", "text": "זְכֹר בְּרִית אַבְרָהָם וַעֲקֵדַת יִצְחָק וְהָשֵׁב שְׁבוּת אָהֳלֵי יַעֲקֹב וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ:"}], "paragraph": 1}]}, "marked": true, "review_encoding": true, "source_notes": {"he": [{"language": "en", "text": "The printed combined condition/action rubric is retained verbatim. Its Ark-opening clause is repeated as an attributed instruction inside the selected conditional scope so that resolving the condition cannot suppress the ritual action."}]}, "stem": "musaf_repetition_circumcision", "title": {"en": "Remember the covenant of Abraham", "he": "זכר ברית אברהם"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/circumcision"}, "variants": []}
