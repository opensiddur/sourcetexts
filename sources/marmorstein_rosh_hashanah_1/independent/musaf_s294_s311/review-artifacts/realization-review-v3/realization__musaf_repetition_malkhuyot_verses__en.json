{"corrections": [{"corr": "Lord’s’.", "file": "prayerbook_for_the_new_year-marmorstein-1965-en/musaf_repetition_malkhuyot_verses.xml", "id": "musaf_malkhuyot_obadiah_quote", "reason": "Missing closing quotation mark and extraneous space in scan273; restored from the same verse correctly printed in the quiet Musaf on 209.", "sic": "Lord’s ."}], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"en": []}, "instructions": [], "languages": {"en": [{"end_reference": true, "fragments": [{"page_start": true, "printed_page": "126", "scan": "s273", "text": "As it is written in Thy Torah:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/exodus_15_18/exodus_15", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/exodus_15_18/exodus_15/18", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘The Lord will reign for ever and ever.’"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:exodus/15/18"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/numbers_23_21/numbers_23", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/numbers_23_21/numbers_23/21", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘And He observed no wrong in Jacob nor did He see trouble in Israel, the Lord His God is with him and the royal Teruah within him.’"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:numbers/23/21"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/deuteronomy_33_5/deuteronomy_33", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/deuteronomy_33_5/deuteronomy_33/5", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘And He became King in Yeshurun when the heads of the people assembled together with the tribes of Israel’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/33/5"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And in Thy holy words it is written saying:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_22_29/psalms_22", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_22_29/psalms_22/29", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘For dominion is the Lord’s and He is ruler over nations’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/22/29"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_93_1/psalms_93", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_93_1/psalms_93/1", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘The Lord has reigned, clothed in majesty, the Lord has clothed Himself in strength. He has girded Himself, the world is firmly founded, it does not totter.’"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/93/1"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_7/psalms_24", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_7/psalms_24/7", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘Lift up your heads, O gates and lift yourselves up, O portals of eternity, so that the King of glory may enter."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/7"}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_8/psalms_24", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_8/psalms_24/8", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Who is this King of glory? He is the Lord, strong and mighty, the Lord mighty in war."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/8"}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_9/psalms_24", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_9/psalms_24/9", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Lift up your heads, O gates, lift up, O portals of eternity, so that the King of glory may enter."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/9"}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_10/psalms_24", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/psalms_24_10/psalms_24/10", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "Who is this King of glory? The Lord of Hosts, He is the King of glory, Selah’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:psalms/24/10"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And through Thy servants the prophets it is written saying:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/isaiah_44_6/isaiah_44", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/isaiah_44_6/isaiah_44/6", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘Thus says the Lord, the King of Israel and its redeemer, the Lord of Hosts: I am the first and I am the last and apart from Me there is no God’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:isaiah/44/6"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/obadiah_1_21/obadiah_1", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/obadiah_1_21/obadiah_1/21", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘Deliverers shall ascend Mount Zion to judge the mountain of Esau and dominion shall be the Lord’s ."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:obadiah/1/21"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And it was said:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/zechariah_14_9/zechariah_14", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/zechariah_14_9/zechariah_14/9", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘And the Lord shall be King over all the earth, on that day will the Lord be One and His Name One’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:zechariah/14/9"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "And in Thy Torah it is written saying:"}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/deuteronomy_6_4/deuteronomy_6", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses/quotes/deuteronomy_6_4/deuteronomy_6/4", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "126", "scan": "s273", "text": "‘Hear, O Israel, the Lord is our God, the Lord is One’."}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:deuteronomy/6/4"}]}, "review_encoding": true, "stem": "musaf_repetition_malkhuyot_verses", "title": {"en": "Malkhuyot scripture verses", "he": "פסוקי מלכיות"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/malkhuyot_verses"}, "variants": []}
