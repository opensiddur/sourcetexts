{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"canonical_parts": true, "citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/text", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "93", "scan": "s206", "text": "יִשְׂמְחוּ בְּמַלְכוּתְךָ שֹׁמְרֵי שַׁבָּת וְקוֹרְאֵי עֹנֶג עַם מְקַדְּשֵׁי שְׁבִיעִי. כֻּלָּם יִשְׂבְּעוּ וְיִתְעַנְּגוּ מִטּוּבֶךָ וּבַשְּׁבִיעִי רָצִיתָ בּוֹ וְקִדַּשְׁתּוֹ חֶמְדַּת יָמִים אוֹתוֹ קָרָאתָ זֵכֶר לְמַעֲשֵׂה בְרֵאשִׁית:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:prayer:amidah/yismechu_vemalkhutekha"}]}, "stem": "musaf_yismechu_word_parts", "title": {"en": "Sabbath delight", "he": "ישמחו במלכותך"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/yismechu/word_parts"}, "variants": []}
