{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": [{"abbreviations": [{"abbr": "נ״א", "expan": "נוסח אחר"}], "language": "he", "note_type": "annotation", "scan": "s246", "target": "#musaf_qedushah_conclusion_parts_source_variant_1", "text": "נ״א"}, {"abbreviations": [{"abbr": "נ״א", "expan": "נוסח אחר"}], "language": "he", "note_type": "annotation", "scan": "s248", "target": "#musaf_qedushah_conclusion_parts_source_variant_2", "text": "נ״א"}]}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:prayer:amidah/ki_maqdishekha", "fragments": [{"alternatives": [{"printed": "בִּקְדֻשָּׁתְךָ (נ״א כערכך)", "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/ki_maqdishekha/biqdushatekha", "text": "בִּקְדֻשָּׁתְךָ"}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/ki_maqdishekha/keerkekha", "text": "כערכך"}], "xml_id": "musaf_qedushah_conclusion_parts_source_variant_1"}], "page_start": false, "printed_page": "113", "scan": "s246", "text": "כִּי מַקְדִּישֶׁיךָ בִּקְדֻשָּׁתְךָ (נ״א כערכך) קִדַּשְׁתָּ. נָאֶה לְקָדוֹשׁ פְּאֵר מִקְּדוֹשִׁים. וּבְכֵן יִתְקַדַּשׁ שִׁמְךָ יְיָ"}], "paragraph": 1, "reference_unit": "prayer"}, {"fragments": [{"page_start": true, "printed_page": "114", "scan": "s248", "text": "אֱלֹהֵינוּ. עַל יִשְׂרָאֵל עַמֶּךָ. וְעַל יְרוּשָׁלַיִם עִירֶךָ. וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדֶךָ. וְעַל מַלְכוּת בֵּית דָּוִד מְשִׁיחֶךָ. וְעַל מְכוֹנְךָ וְהֵיכָלֶךָ:"}], "paragraph": 1}, {"corresp": "urn:x-opensiddur:text:prayer:amidah/od_yizkor_lanu", "end_reference": true, "fragments": [{"alternatives": [{"printed": "אָיוֹם (נ״א היום)", "readings": [{"corresp": "urn:x-opensiddur:condition:prayer:amidah/od_yizkor_lanu/ayom", "text": "אָיוֹם"}, {"corresp": "urn:x-opensiddur:condition:prayer:amidah/od_yizkor_lanu/hayom", "text": "היום"}], "xml_id": "musaf_qedushah_conclusion_parts_source_variant_2"}], "page_start": false, "printed_page": "114", "scan": "s248", "text": "עוֹד יִזְכָּר לָנוּ אַהֲבַת אֵיתָן, אֲדוֹנֵינוּ. וּבֵן הַנֶּעֱקָד יַשְׁבִּית מְדַיְּנֵנוּ. וּבִזְכוּת הַתָּם יוֹצִיא אָיוֹם (נ״א היום) לְצֶדֶק דִּינֵנוּ. כִּי קָדוֹשׁ הַיּוֹם לַאֲדֹנֵינוּ: בְּאֵין מֵלִיץ יֹשֶׁר מוּל מָגִּיד פֶּשַׁע. תַּגִּיד לְיַעֲקֹב דָּבָר חק וּמִשְׁפָּט. וְצַדְּקֵנוּ בְּמִשְׁפָּט הַמֶּלֶךְ הַמִּשְׁפָּט."}], "paragraph": 1, "reference_unit": "prayer"}]}, "map_root": false, "publication_context": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/qedushah/conclusion_parts", "review_encoding": true, "source_notes": {"en": [{"language": "en", "text": "The printed English follows the main Hebrew readings rendered as “with Thy holiness” and “Awe-inspiring One.” This edition prints no English alternatives for the corresponding Hebrew variants."}]}, "stem": "musaf_qedushah_conclusion_parts", "title": {"en": "For those who sanctify Thee", "he": "כי מקדישיך"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/qedushah/conclusion_parts"}, "variants": []}
