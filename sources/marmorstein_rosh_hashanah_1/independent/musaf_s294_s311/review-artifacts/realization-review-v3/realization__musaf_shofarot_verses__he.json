ah_27/13", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "98", "scan": "s216", "text": "וְהָיָה בַּיּוֹם הַהוּא יִתָּקַע בְּשׁוֹפָר גָּדוֹל וּבָאוּ הָאֹבְדִים בְּאֶרֶץ אַשּׁוּר וְהַנִּדָּחִים בְּאֶרֶץ מִצְרָיִם וְהִשְׁתַּחֲווּ לַיְיָ בְּהַר הַקֹּדֶשׁ בִּירוּשָׁלָֽ͏ִם:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:isaiah/27/13"}, {"end_reference": true, "fragments": [{"page_start": false, "printed_page": "98", "scan": "s216", "text": "וְנֶאֱמַר, "}], "paragraph": 1}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_14/zechariah_9", "corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_14/zechariah_9/14", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "98", "scan": "s216", "text": "וַיְיָ עֲלֵיהֶם יֵרָאֶה וְיָצָא כַבָּרָק חִצּוֹ וַאֲדֹנָי יֱהֹוִה בַּשּׁוֹפָר יִתְקָע וְהָלַךְ בְּסַעֲרוֹת תֵּימָן:"}], "paragraph": 1, "reference_unit": "verse", "source": "urn:x-opensiddur:text:bible:zechariah/9/14"}, {"chapter_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "98", "scan": "s216", "text": "יְיָ צְבָאוֹת יָגֵן עֲלֵיהֶם:"}], "paragraph": 1, "source": "urn:x-opensiddur:text:bible:zechariah/9/15/adonai_tzevaot_yagen", "source_reference": "urn:x-opensiddur:text:bible:zechariah/9/15", "source_reference_corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9/15", "source_reference_part": {"corresp": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/shofarot_verses/quotes/zechariah_9_15/zechariah_9/15/adonai_tzevaot_yagen", "n": "adonai_tzevaot_yagen", "unit": "verse-part"}}, {"canonical": "urn:x-opensiddur:text:prayer:ken_tagen_al_ammekha_yisrael", "fragments": [{"page_start": false, "printed_page":