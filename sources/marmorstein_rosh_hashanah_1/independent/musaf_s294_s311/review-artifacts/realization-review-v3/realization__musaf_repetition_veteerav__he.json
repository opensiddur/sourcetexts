{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:siddur:regalim/musaf/text/veteerav", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "145", "scan": "s310", "text": "וְתֶעֱרַב עָלֶֽיךָ עֲתִירָתֵֽנוּ כְּעוֹלָה וּכְקָרְבָּן. אָנָּא רַחוּם בְּרַחֲמֶיךָ הָרַבִּים הָשֵׁב שְׁכִינָתְךָ לְצִיּוֹן וְסֵדֶר הָעֲבוֹדָה לִירוּשָׁלָֽיִם. וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְצִיּוֹן בְּרַחֲמִים. וְשָׁם נַעֲבָדְךָ בְּיִרְאָה כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמוֹנִיּוֹת:"}], "paragraph": 1}, {"corresp": "urn:x-opensiddur:text:siddur:regalim/musaf/text/sheotekha", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "145", "scan": "s310", "text": "בָּרוּךְ אַתָּה יְיָ שֶׁאוֹתְךָ לְבַדְּךָ בְּיִרְאָה נַעֲבוֹד:"}], "instructions": [{"abbreviations": [{"abbr": "הש״ץ", "expan": "השליח ציבור"}], "corresp": "urn:x-opensiddur:instruction:role/reader", "language": "he", "text": "הש״ץ מסיים", "type": "description"}], "paragraph": 2}]}, "review_encoding": true, "stem": "musaf_repetition_veteerav", "title": {"en": "May our entreaty be pleasing", "he": "ותערב"}, "urn": "urn:x-opensiddur:text:siddur:rosh_hashanah/musaf/repetition/veteerav"}, "variants": []}
