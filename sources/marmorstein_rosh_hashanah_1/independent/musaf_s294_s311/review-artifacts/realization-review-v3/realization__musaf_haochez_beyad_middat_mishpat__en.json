{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"en": []}, "instructions": [], "join_source_fragments": true, "languages": {"en": [{"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haochez", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "In His hand He holds the attribute of judgment. All believe that He is God of faith."}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/habochen", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He tests and examines hidden secrets. All believe that He tests the inwards."}], "paragraph": 2, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hagoel", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He redeems from death and delivers from destruction. All believe that He is a strong redeemer."}], "paragraph": 3, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hadan", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He judges alone those who come into the world. All believe that He is judge of truth."}], "paragraph": 4, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui", "fragments": [{"join_next": true, "page_start": false, "printed_page": "114", "quotations": [{"chapter_corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui/quotations/quoted_exodus_3_14", "inline_scope": true, "source_reference": "urn:x-opensiddur:text:bible:exodus/3/14", "source_reference_corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hehagui/quotations/quoted_exodus_3_14/14", "text": "I am that I am"}], "scan": "s249", "text": "He is thought of as ‘I am that I am’. All believe that He was"}], "paragraph": 5, "reference_unit": "stanza"}, {"conditions": [{"features": {"urn:x-opensiddur:condition:poem:haochez_beyad_middat_mishpat/hehagui/vehoveh": true}, "type": "opensiddur:variant"}], "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": ", is"}], "paragraph": 5}, {"fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": " and shall be."}], "paragraph": 5}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/havaddai", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "Sure is His Name and likewise His fame. All believe that He is with none beside Him."}], "paragraph": 6, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hazokher", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He remembers those who remember Him in kind memory. All believe that He remembers the covenant."}], "paragraph": 7, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hachotekh", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He distributes life to all the living. All believe that He lives and endures."}], "paragraph": 8, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatov", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He is good and acts well towards evil and good. All believe that He is good towards all."}], "paragraph": 9, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hayodea", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He knows the impulse of all creatures. All believe that He has formed them in the womb."}], "paragraph": 10, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hakol", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He has power over all and contains them all. All believe that He has power over all."}], "paragraph": 11, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/halan", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "Almighty, He dwells in mystery, in shadow. All believe that He alone is He."}], "paragraph": 12, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hamamlikh", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He appoints kings and His is the kingdom. All believe that He is King of the world."}], "paragraph": 13, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hanoheg", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He leads with His mercy every generation. All believe that He retains kindness."}], "paragraph": 14, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hasovel", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He is long suffering and hides His eye from the stubborn. All believe that He grants pardon."}], "paragraph": 15, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haelyon", "fragments": [{"page_start": false, "printed_page": "114", "scan": "s249", "text": "He is supreme and His eye rests on those who fear Him. All believe that He answers soft prayer."}], "paragraph": 16, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hapoteach", "fragments": [{"page_start": true, "printed_page": "115", "scan": "s251", "text": "He opens the gates for those who knock in repentance. All believe that His hand is open."}], "paragraph": 17, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatzofeh", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s251", "text": "He waits for the evil-doer and delights in his justification. All believe that He is righteous and upright."}], "paragraph": 18, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/haqetzar", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s251", "text": "He shortens anger and holds back wrath. All believe that He is hard to anger."}], "paragraph": 19, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/harachum", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s251", "text": "Compassionate, He lets mercy precede wrath. All believe that He is soft to appease."}], "paragraph": 20, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hashaveh", "fragments": [{"page_start": false, "printed_page": "115", "scan": "s251", "text": "He is just and treats small and great equally. All believe that He is a righteous judge."}], "paragraph": 21, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat/hatam", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "115", "scan": "s251", "text": "He is perfect and shows perfection with the flawless. All believe that His work is flawless."}], "paragraph": 22, "reference_unit": "stanza"}]}, "review_encoding": true, "stem": "musaf_haochez_beyad_middat_mishpat", "title": {"en": "In His hand He holds the attribute of judgment", "he": "האוחז ביד מדת משפט"}, "urn": "urn:x-opensiddur:text:poem:haochez_beyad_middat_mishpat"}, "variants": []}
