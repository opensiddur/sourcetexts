{"corrections": [], "documentary_instructions_sha256": "5104896d26339ccedd607a6f9e0ca235e8ae6ba6d9bdeefcab851acb5d48e1a7", "expanded_order_sha256": "0975f7eead82eb895b287cdf57a00cabf59d099c9882fcda90e4cafd723aaab4", "navigation_sha256": "a8da7859b185a3665b12507ea6d70fa1d4990a8f26b21f8e302a5a33e039044f", "source_fidelity": [], "source_order_sha256": "57b8ada1caf43c896b1f8d7375f9b4034ac3871898019ef59b00d0f9f35b5f9b", "unit": {"citations": {"he": []}, "instructions": [], "languages": {"he": [{"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_1", "fragments": [{"page_start": true, "printed_page": "129", "scan": "s278", "text": "זֵֽכֶר תְּחִלַּת כָּל מַעַשׂ. אֲשֶׁר בְּכָל שָׁנָה נַעַשׂ. תּוֹחַלְתָּם לִמְאַס. יוֹצֵר בַּל יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ק׳", "expan": "קהל"}, "speaker_before_reference": true}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_2", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "תּוֹכַחַת מַעַשׂ. אִם יָצְאָה בְּכַעַס. תּוֹמֵךְ לְמַעֲנוֹ יַעַשׂ. וִיצוּרִים יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_3", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "זֵֽכֶר שֶׁמִּבְּרֵאשִׁית. תְּבוּאַת רֵאשִׁית. שֹֽׁרֶשׁ בִּכּוּר רֵאשִׁית. יֵרָא וְיִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_4", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "שֶֽׁצֶף חֲרִישִׁית. אִם חָר לְהָשִׁית. שׁוּבָה אֲשֶׁר הֵשִׁית. לַשּׁוֹבָבִים יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_5", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "זֵֽכֶר רֹאשׁ עֲפָרוֹת. וְתוֹלָדוֹת סְפוּרוֹת. רְשׁוּם סְפוּרוֹת. לְמִסְפַּר חוֹל יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_6", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "רֹבַע מִסְפָּרוֹת. מְחַנְנֵי לְכַפָּרֹת. רֶֽגֶשׁ שׁוֹפָרֹת. לְשַׁפְּרֵם יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_7", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "זֵֽכֶר קְרִיאַת סֵֽפֶר. אֲשֶׁר גָּלְמִי שִׁפֵּר. קָצַב לוֹ בַּסֵּֽפֶר. בְּכָל דּוֹר וָדוֹר לִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_8", "fragments": [{"page_start": false, "printed_page": "129", "scan": "s278", "text": "קֶֽצֶב אִם"}, {"page_start": true, "printed_page": "130", "scan": "s280", "text": "הֶחֱרַט בַּסֵּֽפֶר. לְבִלְתִּי מְצוֹא כֹּֽפֶר. קִיּוּם זִכְרוֹן זֶה סֵֽפֶר. לְפָנָיו יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_9", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זֵֽכֶר צָפוּן מֹרְדֵי אוֹר. תָּמִים דּוֹר כָּאוֹר. צִיָּה כְּחָר לָאוֹר. קְנוּיָו יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_10", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "צְפוּפִים פְּנֵי נָאוֹר. מִשְׁפָּטָם תֵּת לָאוֹר. צַחַן רוֹעַ שְׂאוֹר. בְּרִיב בַּל יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_11", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זֵֽכֶר פְּעֻלַּת אֶזְרָח. הֵעַרְתָּהּ מִמִּזְרָח. פָּעֳלוֹ יִזְרָח. בְּקֶֽרֶב שָׁנִים יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_12", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "פַּח אִם הָטְרַח. פִּרְחָיו לְמָרַח. פִּלּוּלוֹ יִצְרַח. בַּעֲדָם יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_13", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זֵֽכֶר עֲקֵדַת מוֹרִיָּה. כְּהִיַּת רְאִיָּה. עֲדֵי עֵרוֹם וְעֶרְיָה. סְבוּכוֹ יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_14", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "עֵֽצֶב טְרִיָּה. אִם כּוֹאֲבָה פּוֹרִיָּה. עֲתָרוֹ לִרְאִיָּה. וְלִזְכוּת יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_15", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "זֵֽכֶר סֻלָּם חָלָם. וְעָלָיו מְחוֹלְלָם. שָׂרֵי אַרְבַּע וְעֻלָּם. בּוֹ כְּמֵאָז יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_16", "fragments": [{"page_start": false, "printed_page": "130", "scan": "s280", "text": "שְׂרִיגָיו בְּמַעֲלָם. וְיֹאמַר לְגָעֳלָם. שִׂיחוֹ"}, {"page_start": true, "printed_page": "131", "scan": "s282", "text": "יוֹעִילָם. בְּרִית לִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_17", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "זֵכֶר נְקוּבֵי מַטּוֹת. שְׁבוּעוֹת מַטּוֹת. נְדִידוֹת הַמַּטּוֹת. לְאַמְּצָם יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_18", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "נֹשְׂאֵי עֹל מוֹטַת. אִם פָּץ לְהַמְטוֹת. נֶפֶץ חֲדַר הַמִּטּוֹת. לְכִפּוּר יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_19", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "זֵכֶר מְצוּקִים. יְסוֹד מוּצָקִים. מִפְעָלָם לְצַעֲקִים. בְּפוּט חָשׁ לִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_20", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "מִפִּי יוֹנְקִים. אֲשֶׁר בַּסּוּף נֶאֱקִים. מַאֲמַר בְּרִית וְחֻקִּים. דְּבַר קָדְשׁוֹ יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_21", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "זֵכֶר לִין כְּפָרִים. וְאִמְרֵי שְׁפָרִים. לִמְשַׁלְּמֵי פָרִים. בְּשָׂפָה יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_22", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "לְעֵת בִּקּוּר סְפָרִים. סְתָרִים מְסַפְּרִים. לִשְׁנֵי עֳפָרִים. לְצֶדֶק יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_23", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "זֵכֶר כְּבוֹד מִשְׁכָּן. מְקוֹם דּוֹד שִׁכַּן. כְּרוּבִים בּוֹ שִׁכַּן. חֶסֶד נְעוּרִים יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_24", "fragments": [{"page_start": false, "printed_page": "131", "scan": "s282", "text": "כִּיּוֹר עִם כַּן. וְנֹעַם קוֹל דּוּכַן. כַּבִּיר בְּיוֹם מוּכַן. לַנְּבוֹנִים יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_25", "fragments": [{"page_start": true, "printed_page": "132", "scan": "s284", "text": "זֵכֶר יְלִיד נוּן. וּמִשְׁפְּטֵי אוּרִי אֶפְנוּן. יִזָּכְרוּ בְּרִנּוּן. פִּלְאָם לִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_26", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "יֶקֶשׁ בְּרַק הַשָּׁנוּן. אִם הָשְׁלַף לְתַאֲנוּן. יַקְשִׁיב תַּחֲנוּן. חֲנוּנָיו לִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_27", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זֵכֶר טַעַם שֹׁפְטִים. וְאוֹת קְצִיר חִטִּים. טֶפֶשׁ שׁוֹטִים. יְחַתֵּל מִלִּזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_28", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "טֹרַח אַרְבַּעַת שְׁפָטִים. אִם נֶעֶנְשׁוּ נִשְׁפָּטִים. טֶבַע מִשְׁפָּטִים. אֲשֶׁר שָׂם יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_29", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זֵכֶר חֲצוֹת לַיְלָה. וְתוֹדוֹת מִשְׁפְּטֵי לָיְלָה. חֹשֶׁךְ בְּאִישׁוֹן לַיְלָה. נִגּוּנוֹ לָמוֹ יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_30", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "חֵקֶר מִפְקַד לַיְלָה. יַגִּיהַּ בְּלַהַב לָיְלָה. חֹק הֶגֶה יוֹמָם וָלַיְלָה. לְגִיהָם יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_31", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זֵכֶר זֶה זְבוּל. אֲשֶׁר בְּבִצְעִי חָבוּל. זְדוֹנוֹת סָבוּל. עוֹד בַּל יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_32", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זַעַם כַּמַּבּוּל. אִם יָצְאָה לְחִבּוּל. זִכְרֹן יֶרַח בּוּל. לְחֶמְלָה יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_33", "fragments": [{"page_start": false, "printed_page": "132", "scan": "s284", "text": "זֵכֶר וְכַח"}, {"page_start": true, "printed_page": "133", "scan": "s286", "text": "כָּל פֹּעַל. בְּקַו וָפֶלֶס יַעַל. וְאִם בְּמֶרֶד וְאִם בְּמַעַל. רַב חֶסֶד יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_34", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "וְאִם טוֹב וְאִם רַע. אֲשֶׁר בּוֹ יֵאָרַע. וֶסְתּוֹ יִפָּרַע. בְּסַאסְּאָה מִלִּזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_35", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "זֵכֶר הַחַיִּים. עַד כַּמֶּה הֵם חַיִּים. הֵן לַמָּוֶת אִם לַחַיִּים. חַי חַי יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_36", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "הֲמוֹן שְׁאוֹן בְּרוּאִים. יַעַבְרוּ לְפָנָיו כִּמְרִיאִים. הֲלֹא כְּמוֹ רְאוּיִים. לְכָל אֶחָד יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_37", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "זֵכֶר דַּלּוּת וָעֹשֶׁר. בַּצֹּרֶת וָחֹשֶׁר. דּוֹפִי וְגַם יֹשֶׁר. בַּדִּין הוּא יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_38", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "דְּבַר גָּלוּי וָסֵתֶר. בִּנְיָנוֹת וְסוֹתֵר. דֵּי חָסֵר וָיֶתֶר. לְקֶצֶב יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_39", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "זֵכֶר גְּנוּנִים לְיַשֵּׁב. בַּמִּדְבָּר וְיוֹשֵׁב. גֶּשֶׁם וְרוּחַ לְנַשֵּׁב. מֵהַיּוֹם יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_40", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "גָּרוֹן לְהַקְשֵׁב. מֵעַם שְׁמוֹ חוֹשֵׁב. גָּלְיוֹת לְהָשֵׁב. בְּיוֹם תֶּקַע יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_41", "fragments": [{"page_start": false, "printed_page": "133", "scan": "s286", "text": "זֵכֶר בַּהַל וְחֵמָה. קְרָב"}, {"page_start": true, "printed_page": "134", "scan": "s288", "text": "וּמִלְחָמָה. בִּקּוּעַ חוֹמָה. לְחוֹמַת יָם יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_42", "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "בָּאָדָם וּבַבְּהֵמָה. אִם הָקְנַס מְהוּמָה. בְּצוּר קוֹל הוֹמָה. לָאֲדָמָה יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_43", "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "זֵכֶר אֱמוּנָה וָשֶׁקֶר. אוֹזֶן שִׂיחַ וָסֶקֶר. אוֹת פְּקֻדַּת בֹּקֶר. לִרְגָעִים יִזְכּוֹר:"}], "paragraph": 1, "reference_unit": "stanza"}, {"corresp": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas/stanza_44", "end_reference": true, "fragments": [{"page_start": false, "printed_page": "134", "scan": "s288", "text": "אִם לְזוֹל אִם לִיקֶר. אוֹ לָטַעַת אוֹ לְעַקֶּר. אֱנוֹשׁ בְּדִקְדּוּק וָחֵקֶר. לַמִּשְׁפָּט יִזְכֹּר:"}], "paragraph": 1, "reference_unit": "stanza", "speaker": {"abbr": "ח׳", "expan": "חזן"}, "speaker_before_reference": true}]}, "review_encoding": true, "source_notes": {"en": [{"text": "The English rendering of strophe 28 repeats the destructive-sword phrase used in 26; the Hebrew reads differently. The printed translation is retained. The source splits the word remembers across the page boundary between scans 285 and 287."}]}, "stem": "musaf_zekher_techillat_kol_maas", "title": {"en": "The memory of the beginning of all action", "he": "זכר תחלת כל מעש"}, "urn": "urn:x-opensiddur:text:poem:zekher_techillat_kol_maas"}, "variants": []}
