    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "status": "context",
      "note": "A grouping only. The Kaddish's paragraphs are addressed one at a time because the congregation answers between them."
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/al_yisrael",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "עַל יִשְׂרָאֵל וְעַל רַבָּנָן",
      "label_en": "We pray for Israel and for our teachers"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/oseh_shalom",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו",
      "label_en": "He who creates peace in his celestial heights"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/yehe_shelama",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "יְהֵא שְׁלָמָא רַבָּא",
      "label_en": "May there be abundant peace from heaven"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/yehe_shemeh",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ",
      "label_en": "May his great name be blessed"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/yitbarakh",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "יִתְבָּרַךְ וְיִשְׁתַּבַּח",
      "label_en": "Blessed and praised, glorified and exalted"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/derabbanan/yitgaddal",
      "status": "canonical",
      "parent": "urn:x-opensiddur:text:prayer:kaddish/derabbanan",
      "label_he": "יִתְגַּדַּל וְיִתְקַדַּשׁ",
      "label_en": "Glorified and sanctified be God's great name"
    },
    {
      "urn": "urn:x-opensiddur:text:prayer:kaddish/yatom",
      "status": "canonical",
      "label_he": "קַדִּישׁ יָתוֹם",
      "label_en": "Mourners’ Kaddish",
      "parent": "urn:x-opensiddur:text:prayer:kaddish"
    },
    {
