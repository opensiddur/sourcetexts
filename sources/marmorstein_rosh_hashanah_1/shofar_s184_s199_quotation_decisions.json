  },
  {
    "stem": "torah_return_psalm_24",
    "language": "he",
    "printed_quote": "מִי הוּא־זֶה מֶלֶךְ הַכָּבוֹד יְהוָה צְבָאוֹת הוּא מֶלֶךְ הַכָּבוֹד סֶלָה:",
