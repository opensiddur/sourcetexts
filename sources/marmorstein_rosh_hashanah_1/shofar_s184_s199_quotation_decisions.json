    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/13"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "The Lord supports all that fall and straightens all that are bent.",
