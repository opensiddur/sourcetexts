    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_144/15"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Hymn by David. I exalt Thee, my God and King, and bless Thy Name for ever and ever.",
