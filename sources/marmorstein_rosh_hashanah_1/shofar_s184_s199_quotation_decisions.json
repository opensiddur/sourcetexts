  },
  {
    "stem": "torah_return_psalm_24",
    "language": "he",
    "printed_quote": "לְדָוִד מִזְמוֹר. לַיהוָה הָאָרֶץ וּמְלוֹאָהּ תֵּבֵל וְיֹשְׁבֵי בָהּ:",
