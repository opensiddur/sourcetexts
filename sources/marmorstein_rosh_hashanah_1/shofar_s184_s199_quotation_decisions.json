    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/16"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Righteous is the Lord in all His ways and pious in all His deeds.",
