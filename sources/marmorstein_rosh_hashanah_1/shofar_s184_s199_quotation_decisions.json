  },
  {
    "stem": "torah_ashrei",
    "language": "he",
    "printed_quote": "וַאֲנַחְנוּ נְבָרֵךְ יָהּ מֵעַתָּה וְעַד־עוֹלָם הַלְלוּיָהּ:",
