    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/15"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Thou openest Thy hands and satisfiest all the living in favour.",
