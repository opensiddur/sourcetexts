    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_84/5"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Fortunate the people to whom this happens, fortunate the people whose God is the Lord.",
