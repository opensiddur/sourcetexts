    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_115/18"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Fortunate are they that dwell in Thine House, they will still praise Thee, Selah.",
