  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "All Thy works acknowledge Thee, O Lord, and Thy pious ones bless Thee.",
    "source": "urn:x-opensiddur:text:bible:psalms/145/10",
    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/10"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "They speak of the glory of Thy dominion and tell of Thy might",
