    "local_verse": "urn:x-opensiddur:text:siddur:rosh_hashanah/torah/ashrei/psalms_145/1"
  },
  {
    "stem": "torah_ashrei",
    "language": "en",
    "printed_quote": "Every day do I bless Thee and praise Thy Name for ever and ever.",
