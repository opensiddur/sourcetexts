          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "טֶרֶף נָתַן לִירֵאָיו מַמְלִיךְ כָּל־מֶלֶךְ.",
                "page_start": false
              }
