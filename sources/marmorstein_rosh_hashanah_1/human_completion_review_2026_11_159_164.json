            "paragraph": 5,
            "fragments": [
              {
                "scan": "s108",
                "printed_page": "40",
                "text": "פְּדֵם הַיּוֹם מִדִּין גָּמוּר מִלְּחַיְּבֵם מֶלֶךְ.",
                "page_start": false
