              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "דּוֹק וָחֶלֶד יֶחֶרְדוּן מֵאֵימַת מֶלֶךְ:",
                "page_start": false
