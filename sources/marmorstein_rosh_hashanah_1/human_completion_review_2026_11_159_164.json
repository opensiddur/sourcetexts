          },
          {
            "paragraph": 2,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "יִזְכּוֹר לְעוֹלָם בְּרִיתוֹ בְּזִכְרוֹן טוֹב מֶלֶךְ:",
                "page_start": false
