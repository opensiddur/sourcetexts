  "before": {
    "yotzer_hakol_yodukha": {
      "stem": "yotzer_hakol_yodukha",
      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/hakol_yodukha",
      "title": {
        "he": "הַכֹּל יוֹדוּךָ",
        "en": "All thank Thee"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "הַכֹּל יוֹדוּךָ וְהַכֹּל יְשַׁבְּחוּךָ. וְהַכֹּל יֹאמְרוּ אֵין קָדוֹשׁ כַּייָ: הַכֹּל יְרוֹמְמוּךָ סֶּֽלָה יוֹצֵר הַכֹּל. הָאֵל הַפּוֹתֵחַ בְּכָל־יוֹם דַּלְתוֹת שַׁעֲרֵי מִזְרָח: וּבוֹקֵעַ חַלּוֹנֵי רָקִיעַ. מוֹצִיא חַמָּה מִמְּקוֹמָהּ וּלְבָנָה מִמְּכוֹן שִׁבְתָּהּ: וּמֵאִיר לָעוֹלָם כֻּלּוֹ וּלְיוֹשְׁבָיו. שֶׁבָּרָא בְּמִדַּת רַחֲמִים: הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית: הַמֶּלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶֽיךָ הָרַבִּים רַחֵם עָלֵֽינוּ. אֲדוֹן עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵֽנוּ מִשְׂגָּב בַּעֲדֵֽנוּ: אֵין כְּעֶרְכֶּךָ וְאֵין זוּלָתֶךָ. אֶפֶס בִּלְתֶּךָ וּמִי דוֹמֶה־לָּךְ: אֵין כְּעֶרְכֶּךָ יְיָ אֱלֹהֵינוּ בָּעוֹלָם הַזֶּה. וְאֵין זוּלָתְךָ מַלְכֵּנוּ לְחַיֵּי הָעוֹלָם הַבָּא: אֶפֶס בִּלְתְּךָ גּוֹאֲלֵנוּ לִימוֹת הַמָּשִׁיחַ. וְאֵין דּוֹמֶה־לְךָ מוֹשִׁיעֵנוּ לִתְחִיַּת הַמֵּתִים:",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "All thank Thee, all praise Thee, all say: None is holy like the Lord. All exalt Thee, Selah, Creator of all, God who opens daily the portals of the Eastern gates and throws open windows of the firmament, brings forth the sun from its place and the moon from the site of its dwelling. He illuminates the whole world and its inhabitants whom He created through the attribute of mercy. He illuminates the earth and those who dwell on it with mercy, and in His goodness renews daily and constantly the work of creation. O King, who alone is exalted from of old, extolled and praised and glorified since days of antiquity. O God of eternity, in Thy great mercy have mercy upon us, Lord of our might, Rock of our fortress, shield of our salvation, a fortress around us. None can be compared with Thee, there is none except Thee, none beside Thee, and who resembles Thee? None can be compared with Thee, O Lord our God, in this world and there is none except Thee, our King, in the life of the future world. There will be nought besides Thee, our Redeemer, in the days of the anointed one and none resembles Thee, our Helper, at the revival of the dead.",
                "page_start": false
              }
            ]
          }
        ]
      },
