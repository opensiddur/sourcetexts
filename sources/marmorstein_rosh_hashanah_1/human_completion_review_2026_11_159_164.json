    "yotzer_et_shem": {
      "stem": "yotzer_et_shem",
      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/et_shem",
      "title": {
        "he": "אֶת־שֵׁם הָאֵל",
        "en": "The Name of God"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "אֶת־שֵׁם הָאֵל הַמֶּלֶךְ הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא קָדוֹשׁ הוּא:",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s106",
                "printed_page": "39",
                "text": "וְכֻלָּם מְקַבְּלִים עֲלֵיהֶם עֹל מַלְכוּת שָׁמַיִם זֶה מִזֶּה. וְנוֹתְנִים רְשׁוּת זֶה לָזֶה. לְהַקְדִּישׁ לְיוֹצְרָם בְּנַחַת רוּחַ בְּשָׂפָה בְרוּרָה וּבִנְעִימָה קְדֻשָּׁה כֻּלָּם כְּאֶחָד עוֹנִים וְאוֹמְרִים בְּיִרְאָה.",
                "page_start": false
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s107",
                "printed_page": "39",
                "text": "the Name of God, the great, mighty and awe-inspiring King, holy is He.",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s107",
                "printed_page": "39",
                "text": "And all accept upon themselves the yoke of the Kingdom of Heaven, one from the other, and grant each other permission to sanctify their Creator in tranquillity of spirit with pure speech and pleasantness, they all chime the sanctification together and say in fear:",
                "page_start": false
              }
            ]
          }
        ]
      }
    },
