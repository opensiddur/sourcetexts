    "misod_chakhamim": {
      "stem": "misod_chakhamim",
      "urn": "urn:x-opensiddur:text:prayer:misod_chakhamim",
      "title": {
        "he": "מִסּוֹד חֲכָמִים",
        "en": "מִסּוֹד חֲכָמִים"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s124",
                "printed_page": "48",
                "text": "מִסּוֹד חֲכָמִים וּנְבוֹנִים. וּמִלֶּמֶד דַּעַת מְבִינִים. אֶפְתְּחָה פִי בִּתְפִלָּה וּבְתַחֲנוּנִים. לְחַלּוֹת וּלְחַנֵּן ",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:misod_chakhamim/text"
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s124",
                "printed_page": "48",
                "text": "פְּנֵי מֶלֶךְ מַלְכֵי הַמְּלָכִים וַאֲדוֹנֵי הָאֲדוֹנִים",
                "page_start": true
              }
            ],
            "anchor": "misod_variant"
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s125",
                "printed_page": "48",
                "text": "Choosing from the counsel of wise and discerning men and from the teaching of those that understand knowledge, I open my mouth in prayer and supplication to entreat and implore the countenance of the King of Kings and the Lord of Lords.",
                "page_start": true
              }
            ],
            "corresp": "urn:x-opensiddur:text:prayer:misod_chakhamim/text"
          }
        ]
      },
      "citations": {
