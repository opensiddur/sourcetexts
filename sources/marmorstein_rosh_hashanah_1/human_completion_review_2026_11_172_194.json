      "urn": "urn:x-opensiddur:text:prayer:yotzer_or/hameir",
      "title": {
        "he": "הַמֵּאִיר",
        "en": "He who lights the earth"
      },
      "languages": {
        "he": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶֽיהָ בְּרַחֲמִים. וּבְטוּבוֹ מְחַדֵּשׁ בְּכָל־יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית: ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "מָה רַבּוּ מַעֲשֶׂיךָ יְיָ. כֻּלָּם בְּחָכְמָה עָשִׂיתָ. מָלְאָה הָאָרֶץ קִנְיָנֶךָ: ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
            "source": "urn:x-opensiddur:text:bible:psalms/104/24",
            "reference_unit": "verse",
            "end_reference": true
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "הַמֶּלֶךְ הַמְרוֹמָם לְבַדּוֹ מֵאָז. הַמְשֻׁבָּח וְהַמְפֹאָר וְהַמִּתְנַשֵּׂא מִימוֹת עוֹלָם: אֱלֹהֵי עוֹלָם בְּרַחֲמֶֽיךָ הָרַבִּים רַחֵם עָלֵֽינוּ.",
                "page_start": false
              },
              {
                "scan": "s102",
                "printed_page": "37",
                "text": "אֲדוֹן",
                "page_start": false
              },
              {
                "scan": "s104",
                "printed_page": "38",
                "text": "עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ. מָגֵן יִשְׁעֵֽנוּ מִשְׂגָּב בַּעֲדֵֽנוּ:",
                "page_start": true
              }
            ]
          }
        ],
        "en": [
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "He who lights the earth and those who dwell on it, with mercy and daily in His goodness constantly renews the work of creation. ",
                "page_start": false
              }
            ]
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "How numerous are Thy works, O Lord, all of them hast Thou made with wisdom, the earth is full of Thy possessions. ",
                "page_start": false
              }
            ],
            "corresp": "urn:x-opensiddur:text:bible:psalms/104/24",
            "source": "urn:x-opensiddur:text:bible:psalms/104/24",
            "reference_unit": "verse",
            "end_reference": true
          },
          {
            "paragraph": 1,
            "fragments": [
              {
                "scan": "s103",
                "printed_page": "37",
                "text": "O King, who alone is exalted from of old, extolled and praised and glorified since days of antiquity. O God of eternity, in Thy great mercy have mercy upon us,",
                "page_start": false
              },
              {
                "scan": "s105",
                "printed_page": "38",
                "text": "Lord of our might, Rock of our fortress, shield of our salvation, a fortress around us.",
                "page_start": true
              }
            ]
          }
        ]
      },
