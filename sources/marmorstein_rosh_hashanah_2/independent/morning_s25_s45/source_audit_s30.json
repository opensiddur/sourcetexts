    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "text": "וְעִם־רוּחִי גְּוִיָּתִי. יְיָ לִי וְלֹא אִירָא:",
