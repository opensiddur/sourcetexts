      "unit": "morning_entrance_verses",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶֽךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:"
    },
    {
      "unit": "morning_entrance_verses",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "בְּבֵית אֱלֹהִים נְהַלֵּךְ בְּרָֽגֶשׁ:"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "מַה־טֹּֽבוּ אֹהָלֶֽיךָ יַעֲקֹב מִשְׁכְּנֹתֶֽיךָ יִשְׂרָאֵל:"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶֽךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "יְיָ אָהַֽבְתִּי מְעוֹן בֵּיתֶֽךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶֽךָ:"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה אֶבְרְכָה לִפְנֵי־יְיָ עֹשִׂי:"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "וַאֲנִי תְפִלָּתִי־לְךָ יְיָ עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּֽךָ עֲנֵֽנִי בֶּאֱמֶת יִשְׁעֶֽךָ:"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "שַֽׁחַר אֲבַקֶּשְׁךָ. צוּרִי וּמִשְׂגַּבִּי. אֶעְרוֹךְ לְפָנֶֽיךָ. שַׁחְרִי וְגַם־עַרְבִּי:"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "לִפְנֵי גְדֻלָּתְךָ. אֶעְמֹד וְאֶבָּהֵל. כִּי־עֵינְךָ תִרְאֶה. כָּל־מַחְשְׁבוֹת לִבִּי:"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "מַה־זֶּה אֲשֶׁר יוּכַל. הַלֵּב וְהַלָּשׁוֹן לַעֲשׂוֹת, וּמַה־כֹּחִי. רוּחִי בְּתוֹךְ קִרְבִּי:"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "הִנֵּה לְךָ תִיטַב. זִמְרַת אֱנוֹשׁ, עַל־כֵּן אוֹדְךָ בְּעוֹד תִּהְיֶה. נִשְׁמַת אֱלוֹהַּ בִּי:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "אֲנִי קְרָאתִֽיךָ כִּי־תַעֲנֵֽנִי אֵל הַט־אָזְנְךָ לִי שְׁמַע אִמְרָתִי:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "אֲנִי בְּצֶֽדֶק אֶחֱזֶה פָנֶֽיךָ אֶשְׂבְּעָה בְהָקִיץ תְּמוּנָתֶֽךָ:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "וַאֲנִי עָלֶֽיךָ בָטַֽחְתִּי יְיָ אָמַֽרְתִּי אֱלֹהַי אָֽתָּה:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "שְׁמַע קוֹל תַּחֲנוּנַי בְּשַׁוְּעִי אֵלֶֽיךָ בְּנָשְׂאִי יָדַי אֶל־דְּבִיר קָדְשֶֽׁךָ:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "יְיָ אֱלֹהָי שִׁוַּֽעְתִּי אֵלֶֽיךָ וַתִּרְפָּאֵֽנִי:"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
