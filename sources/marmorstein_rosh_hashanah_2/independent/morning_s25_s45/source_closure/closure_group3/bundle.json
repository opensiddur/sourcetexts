        {
          "unit": "qorbanot_kiyyor",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וַיְדַבֵּר יְהֹוָה אֶל־מֹשֶׁה לֵּאמֹר:",
          "page_start": true
        },
        {
          "unit": "qorbanot_kiyyor",
          "language": "he",
          "paragraph_index": 1,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וְעָשִׂיתָ כִּיּוֹר נְחֹֽשֶׁת וְכַנּוֹ נְחֹֽשֶׁת לְרָחְצָה וְנָתַתָּ אֹתוֹ בֵּין־אֹֽהֶל מוֹעֵד וּבֵין הַמִּזְבֵּֽחַ וְנָתַתָּ שָֽׁמָּה מָיִם:",
          "page_start": false
        },
        {
          "unit": "qorbanot_kiyyor",
          "language": "he",
          "paragraph_index": 2,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וְרָחֲצוּ אַהֲרֹן וּבָנָיו מִמֶּֽנּוּ אֶת־יְדֵיהֶם וְאֶת־רַגְלֵיהֶם:",
          "page_start": false
        },
        {
          "unit": "qorbanot_kiyyor",
          "language": "he",
          "paragraph_index": 3,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "בְּבֹאָם אֶל־אֹֽהֶל מוֹעֵד יִרְחֲצוּ־מַיִם וְלֹא יָמֻֽתוּ אוֹ בְגִשְׁתָּם אֶל־הַמִּזְבֵּֽחַ לְשָׁרֵת לְהַקְטִיר אִשֶּׁה לַיהֹוָה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_kiyyor",
          "language": "he",
          "paragraph_index": 4,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וְרָחֲצוּ יְדֵיהֶם וְרַגְלֵיהֶם וְלֹא יָמֻֽתוּ וְהָיְתָה לָהֶם חָק־עוֹלָם לוֹ וּלְזַרְעוֹ לְדֹרֹתָם:",
          "page_start": false
        },
        {
          "unit": "leviticus_6_3_to_4",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וְלָבַשׁ הַכֹּהֵן מִדּוֹ בַד וּמִכְנְסֵי־בַד יִלְבַּשׁ עַל־בְּשָׂרוֹ וְהֵרִים אֶת־הַדֶּֽשֶׁן אֲשֶׁר תֹּאכַל הָאֵשׁ אֶת־הָעֹלָה עַל־הַמִּזְבֵּֽחַ וְשָׂמוֹ אֵֽצֶל הַמִּזְבֵּֽחַ:",
          "page_start": false
        },
        {
          "unit": "leviticus_6_3_to_4",
          "language": "he",
          "paragraph_index": 1,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וּפָשַׁט אֶת־בְּגָדָיו וְלָבַשׁ בְּגָדִים אֲחֵרִים וְהוֹצִיא אֶת־הַדֶּֽשֶׁן אֶל־מִחוּץ לַמַּחֲנֶה אֶל־מָקוֹם טָהוֹר:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וַיְדַבֵּ֥ר יְהֹוָ֖ה אֶל־מֹשֶׁ֥ה לֵּאמֹֽר:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 1,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "צַ֚ו אֶת־בְּנֵ֣י יִשְׂרָאֵ֔ל וְאָמַרְתָּ֖ אֲלֵהֶ֑ם אֶת־קָרְבָּנִ֨י לַחְמִ֜י לְאִשַּׁ֗י רֵ֚יחַ נִֽיחֹחִ֔י תִּשְׁמְר֕וּ לְהַקְרִ֥יב לִ֖י בְּמוֹעֲדֽוֹ:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 2,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "וְאָמַרְתָּ֣ לָהֶ֔ם זֶ֚ה הָֽאִשֶּׁ֔ה אֲשֶׁ֥ר תַּקְרִ֖יבוּ לַֽיהֹוָ֑ה כְּבָשִׂ֨ים בְּנֵֽי־שָׁנָ֧ה תְמִימִ֛ם שְׁנַ֥יִם לַיּ֖וֹם עֹלָ֥ה תָמִֽיד:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 3,
          "fragment_index": 0,
          "scan": "s40",
          "printed_page": "9",
          "text": "אֶת־הַכֶּ֥בֶשׂ אֶחָ֖ד",
