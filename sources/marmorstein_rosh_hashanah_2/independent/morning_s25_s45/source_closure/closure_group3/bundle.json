        {
          "unit": "middot",
          "language": "he",
          "paragraph_index": 12,
          "fragment_index": 0,
          "scan": "s45",
          "printed_page": "14",
          "text": "דָּבָר הַלָּמֵד מֵעִנְיָנוֹ. וְדָבָר הַלָּמֵד מִסּוֹפוֹ.",
