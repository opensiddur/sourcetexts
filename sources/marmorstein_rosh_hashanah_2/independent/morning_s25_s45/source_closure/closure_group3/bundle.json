        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 3,
          "fragment_index": 1,
          "scan": "s41",
          "printed_page": "10",
          "text": "תַּֽעֲשֶׂ֣ה בַבֹּ֑קֶר וְאֵת֙ הַכֶּ֣בֶשׂ הַשֵּׁנִ֔י תַּֽעֲשֶׂ֖ה בֵּ֥ין הָֽעַרְבָּֽיִם:",
          "page_start": true
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 4,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וַֽעֲשִׂירִ֧ית הָֽאֵיפָ֛ה סֹ֖לֶת לְמִנְחָ֑ה בְּלוּלָ֛ה בְּשֶׁ֥מֶן כָּתִ֖ית רְבִיעִ֥ת הַהִֽין:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 5,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "עֹלַ֖ת תָּמִ֑יד הָֽעֲשֻׂיָה֙ בְּהַ֣ר סִינַ֔י לְרֵ֣יחַ נִיחֹ֔חַ אִשֶּׁ֖ה לַֽיהוָֽה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 6,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְנִסְכּוֹ֙ רְבִיעִ֣ת הַהִ֔ין לַכֶּ֖בֶשׂ הָֽאֶחָ֑ד בַּקֹּ֗דֶשׁ הַסֵּ֛ךְ נֶ֥סֶךְ שֵׁכָ֖ר לַֽיהוָֽה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_tamid",
          "language": "he",
          "paragraph_index": 7,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְאֵת֙ הַכֶּ֣בֶשׂ הַשֵּׁנִ֔י תַּֽעֲשֶׂ֖ה בֵּ֣ין הָֽעַרְבָּ֑יִם כְּמִנְחַ֨ת הַבֹּ֤קֶר וּכְנִסְכּוֹ֙ תַּעֲשֶׂ֔ה אִשֵּׁ֛ה רֵ֥יחַ נִיחֹ֖חַ לַֽיהוָֽה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_veshachat",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְשָׁחַ֨ט אֹת֜וֹ עַ֣ל יֶ֧רֶךְ הַמִּזְבֵּ֛חַ צָפֹ֖נָה לִפְנֵ֣י יְהוָ֑ה וְזָֽרְק֡וּ בְּנֵי֩ אַֽהֲרֹ֨ן הַכֹּֽהֲנִ֧ים אֶת־דָּמ֛וֹ עַל־הַמִּזְבֵּ֖חַ סָבִֽיב:",
          "page_start": false
        },
        {
          "unit": "qorbanot_attah_hu",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "אַתָּה הוּא יְיָ אֱלֹהֵֽינוּ שֶׁהִקְטִֽירוּ אֲבוֹתֵֽינוּ לְפָנֶֽיךָ אֶת־קְטֹֽרֶת הַסַּמִּים בִּזְמַן שֶׁבֵּית הַמִּקְדָּשׁ קַיָּם. כַּאֲשֶׁר צִוִּֽיתָ אוֹתָם עַל יְדֵי מֹשֶׁה נְבִיאֶֽךָ כַּכָּתוּב בְּתוֹרָתֶֽךָ.",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 0,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וַיֹּֽאמֶר יְהוָה אֶל־מֹשֶׁה קַח־לְךָ סַמִּים נָטָף וּשְׁחֵֽלֶת וְחֶלְבְּנָה סַמִּים וּלְבֹנָה זַכָּה בַּד בְּבַד יִהְיֶה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 1,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְעָשִֽׂיתָ אֹתָהּ קְטֹֽרֶת רֹֽקַח מַעֲשֵׂה רוֹקֵחַ מְמֻלָּח טָהוֹר קֹֽדֶשׁ:",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 2,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְשָׁחַֽקְתָּ מִמֶּנָּה הָדֵק וְנָתַתָּה מִמֶּנָּה לִפְנֵי הָעֵדֻת בְּאֹֽהֶל מוֹעֵד אֲשֶׁר אִוָּעֵד לְךָ שָׁמָּה קֹֽדֶשׁ קָדָשִׁים תִּהְיֶה לָכֶם:",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 3,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְנֶאֱמַר",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 4,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וְהִקְטִיר עָלָיו אַהֲרֹן קְטֹֽרֶת סַמִּים בַּבֹּֽקֶר בַּבֹּֽקֶר בְּהֵיטִיבוֹ אֶת־הַנֵּרֹת יַקְטִירֶֽנָּה:",
          "page_start": false
        },
        {
          "unit": "qorbanot_qetoret",
          "language": "he",
          "paragraph_index": 5,
          "fragment_index": 0,
          "scan": "s41",
          "printed_page": "10",
          "text": "וּבְהַעֲלֹת אַהֲרֹן אֶת־הַנֵּרֹת בֵּין הָעַרְבַּֽיִם יַקְטִירֶֽנָּה קְטֹֽרֶת תָּמִיד לִפְנֵי יְהוָה לְדֹרֹתֵיכֶם:",
          "page_start": false
        }
