      "paragraph_index": 8,
      "fragment_index": 1,
      "scan": "s28",
      "printed_page": "3",
      "text": "תְפִלָּתִי יְיָ וְשַׁוְעָתִי הַאֲזִֽינָה אֶל־דִּמְעָתִי אַל־תֶּחֱרָשׁ:",
      "page_start": true
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "שְׁמַע־יְיָ וְחָנֵּֽנִי יְיָ הֱיֵה עֹזֵר לִי:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 10,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "שִׁיר הַמַּעֲלוֹת לְדָוִד שָׂמַֽחְתִּי בְּאֹמְרִים לִי בֵּית יְיָ נֵלֵךְ:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 11,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "שָׂשׂ אָנֹֽכִי עַל־אִמְרָתֶֽךָ כְּמוֹצֵא שָׁלָל רָב:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 12,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "הַקְשִֽׁיבָה לְקוֹל שַׁוְעִי מַלְכִּי וֵאלֹהָי כִּי־אֵלֶֽיךָ אֶתְפַּלָּל:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 13,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "יְיָ בֹּֽקֶר תִּשְׁמַע קוֹלִי בֹּֽקֶר אֶעֱרָךְ־לְךָ וַאֲצַפֶּה:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 14,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "אֲנִי קְרָאתִֽיךָ כִּי־תַעֲנֵֽנִי אֵל הַט־אָזְנְךָ לִי שְׁמַע אִמְרָתִי:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 15,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "רַגְלִי עָמְדָה בְמִישׁוֹר בְּמַקְהֵלִים אֲבָרֵךְ יְיָ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "יִגְדַּל אֱלֹהִים חַי וְיִשְׁתַּבַּח נִמְצָא וְאֵין עֵת אֶל־מְצִיאוּתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "אֶחָד וְאֵין יָחִיד כְּיִחוּדוֹ נֶעְלָם וְגַם אֵין סוֹף לְאַחְדּוּתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "אֵין לוֹ דְּמוּת הַגּוּף וְאֵינוֹ גוּף לֹא נַעֲרוֹךְ אֵלָיו קְדֻשָּׁתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "קַדְמוֹן לְכָל־דָּבָר אֲשֶׁר נִבְרָא רִאשׁוֹן וְאֵין רֵאשִׁית לְרֵאשִׁיתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "הִנּוֹ אֲדוֹן עוֹלָם וְכָל־נוֹצָר יוֹרֶה גְדֻלָּתוֹ וּמַלְכוּתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "שֶֽׁפַע נְבוּאָתוֹ נְתָנוֹ אֶל־אַנְשֵׁי סְגֻלָּתוֹ וְתִפְאַרְתּוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "לֹא קָם בְּיִשְׂרָאֵל כְּמֹשֶׁה עוֹד נָבִיא וּמַבִּיט אֶת־תְּמוּנָתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "תּוֹרַת אֱמֶת נָתַן לְעַמּוֹ אֵל עַל־יַד נְבִיאוֹ נֶאֱמַן בֵּיתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "לֹא יַחֲלִיף הָאֵל וְלֹא יָמִיר דָּתוֹ לְעוֹלָמִים לְזוּלָתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "צוֹפֶה וְיוֹדֵֽעַ סְתָרֵֽינוּ מַבִּיט לְסוֹף דָּבָר בְּקַדְמָתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 10,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "גּוֹמֵל לְאִישׁ חֶֽסֶד כְּמִפְעָלוֹ נוֹתֵן לְרָשָׁע רַע כְּרִשְׁעָתוֹ:",
      "page_start": false
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 11,
      "fragment_index": 0,
      "scan": "s28",
      "printed_page": "3",
      "text": "יִשְׁלַח לְקֵץ יָמִין מְשִׁיחֵֽנוּ לִפְדּוֹת מְחַכֵּי קֵץ יְשׁוּעָתוֹ:",
      "page_start": false
    },
    {
