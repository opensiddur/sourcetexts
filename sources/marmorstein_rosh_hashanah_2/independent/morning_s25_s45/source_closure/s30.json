  "prayer_fragments": [
    {
      "unit": "birkhot_hatorah_laasoq",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֹתָיו וְצִוָּֽנוּ לַעֲשׂוֹק בְּדִבְרֵי תוֹרָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ. בְּטֶֽרֶם כָּל־יְצִיר נִבְרָא:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "לְעֵת נַעֲשָׂה בְחֶפְצוֹ כֹּל. אֲזַי מֶֽלֶךְ שְׁמוֹ נִקְרָא:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְאַחֲרֵי כִּכְלוֹת הַכֹּל. לְבַדּוֹ יִמְלוֹךְ נוֹרָא:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְהוּא הָיָה וְהוּא הֹוֶה. וְהוּא יִהְיֶה בְּתִפְאָרָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְהוּא אֶחָד וְאֵין שֵׁנִי לְהַמְשִׁיל לוֹ לְהַחְבִּֽירָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "בְּלִי רֵאשִׁית בְּלִי תַכְלִית. וְלוֹ הָעֹז וְהַמִּשְׂרָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְהוּא אֵלִי וְחַי גֹּאֲלִי. וְצוּר חֶבְלִי בְּעֵת צָרָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְהוּא נִסִּי וּמָנוֹס לִי. מְנָת כּוֹסִי בְּיוֹם אֶקְרָא:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "בְּיָדוֹ אַפְקִיד רוּחִי. בְּעֵת אִישַׁן וְאָעִֽירָה:",
      "page_start": false
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "וְעִם־רוּחִי גְּוִיָּתִי. יְיָ לִי וְלֹא אִירָא:",
      "page_start": false
    },
    {
      "unit": "al_netilat_yadayim",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּֽנוּ עַל נְטִילַת יָדָֽיִם:",
      "page_start": false
    },
    {
      "unit": "asher_yatzar",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s30",
      "printed_page": "4",
      "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם אֲשֶׁר יָצַר אֶת־הָאָדָם בְּחָכְמָה וּבָרָא בוֹ נְקָבִים נְקָבִים חֲלוּלִים חֲלוּלִים. גָּלוּי וְיָֽדוּעַ לִפְנֵי כִסֵּא כְבוֹדֶֽךָ שֶׁאִם יִפָּתֵֽחַ אֶחָד מֵהֶם אוֹ יִסָּתֵם אֶחָד מֵהֶם אִי אֶפְשַׁר לְהִתְקַיַּם וְלַעֲמוֹד לְפָנֶֽיךָ. בָּרוּךְ אַתָּה יְיָ רוֹפֵא כָל־בָשָׂר וּמַפְלִיא לַעֲשׂוֹת:",
      "page_start": false
    }
  ],
