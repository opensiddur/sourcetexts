{
  "scan_page": 42,
  "prayer_fragments": [
    {
      "unit": "qorbanot_pittum",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "תנו רבנן פטום הקטרת, הצרי והצפורן החלבנה והלבונה משקל שבעים שבעים מנה, מור וקציעה שבולת נרד וכרכום משקל ששה עשר ששה עשר מנה, הקושט שנים עשר, וקלופה שלשה, וקנמון תשעה, בורית כרשינה תשעה קבין, יין קפריסין סאין תלתא וקבין תלתא, ואם אין לו יין קפריסין, מביא חמר חורין עתיק, מלח סדומית רובע הקב, מעלה עשן כל שהוא, רבי נתן אומר אף כפת הירדן כל שהוא, ואם נתן בה דבש פסלה ואם חסר אחת מכל סמניה חייב מיתה:",
      "page_start": true
    },
    {
      "unit": "qorbanot_rashbag",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "רבן שמעון בן גמליאל אומר, הצרי אינו אלא שרף הנוטף מעצי הקטף. בורית כרשינה ששפין בה את הצפורן, כדי שתהא נאה. יין קפריסין ששורין בו את הצפורן, כדי שתהא עזה. והלא מי רגלים יפין לה, אלא שאין מכניסין מי רגלים בעזרה מפני הכבוד:",
      "page_start": false
    },
    {
      "unit": "qorbanot_rabbi_natan",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "תניא רבי נתן אומר כשהוא שוחק אומר הדק היטיב היטיב הדק מפני שהקול יפה לבשמים. פטמה לחצאין כשרה, לשליש ולרביע לא שמענו. אמר רבי יהודה זה הכלל, אם כמדתה כשרה לחצאין, ואם חסר אחת מכל סמניה חייב מיתה:",
      "page_start": false
    },
    {
      "unit": "qorbanot_bar_kappara",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "תני בר קפרא אחת לששים או לשבעים שנה היתה באה של שירים לחצאין. עוד תני בר קפרא, אלו היה נותן בה קורטוב של דבש אין אדם יכול לעמוד מפני ריחה. ולמה אין מערבין בה דבש, מפני שהתורה אמרה",
      "page_start": false
    },
    {
      "unit": "qorbanot_bar_kappara",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "כי כל שאור וכל דבש לא תקטירו ממנו אשה ליי:",
      "page_start": false
    },
    {
      "unit": "qorbanot_pesuqim",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "יְיָ צְבָאוֹת עִמָּֽנוּ מִשְׂגָּב לָֽנוּ אֱלֹהֵי יַעֲקֹב סֶֽלָה:",
      "page_start": false
    },
    {
      "unit": "qorbanot_pesuqim",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בּוֹטֵחַ בָּךְ:",
      "page_start": false
    },
    {
      "unit": "qorbanot_pesuqim",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵֽנוּ בְיוֹם קָרְאֵֽנוּ:",
      "page_start": false
    },
    {
      "unit": "qorbanot_attah_seter",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "אַתָּה סֵתֶר לִי מִצַּר תִּצְּרֵֽנִי רָנֵּי פַלֵּט תְּסוֹבְבֵֽנִי סֶֽלָה:",
      "page_start": false
    },
    {
      "unit": "qorbanot_vearvah",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "וְעָרְבָה לַייָ מִנְחַת יְהוּדָה וִירוּשָׁלָֽיִם כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת:",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "אָנָּא בְּכֹחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "קַבֵּל רִנַּת עַמְּךָ שַׂגְּבֵֽנוּ טַהֲרֵֽנוּ נוֹרָא.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "נָא גִבּוֹר דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "בָּרְכֵם טַהֲרֵם רַחֲמֵם צִדְקָתְךָ תָּמִיד גָּמְלֵם.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "חֲסִין קָדוֹשׁ בְּרֹב טוּבְךָ נַהֵל עֲדָתֶֽךָ.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "יָחִיד גֵּאֶה לְעַמְּךָ פְנֵה זוֹכְרֵי קְדֻשָּׁתֶֽךָ.",
      "page_start": false
    },
    {
      "unit": "anna_bekhoach",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "שַׁוְעָתֵֽנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵֽנוּ יוֹדֵֽעַ תַּעֲלֻמוֹת.",
      "page_start": false
    },
    {
      "unit": "qorbanot_barukh_shem",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s42",
      "printed_page": "11",
      "text": "בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:",
      "page_start": false
    }
  ],
