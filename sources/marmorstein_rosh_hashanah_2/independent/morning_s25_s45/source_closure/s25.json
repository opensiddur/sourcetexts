      ],
      "page_start": true,
      "type": "heading"
    },
    {
      "key": "morning_tallit_before",
      "scan": "s25",
      "printed_page": "1",
      "text": "Before draping oneself in the טלית the following is said:",
      "language": "en",
      "witnesses": [
        "he"
      ],
      "page_start": false,
      "type": "description"
    },
    {
      "key": "morning_tallit_standing",
      "scan": "s25",
      "printed_page": "1",
      "text": "Then this ברכה is recited while standing:",
      "language": "en",
      "witnesses": [
        "he"
      ],
      "page_start": false,
      "type": "description"
    },
    {
      "key": "morning_tallit_draping",
      "scan": "s25",
      "printed_page": "1",
      "text": "One then drapes oneself in the טלית and says:",
      "language": "en",
      "witnesses": [
        "he"
      ],
      "page_start": false
    },
    {
      "key": "morning_tallit_after",
      "scan": "s25",
      "printed_page": "1",
      "text": "One then removes the טלית from the face and drapes oneself in such a way that there should be one ציצת in front and one behind on each side.",
      "language": "en",
      "witnesses": [
        "he"
      ],
      "page_start": false
    }
  ],
