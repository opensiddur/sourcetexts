      "scan": "s26",
      "printed_page": "2",
      "text": "וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶֽךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:",
      "page_start": false
    },
    {
      "unit": "morning_entrance_verses",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "בְּבֵית אֱלֹהִים נְהַלֵּךְ בְּרָֽגֶשׁ:",
      "page_start": false
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "מַה־טֹּֽבוּ אֹהָלֶֽיךָ יַעֲקֹב מִשְׁכְּנֹתֶֽיךָ יִשְׂרָאֵל:",
      "page_start": false
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶֽךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶֽךָ:",
      "page_start": false
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "יְיָ אָהַֽבְתִּי מְעוֹן בֵּיתֶֽךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶֽךָ:",
      "page_start": false
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָֽעָה אֶבְרְכָה לִפְנֵי־יְיָ עֹשִׂי:",
      "page_start": false
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "וַאֲנִי תְפִלָּתִי־לְךָ יְיָ עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּֽךָ עֲנֵֽנִי בֶּאֱמֶת יִשְׁעֶֽךָ:",
      "page_start": false
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "שַֽׁחַר אֲבַקֶּשְׁךָ. צוּרִי וּמִשְׂגַּבִּי. אֶעְרוֹךְ לְפָנֶֽיךָ. שַׁחְרִי וְגַם־עַרְבִּי:",
      "page_start": false
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "לִפְנֵי גְדֻלָּתְךָ. אֶעְמֹד וְאֶבָּהֵל. כִּי־עֵינְךָ תִרְאֶה. כָּל־מַחְשְׁבוֹת לִבִּי:",
      "page_start": false
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "מַה־זֶּה אֲשֶׁר יוּכַל. הַלֵּב וְהַלָּשׁוֹן לַעֲשׂוֹת, וּמַה־כֹּחִי. רוּחִי בְּתוֹךְ קִרְבִּי:",
      "page_start": false
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "הִנֵּה לְךָ תִיטַב. זִמְרַת אֱנוֹשׁ, עַל־כֵּן אוֹדְךָ בְּעוֹד תִּהְיֶה. נִשְׁמַת אֱלוֹהַּ בִּי:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "אֲנִי קְרָאתִֽיךָ כִּי־תַעֲנֵֽנִי אֵל הַט־אָזְנְךָ לִי שְׁמַע אִמְרָתִי:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "אֲנִי בְּצֶֽדֶק אֶחֱזֶה פָנֶֽיךָ אֶשְׂבְּעָה בְהָקִיץ תְּמוּנָתֶֽךָ:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "וַאֲנִי עָלֶֽיךָ בָטַֽחְתִּי יְיָ אָמַֽרְתִּי אֱלֹהַי אָֽתָּה:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "שְׁמַע קוֹל תַּחֲנוּנַי בְּשַׁוְּעִי אֵלֶֽיךָ בְּנָשְׂאִי יָדַי אֶל־דְּבִיר קָדְשֶֽׁךָ:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "יְיָ אֱלֹהָי שִׁוַּֽעְתִּי אֵלֶֽיךָ וַתִּרְפָּאֵֽנִי:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "אֵלֶֽיךָ יְיָ אֶקְרָא וְאֶל־אֲדֹנָי אֶתְחַנָּן:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "scan": "s26",
      "printed_page": "2",
      "text": "הָאִֽירָה פָנֶֽיךָ עַל־עַבְדֶּֽךָ הוֹשִׁיעֵֽנִי בְחַסְדֶּֽךָ:",
      "page_start": false
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "scan": "s26",
