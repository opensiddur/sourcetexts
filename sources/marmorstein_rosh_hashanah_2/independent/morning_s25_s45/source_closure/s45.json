    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "מִקַּל וָחֹֽמֶר",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "וּמִגְּזֵרָה שָׁוָה.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "מִבִּנְיַן אָב מִכָּתוּב אֶחָד. וּמִבִּנְיַן אָב מִשְּׁנֵי כְתוּבִים.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "מִכְּלָל וּפְרָט.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "וּמִפְּרָט וּכְלָל.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "כְּלָל וּפְרָט וּכְלָל אִי אַתָּה דָן אֶלָּא כְּעֵין הַפְּרָט.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "מִכְּלָל שֶׁהוּא צָרִיךְ לִפְרָט וּמִפְּרָט שֶׁהוּא צָרִיךְ לִכְלָל.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "כָּל־דָּבָר שֶׁהָיָה בִּכְלָל וְיָצָא מִן־הַכְּלָל לְלַמֵּד לֹא לְלַמֵּד עַל־עַצְמוֹ יָצָא אֶלָּא לְלַמֵּד עַל־הַכְּלָל כֻּלּוֹ יָצָא.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "כָּל־דָּבָר שֶׁהָיָה בִּכְלָל וְיָצָא לִטְעוֹן טֹֽעַן אֶחָד שֶׁהוּא כְעִנְיָנוֹ יָצָא לְהָקֵל וְלֹא לְהַחֲמִיר.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 10,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "כָּל־דָּבָר שֶׁהָיָה בִּכְלָל וְיָצָא לִטְעוֹן טֹֽעַן אַחֵר שֶׁלֹּא כְעִנְיָנוֹ יָצָא לְהָקֵל וּלְהַחֲמִיר.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 11,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "כָּל־דָּבָר שֶׁהָיָה בִּכְלָל וְיָצָא לִדּוֹן בַּדָּבָר הֶחָדָשׁ אִי אַתָּה יָכוֹל לְהַחֲזִירוֹ לִכְלָלוֹ עַד שֶׁיַּחֲזִירֶֽנּוּ הַכָּתוּב לִכְלָלוֹ בְּפֵרוּשׁ.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 12,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "דָּבָר הַלָּמֵד מֵעִנְיָנוֹ. וְדָבָר הַלָּמֵד מִסּוֹפוֹ.",
      "page_start": false
    },
    {
      "unit": "middot",
      "language": "he",
      "paragraph_index": 13,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "וְכֵן שְׁנֵי כְתוּבִים הַמַּכְחִישִׁים זֶה אֶת־זֶה עַד שֶׁיָּבוֹא הַכָּתוּב הַשְּׁלִישִׁי וְיַכְרִֽיעַ בֵּינֵיהֶם:",
      "page_start": false
    },
    {
      "unit": "middot_yehi_ratzon",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "scan": "s45",
      "printed_page": "14",
      "text": "יְהִי רָצוֹן לְפָנֶֽיךָ יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ שֶׁיִּבָּנֶה בֵּית הַמִּקְדָּשׁ בִּמְהֵרָה בְיָמֵֽינוּ וְתֵן חֶלְקֵֽנוּ בְּתוֹרָתֶֽךָ:",
