  "prayer_fragments": [
    {
      "unit": "tallith_hineni_mitattef",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "הִנְנִי מִתְעַטֵּף בְּטַלִּית שֶׁל־צִיצִת כְּדֵי לְקַיֵּם מִצְוַת בּוֹרְאִי כַּכָּתוּב בַּתּוֹרָה",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_hineni_mitattef",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "וְעָשׂוּ לָהֶם צִיצִת עַל־כַּנְפֵי בִגְדֵיהֶם לְדֹרֹתָם.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_hineni_mitattef",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "וּכְשֵׁם שֶׁאֲנִי מִתְכַּסֶּה בְטַלִּית בָּעוֹלָם הַזֶּה כֵּן תִּזְכֶּה נִשְׁמָתִי לְהִתְלַבֵּשׁ בְּטַלִּית נָאָה לָעוֹלָם הַבָּא בְּגַן עֵֽדֶן, אָמֵן:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_lehitattef",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לְהִתְעַטֵּף בַּצִּיצִת:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_lehitattef",
      "language": "en",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "Blessed art Thou, O Lord our God, King of the World, who has sanctified us with His commandments and ordered us to drape ourselves with show-fringes.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "מַה־יָּקָר חַסְדְּךָ אֱלֹהִים וּבְנֵי אָדָם בְּצֵל כְּנָפֶיךָ יֶחֱסָיוּן:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "יִרְוְיֻן מִדֶּשֶׁן בֵּיתֶךָ וְנַחַל עֲדָנֶיךָ תַשְׁקֵם:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "כִּי עִמְּךָ מְקוֹר חַיִּים, בְּאוֹרְךָ נִרְאֶה־אוֹר:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "מְשֹׁךְ חַסְדְּךָ לְיֹדְעֶיךָ וְצִדְקָתְךָ לְיִשְׁרֵי־לֵב:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "en",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "How precious is Thy grace, O God, and the children of man shelter in the shadow of Thy wings.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "en",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "They are refreshed by the felicity of Thy house and with the brook of Thy bliss dost Thou water them.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "en",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "For with Thee is the source of life, in Thy light do we behold light.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_mah_yaqar",
      "language": "en",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "Extend Thy grace to those who acknowledge Thee, and Thy charity to those who are of upright heart.",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "tallith_yehi_ratzon",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁתְּהֵי חֲשׁוּבָה מִצְוַת צִיצִת זוֹ כְּאִלּוּ קִיַּמְתִּיהָ בְּכָל־פְּרָטֶיהָ וְדִקְדּוּקֶיהָ וְכַוָּנוֹתֶיהָ ותרי״ג מִצְוֹת־הַתְּלוּיִם בָּהּ. אָמֵן:",
      "reference_scan": "s39",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    }
  ],
