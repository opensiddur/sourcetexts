  "prayer_fragments": [
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 1,
      "text": "תְפִלָּתִי יְיָ וְשַׁוְעָתִי הַאֲזִינָה אֶל־דִּמְעָתִי אַל־תֶּחֱרַשׁ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "text": "שְׁמַע־יְיָ וְחָנֵּנִי יְיָ הֱיֵה עֹזֵר לִי:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 10,
      "fragment_index": 0,
      "text": "שִׁיר הַמַּעֲלוֹת לְדָוִד שָׂמַחְתִּי בְּאֹמְרִים לִי בֵּית יְיָ נֵלֵךְ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 11,
      "fragment_index": 0,
      "text": "שָׂשׂ אָנֹכִי עַל־אִמְרָתֶךָ כְּמוֹצֵא שָׁלָל רָב:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 12,
      "fragment_index": 0,
      "text": "הַקְשִׁיבָה לְקוֹל שַׁוְעִי מַלְכִּי וֵאלֹהָי כִּי־אֵלֶיךָ אֶתְפַּלָּל:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 13,
      "fragment_index": 0,
      "text": "יְיָ בֹּקֶר תִּשְׁמַע קוֹלִי בֹּקֶר אֶעֱרָךְ־לְךָ וַאֲצַפֶּה:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 14,
      "fragment_index": 0,
      "text": "אֲנִי קְרָאתִיךָ כִּי־תַעֲנֵנִי אֵל הַט־אָזְנְךָ לִי שְׁמַע אִמְרָתִי:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 15,
      "fragment_index": 0,
      "text": "רַגְלִי עָמְדָה בְמִישׁוֹר בְּמַקְהֵלִים אֲבָרֵךְ יְיָ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "יִגְדַּל אֱלֹהִים חַי וְיִשְׁתַּבַּח נִמְצָא וְאֵין עֵת אֶל־מְצִיאוּתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "אֶחָד וְאֵין יָחִיד כְּיִחוּדוֹ נֶעְלָם וְגַם אֵין סוֹף לְאַחְדּוּתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "אֵין לוֹ דְּמוּת הַגּוּף וְאֵינוֹ גוּף לֹא נַעֲרוֹךְ אֵלָיו קְדֻשָּׁתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "קַדְמוֹן לְכָל־דָּבָר אֲשֶׁר נִבְרָא רִאשׁוֹן וְאֵין רֵאשִׁית לְרֵאשִׁיתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "הִנּוֹ אֲדוֹן עוֹלָם וְכָל־נוֹצָר יוֹרֶה גְדֻלָּתוֹ וּמַלְכוּתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "text": "שֶׁפַע נְבוּאָתוֹ נְתָנוֹ אֶל אַנְשֵׁי סְגֻלָּתוֹ וְתִפְאַרְתּוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "text": "לֹא קָם בְּיִשְׂרָאֵל כְּמֹשֶׁה עוֹד נָבִיא וּמַבִּיט אֶת־תְּמוּנָתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "text": "תּוֹרַת אֱמֶת נָתַן לְעַמּוֹ אֵל עַל־יַד נְבִיאוֹ נֶאֱמַן בֵּיתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 0,
      "text": "לֹא יַחֲלִיף הָאֵל וְלֹא יָמִיר דָּתוֹ לְעוֹלָמִים לְזוּלָתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "text": "צוֹפֶה וְיוֹדֵעַ סְתָרֵינוּ מַבִּיט לְסוֹף דָּבָר בְּקַדְמָתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 10,
      "fragment_index": 0,
      "text": "גּוֹמֵל לְאִישׁ חֶסֶד כְּמִפְעָלוֹ נוֹתֵן לְרָשָׁע רַע כְּרִשְׁעָתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 11,
      "fragment_index": 0,
      "text": "יִשְׁלַח לְקֵץ יָמִין מְשִׁיחֵנוּ לִפְדּוֹת מְחַכֵּי קֵץ יְשׁוּעָתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "yigdal",
      "language": "he",
      "paragraph_index": 12,
      "fragment_index": 0,
      "text": "מֵתִים יְחַיֶּה אֵל בְּרֹב חַסְדּוֹ בָּרוּךְ עֲדֵי־עַד שֵׁם תְּהִלָּתוֹ:",
      "reference_scan": "s42",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    }
