    {
      "unit": "birkhot_hatorah_laasoq",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לַעֲסוֹק בְּדִבְרֵי תוֹרָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "אֲדוֹן עוֹלָם אֲשֶׁר מָלַךְ. בְּטֶרֶם כָּל־יְצִיר נִבְרָא:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "לְעֵת נַעֲשָׂה בְחֶפְצוֹ כֹּל. אֲזַי מֶלֶךְ שְׁמוֹ נִקְרָא:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "וְאַחֲרֵי כִּכְלוֹת הַכֹּל. לְבַדּוֹ יִמְלוֹךְ נוֹרָא:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "וְהוּא הָיָה וְהוּא הֹוֶה. וְהוּא יִהְיֶה בְּתִפְאָרָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "וְהוּא אֶחָד וְאֵין שֵׁנִי לְהַמְשִׁיל לוֹ לְהַחְבִּירָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "text": "בְּלִי רֵאשִׁית בְּלִי תַכְלִית. וְלוֹ הָעֹז וְהַמִּשְׂרָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "text": "וְהוּא אֵלִי וְחַי גֹּאֲלִי. וְצוּר חֶבְלִי בְּעֵת צָרָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 7,
      "fragment_index": 0,
      "text": "וְהוּא נִסִּי וּמָנוֹס לִי. מְנָת כּוֹסִי בְּיוֹם אֶקְרָא:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 8,
      "fragment_index": 0,
      "text": "בְּיָדוֹ אַפְקִיד רוּחִי. בְּעֵת אִישַׁן וְאָעִירָה:",
      "reference_scan": "s44",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "adon_olam",
      "language": "he",
      "paragraph_index": 9,
      "fragment_index": 0,
      "text": "וְעִם־רוּחִי גְּוִיָּתִי. יְיָ לִי וְלֹא אִירָא:",
