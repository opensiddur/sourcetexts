    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "מַה־טֹּבוּ אֹהָלֶיךָ יַעֲקֹב מִשְׁכְּנֹתֶיךָ יִשְׂרָאֵל:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "וַאֲנִי בְּרֹב חַסְדְּךָ אָבֹא בֵיתֶךָ אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ בְּיִרְאָתֶךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "יְיָ אָהַבְתִּי מְעוֹן בֵּיתֶךָ וּמְקוֹם מִשְׁכַּן כְּבוֹדֶךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "וַאֲנִי אֶשְׁתַּחֲוֶה וְאֶכְרָעָה אֶבְרְכָה לִפְנֵי־יְיָ עֹשִׂי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_mah_tovu",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "וַאֲנִי תְפִלָּתִי־לְךָ יְיָ עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּךָ עֲנֵנִי בֶּאֱמֶת יִשְׁעֶךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "שַׁחַר אֲבַקֶּשְׁךָ. צוּרִי וּמִשְׂגַּבִּי. אֶעְרוֹךְ לְפָנֶיךָ. שַׁחְרִי וְגַם־עַרְבִּי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "לִפְנֵי גְדֻלָּתְךָ. אֶעְמֹד וְאֶבָּהֵל. כִּי־עֵינְךָ תִרְאֶה. כָּל־מַחְשְׁבוֹת לִבִּי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "מַה־זֶּה אֲשֶׁר יוּכַל. הַלֵּב וְהַלָּשׁוֹן לַעֲשׂוֹת, וּמַה־כֹּחִי. רוּחִי בְּתוֹךְ קִרְבִּי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "shachar_avaqeshkha_gabirol",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "הִנֵּה לְךָ תִיטַב. זִמְרַת אֱנוֹשׁ, עַל־כֵּן אוֹדְךָ בְּעוֹד תִּהְיֶה. נִשְׁמַת אֱלוֹהַּ בִּי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 0,
      "fragment_index": 0,
      "text": "אֲנִי קְרָאתִיךָ כִּי־תַעֲנֵנִי אֵל הַט־אָזְנְךָ לִי שְׁמַע אִמְרָתִי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "אֲנִי בְּצֶדֶק אֶחֱזֶה פָנֶיךָ אֶשְׂבְּעָה בְהָקִיץ תְּמוּנָתֶךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 2,
      "fragment_index": 0,
      "text": "וַאֲנִי עָלֶיךָ בָטַחְתִּי יְיָ אָמַרְתִּי אֱלֹהַי אָתָּה:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 3,
      "fragment_index": 0,
      "text": "שְׁמַע קוֹל תַּחֲנוּנַי בְּשַׁוְּעִי אֵלֶיךָ בְּנָשְׂאִי יָדַי אֶל־דְּבִיר קָדְשֶׁךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 4,
      "fragment_index": 0,
      "text": "יְיָ אֱלֹהָי שִׁוַּעְתִּי אֵלֶיךָ וַתִּרְפָּאֵנִי:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 5,
      "fragment_index": 0,
      "text": "אֵלֶיךָ יְיָ אֶקְרָא וְאֶל־אֲדֹנָי אֶתְחַנָּן:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
    },
    {
      "unit": "morning_before_prayer",
      "language": "he",
      "paragraph_index": 6,
      "fragment_index": 0,
      "text": "הָאִירָה פָנֶיךָ עַל־עַבְדֶּךָ הוֹשִׁיעֵנִי בְחַסְדֶּךָ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
