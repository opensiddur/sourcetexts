    },
    {
      "unit": "morning_entrance_verses",
      "language": "he",
      "paragraph_index": 1,
      "fragment_index": 0,
      "text": "בְּבֵית אֱלֹהִים נְהַלֵּךְ בְּרָגֶשׁ:",
      "reference_scan": "s40",
      "reference_readings_sha256": "ec12d97226b9adf43efea9e010be1cbf1ac9559095537d959b7760fdfb5c4f6f"
